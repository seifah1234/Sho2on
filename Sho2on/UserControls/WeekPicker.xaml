<UserControl x:Class="HR_Application.UserControls.WeekPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>
        <!-- تدرج لوني للخلفية -->
        <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3E5F5" Offset="0"/>
            <GradientStop Color="#E1F5FE" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="3" Color="Gray"/>
        <!-- نمط للـ CheckBox -->
        <Style x:Key="DayCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" >
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Icon:PackIconMaterial Kind="CalendarToday" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#0D47A1"/>
                    <Setter Property="BorderBrush" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="15"  >
        <Grid Margin="10">
            <!-- تنظيم الأيام في Grid ليبدو أكثر تناسقًا -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الصف الأول -->
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="0" Grid.Column="0" Content="السبت" Name="D1" HorizontalAlignment="Center"/>
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="0" Grid.Column="1" Content="الأحد" Name="D2" HorizontalAlignment="Center"/>

            <!-- الصف الثاني -->
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="1" Grid.Column="0" Content="الاثنين" Name="D3" HorizontalAlignment="Center"/>
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="1" Grid.Column="1" Content="الثلاثاء" Name="D4" HorizontalAlignment="Center"/>

            <!-- الصف الثالث -->
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="2" Grid.Column="0" Content="الأربعاء" Name="D5" HorizontalAlignment="Center"/>
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="2" Grid.Column="1" Content="الخميس" Name="D6" HorizontalAlignment="Center"/>

            <!-- الصف الرابع (الجمعة فقط) -->
            <CheckBox Style="{StaticResource DayCheckBoxStyle}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="الجمعة" Name="D7" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>