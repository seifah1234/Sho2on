<UserControl x:Class="HR_Application.UserControls.Card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="card" Foreground="#ffffff"
             >
    <Border MouseEnter="btn_mouseEnter" MouseLeave="btn_mouseLeave" Name="btn_border" MouseLeftButtonDown="Border_MouseLeftButtonDown" Background="#ffffff" CornerRadius="7" Margin="30 4" BorderThickness="1" Cursor="Hand">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="Black"/>
                    </Trigger>

                    <DataTrigger Binding="{Binding ElementName=card, Path=IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="Black"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding ElementName=card, Path=Click}" Value="True">
                        <Setter Property="BorderBrush" Value="Black"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>


        <Grid>
            
            <StackPanel HorizontalAlignment="Center"  VerticalAlignment="Center">
                <TextBlock x:Name="btn_txt" FontWeight="ExtraBold" FontSize="16" Text="{Binding ElementName=card, Path=Title}" HorizontalAlignment="Center" Foreground="Black"/>
            </StackPanel>
        </Grid>


    </Border>
</UserControl>
