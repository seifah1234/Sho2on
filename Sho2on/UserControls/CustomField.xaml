<UserControl x:Class="HR_Application.UserControls.CustomField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="customField">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="12" FontWeight="Bold" FlowDirection="RightToLeft" Grid.Column="1" Text="{Binding ElementName=customField, Path=Label}" Foreground="#ffffff" VerticalAlignment="Center"/>
        <Border Grid.Column="0" CornerRadius="5" Background="#ffffff" Width="150" Height="35">
            <TextBox x:Name="TextField" BorderThickness="0" FlowDirection="RightToLeft" Margin="5"/>
        </Border>
    </Grid>
</UserControl>
