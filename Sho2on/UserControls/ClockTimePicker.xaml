<UserControl x:Class="HR_Application.UserControls.ClockTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HR_Application.UserControls"
             Width="360" Background="Transparent">

    <UserControl.Resources>
        <!-- ToggleButton style for AM/PM and Hour/Minute selectors -->
        <Style x:Key="SegmentToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AM/PM specific toggle (purple accent) -->
        <Style x:Key="AmPmToggle" TargetType="ToggleButton" BasedOn="{StaticResource SegmentToggle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#534AB7"/>
                    <Setter Property="Foreground" Value="#EEEDFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- OK Button -->
        <Style x:Key="OkButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="32,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowRootBackground}" CornerRadius="16"
            BorderBrush="#E0DFD8" BorderThickness="1"
            Padding="24">
        <StackPanel>

            <!-- ── TOP ROW: Mode selector + Time display + AM/PM ── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hour / Minute toggle -->
                <Border Grid.Column="0" BorderBrush="#D3D1C7" BorderThickness="1" Margin="5"
                        CornerRadius="8" ClipToBounds="True"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="HourModeButton"
                                      Style="{StaticResource SegmentToggle}"
                                      Content="Hour" IsChecked="True"
                                      Checked="HourModeButton_Checked"/>
                        <Rectangle Width="1" Fill="#D3D1C7"/>
                        <ToggleButton x:Name="MinuteModeButton"
                                      Style="{StaticResource SegmentToggle}"
                                      Content="Min"
                                      Checked="MinuteModeButton_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Time display -->
                <TextBlock x:Name="TimeDisplay"
                           Grid.Column="1"
                           Text="10:30"
                           Margin="5"
                           FontSize="42" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryColor}"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- AM / PM toggle -->
                <Border Grid.Column="2" BorderBrush="#D3D1C7" BorderThickness="1"
                        CornerRadius="8" ClipToBounds="True" Margin="5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical">
                        <ToggleButton x:Name="AmButton"
                                      Style="{StaticResource AmPmToggle}"
                                      Content="AM" IsChecked="True"
                                      Checked="AmButton_Checked"/>
                        <Rectangle Height="1" Fill="#D3D1C7"/>
                        <ToggleButton x:Name="PmButton"
                                      Style="{StaticResource AmPmToggle}"
                                      Content="PM"
                                      Checked="PmButton_Checked"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CLOCK FACE ── -->
            <Border HorizontalAlignment="Center">
                <Canvas x:Name="ClockCanvas"
                        Width="260" Height="260"
                        Cursor="Hand"
                        MouseDown="ClockCanvas_MouseDown"
                        MouseMove="ClockCanvas_MouseMove"
                        MouseUp="ClockCanvas_MouseUp"
                        MouseLeave="ClockCanvas_MouseLeave">

                    <!-- Outer circle -->
                    <Ellipse Width="260" Height="260"
                             Fill="{DynamicResource PrimaryColor}"
                             Stroke="{DynamicResource SecondaryColor}" StrokeThickness="1"
                             Canvas.Left="0" Canvas.Top="0"/>

                    <!-- Hour/Minute number labels (drawn in code-behind) -->

                    <!-- Hour hand -->
                    <Line x:Name="HourHand"
                          Stroke="#534AB7" StrokeThickness="4"
                          />

                    <!-- Minute hand -->
                    <Line x:Name="MinuteHand"
                          Stroke="#1D9E75" StrokeThickness="2.5"
                         />

                    <!-- Selection highlight circle (at hand tip) -->
                    <Ellipse x:Name="SelectionHighlight"
                             Width="32" Height="32"
                             Fill="#534AB7" Opacity="0.15"/>

                    <!-- Selection dot (at hand tip) -->
                    <Ellipse x:Name="SelectionDot"
                             Width="16" Height="16"
                             Fill="#534AB7"/>

                    <!-- Center cap -->
                    <Ellipse Width="10" Height="10"
                             Fill="#534AB7"
                             Canvas.Left="125" Canvas.Top="125"/>
                </Canvas>
            </Border>

            <!-- ── OK BUTTON ── -->
            <Button x:Name="OkBtn"
                    Content="OK ✓"
                    Style="{StaticResource OkButton}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Click="OkBtn_Click"/>

        </StackPanel>
    </Border>
</UserControl>
