<UserControl x:Class="HR_Application.UserControls.GroupChatBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:HR_Application.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="45" Height="45" Grid.Column="0" Margin="0,0,10,0">
                    <Border.Clip>
                        <EllipseGeometry Center="22.5,22.5" RadiusX="22.5" RadiusY="22.5"/>
                    </Border.Clip>
                    <Image x:Name="GroupImage"
                           Source="/assets/images/group_avatar.png"
                           Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GroupNameText"
                               FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryColor}"/>
                    <TextBlock x:Name="MembersCountText"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource TextPrimaryColor}"/>
                </StackPanel>

                <!-- زر إدارة الأعضاء — بس للـ admin -->
                <Button x:Name="ManageMembersBtn"
                        Grid.Column="2"
                        Background="Transparent" BorderThickness="0"
                        Click="ManageMembers_Click"
                        ToolTip="إدارة الأعضاء"
                        Visibility="Collapsed">
                    <icons:PackIconMaterial Kind="AccountCog" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Placeholder -->
        <Grid x:Name="NoChatSelectedPlaceholder" Grid.Row="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <icons:PackIconMaterial Kind="AccountGroup"
                                        Width="60" Height="60"
                                        Opacity="0.2"
                                        HorizontalAlignment="Center"/>
                <TextBlock Text="اختر جروب للبدء"
                           Opacity="0.4" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- الرسائل -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,4">
                            <!-- رسالتي -->
                            <StackPanel HorizontalAlignment="Left"
                                        Visibility="{Binding MyMessageVisibility}">
                                <Border Background="#00BCD4"
                                        CornerRadius="0,12,12,12"
                                        Padding="10,7" MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MessageText}"
                                                   Foreground="White" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Time}" FontSize="10" Opacity="0.7" Foreground="White"/>
                                            <TextBlock Text="{Binding ReadCountText}" 
               FontSize="10" Opacity="0.8" Foreground="White"
               Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- رسالة غيري -->
                            <StackPanel HorizontalAlignment="Right"
                                        Visibility="{Binding OtherMessageVisibility}">
                                <!-- اسم المرسل -->
                                
                                <TextBlock Text="{Binding SenderName}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#00BCD4"
                                           HorizontalAlignment="Right"
                                           Margin="5,0,5,2"/>
                                <Border Background="{DynamicResource SecondaryColor}"
                                        CornerRadius="12,0,12,12"
                                        Padding="10,7" MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MessageText}"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Time}"
                                                   FontSize="10" Opacity="0.5"
                                                   HorizontalAlignment="Left"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- المرفقات المعلقة -->
        <ScrollViewer x:Name="AttachmentsScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Visibility="Collapsed" MaxHeight="80">
            <ItemsControl ItemsSource="{Binding SelectedAttachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SecondaryColor}"
                                CornerRadius="5" Margin="5" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}"
                                           VerticalAlignment="Center" MaxWidth="100"
                                           TextTrimming="WordEllipsis"/>
                                <Button Tag="{Binding}"
                                        Click="RemoveAttachment_Click"
                                        Background="Transparent"
                                        BorderThickness="0" Margin="5,0,0,0">
                                    <icons:PackIconMaterial Kind="Close"
                                                            Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="3"
                Background="{DynamicResource PrimaryColor}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="AttachButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Margin="0,0,5,0">
                    <icons:PackIconMaterial Kind="Attachment" Width="20" Height="20"/>
                </Button>

                <TextBox x:Name="MessageTextBox"
                         Grid.Column="1"
                         MinHeight="40" MaxHeight="120"
                         TextWrapping="Wrap"
                         Width="Auto"
                         HorizontalAlignment="Stretch"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="MessageTextBox_KeyDown"
                         IsEnabled="False"/>

                <Button x:Name="SendButton"
                        Grid.Column="2"
                        Click="SendButton_Click"
                        IsEnabled="False"
                        Background="Transparent" BorderThickness="0"
                        Margin="5,0,0,0">
                    <icons:PackIconMaterial Kind="Send" Width="20" Height="20"
                                            Foreground="#00BCD4"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>