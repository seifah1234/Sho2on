<UserControl x:Class="HR_Application.UserControls.GroupChatBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:HR_Application.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="45" Height="45" Grid.Column="0" Margin="0,0,10,0">
                    <Border.Clip>
                        <EllipseGeometry Center="22.5,22.5" RadiusX="22.5" RadiusY="22.5"/>
                    </Border.Clip>
                    <Image x:Name="GroupImage"
                           Source="/assets/images/group_avatar.png"
                           Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GroupNameText"
                               FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryColor}"/>
                    <TextBlock x:Name="MembersCountText"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource TextPrimaryColor}"/>
                </StackPanel>

                <!-- زر إدارة الأعضاء — بس للـ admin -->
                <Button x:Name="ManageMembersBtn"
                        Grid.Column="2"
                        Background="Transparent" BorderThickness="0"
                        Click="ManageMembers_Click"
                        ToolTip="إدارة الأعضاء"
                        Visibility="Collapsed">
                    <icons:PackIconMaterial Kind="AccountCog" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Placeholder -->
        <Grid x:Name="NoChatSelectedPlaceholder" Grid.Row="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <icons:PackIconMaterial Kind="AccountGroup"
                                        Width="60" Height="60"
                                        Opacity="0.2"
                                        HorizontalAlignment="Center"/>
                <TextBlock Text="اختر جروب للبدء"
                           Opacity="0.4" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- الرسائل -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,4">
                            <!-- رسالتي -->
                            <StackPanel HorizontalAlignment="Left"
                                        Visibility="{Binding MyMessageVisibility}">
                                <Border Background="#00BCD4"
                                        CornerRadius="0,12,12,12"
                                        Padding="10,7" MaxWidth="400">
                                    <Border.ContextMenu>
                                        <ContextMenu FlowDirection="RightToLeft">
                                            <MenuItem Header="✏️ تعديل" Click="EditGroupMessage_Click" Tag="{Binding}"/>
                                            <MenuItem Header="🗑️ حذف"   Click="DeleteGroupMessage_Click" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding MessageText}"
                                                   Foreground="White" TextWrapping="Wrap"/>
                                        <ItemsControl Grid.Row="1" 
ItemsSource="{Binding Attachments}"
Margin="0,5,0,0"
Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="DownloadAttachment_Click" Tag="{Binding}"
      Background="{DynamicResource PrimaryColor}"
      Padding="5,2" Margin="0,0,5,5"
      Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:PackIconMaterial Kind="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryColor}"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}"/>
                                                            <TextBlock Text="{Binding FileSizeText}" FontSize="8" Opacity="0.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding ReadCountText}" 
               FontSize="10" Opacity="0.8" Foreground="White"
               Margin="5,0,0,0"/>
                                            
                                            <TextBlock Text="{Binding EditedLabel}" 
FontSize="9" Opacity="0.6"
                                                       Margin="5,0"
Foreground="{DynamicResource PrimaryColor}"
Visibility="{Binding ShowEditedLabel, 
    Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Time}" FontSize="10" Opacity="0.7" Foreground="White" Margin="5,0" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- رسالة غيري -->
                            <StackPanel HorizontalAlignment="Right"
                                        Visibility="{Binding OtherMessageVisibility}">
                                <!-- اسم المرسل -->
                                
                                <TextBlock Text="{Binding SenderName}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#00BCD4"
                                           HorizontalAlignment="Right"
                                           Margin="5,0,5,2"/>
                                <Border Background="{DynamicResource SecondaryColor}"
                                        CornerRadius="12,0,12,12"
                                        Padding="10,7" MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MessageText}"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                                   TextWrapping="Wrap"/>
                                        <ItemsControl Grid.Row="1" 
ItemsSource="{Binding Attachments}"
Margin="0,5,0,0"
Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="DownloadAttachment_Click" Tag="{Binding}"
      Background="{DynamicResource PrimaryColor}"
      Padding="5,2" Margin="0,0,5,5"
      Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:PackIconMaterial Kind="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryColor}"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}"/>
                                                            <TextBlock Text="{Binding FileSizeText}" FontSize="8" Opacity="0.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding EditedLabel}" 
FontSize="9" Opacity="0.6"
                                                       Margin="5,0"
Foreground="{DynamicResource PrimaryColor}"
Visibility="{Binding ShowEditedLabel, 
    Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Time}"
                                                   FontSize="10" Opacity="0.5"
                                                   HorizontalAlignment="Left"
                                                   FlowDirection="LeftToRight"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                                   Margin="5,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- المرفقات المعلقة -->
        <ScrollViewer x:Name="AttachmentsScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Visibility="Collapsed" MaxHeight="80">
            <ItemsControl ItemsSource="{Binding SelectedAttachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SecondaryColor}"
                                CornerRadius="5" Margin="5" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}"
                                           VerticalAlignment="Center" MaxWidth="100"
                                           TextTrimming="WordEllipsis"/>
                                <Button Tag="{Binding}"
                                        Click="RemoveAttachment_Click"
                                        Background="Transparent"
                                        BorderThickness="0" Margin="5,0,0,0">
                                    <icons:PackIconMaterial Kind="Close"
                                                            Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" x:Name="EditBar"
Background="#1A00BCD4" 
BorderBrush="#00BCD4"
BorderThickness="0,2,0,0"
Padding="10,5"
Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EditingLabel" 
           Text="✏️ تعديل رسالة..."
           Foreground="#00BCD4" FontSize="12"
           VerticalAlignment="Center"/>
                <Button Grid.Column="1" 
        Content="✕ إلغاء"
        Background="Transparent" BorderThickness="0"
        Foreground="#00BCD4"
        Click="CancelEdit_Click"/>
            </Grid>
        </Border>
        
        <!-- Input -->
        <Border Grid.Row="4"
                Background="{DynamicResource PrimaryColor}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="AttachButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Margin="0,0,5,0">
                    <icons:PackIconMaterial Kind="Attachment" Width="20" Height="20"/>
                </Button>

                <TextBox x:Name="MessageTextBox"
                     Grid.Column="1"
                     Tag="اكتب رسالة..."
                     MinHeight="80"
                     MaxHeight="100"
                             Width="Auto"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource PrimaryColor}"
                     Foreground="{DynamicResource TextPrimaryColor}"
                     BorderBrush="{DynamicResource SecondaryColor}"
                     BorderThickness="1"
                     MaxLines="5"
                     Padding="2,0"
                     KeyDown="MessageTextBox_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="2"
                        Click="SendButton_Click"
                        IsEnabled="False"
                        Background="Transparent" BorderThickness="0"
                        Margin="5,0,0,0">
                    <icons:PackIconMaterial Kind="Send" Width="20" Height="20" FlowDirection="RightToLeft"
                                            Foreground="#00BCD4"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>