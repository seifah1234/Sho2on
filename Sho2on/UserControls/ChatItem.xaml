<UserControl x:Class="HR_Application.UserControls.ChatItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:HR_Application.Converters"
             mc:Ignorable="d" FlowDirection="RightToLeft"
             x:Name="ChatItemControl">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryColor}" Height="80">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- الصورة الدائرية -->
        <Border Width="60" Height="60" Margin="10,10,5,10">
            <Border.Clip>
                <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
            </Border.Clip>
            <Border BorderBrush="{DynamicResource SecondaryColor}" 
                    BorderThickness="1"
                    Background="{DynamicResource SecondaryColor}">

                <!-- الصورة من قاعدة البيانات -->
                <Image Source="{Binding ProfileImage, FallbackValue=/assets/images/avatar.jpg, UpdateSourceTrigger=PropertyChanged}"
       Stretch="UniformToFill"/>
            </Border>
        </Border>

        <!-- محتوى النصوص -->
        <Grid Grid.Column="1" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding UserName, ElementName=ChatItemControl}" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource TextPrimaryColor}"
                   FontSize="14"/>
                <TextBlock Text="{Binding LastMessageTime, ElementName=ChatItemControl, StringFormat='HH:mm tt'}" 
                   FontSize="10"
                   Opacity="0.5"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" 
                       Text="{Binding LastMessage,UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="{DynamicResource TextPrimaryColor}"
                       FontSize="12"
                       Opacity="0.8"
                       VerticalAlignment="Center"
                       TextTrimming="WordEllipsis"/>
        </Grid>
    </Grid>
</UserControl>