<UserControl x:Class="HR_Application.UserControls.MenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="CustomButton" Height="50">
    <Border MouseEnter="btn_mouseEnter" MouseLeave="btn_mouseLeave" Name="btn_border" Cursor="Hand" MouseLeftButtonDown="Border_MouseLeftButtonDown" Background="#ffffff" CornerRadius="10">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#ffffff"/>
                    </Trigger>

                    <DataTrigger Binding="{Binding ElementName=CustomButton, Path=IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="#ffffff"/>
                    </DataTrigger>


                </Style.Triggers>
            </Style>
        </Border.Style>


        <Grid>

            <StackPanel VerticalAlignment="Center" Margin="5 0 5 0">
                <TextBlock x:Name="btn_txt" FontSize="14" Text="{Binding ElementName=CustomButton, Path=Title}" HorizontalAlignment="Center" Foreground="Black"/>
            </StackPanel>


        </Grid>


    </Border>
</UserControl>
