<UserControl x:Class="HR_Application.Controls.DashboardTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HR_Application.Controls"
             xmlns:converters="clr-namespace:HR_Application.Converters"
             xmlns:classes="clr-namespace:HR_Application.Classes"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             d:DesignHeight="500" d:DesignWidth="350"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <converters:NodeColorConverter x:Key="NodeColorConverter"/>
        <converters:NodeIconConverter x:Key="NodeIconConverter"/>
        <converters:NodeHeightConverter x:Key="NodeHeightConverter"/>
        <converters:VisibilityConverter x:Key="VisibilityConverter"/>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush"     Color="#1E2A3A"/>
        <SolidColorBrush x:Key="AccentBrush"      Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SurfaceBrush"     Color="#263548"/>
        <SolidColorBrush x:Key="BorderBrush"      Color="#334155"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondBrush"  Color="#94A3B8"/>
        <SolidColorBrush x:Key="GreenBrush"       Color="#22C55E"/>
        <SolidColorBrush x:Key="HoverBrush"       Color="#2D4060"/>
        <SolidColorBrush x:Key="LineColor"        Color="#475569"/>
        <SolidColorBrush x:Key="DangerBrush"      Color="#EF4444"/>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin"          Value="6"/>
        </Style>

        <Style x:Key="CardHeaderBrush" TargetType="Border">
            <Setter Property="CornerRadius" Value="16 16 0 0"/>
            <Setter Property="Padding"      Value="16,12"/>
            <Setter Property="Background"   Value="{DynamicResource DataGridHeaderBackground}"/>
        </Style>
        <!-- Toggle Button (Expand/Collapse Arrow) -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width"     Value="18"/>
            <Setter Property="Height"    Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="18" Height="18">
                            <Path x:Name="Arrow"
                                  Data="M 4 6 L 9 11 L 14 6"
                                  Stroke="{StaticResource TextSecondBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ArrowRotate" Angle="-90" CenterX="9" CenterY="8.5"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="-90" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem Style for Level 3+ -->
        <Style x:Key="SubLevelTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded"         Value="True"/>
            <Setter Property="Foreground"         Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Background="{Binding Type, Converter={StaticResource NodeColorConverter}}"
                                    CornerRadius="6"
                                    Margin="2,1"
                                    Height="{Binding Type, Converter={StaticResource NodeHeightConverter}}"
                                    Padding="6,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Visibility="Hidden"
                                                  Margin="0,0,4,0"/>

                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Margin="20,2,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"    Value="False"/>
                                    <Condition Property="IsMouseOver"   Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView Style for Level 3+ -->
        <Style x:Key="SubLevelTreeViewStyle" TargetType="TreeView">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Root Card Template -->
        <DataTemplate x:Key="RootCardTemplate" DataType="{x:Type classes:DashboardTree}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,12,0">
                            <Grid>
                                
                            <TextBlock Text="{Binding Type, Converter={StaticResource NodeIconConverter}}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"
                                       x:Name="RootNodeIcon"
                                       VerticalAlignment="Center"/>

                            <Image x:Name="RootNodeImage"
                                   Width="16" Height="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Type}"
                                       Foreground="{DynamicResource TextSecondBrush}"
                                       FontSize="11"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Border CornerRadius="8"
                                Background="#1E3A5F"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="الموظفين:"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalEmployees}"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8"
                                Background="#1A3A2A"
                                BorderBrush="{DynamicResource GreenBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Visibility="{Binding TotalChildren, Converter={StaticResource VisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊"
                                           FontSize="12"
                                           Foreground="{DynamicResource GreenBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChildrenType}"
                                           FontSize="11"
                                           Foreground="{DynamicResource GreenBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalChildren}"
                                           Foreground="{DynamicResource GreenBrush}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Level 1 Card Template (Sector with Branches inside) -->
        <DataTemplate x:Key="Level1CardTemplate" DataType="{x:Type classes:DashboardTree}">
            <Border
            CornerRadius="10"
                    HorizontalAlignment="Center"
            
                                Style="{DynamicResource StatCard}"
            BorderThickness="1"
            Padding="16"
            Margin="0,0,8,8"
            Width="240">
                <StackPanel x:Name="SectorStackPanel">
                    <!-- Sector Header -->
                    <Border x:Name="SectorHeader"
                            Style="{DynamicResource CardHeaderBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8"
                    Cursor="Hand"
                    MouseLeftButtonDown="SectorHeader_MouseLeftButtonDown">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="28" Height="28"
                                CornerRadius="6"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Type, Converter={StaticResource NodeIconConverter}}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="180"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Border CornerRadius="6"
                                Background="#1E3A5F"
                                Padding="6,3"
                                Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤"
                                           FontSize="9"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,3,0"
                                           VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalEmployees}"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="6"
                                Background="#1A3A2A"
                                Padding="6,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ChildrenType}"
                                           FontSize="9"
                                           Foreground="{DynamicResource GreenBrush}"
                                           Margin="0,0,3,0"
                                           VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalChildren}"
                                           Foreground="{DynamicResource GreenBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Expand/Collapse Arrow Indicator -->
                                <TextBlock x:Name="ExpandArrow"
                                   Text="▼"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Branches List (Collapsible) -->
                    <ItemsControl x:Name="BranchesList"
                          ItemsSource="{Binding Children}"
                          Visibility="Visible">
                        <ItemsControl.ItemTemplate>
                            <!-- Branch Item Template (inside BranchesList) -->
                            <DataTemplate DataType="{x:Type classes:DashboardTree}">
                                <Border Background="{DynamicResource MainBackgroundBrush}"
            CornerRadius="6"
            Padding="10"
            Margin="8,2,0,2"
                                        
                                Style="{DynamicResource StatCard}"
            Cursor="Hand"
            MouseLeftButtonDown="BranchHeader_MouseLeftButtonDown">
                                    <StackPanel>
                                        <!-- Branch Header Info -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Width="20" Height="20"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource NodeIconConverter}}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                                                <!-- Arrow indicator for expand/collapse -->
                                                <TextBlock Text="▼"
                               FontSize="8"
                               Foreground="{DynamicResource TextSecondBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,0,0,0">
                                                <TextBlock Text="👤 "
                               FontSize="9"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                               VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalEmployees}"
                               Foreground="{DynamicResource AccentLightBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ChildrenType}"
                               FontSize="9"
                               Foreground="{DynamicResource GreenBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                                                <TextBlock Text="{Binding TotalChildren}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Departments List (Nested in Branch) - MUST have x:Name="DepartmentsList" -->
                                        <ItemsControl x:Name="DepartmentsList"
                          ItemsSource="{Binding Children}"
                          Visibility="Visible"
                          Margin="20,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type classes:DashboardTree}">
                                                    <Border
                                CornerRadius="4"
                                Padding="8,6"
                                                            
                                Style="{DynamicResource StatCard}"
                                Margin="0,2,0,2">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                
                                                            <Border Width="16" Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Type, Converter={StaticResource NodeIconConverter}}"
                                               FontSize="8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="150"/>
                                                            </StackPanel>
                                                            <Border Background="#1E3A5F"
                                                                    HorizontalAlignment="Right"
                                        CornerRadius="3"
                                        Padding="4,2">
                                                                <StackPanel Orientation="Horizontal" >
                                                                    <TextBlock Text="👤 "
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                                   FontSize="7"
                                                   VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TotalEmployees}"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        
        <!-- Template for Level 3+ TreeView Items (Departments) -->
        <HierarchicalDataTemplate x:Key="SubLevelTreeTemplate"
                                  DataType="{x:Type classes:DashboardTree}"
                                  ItemsSource="{Binding Children}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="20" Height="20"
                        CornerRadius="4"
                        Style="{DynamicResource CardHeaderBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Type, Converter={StaticResource NodeIconConverter}}"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="👤 "
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalEmployees}"
                               Foreground="{DynamicResource AccentLightBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <!-- Main Layout -->
    <Border Background="{DynamicResource InputBackground}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Zoom Controls -->
                        <Border 
                                CornerRadius="6"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnZoomOut"
                                        Content="🔍－"
                                        Click="BtnZoomOut_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="4,2">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock x:Name="ZoomLevelText"
                                           Text="100%"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="4,0"
                                           Width="40"
                                           TextAlignment="Center"/>

                                <Button x:Name="BtnZoomIn"
                                        Content="🔍＋"
                                        Click="BtnZoomIn_Click"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="4,2">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="BtnZoomReset"
                                        Content="↺"
                                        Click="BtnZoomReset_Click"
                                        Width="32" Height="28"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondBrush}"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Cursor="Hand"
                                        ToolTip="إعادة الضبط"
                                        Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="4,2">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnExpandAll"
                                Content="＋ اظهار كامل"
                                Click="BtnExpandAll_Click"
                                Foreground="{DynamicResource AccentBrush}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                FontSize="11"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
                                    <Setter Property="FontSize"   Value="11"/>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BtnCollapseAll"
                                Content="－ اظهار جزئي"
                                Click="BtnCollapseAll_Click"
                                Foreground="{DynamicResource BorderBrush}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="8,4"
                                FontSize="11"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondBrush}"/>
                                    <Setter Property="FontSize"   Value="11"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" x:Name="MainScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
              CanContentScroll="True"
                          Padding="16">
                <Grid x:Name="ZoomContainer">
                    <StackPanel x:Name="MainContentPanel"
                HorizontalAlignment="Center"
                    Width="{Binding ElementName=ZoomContainer, Path=ActualWidth}">

                        <!-- Root Card -->

                        <Border
                    CornerRadius="12"
                                Style="{DynamicResource StatCard}"
                            Name="RootCard"
                    BorderThickness="1.5"
                    Padding="20"
                    Margin="0,0,0,16"
                MaxWidth="800">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,12,0">
                                        <Grid>

                                            <TextBlock Text="{Binding Type, Converter={StaticResource NodeIconConverter}}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"
                                       x:Name="RootNodeIcon"
                                       VerticalAlignment="Center"/>

                                            <Image x:Name="RootNodeImage"
                                   Width="16" Height="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <UniformGrid Grid.Row="1" Columns="4">
                                    <Border CornerRadius="8"
                                Background="#1E3A5F"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👤"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="الموظفين:"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalEmployees}"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8"
                                Background="#1E3A5F"
                                BorderBrush="{DynamicResource AccentLightBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Visibility="{Binding TotalChildren, Converter={StaticResource VisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="القطاعات"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalChildren}"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8"
                                Background="#1E3A5F"
                                BorderBrush="{DynamicResource AccentLightBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Visibility="{Binding TotalChildren, Converter={StaticResource VisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌆"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="الفروع"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalBranches}"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8"
                                Background="#1E3A5F"
                                BorderBrush="{DynamicResource AccentLightBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Visibility="{Binding TotalChildren, Converter={StaticResource VisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏢"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="الادارات"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalDeparts}"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Level 1 Cards (Sectors with Branches) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,16">
                            <ItemsControl x:Name="Level1CardsControl"
                                      ItemTemplate="{StaticResource Level1CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>