<UserControl x:Class="HR_Application.UserControls.Textfield"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      Name="customField">

    <Grid >
        
        <Border CornerRadius="5" Background="#ffffff">
            <TextBox x:Name="TextField" BorderThickness="0" FlowDirection="RightToLeft" Margin="5"/>
        </Border>
    </Grid>
</UserControl>
