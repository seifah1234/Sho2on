<UserControl x:Class="HR_Application.UserControls.ChatBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             xmlns:controls="clr-namespace:HR_Application.UserControls"
             xmlns:converters="clr-namespace:HR_Application.Converters"
             FlowDirection="RightToLeft"
             d:DesignHeight="450" d:DesignWidth="500"
             x:Name="ChatBoxControl">

    <UserControl.Resources>
        <!-- محول لتحويل حالة الرسالة إلى أيقونة -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header - معلومات المستخدم -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryColor}" 
                BorderBrush="{DynamicResource SecondaryColor}"
                BorderThickness="0,0,0,1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- صورة المستخدم -->
                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0">
                    <Border.Clip>
                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                    </Border.Clip>
                    <Image Source="{Binding SelectedUserImage, ElementName=ChatBoxControl, FallbackValue=/assets/images/avatar.jpg}" 
                           Stretch="UniformToFill"/>
                </Border>

                <!-- اسم المستخدم -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedUserName, ElementName=ChatBoxControl}" 
                               FontWeight="Bold" 
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryColor}"/>
                    <TextBlock Text="{Binding UserStatus, ElementName=ChatBoxControl}" Visibility="Hidden"
                               FontSize="11"
                               Opacity="0.7"
                               Foreground="{DynamicResource TextPrimaryColor}"/>
                </StackPanel>

                <!-- أزرار الإجراءات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button ToolTip="تغيير الخلفية" 
            Background="Transparent" BorderThickness="0"
            Click="ChangeBackground_Click">
                        <icons:PackIconMaterial Kind="ImageEdit" Width="20" Height="20" 
                                Foreground="{DynamicResource TextPrimaryColor}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- منطقة الرسائل -->
        <ScrollViewer Grid.Row="1" 
                      x:Name="MessagesScrollViewer"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Background>
                <ImageBrush x:Name="ChatBackgroundBrush" 
                    Stretch="UniformToFill"/>
            </ScrollViewer.Background>
            <ItemsControl x:Name="MessagesItemsControl" Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,5">
                            <!-- رسالة من المستخدم الآخر -->
                            <Border x:Name="OtherMessageBorder"
                                    Background="{DynamicResource PrimaryColor}"
                                    CornerRadius="0,10,10,10"
                                    Padding="10"
                                    Margin="0,0,50,0"
                                   Visibility="{Binding MyMessageVisibility}"
                                    BorderBrush="{DynamicResource SecondaryColor}"
                                    BorderThickness="1"
                                    MinWidth="200"
                                    MinHeight="50"
                                    HorizontalAlignment="Left"
                                    MaxWidth="400">
                                <Border.ContextMenu>
                                    <ContextMenu FlowDirection="RightToLeft">
                                        <MenuItem Header="✏️ تعديل" Click="EditMessage_Click" Tag="{Binding}"/>
                                        <MenuItem Header="🗑️ حذف"   Click="DeleteMessage_Click" Tag="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding MessageText}" 
                                               Foreground="{DynamicResource TextPrimaryColor}"
                                               TextWrapping="Wrap"/>

                                    <ItemsControl Grid.Row="1" 
                      ItemsSource="{Binding Attachments}"
                      Margin="0,5,0,0"
                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="DownloadAttachment_Click" Tag="{Binding}"
                            Background="{DynamicResource SecondaryColor}"
                            Padding="5,2" Margin="0,0,5,5"
                            Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icons:PackIconMaterial Kind="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,5,0" Foreground="{DynamicResource PrimaryColor}"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}"/>
                                                        <TextBlock Text="{Binding FileSizeText}" FontSize="8" Opacity="0.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
                                        <icons:PackIconMaterial Kind="{Binding StatusIcon}" Width="12" Height="12" 
                            Foreground="{DynamicResource TextPrimaryColor}"/>
                                        <TextBlock Text="{Binding EditedLabel}" 
           FontSize="9" Opacity="0.6"
           Foreground="{DynamicResource TextPrimaryColor}"
           Visibility="{Binding ShowEditedLabel, 
               Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Time}" FontSize="10" Opacity="0.5" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- رسالة من أنا -->
                            <Border x:Name="MyMessageBorder"
                                    Background="{DynamicResource SecondaryColor}"
                                    CornerRadius="10,0,10,10"
                                    Padding="10"
                                    MinWidth="200"
                                    Margin="50,0,0,0"
                                    MinHeight="50"
                                    BorderBrush="{DynamicResource PrimaryColor}"
                                    BorderThickness="1"
                                    MaxWidth="400"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding OtherMessageVisibility}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding MessageText}" 
                         Foreground="{DynamicResource PrimaryColor}"
                         TextWrapping="Wrap"/>

                                    <ItemsControl Grid.Row="1" 
ItemsSource="{Binding Attachments}"
Margin="0,5,0,0"
Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="DownloadAttachment_Click" Tag="{Binding}"
      Background="{DynamicResource PrimaryColor}"
      Padding="5,2" Margin="0,0,5,5"
      Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icons:PackIconMaterial Kind="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryColor}"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}"/>
                                                        <TextBlock Text="{Binding FileSizeText}" FontSize="8" Opacity="0.5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding EditedLabel}" 
FontSize="9" Opacity="0.6"
Foreground="{DynamicResource PrimaryColor}"
Visibility="{Binding ShowEditedLabel, 
    Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- وقت الرسالة -->
                                        <TextBlock Text="{Binding Time}" 
                                       FontSize="10"
                                       Opacity="0.5"
                                       FlowDirection="LeftToRight"
                                       Margin="5,2"
                                                   Foreground="{DynamicResource PrimaryColor}"
                                       HorizontalAlignment="{Binding Alignment}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="EditBar"
        Background="#1A00BCD4" 
        BorderBrush="#00BCD4"
        BorderThickness="0,2,0,0"
        Padding="10,5"
        Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EditingLabel" 
                   Text="✏️ تعديل رسالة..."
                   Foreground="#00BCD4" FontSize="12"
                   VerticalAlignment="Center"/>
                <Button Grid.Column="1" 
                Content="✕ إلغاء"
                Background="Transparent" BorderThickness="0"
                Foreground="#00BCD4"
                Click="CancelEdit_Click"/>
            </Grid>
        </Border>
        
        <!-- منطقة إرسال الرسالة -->
        <Border Grid.Row="3" 
        Background="{DynamicResource PrimaryColor}" 
        BorderBrush="{DynamicResource SecondaryColor}"
        BorderThickness="0,1,0,0"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر إرفاق ملف -->
                <Button Grid.Column="0" 
                x:Name="AttachButton"
                ToolTip="إرفاق ملف" 
                Background="Transparent" 
                BorderThickness="0" 
                Margin="0,0,10,0"
                Click="AttachButton_Click">
                    <icons:PackIconMaterial Kind="Paperclip" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryColor}"/>
                </Button>

                <!-- قائمة المرفقات المختارة -->
                <ScrollViewer Grid.Column="1" 
                      x:Name="AttachmentsScrollViewer"
                      MaxHeight="60"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,10,0"
                      Visibility="Collapsed">
                    <ItemsControl x:Name="SelectedAttachmentsList" 
                          ItemsSource="{Binding SelectedAttachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SecondaryColor}" 
                                CornerRadius="5" 
                                Padding="5,5" 
                                Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <icons:PackIconMaterial Kind="File" Width="14" Height="14" Margin="0,0,5,0" Foreground="{DynamicResource PrimaryColor}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource PrimaryColor}"/>
                                        <Button Grid.Column="2" 
                                        Content="✕" 
                                        Background="Transparent" 
                                        BorderThickness="0"
                                                Height="30"
                                        Foreground="Red"
                                        FontSize="8"
                                                HorizontalAlignment="Center"
                                        Margin="5"
                                        Click="RemoveAttachment_Click"
                                        Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBox x:Name="MessageTextBox"
                 Grid.Column="2"
                 Tag="اكتب رسالة..."
                 MinHeight="80"
                 MaxHeight="100"
                         Width="Auto"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 Background="{DynamicResource PrimaryColor}"
                 Foreground="{DynamicResource TextPrimaryColor}"
                 BorderBrush="{DynamicResource SecondaryColor}"
                 BorderThickness="1"
                 MaxLines="5"
                 Padding="2,0"
                 KeyDown="MessageTextBox_KeyDown"/>

                <Button x:Name="SendButton"
                Grid.Column="3"
                ToolTip="إرسال"
                Background="#00BCD4"
                BorderThickness="0"
                Margin="10,0,0,0"
                Width="35"
                Height="35"
                Click="SendButton_Click">
                    <icons:PackIconMaterial Kind="Send" Width="18" Height="18" Foreground="White" FlowDirection="RightToLeft"/>
                </Button>
            </Grid>
        </Border>

        <!-- Placeholder عند عدم اختيار محادثة -->
        <Border Grid.RowSpan="3" 
                x:Name="NoChatSelectedPlaceholder"
                Background="{DynamicResource MainBackground}"
                Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <icons:PackIconMaterial Kind="Chat" Width="80" Height="80" Opacity="0.3" Foreground="{DynamicResource SecondaryColor}"/>
                <TextBlock Text="اختر محادثة للبدء" 
                           FontSize="16" 
                           Foreground="{DynamicResource SecondaryColor}"
                           Opacity="0.5"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>