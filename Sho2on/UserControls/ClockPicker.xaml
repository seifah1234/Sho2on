<UserControl x:Class="HR_Application.UserControls.ClockPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="clockPicker">
    <Grid Width="250">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <ComboBox Name="A_P" Grid.Column="0" Foreground="Black" Background="#ffffff" BorderThickness="0" FlowDirection="RightToLeft">
                <ComboBoxItem Content="{DynamicResource AM}" HorizontalAlignment="Center"/>
                <ComboBoxItem Content="{DynamicResource Evening}" HorizontalAlignment="Center" />
            </ComboBox>

        <ComboBox Name="clock" Margin="10 0 10 0" Grid.Column="1" Foreground="Black" Background="#ffffff" BorderThickness="0" FlowDirection="RightToLeft">
            <ComboBoxItem Content="01:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="01:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="02:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="02:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="03:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="03:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="04:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="04:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="05:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="05:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="06:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="06:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="07:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="07:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="08:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="08:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="09:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="09:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="10:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="10:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="11:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="11:30" HorizontalAlignment="Center" />
            <ComboBoxItem Content="12:00" HorizontalAlignment="Center" />
            <ComboBoxItem Content="12:30" HorizontalAlignment="Center" />
        </ComboBox>

        <TextBlock Grid.Column="2" Text="{Binding ElementName=clockPicker, Path=Label}" FontSize="14" FontWeight="SemiBold" Foreground="#ffffff"/>
    </Grid>
</UserControl>
