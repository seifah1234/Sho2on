<Window x:Class="HR_Application.EmployeeSalaryData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="650" Width="1300" MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="Transparent"
        Title="{DynamicResource EmployeeData}">

    <Window.Resources>
        <!-- تدرج للقسم العلوي -->
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideInputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ThirdColorBrushBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#1976D2" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط لصفوف DataGrid -->
        <Style x:Key="EmployeeRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource MainBackgroundBrush}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            
            

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource EmployeeData}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="14" 
                       FontWeight="Bold" 
                         Foreground="{DynamicResource TextPrimaryColor}"
                       Grid.ColumnSpan="2"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- القسم العلوي المحسن -->
                <Border Grid.Column="0" CornerRadius="0 0 20 20" Background="{DynamicResource PrimaryColor}"  >
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
                                <!-- الفلاتر الرئيسية -->
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                                <TextBox Width="100" Name="code_box" Tag="{DynamicResource TagCode}" FlowDirection="RightToLeft" Margin="2"/>
                                                <StackPanel FlowDirection="RightToLeft" Orientation="Vertical">
                                                    <Label Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold" Content="{DynamicResource EmployeeName}" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                                    <ComboBox Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" SelectedValuePath="Code" DisplayMemberPath="FullName" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>
                                                </StackPanel>
                                            </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBox Width="100" Name="holiday_balance_box" Tag="{DynamicResource TagLeaveBalance}" FlowDirection="RightToLeft" Margin="2"/>
                                            <TextBox Width="250" Name="cardId_box" Tag="{DynamicResource TagNationalNumber}" FlowDirection="RightToLeft" Margin="2"/>
                                            
                                        </StackPanel>

                                    </StackPanel>
                                        <!-- الأزرار -->
                                        <UniformGrid Columns="2" HorizontalAlignment="Center" Margin="5" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource ActionButtonStyle}" x:Name="data_load_btn" Click="data_load_btn_Click" Margin="2" ToolTip="{DynamicResource SearchEmployeeData}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Icon:PackIconMaterial Kind="Magnify" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                                    <TextBlock Text="{DynamicResource Research}" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{DynamicResource ActionButtonStyle}" x:Name="clear_btn" Click="clear_btn_Click" Margin="2" ToolTip="{DynamicResource ClearAllFilters}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Icon:PackIconMaterial Kind="Refresh" VerticalAlignment="Center" Margin="0 0 5 0"/>

                                                    <TextBlock Text="{DynamicResource New}" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{DynamicResource ActionButtonStyle}" x:Name="excel_btn" Click="excel_btn_Click" Margin="2" ToolTip="{DynamicResource ExportDataToExcel}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Icon:PackIconMaterial Kind="FileExcel" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                                    <TextBlock Text="Excel" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- DatePickers للتعيين -->
                                    <StackPanel Orientation="Horizontal">
                                        <GroupBox BorderBrush="{DynamicResource ThirdColorBrush}" Foreground="{DynamicResource ThirdColorBrushBrush}" Header="{DynamicResource Appointment}" Margin="5" Padding="5">

                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" >
                                                <StackPanel>
                                                    <Label Content="{DynamicResource From}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <DatePicker Width="120"  Name="from_picker" Margin="2"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <Label Content="{DynamicResource To2}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <DatePicker Width="120" Name="to_picker" Margin="2"/>

                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                        <!-- DatePickers للانتهاء -->
                                        <GroupBox BorderBrush="{DynamicResource ThirdColorBrush}" Foreground="{DynamicResource ThirdColorBrushBrush}" Header="{DynamicResource AnEnd}" Margin="5" Padding="5">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" >
                                                <StackPanel>
                                                    <Label Content="{DynamicResource From}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <DatePicker Width="120" Name="end_from_picker" Margin="2"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <Label Content="{DynamicResource To2}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <DatePicker Width="120" Name="end_to_picker" Margin="2"/>

                                                </StackPanel>
                                            </StackPanel>

                                        </GroupBox>

                                        <!-- ComboBoxes والفلاتر الأخرى -->
                                    </StackPanel>
                                        <StackPanel VerticalAlignment="Top" Orientation="Vertical" Margin="10">
                                        <UniformGrid Columns="3" HorizontalAlignment="Left">
                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource Branch}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <ComboBox x:Name="branchComboBox" Width="150"/>
                                                </StackPanel>
                                                
                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource Job}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                <ComboBox x:Name="jobComboBox" Width="150"/>
                                                </StackPanel>

                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource OnDuty}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <ComboBox x:Name="inDutyComboBox" Width="150"/>
                                                </StackPanel>
                                                
                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource Insured}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <ComboBox x:Name="insuredComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="150"/>
                                                </StackPanel>

                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource Management3}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" x:Name="deptComboBox" Width="150"/>
                                                </StackPanel>

                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource Accommodation}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" x:Name="recidenceComboBox" Width="150"/>
                                                </StackPanel>

                                                <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource MaritalStatus}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" x:Name="maritalComboBox" Width="150"/>
                                                </StackPanel>


                                            <StackPanel Margin="5">
                                                <Label Content="{DynamicResource Qualification}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" x:Name="eduComboBox" Width="150"/>
                                            </StackPanel>

                                            <StackPanel Margin="5">
                                                    <Label Content="{DynamicResource DateOfBirth}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                                    <DatePicker Name="birth_picker" Width="150"/>
                                                </StackPanel>

                                                <StackPanel Margin="5">
                                                    <TextBox Tag="{DynamicResource TagWhatsAppNumber}" x:Name="whatsAppNoBox" Width="150"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>

                                  
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- DataGrid المحسن -->
                <Border Grid.Column="1" Margin="20" BorderBrush="{DynamicResource AccentColor}" BorderThickness="2" Opacity="0.95" CornerRadius="10"  >
                    <DataGrid x:Name="list"
              AutoGenerateColumns="False"
              Margin="10"
              HorizontalScrollBarVisibility="Visible"
              SelectionChanged="list_SelectionChanged"
              MouseDoubleClick="list_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource M}" Width="40" Binding="{Binding RowNumber}"/>
                            <DataGridTextColumn Header="{DynamicResource Code}" Width="60" Binding="{Binding Code}"/>
                            <DataGridTextColumn Header="{DynamicResource TheName}" Width="200" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="{DynamicResource Job}" Width="150" Binding="{Binding Job}"/>
                            <DataGridTextColumn Header="{DynamicResource Branch}" Width="120" Binding="{Binding Br}"/>
                            <DataGridTextColumn Header="{DynamicResource Management}" Width="150" Binding="{Binding Department}"/>
                            <DataGridTextColumn Header="{DynamicResource NationalNumber}" Width="120" Binding="{Binding CardNo}"/>
                            <DataGridTextColumn Header="{DynamicResource Type}" Width="60" Binding="{Binding Gender}"/>
                            <DataGridTextColumn Header="{DynamicResource DateOfBirth}" Width="100" Binding="{Binding BirthD, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource TheAge}" Width="60" Binding="{Binding Age}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource AppointmentDate}" Width="100" Binding="{Binding DateT, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource EndDateOfEmployment}" Width="100" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource TheAddress}" Width="200" Binding="{Binding Address}"/>
                            <DataGridTextColumn Header="{DynamicResource Salary2}" Width="100" Binding="{Binding Salary, StringFormat={}{0:N0}}" Visibility="Visible">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource LeaveBalance2}" Width="100" Binding="{Binding HolidayBalance}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Insured}" Width="80" Binding="{Binding Insured}"/>
                            <DataGridTextColumn Header="{DynamicResource Phone}" Width="120" Binding="{Binding Phone}"/>
                            <DataGridTextColumn Header="{DynamicResource EMail}" Width="180" Binding="{Binding Email}"/>
                            <DataGridTextColumn Header="{DynamicResource InsuranceNumber}" Width="120" Binding="{Binding SSN}"/>
                            <DataGridTextColumn Header="{DynamicResource HealthInsurance}" Width="120" Binding="{Binding HealthInsurance}"/>
                            <DataGridTextColumn Header="{DynamicResource OnDuty}" Width="80" Binding="{Binding InDuty}"/>
                            <DataGridTextColumn Header="{DynamicResource UnderTraining}" Width="90" Binding="{Binding UnderTraining}"/>
                            <DataGridTextColumn Header="{DynamicResource UnderEmployment}" Width="90" Binding="{Binding UnderEmployment}"/>
                            <DataGridTextColumn Header="{DynamicResource BlackList}" Width="90" Binding="{Binding Blacklist}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>


            </Grid>
            
            <!-- Footer مع العدد الإجمالي -->
            <Border Grid.Row="3" Background="{DynamicResource PrimaryColor}" CornerRadius="0,0,15,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" 
                               Text="{DynamicResource InformationDoubleClickOnTheRowToOpenTheEmployeeDataForEditing}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0"/>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="العدد الإجمالي: " VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalCount" Text="0"  FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>