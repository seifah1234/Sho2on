<Window x:Class="HR_Application.Views.BenefitsDeductions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:design="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HR_Application.Views"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Title="BenefitsDeductions" Height="650" Width="1050" MinHeight="650" MinWidth="1050"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم العلوي -->
        <LinearGradientBrush x:Key="TopSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ThirdColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource SecondaryColor}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="160"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="استحقاقات واستقطاعات" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Grid.Row="1" CornerRadius="0 0 20 20" Background="{StaticResource PrimaryColor}"  >
                <Grid>
                    <Image Visibility="Collapsed" Name="GIFTop" Source="pack://application:,,,/assets/images/Top.gif" Stretch="UniformToFill" Opacity="0.3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <!-- الفلاتر -->
                        <StackPanel FlowDirection="LeftToRight" Orientation="Vertical" HorizontalAlignment="Center" Margin="10 20">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="5">
                                        <DatePicker Width="120" Language="en-GB" Name="from_picker" FlowDirection="RightToLeft"/>
                                        <Label Content="من :" FlowDirection="RightToLeft" Foreground="#FFFFFF" Margin="10 0 0 0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="5">
                                        <DatePicker Width="120" Language="en-GB" Name="to_picker" FlowDirection="RightToLeft"/>
                                        <Label Content="الى :" FlowDirection="RightToLeft" Foreground="#FFFFFF" Margin="10 0 0 0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="5 0 0 5">
                                            <TextBox Visibility="Collapsed" Name="job_box" Margin="5"/>
                                            <TextBox  Width="230" Name="name_box" Tag="اسم الموظف" FlowDirection="RightToLeft" Margin="5"/>
                                            <TextBox Name="code_box" Tag="كود الموظف" FlowDirection="RightToLeft" Margin="5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel FlowDirection="RightToLeft" VerticalAlignment="Center" Orientation="Horizontal" Margin="0 0 10 0">
                                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Label Content="الفرع" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" FlowDirection="LeftToRight" Name="branch_box" Margin="5 0 0 0"/>
                                        </StackPanel>
                                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Label Content="السنة" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <ComboBox FlowDirection="LeftToRight" Name="year_box" Margin="5 0 0 0"/>
                                        </StackPanel>
                                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Label Content="الشهر" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <ComboBox FlowDirection="LeftToRight" Name="month_box" Margin="5 0 0 0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- الأزرار الرئيسية -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionButtonStyle}" IsDefault="True" x:Name="data_load_btn" Click="data_load_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Eye" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="عرض البيانات" VerticalAlignment="Center" Foreground="{StaticResource PrimaryColor}"/>
                                </StackPanel>
                            </Button>
                            <Button Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" x:Name="save_btn" Click="save_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" Background="#D32F2F" x:Name="delete_btn" Click="delete_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource PrimaryColor}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- الأزرار الإضافية -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionButtonStyle}" x:Name="add_btn" Click="add_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="إضافة" VerticalAlignment="Center" Foreground="{StaticResource PrimaryColor}"/>
                                </StackPanel>
                            </Button>
                            <Button Visibility="Collapsed" Margin="5" VerticalAlignment="Center" Cursor="Hand" x:Name="excel_btn" Height="45" Width="70" Background="Transparent" BorderThickness="0" Click="excel_btn_Click">
                                <Image x:Name="GIFImage" Source="pack://application:,,,/assets/images/excel.gif" Stretch="Fill"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- الـ add_print_grid المحسن -->
            <Grid x:Name="add_print_grid" Grid.Row="2" Visibility="Collapsed">
                <Border Background="#FFFFFF" Opacity="0.95" CornerRadius="10"   Margin="20">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <design:TimePicker Name="time_picker" VerticalAlignment="Center" Margin="5" Background="Black" Foreground="Black" BorderBrush="Black" BorderThickness="1" Padding="2" FontSize="12"/>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="5">
                                <DatePicker Style="{StaticResource DatePickerStyle}" VerticalAlignment="Center" Language="en-GB" Name="add_date_picker" FlowDirection="RightToLeft"/>
                                <Label Content="التاريخ :" FlowDirection="RightToLeft" Foreground="#424242" Margin="10 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton Style="{StaticResource RadioButtonStyle}" Content="انصراف" Name="dep_radio"/>
                            <RadioButton Style="{StaticResource RadioButtonStyle}" IsChecked="True" Content="حضور" Name="att_radio"/>
                        </StackPanel>
                        <Button Style="{StaticResource ActionButtonStyle}" x:Name="add_print_btn" Click="add_btn_Click" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="إضافة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="2"  Opacity="0.95"   Margin="20">
                <DataGrid SelectionUnit="FullRow" Visibility="Visible" FlowDirection="RightToLeft" AutoGenerateColumns="False" Name="list" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" CanUserResize="False" Width="0.5*" Header="م" Binding="{Binding RowNumber}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" CanUserResize="False" Width="*" Header="التاريخ" Binding="{Binding Date}"/>
                        <DataGridTextColumn CanUserSort="False" Header="الاجراء" Width="*" CanUserResize="False" IsReadOnly="True" Binding="{Binding Type}"/>
                        <DataGridTextColumn CanUserSort="False" Header="النوع" Width="*" CanUserResize="False" IsReadOnly="True" Binding="{Binding Operation}"/>
                        <DataGridTextColumn CanUserSort="False" Header="القيمة" Width="*" CanUserResize="False" IsReadOnly="True" Binding="{Binding Value}"/>
                        <DataGridTextColumn CanUserSort="False" Header="ملاحظات" Width="2*" CanUserResize="False" IsReadOnly="True" Binding="{Binding Text}"/>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="35" Height="25" Padding="0" CommandParameter="{Binding}" Content="X" Background="#D32F2F" Foreground="White" Margin="5" Click="delete_btn_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>