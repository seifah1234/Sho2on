<Window x:Class="HR_Application.Views.FriendshipBoxStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="كشف حساب صندوق الزمالة" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1976D2"/>
        </Style>

        <Style x:Key="SummaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="{StaticResource MainBackgroundBrush}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- العنوان -->
            <Border Grid.Row="0" Background="#1976D2" CornerRadius="10,10,0,0" Padding="15">
                <TextBlock Text="كشف حساب صندوق الزمالة المشترك" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- الفلاتر -->
            <Border Grid.Row="1" Background="#F5F5F5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="من تاريخ:" VerticalAlignment="Center" Margin="5"/>
                        <DatePicker x:Name="dpFromDate" Width="120" Height="40" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="إلى تاريخ:" VerticalAlignment="Center" Margin="5"/>
                        <DatePicker x:Name="dpToDate" Width="120" Height="40" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="نوع الحركة:" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="cmbTransactionType" Width="120" Height="30" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="الكل"/>
                            <ComboBoxItem Content="إيداع"/>
                            <ComboBoxItem Content="سحب"/>
                            <ComboBoxItem Content="سداد"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="الفرع:" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="cmbBranch" Width="150" Height="30" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="btnGenerate" Content="عرض التقرير" Width="120" Height="30" Margin="5" 
                                Background="#4CAF50" Foreground="White" FontWeight="Bold"
                                Click="BtnGenerate_Click"/>
                        <Button Visibility="Collapsed" x:Name="btnPrint" Content="طباعة" Width="100" Height="30" Margin="5"
                                Background="#2196F3" Foreground="White" FontWeight="Bold"
                                Click="BtnPrint_Click"/>
                        <Button x:Name="btnExport" Content="تصدير Excel" Width="120" Height="30" Margin="5"
                                Background="#9C27B0" Foreground="White" FontWeight="Bold"
                                Click="BtnExport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ملخص التقرير -->
            <Border Grid.Row="2" Background="White" Margin="10,5,10,5" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- إحصائيات سريعة -->
                    <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="5,5,0,0" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="5">
                                <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtOpeningBalance" Style="{StaticResource SummaryTextStyle}" Foreground="Green"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="إجمالي الإيداعات" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTotalDeposits" Style="{StaticResource SummaryTextStyle}" Foreground="Blue"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="5">
                                <TextBlock Text="إجمالي السحوبات" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTotalWithdrawals" Style="{StaticResource SummaryTextStyle}" Foreground="Red"/>
                            </StackPanel>

                            <StackPanel Visibility="Collapsed" Grid.Column="3" Margin="5">
                                <TextBlock Text="إجمالي السداد" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTotalRepayments" Style="{StaticResource SummaryTextStyle}" Foreground="DarkGreen"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="5">
                                <TextBlock Text="الرصيد الختامي" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtClosingBalance" Style="{StaticResource SummaryTextStyle}" Foreground="DarkBlue"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="5">
                                <TextBlock Text="عدد الحركات" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTransactionCount" Style="{StaticResource SummaryTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- تبويبات التفاصيل -->
                    <TabControl Grid.Row="1" Margin="5">
                        <TabItem Header="الحركات التفصيلية">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" x:Name="dgTransactions" AutoGenerateColumns="False" 
                                          IsReadOnly="True" AlternatingRowBackground="#F5F5F5"
                                          SelectionMode="Single" Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                                        <DataGridTextColumn Header="النوع" Binding="{Binding TransactionType}" Width="80">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Foreground">
                                                        <Setter.Value>
                                                            <Binding Path="TransactionType">
                                                                <Binding.Converter>
                                                                    <local:TransactionTypeColorConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="الموظف" Binding="{Binding User.FullName}" Width="150"/>
                                        <DataGridTextColumn Header="الكود" Binding="{Binding User.Code}" Width="80"/>
                                        <DataGridTextColumn Header="الفرع" Binding="{Binding User.Branch.Name}" Width="100"/>
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="الرصيد قبل" Binding="{Binding BalanceBefore, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="الرصيد بعد" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="200"/>
                                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- إجماليات الجزء السفلي -->
                                <Border Grid.Row="1" Background="#E8F5E8" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="إجمالي الإيداعات:" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="txtDepositsTotal" FontWeight="Bold" Foreground="Blue" Margin="5"/>

                                        <TextBlock Grid.Column="2" Text="إجمالي السحوبات:" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="3" x:Name="txtWithdrawalsTotal" FontWeight="Bold" Foreground="Red" Margin="5"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="إحصائيات حسب الفرع">
                            <DataGrid x:Name="dgBranchStatistics" AutoGenerateColumns="False" 
                                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="150"/>
                                    <DataGridTextColumn Header="عدد الموظفين" Binding="{Binding EmployeeCount}" Width="100"/>
                                    <DataGridTextColumn Header="الإيداعات" Binding="{Binding TotalDeposits, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="السحوبات" Binding="{Binding TotalWithdrawals, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="صافي المساهمة" Binding="{Binding NetContribution, StringFormat=N2}" Width="120"/>
                                    <DataGridTextColumn Header="نسبة المساهمة" Binding="{Binding ContributionPercentage, StringFormat=N1}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="إحصائيات حسب الشهر">
                            <DataGrid x:Name="dgMonthlyStatistics" AutoGenerateColumns="False" 
                                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الشهر" Binding="{Binding Month}" Width="150"/>
                                    <DataGridTextColumn Header="الإيداعات" Binding="{Binding Deposits, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="السحوبات" Binding="{Binding Withdrawals, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="السداد" Binding="{Binding Repayments, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="كشف حساب الموظفين">
                            <DataGrid x:Name="dgEmployeeStatement" AutoGenerateColumns="False" 
                                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="الفرع" Binding="{Binding Branch}" Width="100"/>
                                    <DataGridTextColumn Header="الإيداعات" Binding="{Binding TotalDeposits, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="السحوبات" Binding="{Binding TotalWithdrawals, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="صافي المساهمة" Binding="{Binding NetContribution, StringFormat=N2}" Width="120"/>
                                    <DataGridTextColumn Header="السلف الحالية" Binding="{Binding CurrentLoans, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- الأزرار السفلية -->
            <Border Grid.Row="3" Background="#F5F5F5" CornerRadius="0,0,10,10" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnClose" Content="إغلاق" Width="100" Height="35" 
                            Background="#F44336" Foreground="White" FontWeight="Bold"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>