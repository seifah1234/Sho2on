<Window x:Class="HR_Application.Views.FriendshipBoxStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="{DynamicResource FellowshipFundAccountStatement}" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1976D2"/>
        </Style>

        <Style x:Key="SummaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource WindowRootBackground}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- العنوان -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="15">
                <TextBlock Text="{DynamicResource JointFellowshipFundAccountStatement}" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- الفلاتر -->
            <Border Grid.Row="1" Background="{DynamicResource MainBackground}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="{DynamicResource FromDate2}" VerticalAlignment="Center" Margin="5"/>
                        <DatePicker x:Name="dpFromDate" Width="120" Height="40" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="{DynamicResource ToDate2}" VerticalAlignment="Center" Margin="5"/>
                        <DatePicker x:Name="dpToDate" Width="120" Height="40" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="{DynamicResource MovementType}" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="cmbTransactionType" Width="120" Height="30" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource Everyone}"/>
                            <ComboBoxItem Content="{DynamicResource Deposit}"/>
                            <ComboBoxItem Content="{DynamicResource ToWithdraw}"/>
                            <ComboBoxItem Content="{DynamicResource Pay}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="{DynamicResource Branch3}" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="cmbBranch" Width="150" Height="30" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="btnGenerate" Content="{DynamicResource ViewReport}" Width="120" Height="30" Margin="5" 
                                Background="#4CAF50" Foreground="White" FontWeight="Bold"
                                Click="BtnGenerate_Click"/>
                        <Button Visibility="Collapsed" x:Name="btnPrint" Content="{DynamicResource Print}" Width="100" Height="30" Margin="5"
                                Background="#2196F3" Foreground="White" FontWeight="Bold"
                                Click="BtnPrint_Click"/>
                        <Button x:Name="btnExport" Content="{DynamicResource ExcelExport}" Width="120" Height="30" Margin="5"
                                Background="#9C27B0" Foreground="White" FontWeight="Bold"
                                Click="BtnExport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ملخص التقرير -->
            <Border Grid.Row="2" Background="White" Margin="10,5,10,5" CornerRadius="5">
                <Grid Background="{DynamicResource PrimaryColor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- إحصائيات سريعة -->
                    <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" CornerRadius="5,5,0,0" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="5">
                                <TextBlock Text="{DynamicResource OpeningBalance}" Style="{DynamicResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtOpeningBalance" Style="{DynamicResource SummaryTextStyle}" Foreground="Green"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="{DynamicResource TotalDeposits}" Style="{DynamicResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTotalDeposits" Style="{DynamicResource SummaryTextStyle}" Foreground="Blue"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="5">
                                <TextBlock Text="{DynamicResource TotalWithdrawals2}" Style="{DynamicResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTotalWithdrawals" Style="{DynamicResource SummaryTextStyle}" Foreground="Red"/>
                            </StackPanel>

                            <StackPanel Visibility="Collapsed" Grid.Column="3" Margin="5">
                                <TextBlock Text="{DynamicResource TotalPayment}" Style="{DynamicResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTotalRepayments" Style="{DynamicResource SummaryTextStyle}" Foreground="DarkGreen"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="5">
                                <TextBlock Text="{DynamicResource ClosingBalance}" Style="{DynamicResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtClosingBalance" Style="{DynamicResource SummaryTextStyle}" Foreground="DarkBlue"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="5">
                                <TextBlock Text="{DynamicResource NumberOfMovements2}" Style="{DynamicResource HeaderTextStyle}"/>
                                <TextBlock x:Name="txtTransactionCount" Style="{DynamicResource SummaryTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- تبويبات التفاصيل -->
                    <TabControl Grid.Row="1" Margin="5" Background="{DynamicResource InputBackground}">
                        <TabItem >

                            <TabItem.Header>
                                <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                                    <Label Content="{DynamicResource DetailedMovements}" Foreground="{DynamicResource PrimaryColor}"/>

                                </Border>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" x:Name="dgTransactions" AutoGenerateColumns="False" 
                                          IsReadOnly="True" AlternatingRowBackground="#F5F5F5"
                                          SelectionMode="Single" Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource TheDate}" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                                        <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding TransactionType}" Width="80">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Foreground">
                                                        <Setter.Value>
                                                            <Binding Path="TransactionType">
                                                                <Binding.Converter>
                                                                    <local:TransactionTypeColorConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{DynamicResource Employee}" Binding="{Binding User.FullName}" Width="150"/>
                                        <DataGridTextColumn Header="{DynamicResource Code}" Binding="{Binding User.Code}" Width="80"/>
                                        <DataGridTextColumn Header="{DynamicResource Branch}" Binding="{Binding User.Branch.Name}" Width="100"/>
                                        <DataGridTextColumn Header="{DynamicResource Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="{DynamicResource BalanceBefore}" Binding="{Binding BalanceBefore, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="{DynamicResource BalanceAfter}" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding Description}" Width="200"/>
                                        <DataGridTextColumn Header="{DynamicResource Comments}" Binding="{Binding Notes}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- إجماليات الجزء السفلي -->
                                <Border Grid.Row="1"  Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{DynamicResource TotalDeposits2}" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="1" x:Name="txtDepositsTotal" FontWeight="Bold" Foreground="Blue" Margin="5"/>

                                        <TextBlock Grid.Column="2" Text="{DynamicResource TotalWithdrawals3}" FontWeight="Bold" Margin="5"/>
                                        <TextBlock Grid.Column="3" x:Name="txtWithdrawalsTotal" FontWeight="Bold" Foreground="Red" Margin="5"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem >
                            <TabItem.Header>
                                <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                                    <Label Content="{DynamicResource StatisticsByBranch}" Foreground="{DynamicResource PrimaryColor}"/>

                                </Border>
                            </TabItem.Header>
                            <DataGrid x:Name="dgBranchStatistics" AutoGenerateColumns="False" 
                                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Branch}" Binding="{Binding BranchName}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource NumberOfEmployees}" Binding="{Binding EmployeeCount}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Deposits}" Binding="{Binding TotalDeposits, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Withdrawals}" Binding="{Binding TotalWithdrawals, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource NetContribution}" Binding="{Binding NetContribution, StringFormat=N2}" Width="120"/>
                                    <DataGridTextColumn Header="{DynamicResource ContributionPercentage}" Binding="{Binding ContributionPercentage, StringFormat=N1}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem >
                            <TabItem.Header>
                                <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                                    <Label Content="{DynamicResource StatisticsByMonth}" Foreground="{DynamicResource PrimaryColor}"/>

                                </Border>
                            </TabItem.Header>
                            <DataGrid x:Name="dgMonthlyStatistics" AutoGenerateColumns="False" 
                                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Month}" Binding="{Binding Month}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Deposits}" Binding="{Binding Deposits, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Withdrawals}" Binding="{Binding Withdrawals, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Payment}" Binding="{Binding Repayments, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Net}" Binding="{Binding NetAmount, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Balance}" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem>

                            <TabItem.Header>
                                <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                                    <Label Content="{DynamicResource EmployeeAccountStatement}" Foreground="{DynamicResource PrimaryColor}"/>

                                </Border>
                            </TabItem.Header>
                            <DataGrid x:Name="dgEmployeeStatement" AutoGenerateColumns="False" 
                                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Code}" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource TheName}" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Branch}" Binding="{Binding Branch}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Deposits}" Binding="{Binding TotalDeposits, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Withdrawals}" Binding="{Binding TotalWithdrawals, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource NetContribution}" Binding="{Binding NetContribution, StringFormat=N2}" Width="120"/>
                                    <DataGridTextColumn Header="{DynamicResource CurrentAdvances}" Binding="{Binding CurrentLoans, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource TheCondition}" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- الأزرار السفلية -->
            <Border Grid.Row="3" Background="{DynamicResource MainBackground}" CornerRadius="0,0,10,10" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnClose" Content="{DynamicResource Closing}" Width="100" Height="35" 
                            Background="#F44336" Foreground="White" FontWeight="Bold"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>