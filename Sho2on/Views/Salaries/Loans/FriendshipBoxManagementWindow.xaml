<Window x:Class="HR_Application.Views.FriendshipBoxManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ManagingTheJointFellowshipFund}" 
        FlowDirection="RightToLeft"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowRootBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0" Padding="15">
            <TextBlock Text="{DynamicResource ManagingTheJointFellowshipFund}" 
                       Foreground="White" 
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- محتوى النافذة -->
        <TabControl Grid.Row="1" Margin="10" Background="{DynamicResource InputBackground}">
            <!-- تبويب معلومات الصندوق -->
            <TabItem>

                <TabItem.Header>
                    <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                        <Label Content="{DynamicResource FundInformation}" Foreground="{DynamicResource PrimaryColor}"/>

                    </Border>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- إحصائيات الصندوق -->
                    <GroupBox Grid.Row="0" Header="{DynamicResource FundStatistics}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="10">
                                <TextBlock Text="{DynamicResource CurrentBalance}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtCurrentBalance" FontSize="16" Foreground="Green" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock Text="{DynamicResource TotalDeposits2}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalDeposits" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10">
                                <TextBlock Text="{DynamicResource TotalAdvances2}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalLoans" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="10">
                                <TextBlock Text="{DynamicResource TotalPayment2}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalRepayments" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- إحصائيات شهرية -->
                    <GroupBox Grid.Row="1" Header="{DynamicResource StatisticsForTheCurrentMonth}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="10">
                                <TextBlock Text="{DynamicResource MonthlyDeposits}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtMonthlyDeposits" Foreground="Blue" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock Text="{DynamicResource MonthlyAdvances}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtMonthlyLoans" Foreground="Red" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10">
                                <TextBlock Text="{DynamicResource NetMonth}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtMonthlyNet" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="10">
                                <TextBlock Text="{DynamicResource NumberOfMovements3}" FontWeight="Bold"/>
                                <TextBlock x:Name="txtMonthlyTransactions" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- إعدادات الصندوق -->
                    <GroupBox Grid.Row="2" Header="{DynamicResource BoxSettings}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource SalaryDeductionPercentage}" 
                                       VerticalAlignment="Center" Margin="10"/>

                            <TextBox Grid.Column="1" x:Name="txtDeductionPercentage" 
                                     Width="100" Height="30" VerticalAlignment="Center"
                                     Text="2.0"/>

                            <Button Grid.Column="2" x:Name="btnUpdatePercentage" 
                                    Content="{DynamicResource UpdateTheRatio}" Width="120" Height="30"
                                    Background="{DynamicResource ButtonHoverBackground}"
                                    Click="BtnUpdatePercentage_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- إجراءات الصندوق -->
                    <GroupBox Grid.Row="3" Header="{DynamicResource FastActions}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                            <Button x:Name="btnRefresh" Content="{DynamicResource DataUpdate}" 
                                    Background="#2196F3" Foreground="White"
                                    Click="BtnRefresh_Click"/>

                            <Button x:Name="btnAddManualDeposit" Content="{DynamicResource AddAManualDeposit}" 
                                    Background="#4CAF50" Foreground="White"
                                    Click="BtnAddManualDeposit_Click"/>

                            <Button x:Name="btnAddManualWithdrawal" Content="{DynamicResource AddManualWithdrawal}" 
                                    Background="#FF9800" Foreground="White"
                                    Click="BtnAddManualWithdrawal_Click"/>

                            <Button x:Name="btnViewAllTransactions" Content="{DynamicResource ViewAllMovements}" 
                                    Background="#9C27B0" Foreground="White"
                                    Click="BtnViewAllTransactions_Click"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- تبويب حركات الصندوق -->
            <TabItem>

                <TabItem.Header>
                    <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                        <Label Content="{DynamicResource FundMovements}" Foreground="{DynamicResource PrimaryColor}"/>

                    </Border>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="241*"/>
                        <ColumnDefinition Width="634*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- فلاتر الحركات -->
                    <Border Grid.Row="0"  Padding="10" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="dpFromDate" Width="120" Margin="5"/>
                            <DatePicker x:Name="dpToDate" Width="120" Margin="5"/>
                            <ComboBox x:Name="cmbTransactionType" Width="120" Margin="5">
                                <ComboBoxItem Content="{DynamicResource Everyone}"/>
                                <ComboBoxItem Content="{DynamicResource Deposit}"/>
                                <ComboBoxItem Content="{DynamicResource ToWithdraw}"/>
                                <ComboBoxItem Content="{DynamicResource Pay}"/>
                            </ComboBox>
                            <Button Content="{DynamicResource Filtering}" Background="{DynamicResource ButtonHoverBackground}" Width="80" Margin="5" Click="BtnFilterTransactions_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- جدول الحركات -->
                    <DataGrid Grid.Row="1" x:Name="dgTransactions" AutoGenerateColumns="False" Margin="5,5,5,5" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource TheDate}" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding TransactionType}" Width="80"/>
                            <DataGridTextColumn Header="{DynamicResource Employee}" Binding="{Binding User.FullName}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource BalanceBefore}" Binding="{Binding BalanceBefore, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource BalanceAfter}" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="{DynamicResource Comments}" Binding="{Binding Notes}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- تبويب تقارير الصندوق -->
            <TabItem>

                <TabItem.Header>
                    <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                        <Label Content="{DynamicResource Reports2}" Foreground="{DynamicResource PrimaryColor}"/>

                    </Border>
                </TabItem.Header>
                <StackPanel Margin="20">
                    <Button Background="{DynamicResource ButtonHoverBackground}" x:Name="btnGenerateMonthlyReport" Content="{DynamicResource MonthlyReport}" 
                            Height="40" Margin="0,10" Click="BtnGenerateMonthlyReport_Click"/>

                    <Button Background="{DynamicResource ButtonHoverBackground}" x:Name="btnGenerateYearlyReport" Content="{DynamicResource AnnualReport}" 
                            Height="40" Margin="0,10" Click="BtnGenerateYearlyReport_Click"/>

                    <Button Background="{DynamicResource ButtonHoverBackground}" x:Name="btnExportToExcel" Content="{DynamicResource ExportToExcel}" 
                            Height="40" Margin="0,10" Click="BtnExportToExcel_Click"/>

                    <Button Background="{DynamicResource ButtonHoverBackground}" x:Name="btnPrintBalanceSheet" Content="{DynamicResource PrintBalanceStatement}"  
                            Height="40" Margin="0,10" Click="BtnPrintBalanceSheet_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- الأزرار السفلية -->
        <Border Grid.Row="2" Background="{DynamicResource MainBackground}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Background="{DynamicResource ButtonHoverBackground}" x:Name="btnClose" Content="{DynamicResource Closing}" Width="100" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>