<Window x:Class="HR_Application.Views.LoanRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طلب سلفة" 
        Height="600" Width="800"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0" Background="#1976D2" Padding="15">
            <TextBlock Text="طلب سلفة من صندوق الزمالة" 
                       Foreground="White" 
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- محتوى النموذج -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- معلومات الموظف -->
                <GroupBox Grid.Row="0" Header="معلومات الموظف" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="الكود:" Margin="5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCode" Width="150" Height="30" Margin="5"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="بحث" Width="80" Height="30" Margin="5" Click="BtnSearch_Click"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="الاسم:" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtName" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="0" Grid.Column="3" Content="الراتب الأساسي:" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="txtBasicSalary" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="3" Content="رصيد صندوق الزمالة:" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" x:Name="txtFriendshipBoxAmount" VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- اختيار المدير -->
                <GroupBox Grid.Row="1" Header="اختيار المدير للموافقة" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="اختر مدير للموافقة:" Margin="5" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="cmbManagers" Width="200" Height="30" Margin="5" 
                                  DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                    </Grid>
                </GroupBox>

                <!-- معلومات السلفة -->
                <GroupBox Grid.Row="2" Header="معلومات السلفة" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="مبلغ السلفة:" Margin="5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLoanAmount" Width="150" Height="30" Margin="5" TextChanged="TxtLoanAmount_TextChanged"/>

                        <Label Grid.Row="0" Grid.Column="2" Content="الحد الأقصى المسموح:" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtMaxAllowed" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="عدد الأشهر:" Margin="5"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectionChanged="cmbInstallmentMonths_SelectionChanged" x:Name="cmbInstallmentMonths" Width="150" Height="30" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="1 شهر"/>
                            <ComboBoxItem Content="2 شهر"/>
                            <ComboBoxItem Content="3 شهر"/>
                            <ComboBoxItem Content="4 شهر"/>
                            <ComboBoxItem Content="5 شهر"/>
                            <ComboBoxItem Content="6 شهر"/>
                        </ComboBox>

                        <Label Grid.Row="1" Grid.Column="2" Content="القسط الشهري:" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtMonthlyInstallment" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="سبب السلفة:" Margin="5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtReason" 
                               Width="300"  Height="60" Margin="5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </GroupBox>

                <!-- ملخص السلفة -->
                <GroupBox Grid.Row="3" Header="ملخص السلفة">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="تاريخ الطلب:" Margin="5"/>
                        <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpLoanDate" Width="150" Height="40" Margin="5"/>

                        <Label Grid.Row="0" Grid.Column="2" Content="تاريخ السداد المتوقع:" Margin="5"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dpExpectedPayback" Width="150" Height="40" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="السلفة المستحقة:" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtCurrentLoan" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="2" Content="حالة الموظف:" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtEmployeeStatus" VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnRequest" Content="إرسال الطلب للمدير" Width="150" Height="35" 
                        Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        Click="BtnRequest_Click"/>
                <Button x:Name="btnCancel" Content="إلغاء" Width="100" Height="35" 
                        Margin="5" Background="#F44336" Foreground="White" FontWeight="Bold"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnCalculate" Content="حساب" Width="100" Height="35" 
                        Margin="5" Background="#2196F3" Foreground="White" FontWeight="Bold"
                        Click="BtnCalculate_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>