<Window x:Class="HR_Application.Views.LoanRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoanRequest}" 
        Height="600" Width="800"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource WindowRootBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0" Padding="15">
            <TextBlock Text="{DynamicResource RequestAnAdvanceFromTheFellowshipFund}" 
                       Foreground="White" 
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- محتوى النموذج -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- معلومات الموظف -->
                <GroupBox Grid.Row="0" Header="{DynamicResource EmployeeInformation}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Code2}" Margin="5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCode" Width="250" Margin="5"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Research}" Width="80" Height="30" Margin="5" Click="BtnSearch_Click"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource TheName2}" Margin="5"/>
                        <!--<TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtName" VerticalAlignment="Center" Margin="5"/>-->
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" SelectedValuePath="Code" DisplayMemberPath="FullName" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>

                        <Label Grid.Row="0" Grid.Column="3" Content="{DynamicResource BasicSalary2}" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="txtBasicSalary" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="3" Content="{DynamicResource FellowshipFundBalance}" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" x:Name="txtFriendshipBoxAmount" VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- اختيار المدير -->
                <GroupBox Grid.Row="1" Header="{DynamicResource DirectorSSelectionForApproval}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{DynamicResource SelectAManagerToApprove}" Margin="5" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="cmbManagers" Width="200" Height="30" Margin="5" 
                                  DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                    </Grid>
                </GroupBox>

                <!-- معلومات السلفة -->
                <GroupBox Grid.Row="2" Header="{DynamicResource AdvanceInformation}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource AdvanceAmount2}" Margin="5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLoanAmount" Width="150" Height="30" Margin="5" TextChanged="TxtLoanAmount_TextChanged"/>

                        <Label Grid.Row="0" Grid.Column="2" Content="{DynamicResource MaximumAllowed}" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtMaxAllowed" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource NumberOfMonths2}" Margin="5"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectionChanged="cmbInstallmentMonths_SelectionChanged" x:Name="cmbInstallmentMonths" Width="150" Height="30" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource 1Month}"/>
                            <ComboBoxItem Content="{DynamicResource 2Months}"/>
                            <ComboBoxItem Content="{DynamicResource 3Month}"/>
                            <ComboBoxItem Content="{DynamicResource 4Month}"/>
                            <ComboBoxItem Content="{DynamicResource 5Month}"/>
                            <ComboBoxItem Content="{DynamicResource 6Month}"/>
                        </ComboBox>

                        <Label Grid.Row="1" Grid.Column="2" Content="{DynamicResource MonthlyInstallment2}" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtMonthlyInstallment" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource ReasonForAdvance}" Margin="5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtReason" 
                               Width="300"  Height="60" Margin="5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </GroupBox>

                <!-- ملخص السلفة -->
                <GroupBox Grid.Row="3" Header="{DynamicResource SummaryOfAdvance}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource OrderDate2}" Margin="5"/>
                        <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpLoanDate" Width="150" Height="40" Margin="5"/>

                        <Label Grid.Row="0" Grid.Column="2" Content="{DynamicResource ExpectedPaymentDate}" Margin="5"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dpExpectedPayback" Width="150" Height="40" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource DueAdvance}" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtCurrentLoan" VerticalAlignment="Center" Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="2" Content="{DynamicResource EmployeeStatus}" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtEmployeeStatus" VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2" Background="{DynamicResource PrimaryColor}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnRequest" Content="{DynamicResource SendTheRequestToTheManager}" Width="150" Height="35" 
                        Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        Click="BtnRequest_Click"/>
                <Button x:Name="btnCancel" Content="{DynamicResource Cancellation}" Width="100" Height="35" 
                        Margin="5" Background="#F44336" Foreground="White" FontWeight="Bold"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnCalculate" Content="{DynamicResource Account}" Width="100" Height="35" 
                        Margin="5" Background="#2196F3" Foreground="White" FontWeight="Bold"
                        Click="BtnCalculate_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>