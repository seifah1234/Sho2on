<Window x:Class="HR_Application.Views.LoanApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views"
        mc:Ignorable="d"
        Title="الموافقة على السلفات" 
        Height="650" Width="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>

       
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource WindowRootBackground}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- العنوان والفلاتر -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="الموافقة على طلبات السلفة" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="cmbStatus" Width="150" Height="30" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="جميع الحالات"/>
                            <ComboBoxItem Content="بانتظار الموافقة"/>
                            <ComboBoxItem Content="تمت الموافقة"/>
                            <ComboBoxItem Content="مرفوض"/>
                        </ComboBox>
                        <Button x:Name="btnFilter" Content="تصفية" Width="80" Height="30" Margin="5" Click="BtnFilter_Click"/>
                        <Button x:Name="btnRefresh" Content="تحديث" Width="80" Height="30" Margin="5" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- قائمة السلفات -->
            <DataGrid Grid.Row="1" x:Name="dgLoans" Margin="10"
                      SelectionChanged="DgLoans_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding User.Code}" Width="80"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding User.FullName}" Width="150"/>
                    <DataGridTextColumn Header="مبلغ السلفة" Binding="{Binding LoanAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="عدد الأشهر" Binding="{Binding InstallmentCount}" Width="80"/>
                    <DataGridTextColumn Header="القسط الشهري" Binding="{Binding MonthlyInstallment, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="تاريخ الطلب" Binding="{Binding LoanDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- تفاصيل السلفة وأزرار التحكم -->
            <Border Grid.Row="2" Background="{DynamicResource PrimaryColor}" CornerRadius="0,0,10,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- تفاصيل السلفة المحددة -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                        <TextBlock x:Name="txtSelectedLoanDetails" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>

                    <!-- أزرار التحكم -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnApprove" Content="موافقة" Width="100" Height="35" Margin="5" 
                                Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="BtnApprove_Click"/>
                        <Button x:Name="btnReject" Content="رفض" Width="100" Height="35" Margin="5"
                                Background="#F44336" Foreground="White" FontWeight="Bold" Click="BtnReject_Click"/>
                        <Button x:Name="btnViewDetails" Content="عرض التفاصيل" Width="120" Height="35" Margin="5"
                                Background="#2196F3" Foreground="White" FontWeight="Bold" Click="BtnViewDetails_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>