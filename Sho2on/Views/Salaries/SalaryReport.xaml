<Window x:Class="HR_Application.Views.SalaryReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم العلوي -->
        <LinearGradientBrush x:Key="TopSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideInputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource WindowRootBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource SalaryReport}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Grid.Row="1" CornerRadius="0 0 20 20" Background="{DynamicResource PrimaryColor}"  >
                <Grid>
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center" Margin="10">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical" FlowDirection="LeftToRight">
                            <!-- الصف الأول: الأزرار والحقول -->
                            <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="print_btn" Click="print_btn_Click" Margin="0 0 10 0">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="Printer" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="{DynamicResource Print}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="excel_btn" Click="excel_btn_Click" Margin="0 0 10 0">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="FileExcel" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="Excel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" IsDefault="True" x:Name="data_load_btn" Click="data_load_btn_Click" Margin="0 0 10 0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource DownloadData2}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Width="300" Name="name_box" Tag="{DynamicResource TagName}" FlowDirection="RightToLeft" Margin="5 0 5 0"/>
                                <TextBox Name="code_box" Tag="{DynamicResource TagCode}" FlowDirection="RightToLeft" Margin="5 0 5 0"/>
                            </StackPanel>

                            <!-- الصف الثاني: الفلاتر -->
                            <StackPanel Margin="0 5 0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                                    <Label Content="{DynamicResource Job}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox x:Name="jobComboBox" FlowDirection="RightToLeft"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                                    <Label Content="{DynamicResource Management}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox x:Name="departComboBox" FlowDirection="RightToLeft"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                                    <Label Content="{DynamicResource Branch}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox x:Name="branchComboBox" FlowDirection="RightToLeft"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                                    <Label Content="{DynamicResource Month}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox  x:Name="monthComboBox" FlowDirection="RightToLeft"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                                    <Label Content="{DynamicResource Sunnah}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox x:Name="yearComboBox" FlowDirection="RightToLeft"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="2"  Opacity="0.95"   Margin="20">
                <DataGrid  ItemsSource="{Binding employeeSalaryList}" AutoGenerateColumns="False" FlowDirection="RightToLeft" Margin="10" x:Name="list">
                    <DataGrid.Columns>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource Code}" Width="120" Binding="{Binding Code}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource TheName}" Width="120" Binding="{Binding Name}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource Branch}" Width="120" Binding="{Binding Branch}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource Job}" Width="120" Binding="{Binding Job}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource Salary}" Width="120" Binding="{Binding Salary, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource HousingAllowance2}" Width="120" IsReadOnly="True" Binding="{Binding Houseing, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource TransferAllowance}" Width="120" IsReadOnly="True" Binding="{Binding Transmission, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource ManagementAllowance}" Width="120" IsReadOnly="True" Binding="{Binding Depart, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource AllowanceForTheNatureOfWork}" Width="120" IsReadOnly="True" Binding="{Binding Nature, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Additional}" Width="120" IsReadOnly="True" Binding="{Binding Added, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Rewards}" Width="120" IsReadOnly="True" Binding="{Binding Reward, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource RealizationCommissions}" Width="120" IsReadOnly="True" Binding="{Binding TargetCommission, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource ExternalCommissions}" Width="120" IsReadOnly="True" Binding="{Binding ExternalCommission, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource TotalEntitlements}" Width="150" IsReadOnly="True" Binding="{Binding TotalEntitlements, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource Absence}" Width="120" Binding="{Binding Abcence, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource Delay}" Width="120" Binding="{Binding Late, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" Header="{DynamicResource RepeatedDelay}" Width="120" Binding="{Binding RepeatLate, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Permission}" Width="120" IsReadOnly="True" Binding="{Binding Permission, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Ancestor}" Width="120" IsReadOnly="True" Binding="{Binding Ancestor, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Inability}" Width="120" IsReadOnly="True" Binding="{Binding Deficit, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Penalty}" Width="120" IsReadOnly="True" Binding="{Binding Penalty, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource TelephoneBill}" Width="120" IsReadOnly="True" Binding="{Binding Phone, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource ZEarnAJob}" Width="120" IsReadOnly="True" Binding="{Binding Tax, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource EmployeeInsurances}" Width="120" IsReadOnly="True" Binding="{Binding Insurance, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource TCompany}" Width="120" IsReadOnly="True" Binding="{Binding CompanyInsurance, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource REmergency}" Width="120" IsReadOnly="True" Binding="{Binding Social, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource PFellowshipMSocial}" Width="120" IsReadOnly="True" Binding="{Binding Box, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource TotalDeductions}" Width="150" IsReadOnly="True" Binding="{Binding TotalDeductions, StringFormat=N2}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Total}" Width="150" IsReadOnly="True" Binding="{Binding Total, StringFormat=N2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>