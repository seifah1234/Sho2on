<Window x:Class="HR_Application.ErrandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Height="400" Width="600" MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم العلوي -->
        <LinearGradientBrush x:Key="TopSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideInputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LargeInputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource MainBackgroundBrush}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="إجراءات" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#1976D2" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Grid.Row="1" CornerRadius="0 0 20 20" Background="{StaticResource TopSectionBrush}"  >
                <Grid>
                    <Image Visibility="Collapsed" Name="GIFTop" Source="pack://application:,,,/assets/images/sidebar.jpg" Stretch="UniformToFill" Opacity="0.3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Orientation="Vertical" FlowDirection="RightToLeft">
                        <!-- RadioButtons -->
                        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                            <RadioButton Style="{StaticResource RadioButtonStyle}" IsChecked="True" x:Name="errand_check" FlowDirection="LeftToRight" Content="مأمورية"/>
                            <RadioButton Style="{StaticResource RadioButtonStyle}" Checked="permission_check_Checked" Unchecked="permission_check_Unchecked" x:Name="permission_check" FlowDirection="LeftToRight" Content="إذن"/>
                        </StackPanel>

                        <!-- TextBoxes للكود والاسم -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Center">
                            <StackPanel Margin="5" Orientation="Vertical" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                                <Label VerticalAlignment="Center" Content="الفرع" Foreground="#FFFFFF" HorizontalAlignment="Left"/>
                                <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" FlowDirection="LeftToRight" Name="branch_box" Margin="5 0 0 0"/>
                            </StackPanel>
                            <TextBox VerticalAlignment="Bottom" Tag="كود الموظف" KeyDown="CodeBox_KeyDown" Name="code_box" Margin="5" TabIndex="2"/>
                            <TextBox VerticalAlignment="Bottom" Width="300" Tag="اسم الموظف" x:Name="name_box" Margin="5" TabIndex="2"/>
                        </StackPanel>

                        <!-- DateTimePickers -->
                        <StackPanel Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="من :" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <xctk:DateTimePicker ValueChanged="from_dateTimePicker_ValueChanged" Name="from_dateTimePicker" Width="170" HorizontalContentAlignment="Center" Format="Custom" FlowDirection="LeftToRight" 
                                                 TimePickerVisibility="Visible" 
                                                 Watermark="Select date and time..." FormatString="dd/MM/yyyy HH:mm" Margin="5"/>
                            <TextBlock VerticalAlignment="Center" Margin="10 0 0 0" Text="الى :" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <xctk:DateTimePicker ValueChanged="to_dateTimePicker_ValueChanged" Name="to_dateTimePicker" Width="170" HorizontalContentAlignment="Center" Format="Custom" FlowDirection="LeftToRight" 
                                                 TimePickerVisibility="Visible" 
                                                 Watermark="Select date and time..." FormatString="dd/MM/yyyy HH:mm" Margin="5"/>
                        </StackPanel>

                        <!-- TextBoxes للبيان والقيمة -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox Width="400" Name="text_box" Tag="ملاحظات" Margin="10" TabIndex="3"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Visibility="Collapsed" Name="value_box" Tag="القيمة" Margin="10" TabIndex="3"/>
                        </StackPanel>

                        <!-- زر الإضافة -->
                        <Button Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Center" x:Name="save_btn" Click="save_month_btn_Click" Margin="20">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="إضافة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>