<Window x:Class="HR_Application.MonthlySalaryData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم العلوي -->
        <LinearGradientBrush x:Key="TopSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="350"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="WideComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="UserComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource WindowRootBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="170"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="البيانات الشهرية" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Background="{DynamicResource PrimaryColor}" FlowDirection="RightToLeft" Grid.Row="1" CornerRadius="0 0 20 20"  >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- الفلاتر اليسرى -->
                    <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="0 0 10 0">
                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Label Content="السنة" Foreground="{DynamicResource ThirdColor}" HorizontalAlignment="Center"/>
                            <ComboBox FlowDirection="LeftToRight" Name="year_box" Margin="5 0 0 0"/>
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Label Content="الشهر" Foreground="{DynamicResource ThirdColor}" HorizontalAlignment="Center"/>
                            <ComboBox FlowDirection="LeftToRight" Name="month_box" Margin="5 0 0 0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- الفلاتر الوسطى -->
                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="150" Tag="كود الموظف" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Name="code_box" Margin="5"/>
                            <StackPanel Margin="5" Orientation="Vertical" HorizontalAlignment="Center">
                                <Label VerticalAlignment="Center" Content="الفرع" Foreground="{DynamicResource ThirdColor}" />
                                <ComboBox Width="200" FlowDirection="LeftToRight" Name="branch_box" Margin="5 0 0 0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                            <ComboBox FlowDirection="RightToLeft" DisplayMemberPath="Name" SelectedValuePath="Code" Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>
                            <Label Foreground="{DynamicResource ThirdColor}" FontSize="14" FontWeight="Bold" Content="اسم الموظف" VerticalAlignment="Center" Margin="10 0 0 0"/>
                        </StackPanel>
                        <TextBox Visibility="Collapsed" Style="{DynamicResource InputFieldStyle}" Tag="اسم الموظف" FlowDirection="RightToLeft" Name="name_box" Margin="5"/>
                    </StackPanel>

                    <!-- الأزرار -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 0">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" IsDefault="True" x:Name="data_show_btn" Click="data_show_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Eye" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="عرض البيانات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="statistics_btn" Click="statistics_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ChartBar" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="الإحصائيات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="5">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="print_btn" Click="print_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Printer" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="طباعة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="excel_btn" Click="excel_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="FileExcel" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="2"  Opacity="0.95"   Margin="20">
                <DataGrid LoadingRow="AttendanceDataGrid_LoadingRow" AutoGenerateColumns="False" Name="dataGrid" Margin="10" FlowDirection="RightToLeft">
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="اليوم" Binding="{Binding Day}" Width="80"/>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="Holiday" Binding="{Binding isHoliday}" Width="80" Visibility="Hidden"/>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="Absence" Binding="{Binding isAbsence}" Width="80" Visibility="Hidden"/>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn IsReadOnly="False" Header="حضور" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding AttendanceTime, StringFormat=\{0:HH\\:mm\\:ss\}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="موقع الحضور" Binding="{Binding AttendBranch}"/>
                        <DataGridTemplateColumn IsReadOnly="False" Header="انصراف" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding DepartureTime, StringFormat=\{0:HH\\:mm\\:ss\}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="موقع الانصراف" Binding="{Binding DepartBranch}"/>
                        <DataGridTemplateColumn IsReadOnly="True" Header="الوردية" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding Shift}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Header="س العمل" Binding="{Binding WorkHours, StringFormat={}{0:hh\\:mm}}" Width="100"/>
                        <DataGridTemplateColumn IsReadOnly="True" Header="قيمة التأخير" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding LateValue}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn IsReadOnly="True" Header="قيمة الأضافي" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding OTValue}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- الصورة المتحركة للتحميل -->
            <Image x:Name="loadingProgressBar" 
                   Source="pack://application:,,,/assets/images/loading.png" 
                   Grid.Row="2"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Width="0" 
                   Height="0">
                <Image.RenderTransform>
                    <RotateTransform x:Name="rotateTransform" CenterX="25" CenterY="25"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                 Storyboard.TargetName="rotateTransform" 
                                 Storyboard.TargetProperty="Angle" 
                                 From="0" 
                                 To="350" 
                                 Duration="0:0:1"
                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
        </Grid>
    </Border>
</Window>