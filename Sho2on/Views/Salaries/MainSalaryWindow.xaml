<Window x:Class="HR_Application.Views.MainSalaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Height="700" Width="1200" MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        WindowState="Maximized"
        Title="إدارة المرتبات">

    <Window.Resources>
        <!-- الألوان والتدرجات -->
        <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f8f9fa" Offset="0"/>
            <GradientStop Color="#e9ecef" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2E86AB" Offset="0"/>
            <GradientStop Color="#4A90E2" Offset="1"/>
        </LinearGradientBrush>

        <!-- نمط جديد لحقول الإدخال -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0 0 0 2"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Tag" Value="{Binding}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90E2"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WideModernTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="250"/>
        </Style>

        <!-- نمط RadioButton -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <!-- نمط GroupBox -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#2E86AB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- نمط الأزرار -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#267199"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Width" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Width" Value="80"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e68900"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- نمط العنوان -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E86AB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource MainBackground}" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Color="Black" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- الهيدر -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" CornerRadius="15,15,0,0">
                <Grid>
                    <TextBlock Text="إدارة المرتبات" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                </Grid>
            </Border>

            <!-- المحتوى الرئيسي -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- قسم البحث -->
                    <Border Background="White" CornerRadius="10" Padding="20" Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="بحث عن الموظف" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- عناصر التحكم في التنقل -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <Button Style="{StaticResource NavigationButton}" Click="prev_btn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ChevronRight" VerticalAlignment="Center"/>
                                            <TextBlock Text="السابق" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock x:Name="currentIndexTxt" Text="0 / 0" 
                                               FontSize="14" Foreground="#2E86AB" 
                                               VerticalAlignment="Center" Margin="10,0"
                                               FontWeight="Bold"/>

                                    <Button Style="{StaticResource NavigationButton}" Click="next_btn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="التالي" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Icon:PackIconMaterial Kind="ChevronLeft" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- حقول البحث -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="كود الموظف" Foreground="#424242" Margin="0,0,0,5"/>
                                        <TextBox x:Name="code_box" Style="{StaticResource ModernTextBox}" Width="120"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="الاسم" Foreground="#424242" Margin="0,0,0,5"/>
                                        <TextBox x:Name="name_box" Style="{StaticResource WideModernTextBox}" Width="200"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="الفرع" Foreground="#424242" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="branch_box" Width="200" Height="38"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- أزرار البحث والحفظ -->
                                <StackPanel VerticalAlignment="Bottom" Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButton}" Click="data_load_btn_Click" Background="#2196F3">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Magnify" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="بحث" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                               
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- معلومات الموظف -->
                    <Border Background="White" CornerRadius="10" Padding="20" Grid.Row="1" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="employeeInfoText" Text="معلومات الموظف" Style="{StaticResource SectionHeader}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الاسم:" Foreground="#424242" Margin="0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeNameText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="الكود:" Foreground="#424242" Margin="0,5,0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center"  x:Name="employeeCodeText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="الفرع:" Foreground="#424242" Margin="0,5,0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeBranchText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="الإدارة:" Foreground="#424242" Margin="0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeDepartmentText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="الوظيفة:" Foreground="#424242" Margin="0,5,0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeJobText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="نظام العمل:" Foreground="#424242" Margin="0,5,0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeWorkTypeText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="تاريخ التعيين:" Foreground="#424242" Margin="0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeHireDateText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="الراتب الأساسي:" Foreground="#424242" Margin="0,5,0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeSalaryText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="حد السلف:" Foreground="#424242" Margin="0,5,0,5"/>
                                        <TextBlock Margin="5" VerticalAlignment="Center" x:Name="employeeLoanLimitText" Text="-" Foreground="#2c3e50" FontWeight="Bold"/>
                                    </StackPanel>

                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- نوع الراتب والمبالغ -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- نوع الراتب -->
                        <Border Background="White" CornerRadius="10" Padding="20" Grid.Column="0" Width="300" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="نوع الراتب" Style="{StaticResource SectionHeader}"/>

                                <RadioButton x:Name="fixed_box" Content="راتب ثابت" 
                                             Style="{StaticResource ModernRadioButton}" 
                                             GroupName="SalaryType" 
                                             Checked="fixed_Checked"/>

                                <RadioButton x:Name="shift" Content="قيمة الساعة يومي" 
                                             Style="{StaticResource ModernRadioButton}" 
                                             GroupName="SalaryType"
                                             Checked="shift_Checked"/>

                                <RadioButton x:Name="hour" Content="قيمة الساعة شهري" 
                                             Style="{StaticResource ModernRadioButton}" 
                                             GroupName="SalaryType"
                                             Checked="hour_Checked"/>

                                <!-- قسم الساعة اليومية -->
                                <Border x:Name="ShiftSalary" CornerRadius="5" Padding="10" 
                                        Background="#F5F5F5" Margin="0,10,0,0" 
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="تفاصيل الساعة اليومية" 
                                                   Foreground="#424242" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,5"/>

                                        <StackPanel Orientation="Vertical">
                                            <TextBox x:Name="shift_hour_box" Tag="عدد الساعات" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="120" 
                                                     TextChanged="shift_hour_box_TextChanged"
                                                     Margin="0,0,0,5"/>

                                            <TextBox x:Name="shift_price_box" Tag="سعر الساعة" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="120" 
                                                     TextChanged="shift_price_box_TextChanged"
                                                     Margin="0,0,0,5"/>

                                            <TextBox x:Name="day_shift_box" Tag="عدد الأيام" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="120" 
                                                     TextChanged="day_shift_box_TextChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- قسم الساعة الشهرية -->
                                <Border x:Name="HourSalary" CornerRadius="5" Padding="10" 
                                        Background="#F5F5F5" Margin="0,10,0,0" 
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="تفاصيل الساعة الشهرية" 
                                                   Foreground="#424242" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,5"/>

                                        <StackPanel Orientation="Vertical">
                                            <TextBox x:Name="hour_box" Tag="عدد الساعات" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="120" 
                                                     TextChanged="hour_box_TextChanged"
                                                     Margin="0,0,0,5"/>

                                            <TextBox x:Name="hour_price_box" Tag="سعر الساعة" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="120" 
                                                     TextChanged="hour_price_box_TextChanged"
                                                     Margin="0,0,0,5"/>

                                            <TextBox x:Name="day_hour_box" Tag="عدد الأيام" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="120" 
                                                     TextChanged="day_hour_box_TextChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- المبالغ التفصيلية -->
                        <Border Background="White" CornerRadius="10" Padding="20" Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="تفاصيل المرتب" Style="{StaticResource SectionHeader}"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- الصف الأول -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="الراتب الأساسي" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="salary_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="بدل السكن" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="housing_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="بدل الانتقال" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="transmission_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- الصف الثاني -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="صندوق الزمالة" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="box_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="بدل الإدارة" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="depart_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="بدل طبيعة العمل" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="natural_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- الصف الثالث -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="تأمينات الموظف" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="insurance_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="ضريبة كسب العمل" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="tax_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="أخرى" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="social_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- الصف الرابع -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="تأمينات الشركة" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="comp_insurance_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="الغياب" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="abcence_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="10">
                                            <TextBlock Text="حد السلف" Foreground="#424242" Margin="0,0,0,5"/>
                                            <TextBox x:Name="loanMax_box" Tag="0" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- الإجمالي -->
                                <Border Background="#E3F2FD" CornerRadius="5" Padding="10" Margin="0,15,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="الإجمالي الصافي للموظف:" 
                                                   Foreground="#1976D2" 
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="totalSalaryText" Text="0.00" 
                                                   Grid.Column="1" 
                                                   Foreground="#1976D2" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- الأزرار السفلية -->
            <Border Grid.Row="2" Background="{StaticResource HeaderBackground}" CornerRadius="0,0,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Visibility="Collapsed" Style="{StaticResource ActionButton}" Click="CalculateTotal_Click" Background="#9C27B0">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Calculator" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="حساب الإجمالي" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                        <Button x:Name="save_btn" Style="{StaticResource ActionButton}" Click="save_btn_Click" Background="#4CAF50">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    
                    <Button Style="{StaticResource ActionButton}" Click="ClearForm_Click" Background="Gray" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Refresh" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="جديد" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Visibility="Collapsed" Style="{StaticResource ActionButton}" Click="OpenSalaryReport_Click" Background="#FF9800" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="FileChart" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="تقرير المرتبات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Click="CloseWindow_Click" Background="#F44336" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Close" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="إغلاق" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>