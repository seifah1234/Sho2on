<Window x:Class="HR_Application.Views.Conversations.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views.Conversations"
        xmlns:converters="clr-namespace:HR_Application.Converters"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="{DynamicResource CreateANewGroup2}"
        Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackground}"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Grid.Row="0" 
                   Text="{DynamicResource CreateANewGroup2}" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- صورة المجموعة -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Width="80" Height="80" 
                    CornerRadius="40" 
                    Margin="0,0,15,0"
                    BorderBrush="{DynamicResource SecondaryColor}"
                    BorderThickness="1">
                <Border.Clip>
                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                </Border.Clip>
                <Image x:Name="GroupImage" 
                       Source="/assets/images/group_avatar.jpg" 
                       Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="SelectImageButton" 
                        Click="SelectImage_Click"
                        Background="{DynamicResource SecondaryColor}"
                        Foreground="White"
                        Padding="10,5"
                        Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="Camera" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource ChooseAPhotoForTheGroup}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveImageButton" 
                        Click="RemoveImage_Click"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SecondaryColor}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryColor}"
                        Padding="10,5"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource RemoveImage}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- اسم المجموعة -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource GroupName}" VerticalAlignment="Center" Margin="0,0,10,5" FontWeight="Bold"/>
            <TextBox x:Name="GroupNameBox" 
                     Tag="{DynamicResource TagGroupNameExample}"
                     MinHeight="35"
                     Padding="2,0"/>
        </StackPanel>

        <!-- البحث عن أعضاء -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0" Grid.Column="0">
                
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource AddMembers}" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox x:Name="SearchMemberBox" 
                     Tag="{DynamicResource TagSearchByUsername}"
                     MinHeight="35"
                     Padding="2,0"
                     KeyDown="SearchMemberBox_KeyDown"
                     Margin="25,0,0,0"/>
            </StackPanel>

                
            <!-- نتائج البحث -->
            <ScrollViewer MaxHeight="150" Margin="0,0,0,10" Grid.Column="0" Grid.Row="1">
                <ItemsControl x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PrimaryColor}" 
                                    CornerRadius="5" 
                                    Padding="10" 
                                    Margin="0,0,10,5"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="AddMember_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        
                                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0">
                                        <Border.Clip>
                                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                        </Border.Clip>
                                        <Image>
                                            <Image.Source>
                                                <Binding Path="ProfileImageData" Converter="{StaticResource ByteArrayToImageConverter}"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Code}" FontSize="10" Opacity="0.5"/>
                                    </StackPanel>
                                    </StackPanel>
                                    <icons:PackIconMaterial Kind="Plus" 
                                                            Width="16" 
                                                            Height="16" 
                                                            Foreground="Green"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- الأعضاء المختارين -->
                    
            <TextBlock Text="{DynamicResource SelectedMembers}" Margin="0,0,0,5" FontWeight="Bold" Grid.Column="1" Grid.Row="0"/>
            
            <ScrollViewer MaxHeight="150" Grid.Column="1" Grid.Row="1">
                <ItemsControl x:Name="SelectedMembersList" ItemsSource="{Binding SelectedMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PrimaryColor}" 
                                    CornerRadius="5" 
                                    Padding="10" 
                                    Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0">
                                        <Border.Clip>
                                            <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                                        </Border.Clip>
                                        <Image>
                                            <Image.Source>
                                                <Binding Path="ProfileImageData" Converter="{StaticResource ByteArrayToImageConverter}"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Code}" FontSize="10" Opacity="0.5"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" 
                                            Click="RemoveMember_Click"
                                            Tag="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="{DynamicResource Removal}">
                                        <icons:PackIconMaterial Kind="Close" Width="16" Height="16" Foreground="Red"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="CreateButton" 
                    Content="{DynamicResource Construction}" 
                    Width="100" 
                    Height="35"
                    Margin="5"
                    Background="#00BCD4"
                    Foreground="White"
                    Click="CreateGroup_Click"/>
            <Button x:Name="CancelButton" 
                    Content="{DynamicResource Cancellation}" 
                    Width="100" 
                    Height="35"
                    Margin="5"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>