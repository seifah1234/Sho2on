<Window x:Class="HR_Application.Views.Conversations.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views.Conversations"
        xmlns:controls="clr-namespace:HR_Application.UserControls"
        xmlns:converters="clr-namespace:HR_Application.Converters"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MainBackground}"
        Title="ChatWindow" Height="450" Width="800">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    </Window.Resources>

    <Grid>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="300" MaxWidth="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- العمود الأيمن - قائمة المحادثات -->
            <StackPanel Grid.Column="0" Background="{DynamicResource PrimaryColor}">
                <Border Margin="5">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#00BCD4" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
                    <Grid>
                        <TextBlock HorizontalAlignment="Left" Text="المحادثات" FontSize="18" FontWeight="Bold" Margin="10"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                            <Button Click="ShowAddChatDialog" ToolTip="إضافة محادثة" Background="Transparent" BorderThickness="0" Margin="5">
                                <icons:PackIconMaterial Kind="Plus" Width="20" Height="20"/>
                            </Button>
                            <Button Click="CloseAddChatDialog" ToolTip="إغلاق" Background="Transparent" BorderThickness="0" Margin="5">
                                <icons:PackIconMaterial Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- قائمة المحادثات -->

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <ToggleButton x:Name="ChatsTab" 
                  Content="محادثات" 
                                  
                  IsChecked="True"
                  Click="ChatsTab_Click"
                  Style="{StaticResource TabToggleButtonStyle}"/>
                    <ToggleButton x:Name="GroupsTab" 
                  Content="مجموعات" 
                  Click="GroupsTab_Click"
                  Style="{StaticResource TabToggleButtonStyle}"/>
                    <ToggleButton x:Name="ArchiveTab" 
                  Content="أرشيف" 
                  Click="ArchiveTab_Click"
                  Style="{StaticResource TabToggleButtonStyle}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ChatsScrollViewer">
                    <ItemsControl x:Name="ChatListControl" ItemsSource="{Binding ChatList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TransparentButtonStyle}" 
                    Click="ChatItem_Click" HorizontalContentAlignment="Stretch"
                                        
                    Tag="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu FlowDirection="RightToLeft">
                                            <MenuItem Header="📦 أرشفة المحادثة"
                      Tag="{Binding}"
                      Click="ArchiveChat_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border>
                                        <!-- Bottom hairline -->
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#00BCD4"     Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
                                        <StackPanel>
                                        
                                        <Grid Background="{DynamicResource PrimaryColor}" Height="80">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- الصورة الدائرية -->
                                            
                                            <Border Width="60" Height="60" Margin="10,10,5,10">
                                                <Border.Clip>
                                                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                </Border.Clip>
                                                <Border BorderBrush="{DynamicResource SecondaryColor}" 
                    BorderThickness="1"
                    Background="{DynamicResource SecondaryColor}">

                                                    <!-- الصورة من قاعدة البيانات -->
                                                    <Image Source="{Binding ProfileImageSource, FallbackValue=/assets/images/avatar.jpg, UpdateSourceTrigger=PropertyChanged}"
       Stretch="UniformToFill"/>
                                                </Border>
                                            </Border>

                                            <!-- محتوى النصوص -->
                                            <Grid Grid.Column="1" Margin="10,10,10,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding UserName}" Grid.Column="0"
                   FontWeight="Bold" 
                                                               HorizontalAlignment="Left"
                   Foreground="{DynamicResource TextPrimaryColor}"
                   FontSize="14"/>
                                                        <Grid Grid.Column="1">
                                                            
                                                            <TextBlock Text="{Binding LastMessageTime, StringFormat='HH:mm tt'}" HorizontalAlignment="Left"
                           FontSize="10"
                           Opacity="0.5"
                                                                       FlowDirection="LeftToRight"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>

                                                            
                                                        </Grid>
                                                </Grid>

                                                    <Grid Grid.Row="1">
                                                <TextBlock 
                       Text="{Binding LastMessage,UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="{DynamicResource TextPrimaryColor}"
                       FontSize="12"
                       Opacity="0.8"
                       VerticalAlignment="Center"
                       TextTrimming="WordEllipsis"/>
                                                        <Border Background="#FF4444" 
CornerRadius="10" 
Width="20" 
Height="20" 
VerticalAlignment="Center" 
HorizontalAlignment="Right"
Margin="5"
                Visibility="{Binding ShowUnreadBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding UnreadCountText}" 
       Foreground="White" 
       FontSize="10" 
       FontWeight="Bold" 
       TextAlignment="Center" 
       VerticalAlignment="Center" 
       HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                        
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- قائمة المجموعات -->
                <ScrollViewer x:Name="GroupsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="+ إنشاء مجموعة جديدة" 
                Click="ShowCreateGroupDialog"
                Style="{StaticResource CreateGroupButtonStyle}"
                Margin="10"/>
                        <ItemsControl ItemsSource="{Binding GroupList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TransparentButtonStyle}" 
                            Click="GroupItem_Click"
                            Tag="{Binding}"
                            HorizontalContentAlignment="Stretch">
                                        <Border>
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#00BCD4" Offset="0.5"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                                            <Grid Height="80">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="60" Height="60" Margin="10,10,5,10">
                                                    <Border.Clip>
                                                        <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                    </Border.Clip>
                                                    <Border BorderBrush="{DynamicResource SecondaryColor}" 
                                            BorderThickness="1"
                                            Background="{DynamicResource SecondaryColor}">
                                                        <Image Source="{Binding GroupImageSource, FallbackValue=/assets/images/group_avatar.jpg}"
                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Border>

                                                <Grid Grid.Column="1" Margin="10,10,10,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding GroupName}" Grid.Column="0"
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   FontSize="14"/>
                                                        <TextBlock Text="{Binding LastMessageTime, StringFormat='HH:mm tt'}" 
                                                   Grid.Column="1"
                                                   FontSize="10"
                                                   Opacity="0.5"
                                                   FlowDirection="LeftToRight"
                                                   Margin="10,0,0,0"/>
                                                    </Grid>

                                                    <Grid Grid.Row="1">
                                                        <TextBlock Text="{Binding LastMessage}"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   FontSize="12"
                                                   Opacity="0.8"
                                                   TextTrimming="WordEllipsis"/>
                                                        <Border Background="#FF4444" 
                                                CornerRadius="10" 
                                                Width="20" 
                                                Height="20" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right"
                                                Margin="5"
                                                Visibility="{Binding ShowUnreadBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding UnreadCountText}" 
                                                       Foreground="White" 
                                                       FontSize="10" 
                                                       FontWeight="Bold" 
                                                       TextAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- قائمة الأرشيف -->
                <ScrollViewer x:Name="ArchiveScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ArchivedChatList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TransparentButtonStyle}" 
                        Click="ArchivedChatItem_Click"
                        Tag="{Binding}"
                        HorizontalContentAlignment="Stretch">
                                    <Button.ContextMenu>
                                        <ContextMenu FlowDirection="RightToLeft">
                                            <MenuItem Header="📤 إلغاء الأرشفة"
                      Tag="{Binding}"
                      Click="UnarchiveChat_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#00BCD4" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                                        <Grid Height="80">
                                            <!-- نفس تنسيق ChatItem -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="60" Height="60" Margin="10,10,5,10">
                                                <Border.Clip>
                                                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                </Border.Clip>
                                                <Border BorderBrush="{DynamicResource SecondaryColor}" 
                                        BorderThickness="1"
                                        Background="{DynamicResource SecondaryColor}">
                                                    <Image Source="{Binding ProfileImageSource, FallbackValue=/assets/images/avatar.jpg}"
                                           Stretch="UniformToFill"/>
                                                </Border>
                                            </Border>

                                            <Grid Grid.Column="1" Margin="10,10,10,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding UserName}" Grid.Column="0"
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextPrimaryColor}"
                                               FontSize="14"/>
                                                    <TextBlock Text="{Binding LastMessageTime, StringFormat='HH:mm tt'}" 
                                               Grid.Column="1"
                                               FontSize="10"
                                               Opacity="0.5"
                                               FlowDirection="LeftToRight"
                                               Margin="10,0,0,0"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1" 
                                           Text="{Binding LastMessage}"
                                           Foreground="{DynamicResource TextPrimaryColor}"
                                           FontSize="12"
                                           Opacity="0.8"
                                           TextTrimming="WordEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- العمود الأيسر - نافذة الشات -->
            <controls:ChatBox x:Name="ChatBoxControl" Grid.Column="1"/>
            <controls:GroupChatBox x:Name="GroupChatBoxControl" Grid.Column="1" Visibility="Collapsed"/>
        </Grid>

        <Grid Background="#77000000" Name="addChatGrid" Visibility="Collapsed">
            <Border Background="{DynamicResource MainBackground}" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="إضافة محادثة جديدة" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="newChatCodeBox" Tag="كود المستخدم..." Margin="0,0,10,10" Width="120" KeyDown="SearchUser_KeyDown"/>
                        <TextBox x:Name="newChatUserBox" Tag="اسم المستخدم..." Margin="0,0,0,10" KeyDown="SearchUser_KeyDown"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="400" Margin="0,10">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="30" Height="30" Margin="0,0,10,0"
       Source="{Binding ProfileImageData, Converter={StaticResource ByteArrayToImageConverter}}"/>
                                            <TextBlock Text="{Binding UserName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="إضافة" Click="AddChatButton_Click"/>
                        <Button Content="إلغاء" Click="CloseAddChatDialog" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid> 
    </Grid>
</Window>