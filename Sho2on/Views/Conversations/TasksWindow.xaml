<Window x:Class="HR_Application.Views.Conversations.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views.Conversations"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Background="{DynamicResource MainBackground}"
        Title="TasksWindow" Height="650" Width="1000">

    <Window.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الهيدر -->
            <Border Grid.Row="0" Margin="15,15,15,0" Background="{DynamicResource PrimaryColor}" 
                    CornerRadius="16" Padding="15">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Icon:PackIconMaterial Kind="ClipboardCheck" Width="32" Height="32" 
                                               Foreground="{DynamicResource AccentColor}" Margin="0,0,10,0"/>
                        <TextBlock Text="شاشة المهام" FontSize="24" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="5" Width="50" Height="50" Name="addTaskBtn" 
                                Click="addTaskBtn_Click" ToolTip="اضافة مهمه">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceLightColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColor}"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Icon:PackIconMaterial Kind="Plus" Width="20" Height="20"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>
                        <Button Margin="5" Width="50" Height="50" Name="refreshTaskBtn" 
                                Click="refreshTaskBtn_Click" ToolTip="تحديث">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceLightColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColor}"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Icon:PackIconMaterial Kind="Refresh" Width="20" Height="20"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- المهام الموكلة إليّ -->
                <Border Grid.Row="0" Margin="15,10,15,5" Background="{DynamicResource SurfaceColor}" 
                        CornerRadius="16" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📋 قائمة الموكلة إليّ" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="تصفية حسب الحالة" VerticalAlignment="Center" Margin="0,0,5,5" 
                                           Foreground="{DynamicResource MutedColor}"/>
                                <ComboBox Name="statusFilterBox" Width="150" 
                                          SelectionChanged="statusFilterBox_SelectionChanged">
                                    <ComboBoxItem Content="الكل"/>
                                    <ComboBoxItem Content="استلمت"/>
                                    <ComboBoxItem Content="معلقة"/>
                                    <ComboBoxItem Content="قيد التنفيذ"/>
                                    <ComboBoxItem Content="مكتملة"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <DataGrid MaxHeight="160" Name="MyTasksDataGrid" Margin="5" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" 
                                  HeadersVisibility="Column" ItemsSource="{Binding MyTasks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المرسل" Binding="{Binding AssignedByUser.FullName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding TypeText}" Width="*"/>
                                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTemplateColumn Header="الحالة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                    CornerRadius="8" Padding="6,3" HorizontalAlignment="Center" Margin="3">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Status, Mode=TwoWay}" Width="100" 
                                                      SelectionChanged="statusBox_SelectionChanged" Name="statusBox">
                                                <ComboBoxItem Content="استلمت"/>
                                                <ComboBoxItem Content="معلقة"/>
                                                <ComboBoxItem Content="قيد التنفيذ"/>
                                                <ComboBoxItem Content="مكتملة"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="موعد التسليم" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" 
                                                    Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- المهام التي قمت بتكليفها -->
                <Border Grid.Row="1" Margin="15,5,15,15" Background="{DynamicResource SurfaceColor}" 
                        CornerRadius="16" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📤 قائمة المهام التي قمت بتكليفها" FontSize="18" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="تصفية حسب الحالة" VerticalAlignment="Center" Margin="0,0,5,5" 
                                           Foreground="{DynamicResource MutedColor}"/>
                                <ComboBox Name="assignedStatusFilterBox" Width="150" 
                                          SelectionChanged="assignedStatusFilterBox_SelectionChanged">
                                    <ComboBoxItem Content="الكل"/>
                                    <ComboBoxItem Content="استلمت"/>
                                    <ComboBoxItem Content="معلقة"/>
                                    <ComboBoxItem Content="قيد التنفيذ"/>
                                    <ComboBoxItem Content="مكتملة"/>
                                    <ComboBoxItem Content="ارسلت"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <DataGrid MaxHeight="160" HorizontalContentAlignment="Center" 
                                  Name="TasksDataGrid" Margin="5" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" HeadersVisibility="Column" 
                                  ItemsSource="{Binding AssignedTasks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستلم" Binding="{Binding AssignedToUser.FullName}" Width="*"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding TypeText}" Width="*"/>
                                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTemplateColumn Header="الحالة" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                    Margin="3" CornerRadius="8" Padding="6,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="موعد التسليم" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="*"/>
                                <DataGridTemplateColumn Header="الاجراءات" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="تعديل" Margin="3" Padding="5,2" Width="55" 
                                                        Click="EditTaskButton_Click"/>
                                                <Button Content="حذف" Margin="3" Padding="5,2" Width="55" 
                                                        Click="DeleteTaskButton_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- نافذة إدارة المهمة -->
        <Grid Background="#99000000" Name="manageTaskGrid" Visibility="Collapsed">
            <Border Background="{DynamicResource SurfaceColor}" Padding="20" CornerRadius="16" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="اضافة" Name="manageTaskTitle" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource AccentColor}" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Label Content="النوع" Margin="0,0,5,0" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        <ComboBox Name="requestTypeBox" SelectionChanged="requestTypeBox_SelectionChanged">
                            <ComboBoxItem Content="مهمة"/>
                            <ComboBoxItem Content="طلب"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="10,0" Name="officalsPanel" Visibility="Collapsed">
                            <Label Content="المسؤولون" Margin="0,0,5,0" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            <ComboBox Name="officialsBox" SelectedValuePath="Id" DisplayMemberPath="User.FullName" SelectionChanged="officialsBox_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>
                    <Label Content="تعيين إلى" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryColor}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Name="assignToCodeBox" Tag="الكود" VerticalAlignment="Bottom" Margin="5" 
                                 KeyDown="assignToCodeBox_KeyDown"/>
                        <ComboBox Width="350" SelectionChanged="userComboBox_SelectionChanged" 
                                  SelectedValuePath="Code" DisplayMemberPath="FullName" 
                                  HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" 
                                  IsTextSearchEnabled="False" Name="assignToBox" Margin="5" 
                                  Foreground="{DynamicResource TextPrimaryColor}"
                                  Loaded="searchComboBox_Loaded" ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                    </StackPanel>
                    <Label Content="تاريخ التسليم" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryColor}"/>
                    <DatePicker Name="dueDatePicker" Margin="0,0,0,10" Tag="موعد التسليم"/>
                    <TextBox TextWrapping="Wrap" MinWidth="500" MaxWidth="500" MinHeight="100" 
                             Name="taskDescriptionBox" Margin="0,0,0,10" Tag="وصف المهمة" MaxLines="5"
                             KeyDown="taskDescriptionBox_KeyDown" 
                             VerticalContentAlignment="Top"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="حفظ" Width="80" Margin="5" Click="SaveTaskButton_Click"/>
                        <Button Content="إلغاء" Width="80" Margin="5" Click="CancelEditButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>