<Window x:Class="HR_Application.MachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="550" Width="1000" MinHeight="550" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للسيده بار -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="Foreground" Value="#263238"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource MachineData}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- الجانب الأيمن: نموذج الإدخال -->
            <Border Grid.Row="1" Grid.Column="1" CornerRadius="20 0 0 20" Background="{DynamicResource PrimaryColor}"  >
                <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="280">
                    <!-- ComboBox للفرع -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0 15 0 0">
                        <ComboBox x:Name="branch_box" FlowDirection="RightToLeft"/>
                        <Label FontWeight="SemiBold" Content="{DynamicResource Branch}" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                   

                    <!-- TextBox لـ Machine IP -->
                    <TextBox HorizontalAlignment="Center" x:Name="machine_num" Margin="0 20 0 0" Tag="Machine IP"/>

                    <!-- TextBox لـ Server IP -->
                    <TextBox x:Name="server_num" Margin="0 20 0 0" Tag="Server IP"/>

                    <!-- أزرار الجديد والحفظ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10 25 10 10" Orientation="Horizontal">
                        <Button Style="{DynamicResource ActionButtonStyle}" Click="reset_Btn" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Refresh" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="{DynamicResource New}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ActionButtonStyle}" Click="save_Btn" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- أزرار الخروج والحذف -->
                    <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        
                        <Button Style="{DynamicResource ActionButtonStyle}" Click="delete_Btn" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="{DynamicResource Delete}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ActionButtonStyle}" Click="edit_Btn" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="{DynamicResource Amendment}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Style="{DynamicResource ActionButtonStyle}" Click="exit_Btn" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                            <TextBlock Text="{DynamicResource Exit}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- الجانب الأيسر: DataGrid -->
            <Border Grid.Row="1" Grid.Column="0" CornerRadius="0 20 20 0" Opacity="0.95"   Margin="20">
                <DataGrid SelectionChanged="list_Changed" AutoGenerateColumns="False" FlowDirection="RightToLeft" Margin="10" x:Name="list">
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource M}" Width="30" Binding="{Binding RowNumber}"/>
                        <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource BranchCode}" Width="80" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="{DynamicResource BranchName}" IsReadOnly="True" Width="120" Binding="{Binding Branch}"/>
                        <DataGridTextColumn Header="{DynamicResource MachineNumber}" Width="120" IsReadOnly="True" Binding="{Binding MIP}"/>
                        <DataGridTextColumn Header="Machine IP" Width="120" IsReadOnly="True" Binding="{Binding MT}"/>
                        <DataGridTextColumn Header="Server IP" Width="120" IsReadOnly="True" Binding="{Binding SIP}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>