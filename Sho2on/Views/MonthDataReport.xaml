<Window x:Class="HR_Application.Views.MonthDataReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application.Views"
        mc:Ignorable="d"
        Title="MonthDataReport" Height="700" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <ScrollViewer>
            <StackPanel Orientation="Vertical">
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="print_btn" Width="60" Height="50" Background="#ffffff" Foreground="Black" BorderThickness="0" Margin="10" Click="print_btn_Click">
                <Image x:Name="GIFPrint" Source="pack://application:,,,/assets/images/print.gif" Stretch="UniformToFill"/>

            </Button>
            <FlowDocumentReader Name="flowReader" ViewingMode="Page" Zoom="90">
            
        </FlowDocumentReader>
        </StackPanel>
            
        </ScrollViewer>


    </Grid>
</Window>
