<Window x:Class="HR_Application.AddLate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Height="600" Width="750" MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للسيده بار -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->


        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ThirdColorBrushBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="Foreground" Value="#263238"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!-- نمط للـ TextBox -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource DelayAndAdditionalData}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- TabControl المحسن -->
            <TabControl Grid.Row="1" FlowDirection="RightToLeft" Background="{DynamicResource InputBackground}" BorderThickness="0">
                <TabItem >
                    <TabItem.Header>
                        <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                            <Label Content="{DynamicResource MinutesValue}" Foreground="{DynamicResource PrimaryColor}"/>
                            
                        </Border>
                    </TabItem.Header>
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- الجانب الأيمن: نموذج الإدخال -->
                        <Border Grid.Column="1" CornerRadius="20 0 0 20" Background="{DynamicResource BorderColor}"  >
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="280">
                                <!-- RadioButtons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                                    <RadioButton x:Name="RadioButton_Late" Style="{DynamicResource RadioButtonStyle}" 
                 Checked="RadioButton_Checked_1" Content="{DynamicResource Delay3}"/>
                                    <RadioButton x:Name="RadioButton_Add" Style="{DynamicResource RadioButtonStyle}" 
                 IsChecked="True" Checked="RadioButton_Checked" Content="{DynamicResource TheExtra}"/>
                                </StackPanel>

                                <!-- Time Picker للوقت من -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource From}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <TextBox x:Name="FromTimePicker" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                    
                                    
                                </StackPanel>

                                <!-- Time Picker للوقت إلى -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource To2}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <TextBox x:Name="ToTimePicker" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة (مخفي) -->
                                <StackPanel Visibility="Collapsed" Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource Value}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <Controls:TimePicker x:Name="ValueTimePicker" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         Culture="en-US" 
                                                         Foreground="Black" 
                                                         Background="Transparent" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة المالية -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource NumberOfMinutes}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <TextBox Style="{DynamicResource InputFieldStyle}" x:Name="ValueMoneyTextBox" Tag="{DynamicResource TagMinutesCount}"/>
                                </StackPanel>

                                <!-- أزرار التعديل والحفظ -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Orientation="Horizontal">
                                    <Button Style="{DynamicResource ActionButtonStyle}" Click="edit_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Amendment}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource ActionButtonStyle}" Click="save_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- أزرار الخروج والحذف -->
                                <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{DynamicResource ActionButtonStyle}" Click="exit_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Exit}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource ActionButtonStyle}" Click="delete_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Delete}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- الجانب الأيسر: DataGrid -->
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Lates}" FlowDirection="RightToLeft" Margin="20" Grid.Column="0" x:Name="list" Background="Transparent" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding TypeName}"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="{DynamicResource Timing}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{DynamicResource Value}" Binding="{Binding Value}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem FontSize="16" FontWeight="Bold">

                    <TabItem.Header>
                        <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                            <Label Content="{DynamicResource MonetaryValue}" Foreground="{DynamicResource PrimaryColor}"/>

                        </Border>
                    </TabItem.Header>
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- الجانب الأيمن: نموذج الإدخال -->
                        <Border Grid.Column="1" CornerRadius="20 0 0 20" Background="{DynamicResource BorderColor}"  >
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="280">
                                <!-- RadioButtons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                                    <RadioButton x:Name="RadioButton_Late_Money" Style="{DynamicResource RadioButtonStyle}" 
                 Checked="RadioButton_Checked_1" Content="{DynamicResource Delay3}"/>
                                    <RadioButton x:Name="RadioButton_Add_Money" Style="{DynamicResource RadioButtonStyle}" 
                 IsChecked="True" Checked="RadioButton_Checked" Content="{DynamicResource TheExtra}"/>
                                </StackPanel>


                                <!-- Time Picker للوقت من -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource From}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <TextBox x:Name="FromTimePickerMoney" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- Time Picker للوقت إلى -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource To2}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <TextBox x:Name="ToTimePickerMoney" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة (مخفي) -->
                                <StackPanel Visibility="Collapsed" Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource Value}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <Controls:TimePicker x:Name="ValueTimePickerMoney" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         Culture="en-US" 
                                                         Foreground="Black" 
                                                         Background="Transparent" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة المالية -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource Value}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <TextBox Style="{DynamicResource InputFieldStyle}" x:Name="ValueMoneyMoneyTextBox" Tag="{DynamicResource TagValue}"/>
                                </StackPanel>

                                <!-- أزرار التعديل والحفظ -->
                                <UniformGrid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" >
                                    <Button Visibility="Collapsed" Name="editMoneyBtn" Style="{DynamicResource ActionButtonStyle}" Click="editMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Amendment}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="saveMoneyBtn" Style="{DynamicResource ActionButtonStyle}" Click="saveMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                <!-- أزرار الخروج والحذف -->
                                    <Button Style="{DynamicResource ActionButtonStyle}" Click="exitMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Exit}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Visibility="Collapsed" Name="deleteMoneyBtn" Style="{DynamicResource ActionButtonStyle}" Click="deleteMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource Delete}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- الجانب الأيسر: DataGrid -->
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding LatesMoney}" FlowDirection="RightToLeft" Margin="20" Grid.Column="0" x:Name="listMoney" Background="Transparent" BorderBrush="#1976D2" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Type}" Binding="{Binding TypeName}"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="{DynamicResource Timing}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{DynamicResource Value}" Binding="{Binding Value}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>

                    <TabItem.Header>
                        <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                            <Label Content="{DynamicResource Settings3}" Foreground="{DynamicResource PrimaryColor}"/>

                        </Border>
                    </TabItem.Header>
                    <Border CornerRadius="20" Margin="10" Background="{DynamicResource BorderColor}"  >
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- RadioButtons -->
                            <GroupBox Foreground="{DynamicResource ThirdColorBrushBrush}" Header="{DynamicResource DelayAndAdditionalAccountSettings}" Margin="5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <RadioButton Style="{DynamicResource RadioButtonStyle}" Content="{DynamicResource MinutesValue}" Name="minuteBtn" IsChecked="True" Checked="minuteBtn_Checked"/>
                                    <RadioButton Style="{DynamicResource RadioButtonStyle}" Content="{DynamicResource MonetaryValue}" Name="moneyBtn" Checked="moneyBtn_Checked"/>
                                </StackPanel>

                            </GroupBox>

                            <GroupBox Margin="5" Foreground="{DynamicResource ThirdColorBrushBrush}" Header="{DynamicResource RepeatedDelay}">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <TextBox Tag="{DynamicResource TagRepeatCount}" x:Name="delay_repeat" Margin="10"/>
                                    <TextBox Tag="{DynamicResource TagDelayValue}" x:Name="delay_value" Margin="10"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- زر الحفظ -->
                            <Button Style="{DynamicResource SaveButtonStyle}" HorizontalAlignment="Center" x:Name="save_btn" Click="save_btn_Click" Margin="20">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>