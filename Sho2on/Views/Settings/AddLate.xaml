<Window x:Class="HR_Application.AddLate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Height="600" Width="750" MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للسيده بار -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->

        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="Foreground" Value="#263238"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!-- نمط للـ TextBox -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للـ DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource MainBackgroundBrush}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="بيانات التأخير و الاضافي" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#1976D2" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- TabControl المحسن -->
            <TabControl Grid.Row="1" FlowDirection="RightToLeft" Background="Transparent" BorderThickness="0">
                <TabItem Header="قيمة دقائق" FontSize="16" FontWeight="Bold">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- الجانب الأيمن: نموذج الإدخال -->
                        <Border Grid.Column="1" CornerRadius="20 0 0 20" Background="{StaticResource HeaderBackground}"  >
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="280">
                                <!-- RadioButtons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                                    <RadioButton x:Name="RadioButton_Late" Style="{StaticResource RadioButtonStyle}" 
                 Checked="RadioButton_Checked_1" Content="تأخير"/>
                                    <RadioButton x:Name="RadioButton_Add" Style="{StaticResource RadioButtonStyle}" 
                 IsChecked="True" Checked="RadioButton_Checked" Content="الاضافي"/>
                                </StackPanel>

                                <!-- Time Picker للوقت من -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="من" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBox x:Name="FromTimePicker" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- Time Picker للوقت إلى -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="الى" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBox x:Name="ToTimePicker" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة (مخفي) -->
                                <StackPanel Visibility="Collapsed" Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="القيمة" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <Controls:TimePicker x:Name="ValueTimePicker" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         Culture="en-US" 
                                                         Foreground="Black" 
                                                         Background="Transparent" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة المالية -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="عدد الدقائق" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBox Style="{StaticResource InputFieldStyle}" x:Name="ValueMoneyTextBox" Tag="عدد الدقائق"/>
                                </StackPanel>

                                <!-- أزرار التعديل والحفظ -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="edit_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="تعديل" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="save_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- أزرار الخروج والحذف -->
                                <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="exit_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="خروج" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="delete_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="حذف" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- الجانب الأيسر: DataGrid -->
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Lates}" FlowDirection="RightToLeft" Margin="20" Grid.Column="0" x:Name="list" Background="Transparent" BorderBrush="#1976D2" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Binding="{Binding TypeName}"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="التوقيت" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="القيمة" Binding="{Binding Value}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="قيمة مالية" FontSize="16" FontWeight="Bold">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- الجانب الأيمن: نموذج الإدخال -->
                        <Border Grid.Column="1" CornerRadius="20 0 0 20" Background="{StaticResource HeaderBackground}"  >
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="280">
                                <!-- RadioButtons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                                    <RadioButton x:Name="RadioButton_Late_Money" Style="{StaticResource RadioButtonStyle}" 
                 Checked="RadioButton_Checked_1" Content="تأخير"/>
                                    <RadioButton x:Name="RadioButton_Add_Money" Style="{StaticResource RadioButtonStyle}" 
                 IsChecked="True" Checked="RadioButton_Checked" Content="الاضافي"/>
                                </StackPanel>


                                <!-- Time Picker للوقت من -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="من" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBox x:Name="FromTimePickerMoney" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- Time Picker للوقت إلى -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="الى" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBox x:Name="ToTimePickerMoney" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة (مخفي) -->
                                <StackPanel Visibility="Collapsed" Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="القيمة" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <Controls:TimePicker x:Name="ValueTimePickerMoney" 
                                                         Margin="0 10 0 0" 
                                                         Width="200" 
                                                         Culture="en-US" 
                                                         Foreground="Black" 
                                                         Background="Transparent" 
                                                         BorderThickness="1"/>
                                </StackPanel>

                                <!-- حقل القيمة المالية -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 12" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="القيمة" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBox Style="{StaticResource InputFieldStyle}" x:Name="ValueMoneyMoneyTextBox" Tag="القيمة"/>
                                </StackPanel>

                                <!-- أزرار التعديل والحفظ -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="editMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="تعديل" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="saveMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- أزرار الخروج والحذف -->
                                <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="exitMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="خروج" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="deleteMoney_Btn" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="حذف" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- الجانب الأيسر: DataGrid -->
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding LatesMoney}" FlowDirection="RightToLeft" Margin="20" Grid.Column="0" x:Name="listMoney" Background="Transparent" BorderBrush="#1976D2" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Binding="{Binding TypeName}"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="التوقيت" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="القيمة" Binding="{Binding Value}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>