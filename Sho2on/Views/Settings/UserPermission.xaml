<Window x:Class="HR_Application.UserPermission"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="UserPermission" Height="500" Width="650" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للجانب الأيسر -->
        <LinearGradientBrush x:Key="LeftSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للزر -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ ComboBox -->
        <Style x:Key="RoleComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للـ TextBox -->
        <Style x:Key="UsernameTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- نمط للـ TextBox -->
        <Style x:Key="PasswordTextBoxStyle" TargetType="PasswordBox">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource UserPermissions}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- المنطقة الرئيسية -->
            <Grid Grid.Row="1" FlowDirection="RightToLeft" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- الجانب الأيسر المحسن -->
                <Border Grid.Column="0" CornerRadius="20" Background="{DynamicResource PrimaryColor}"  >
                    <Grid>
                        <StackPanel Margin="15" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- ComboBox للجروب -->
                            <StackPanel Margin="5" HorizontalAlignment="Left" Orientation="Horizontal">
                                <Label Margin="0" Content="{DynamicResource TheGroup}" Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold"/>
                                <ComboBox Name="roleComboBox" Margin="10 0 0 0"/>
                            </StackPanel>

                            <!-- TextBox لكلمة المرور -->
                            <StackPanel Margin="5" HorizontalAlignment="Left" Orientation="Vertical">
                                <Label Content="{DynamicResource Username3}" Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold" Margin="0 0 0 5"/>
                                <TextBox Style="{DynamicResource UsernameTextBoxStyle}" Tag="اسم المستخدم" Name="username_box"/>
                            </StackPanel>
                            
                            <StackPanel Margin="5" HorizontalAlignment="Left" Orientation="Vertical">
                                <Label Content="{DynamicResource Password2}" Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold" Margin="0 0 0 5"/>
                                <PasswordBox Style="{DynamicResource PasswordTextBoxStyle}" Tag="كلمة المرور" Name="pass_box"/>
                            </StackPanel>

                            <!-- زر الحفظ المحسن -->
                                <Button Style="{DynamicResource SaveButtonStyle}" Margin="10" IsDefault="True" x:Name="save_btn" Click="save_btn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid المحسن -->
                <Border Grid.Column="1" Margin="10 0 0 0" CornerRadius="10" Opacity="0.95"  >
                    <DataGrid  SelectionChanged="dataTable_SelectionChanged" AutoGenerateColumns="False" ItemsSource="{Binding usersList}" FlowDirection="RightToLeft" Name="dataTable" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Code}" Width="100" Header="{DynamicResource Code}"/>
                            <DataGridTextColumn Binding="{Binding Name}" Width="200" Header="{DynamicResource TheName}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>