<Window x:Class="HR_Application.AddAttendRecord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application"
        Loaded="Window_Loaded"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Height="400" Width="400">
    <Grid Background="{StaticResource SecondaryColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="حضور و اصراف مانوال" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryColor}" Height="22"  Grid.ColumnSpan="2"/>

        <Border Grid.Row="1" Background="{StaticResource PrimaryColor}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Orientation="Vertical" FlowDirection="RightToLeft">

                <TextBlock x:Name="Date_Now" Foreground="White" FontSize="24" Text="" HorizontalAlignment="Center" FontWeight="Bold" Margin="20"/>

                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <RadioButton  IsChecked="True" x:Name="attend_check" Margin="5" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Content="حضور" Foreground="{StaticResource ThirdColor}" FontWeight="Bold" FontSize="14"/>
                    <RadioButton x:Name="deaparture_check" Margin="5" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Content="انصراف" Foreground="{StaticResource ThirdColor}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBox Tag="كود الموظف" Name="code_box" BorderThickness="0" Margin="5" TabIndex="2"/>

                    <StackPanel Margin="5" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                        <Label VerticalAlignment="Center" Content="الفرع" Foreground="{StaticResource ThirdColor}" HorizontalAlignment="Center"/>
                        <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" FlowDirection="LeftToRight" Name="branch_box" Margin="5 0 0 0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBox Tag="الموقع" x:Name="location_box" BorderThickness="0" Margin="5" Width="250" TabIndex="3"/>
                </StackPanel>

                <Button HorizontalAlignment="Center" x:Name="save_btn" Content="اضافة" Width="150" Height="40" Margin="20" Background="{StaticResource ThirdColor}" Foreground="{StaticResource PrimaryColor}" FontSize="16" BorderThickness="0" Click="save_record_btn_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
