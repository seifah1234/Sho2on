<Window x:Class="HR_Application.AddEmplo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        WindowStyle="SingleBorderWindow"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="750" Width="1150" MinHeight="950" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="Transparent">

    <Window.Resources>

        <!-- ════ Effects ════ -->
        <DropShadowEffect x:Key="CardShadow"   BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.35"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
        <DropShadowEffect x:Key="CyanGlow"     BlurRadius="14" ShadowDepth="0" Color="#00BCD4" Opacity="0.3"/>

        <!-- ════ Card Section style ════ -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
            <Setter Property="Padding"         Value="20,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════ Section header label ════ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="0,0,0,14"/>
        </Style>

        <!-- ════ Field label ════ -->
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Foreground"  Value="{DynamicResource MutedColor}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="0,0,0,4"/>
            <Setter Property="Margin"      Value="0,8,0,0"/>
        </Style>

        <!-- ════ Modern TextBox ════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness"           Value="0,0,0,2"/>
            <Setter Property="BorderBrush"               Value="{DynamicResource BorderColor}"/>
            <Setter Property="Background"                Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground"                Value="{DynamicResource InputForeground}"/>
            <Setter Property="CaretBrush"                Value="{DynamicResource AccentColor}"/>
            <Setter Property="SelectionBrush"            Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="Padding"                   Value="8,0"/>
            <Setter Property="Height"                    Value="38"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="FocusVisualStyle"          Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="CW-Inline-input-example">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="textBlock">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-6.667">
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <QuinticEase EasingMode="EaseInOut"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="textBlock">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-30.733">
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <QuinticEase EasingMode="EaseInOut"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock">
                                    <EasingColorKeyFrame KeyTime="0:0:0.6" Value="#00BCD4"/>
                                </ColorAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.FontWeight)" Storyboard.TargetName="textBlock">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3">
                                        <DiscreteObjectKeyFrame.Value>
                                            <FontWeight>SemiBold</FontWeight>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <Grid>
                            <Border x:Name="border" CornerRadius="8"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <TextBlock x:Name="textBlock" Text="{TemplateBinding Tag}"
                                       VerticalAlignment="Center" Margin="10,0"
                                       Foreground="{DynamicResource MutedColor}"
                                       IsHitTestVisible="False"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Static sys:String.Empty}">
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource CW-Inline-input-example}"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════ Modern DatePicker ════ -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Height"          Value="38"/>
        </Style>

        <!-- ════ Action button base ════ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceLightColor}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Margin"          Value="5,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════ CheckBox styled for dark cards ════ -->
        <Style x:Key="CardCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="{DynamicResource TextSecondaryColor}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Normal"/>
            <Setter Property="Margin"      Value="0,5"/>
        </Style>

        <!-- ════ Hairline separator ════ -->
        <Style x:Key="HairlineSep" TargetType="Rectangle">
            <Setter Property="Height"  Value="1"/>
            <Setter Property="Opacity" Value="0.15"/>
            <Setter Property="Margin"  Value="0,10"/>
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ════════════ Root ════════════ -->
    <Border CornerRadius="15" Background="{DynamicResource MainBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════ Header ════ -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0"
                    Background="{DynamicResource HeaderBackground}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                </Border.Effect>
                <!-- Bottom hairline -->
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <Grid>
                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="32" Height="32" Margin="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00838F" Offset="0"/>
                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Icon:PackIconMaterial Kind="AccountEdit" Width="16" Height="16"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource EmployeeData3}"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button x:Name="btnClose" Click="Exit_Click"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="14,0" Width="32" Height="32"
                            Background="#2D1010" BorderThickness="1" BorderBrush="#3B1010"
                            Foreground="#EF9A9A" FontSize="13" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Icon:PackIconMaterial Kind="Close" Width="14" Height="14"
                                                           Foreground="#EF5350"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3B1010"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5350"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ════ Main content ════ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" MaxHeight="550"
                          Background="Transparent" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ════ Left column ════ -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">

                        <!-- Avatar card -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource EmployeePhoto}" Style="{StaticResource SectionHeader}"/>

                                <!-- Avatar ring -->
                                <Border Width="160" Height="160"
                                        HorizontalAlignment="Center"
                                        BorderThickness="3" Margin="0,0,0,12">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00BCD4" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00BCD4" Opacity="0.25"/>
                                    </Border.Effect>
                                        <Image x:Name="EmployeeImage"
                                               Stretch="UniformToFill"
                                              
                                               Source="pack://application:,,,/assets/images/avatar.jpg"/>
                                </Border>

                                <!-- Image action buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="addImage" Click="addImage_Click"
                                            Width="38" Height="38" Margin="0,0,8,0"
                                            Background="#003A25" BorderThickness="1" BorderBrush="#004D33"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Icon:PackIconMaterial Kind="Camera" Foreground="#66BB6A"
                                                                           Width="16" Height="16"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#004D33"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="removeImage" Click="removeImage_Click"
                                            Width="38" Height="38" Margin="0"
                                            Background="#3B1010" BorderThickness="1" BorderBrush="#4A1515"
                                            Visibility="Collapsed" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Icon:PackIconMaterial Kind="Delete" Foreground="#EF5350"
                                                                           Width="16" Height="16"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#4A1515"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5350"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Exemptions card -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Exemptions}" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="OV1_box"   Content="{DynamicResource ExemptFromAdditionalFeesAfterWorkingHours}" Style="{StaticResource CardCheckBox}"/>
                                <CheckBox Visibility="Collapsed" x:Name="OV_box" Content="{DynamicResource ExemptFromAdditionalFeesBeforeWorkingHours}" Style="{StaticResource CardCheckBox}"/>
                                <CheckBox x:Name="late_box"   Content="{DynamicResource ExemptFromDelay}"     Style="{StaticResource CardCheckBox}"/>
                                <CheckBox x:Name="absent_box" Content="{DynamicResource ExemptFromAbsence}"      Style="{StaticResource CardCheckBox}"/>
                                <CheckBox Visibility="Collapsed" x:Name="early_end" Content="{DynamicResource ExemptFromEarlyExit}" Style="{StaticResource CardCheckBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Status card -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TheCondition}" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="archive_check" Content="{DynamicResource Inactive}"
                                          Visibility="Collapsed" Style="{StaticResource CardCheckBox}"/>
                                <CheckBox x:Name="blacklist_check" Content="{DynamicResource BlackList}"
                                          Style="{StaticResource CardCheckBox}"
                                          Checked="blacklist_check_Checked"
                                          Unchecked="blacklist_check_Unchecked"/>
                                <TextBox x:Name="blacklist_notes_box"
                                         Tag="سبب الإضافة للقائمة السوداء"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,10,0,0" Height="72"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Archive link card -->
                        <Border Style="{StaticResource SectionCard}">
                            <Button Click="OpenArchive_Click"
                                    Background="#0D2233" BorderThickness="1" BorderBrush="#1E3040"
                                    Height="40" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Icon:PackIconMaterial Kind="ArchiveOutline" Width="16" Height="16"
                                                                       Foreground="{DynamicResource AccentColor}"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Archive}" Foreground="{DynamicResource ThirdColorBrushBrush}"
                                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0D3344"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                    </StackPanel>

                    <!-- ════ Right column: form sections ════ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ── Personal info ── -->
                        <Border Style="{StaticResource SectionCard}" Grid.Row="0">
                            <StackPanel>
                                <!-- Section header with icon -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Icon:PackIconMaterial Kind="AccountCircle" Width="16" Height="16"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource PersonalInformation}"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource HairlineSep}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBox x:Name="emplo_code_box"    Tag="كود الموظف"      Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <TextBox x:Name="emplo_name_box"    Tag="الاسم بالكامل"   Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <TextBox x:Name="emplo_card_box"    Tag="الرقم القومي"    Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <Label Content="{DynamicResource Qualification}" Style="{StaticResource FieldLabel}" Margin="0 10"/>
                                        <ComboBox x:Name="qualificationBox" SelectedValuePath="Id" DisplayMemberPath="Name"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBox x:Name="emplo_tele_box"    Tag="رقم الهاتف (واتساب)"            Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <TextBox x:Name="emplo_email_box"   Tag="البريد الإلكتروني"    Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <TextBox x:Name="emplo_address_box" Tag="العنوان"               Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <Label Content="{DynamicResource Accommodation}" Style="{StaticResource FieldLabel}" Margin="0 10"/>
                                        <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" x:Name="recidenceBox"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <Label Content="{DynamicResource DateOfBirth}" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="birth_date_picker" Style="{StaticResource ModernDatePicker}"/>
                                        
                                        
                                        <Label Content="{DynamicResource MaritalStatus}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id" x:Name="maritalBox"/>

                                        <!-- Gender pills -->
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                            <Border CornerRadius="20" Padding="14,6" Margin="0,0,8,0"
                                                    Background="{DynamicResource SurfaceLightColor}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                                                <RadioButton x:Name="male_box" Content="{DynamicResource Male}"
                                                             GroupName="Gender"
                                                             Foreground="{DynamicResource TextSecondaryColor}"
                                                             FontSize="13"/>
                                            </Border>
                                            <Border CornerRadius="20" Padding="14,6"
                                                    Background="{DynamicResource SurfaceLightColor}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                                                <RadioButton x:Name="female_box" Content="{DynamicResource Feminine}"
                                                             GroupName="Gender"
                                                             Foreground="{DynamicResource TextSecondaryColor}"
                                                             FontSize="13"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Job info ── -->
                        <Border Style="{StaticResource SectionCard}" Grid.Row="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Icon:PackIconMaterial Kind="Briefcase" Width="16" Height="16"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource FunctionalInformation}"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource HairlineSep}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="{DynamicResource TheAreaHeIsResponsibleFor}"   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="area_box" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource Branch}"   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="branch_box" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource Management}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="depart_box" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource Job}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="job_box" SelectionChanged="job_box_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <Label Content="{DynamicResource Sector}"         Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="degree_box"   Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource WorkSystem}"     Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="job_type_box" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource WeeklyVacation}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="week_holi_box"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <Label Content="{DynamicResource TheBoss}"             Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="manager_box" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource WorkStartDate}"   Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="emplo_date_picker" Style="{StaticResource ModernDatePicker}" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource WorkEndDate}" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="end_date_picker" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Shift / attendance info ── -->
                        <Border Style="{StaticResource SectionCard}" Grid.Row="2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Icon:PackIconMaterial Kind="ClockOutline" Width="16" Height="16"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource WorkingHoursInformation}"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource HairlineSep}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="{DynamicResource Rosary}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="shift_box" SelectionChanged="shift_changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <Label Content="{DynamicResource WorkingHours}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="work_hours_box" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                                    </StackPanel>

                                    <!-- Hidden break / holiday balance -->
                                    <StackPanel Visibility="Collapsed" Grid.Column="1" Margin="10,0,10,0">
                                        <Label Content="{DynamicResource Comfort}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="break_box" Margin="0,0,0,10"/>
                                        <TextBox Visibility="Collapsed" x:Name="holiday_balance_box" Tag="رصيد الإجازات" Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                    </StackPanel>

                                    <!-- Status checkboxes -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <Label Content="{DynamicResource EmploymentStatus}" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <CheckBox x:Name="user_check"     Content="{DynamicResource User4}"         Style="{StaticResource CardCheckBox}"/>
                                                <CheckBox x:Name="inDuty_check"   Content="{DynamicResource OnDuty}"      Style="{StaticResource CardCheckBox}"/>
                                                <CheckBox x:Name="employee_check" Content="{DynamicResource UnderEmployment}"    Style="{StaticResource CardCheckBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <CheckBox x:Name="userMobile_check" Content="{DynamicResource AndroidUser}"  Style="{StaticResource CardCheckBox}" IsChecked="False"/>
                                                <CheckBox x:Name="training_check"   Content="{DynamicResource UnderTraining}"     Style="{StaticResource CardCheckBox}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Driving info (conditionally visible) ── -->
                        <Border x:Name="driving_section" Style="{StaticResource SectionCard}"
                                Grid.Row="3" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Icon:PackIconMaterial Kind="Car" Width="16" Height="16"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource DrivingInformation}"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource HairlineSep}" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0">
                                        <Label Content="{DynamicResource ExpiryOfDrivingLicense}" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker Width="200" x:Name="driver_license_expiration"
                                                    Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <Label Content="{DynamicResource ExpiryOfVehicleLicense}" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker Width="200" x:Name="vehicle_license_expiration"
                                                    Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Additional info ── -->
                        <Border Style="{StaticResource SectionCard}" Grid.Row="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Icon:PackIconMaterial Kind="CardAccountDetails" Width="16" Height="16"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource AdditionalInformation}"
                                               Foreground="{DynamicResource AccentColor}"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource HairlineSep}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="{DynamicResource Insured}" Style="{DynamicResource FieldLabel}"/>
                                        <ComboBox x:Name="insuredComboBox"       Tag="مؤمن عليه"               DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,20,0,0"/>
                                        <TextBox  x:Name="ssn_box"               Tag="الرقم التأميني"          Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <TextBox  x:Name="health_insurance_box"  Tag="رقم التأمين الصحي"       Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                        <TextBox  x:Name="army_certificate_box"  Tag="رقم الشهادة العسكرية"    Style="{StaticResource ModernTextBox}" Margin="0,20,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Label Content="{DynamicResource CardExpires}"          Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="national_id_expiration"    Style="{StaticResource ModernDatePicker}" Margin="0,0,0,10"/>
                                        <Label Content="{DynamicResource ExpiryOfMilitaryCertificate}" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="army_certificate_expiration" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ════ Footer action bar ════ -->
            <Border Grid.Row="1" CornerRadius="0,0,15,15" Margin="5" Padding="10"
                    Background="{DynamicResource HeaderBackground}">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Save -->
                    <Button x:Name="saveBtn" Style="{StaticResource ActionButton}"
                            Click="Save_Click"
                            Background="#003A25" BorderBrush="#004D33" Foreground="#A5D6A7">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ContentSave" Width="15" Height="15"
                                                   Foreground="#66BB6A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center" Foreground="#66BB6A"/>
                        </StackPanel>
                    </Button>

                    <!-- Edit (collapsed by default) -->
                    <Button Visibility="Collapsed" Name="editBtn" Style="{StaticResource ActionButton}"
                            Click="edit_btn_Click"
                            Background="#3A2200" BorderBrush="#4D2E00" Foreground="#FFCC80">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Pencil" Width="15" Height="15"
                                                   Foreground="#FFA726" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Amendment}" VerticalAlignment="Center"  Foreground="#FFA726"/>
                        </StackPanel>
                    </Button>

                    <!-- Delete -->
                    <Button Style="{StaticResource ActionButton}" Click="Delete_Click"
                            Background="#3B1010" BorderBrush="#4A1515" Foreground="#EF9A9A">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Delete" Width="15" Height="15"
                                                   Foreground="#EF5350" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Delete}" VerticalAlignment="Center" Foreground="#EF5350"/>
                        </StackPanel>
                    </Button>

                    <!-- Search -->
                    <Button IsDefault="True" Style="{StaticResource ActionButton}" Click="search_btn_Click"
                            Background="#003343" BorderBrush="#004455" Foreground="{DynamicResource ThirdColorBrushBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15"
                                                   Foreground="{DynamicResource AccentColor}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Research}" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
                        </StackPanel>
                    </Button>

                    <!-- New / Clear -->
                    <Button Style="{StaticResource ActionButton}" Click="clear_btn_Click"
                            Background="{DynamicResource SurfaceLightColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            Foreground="{DynamicResource TextSecondaryColor}">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Refresh" Width="15" Height="15"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource New}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Navigation panel (collapsed) -->
                    <StackPanel Orientation="Horizontal" Name="employeesControlPanel" Visibility="Collapsed">

                        <!-- Thin divider -->
                        <Rectangle Width="1" Height="30" Margin="8,0"
                                   Fill="{DynamicResource BorderColor}" Opacity="0.5"/>

                        <Button Style="{StaticResource ActionButton}" Click="next_btn_Click"
                                Background="#1A3A00" BorderBrush="#234D00" Foreground="#C5E1A5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="SkipNext" Width="15" Height="15"
                                                       Foreground="#AED581" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource TheNext}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border CornerRadius="20" Padding="14,4" Margin="6,0"
                                Background="{DynamicResource SurfaceLightColor}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                            <TextBlock Name="currentIndexTxt" Text="0 / 0"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThirdColorBrushBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button Style="{StaticResource ActionButton}" Click="prev_btn_Click"
                                Background="#1A3A00" BorderBrush="#234D00" Foreground="#C5E1A5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource ThePrevious}" VerticalAlignment="Center"/>
                                <Icon:PackIconMaterial Kind="SkipPrevious" Width="15" Height="15"
                                                       Foreground="#AED581" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
