<Window x:Class="HR_Application.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="500" Width="650" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للسيده بار -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <!-- نمط للـ TabControl -->
        <Style x:Key="CustomTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- نمط للـ TabItem -->
        <Style x:Key="CustomTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10 10 0 0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#424242"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource MainBackgroundBrush}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="الإعدادات" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#1976D2" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- TabControl المحسن -->
            <TabControl Grid.Row="1" FlowDirection="RightToLeft" Margin="10">
                <TabItem Header="إعدادات الشهر">
                    <Grid>
                        <Border CornerRadius="20" Margin="10" Background="{StaticResource SidebarBrush}"  >
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- تفاصيل الشهر -->
                                <Label HorizontalAlignment="Center" Content="" Name="month_detail_txt" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="20"/>

                                <!-- حقول بداية ونهاية الشهر -->
                                <StackPanel Margin="20" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBox Tag="بداية الشهر" x:Name="begin_month" Margin="10"/>
                                    <TextBox Tag="نهاية الشهر" x:Name="end_month" Margin="10"/>
                                </StackPanel>

                                <!-- زر الحفظ -->
                                <Button Style="{StaticResource SaveButtonStyle}" HorizontalAlignment="Center" x:Name="save_month_btn" Click="save_month_btn_Click" Margin="20">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="التأخير والإضافي">
                    <Border CornerRadius="20" Margin="10" Background="{StaticResource SidebarBrush}"  >
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- RadioButtons -->
                            <GroupBox Foreground="White" Header="اعدادات حساب التأخير و الاضافي" Margin="5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <RadioButton Style="{StaticResource RadioButtonStyle}" Content="قيمة دقائق" Name="minuteBtn" IsChecked="True" Checked="minuteBtn_Checked"/>
                                    <RadioButton Style="{StaticResource RadioButtonStyle}" Content="قيمة مالية" Name="moneyBtn" Checked="moneyBtn_Checked"/>
                                </StackPanel>
                                
                            </GroupBox>

                            <GroupBox Margin="5" Foreground="White" Header="تكرار التأخير">
                                
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <TextBox Tag="عدد التكرار" x:Name="delay_repeat" Margin="10"/>
                                    <TextBox Tag="قيمة التأخير" x:Name="delay_value" Margin="10"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- زر الحفظ -->
                            <Button Style="{StaticResource SaveButtonStyle}" HorizontalAlignment="Center" x:Name="save_btn" Click="save_month_btn_Click" Margin="20">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>