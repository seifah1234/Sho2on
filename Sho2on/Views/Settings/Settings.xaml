<Window x:Class="HR_Application.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="800" Width="1050" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للسيده بار -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThirdColorBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <!-- نمط للـ TabControl -->
        <Style x:Key="CustomTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- نمط للـ TabItem -->
        <Style x:Key="CustomTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10 10 0 0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#424242"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource Settings2}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- TabControl المحسن -->
            <TabControl Grid.Row="1" FlowDirection="RightToLeft" Margin="10" Background="Transparent">
                <TabItem Background="Transparent" Header="{DynamicResource MonthSettings}">
                    <Grid>
                        <Border CornerRadius="20" Margin="10" Background="{DynamicResource PrimaryColor}"  >
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- تفاصيل الشهر -->
                                <Label HorizontalAlignment="Center" Content="" Name="month_detail_txt" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="20"/>

                                <!-- حقول بداية ونهاية الشهر -->
                                <StackPanel Margin="20" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBox Tag="{DynamicResource TagMonthStart}" x:Name="begin_month" Margin="10"/>
                                    <TextBox Tag="{DynamicResource TagMonthEnd}" x:Name="end_month" Margin="10"/>
                                </StackPanel>

                                <!-- زر الحفظ -->
                                <Button Style="{DynamicResource SaveButtonStyle}" HorizontalAlignment="Center" x:Name="save_month_btn" Click="save_month_btn_Click" Margin="20">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Background="Transparent" Header="{DynamicResource ProgramSettings}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="20" Margin="10" Background="{DynamicResource PrimaryColor}"  Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- تفاصيل الشهر -->
                                <Label HorizontalAlignment="Center" Content="" Name="logo_path_txt" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="20"/>

                                <!-- زر الحفظ -->
                                <Button Style="{DynamicResource SaveButtonStyle}" HorizontalAlignment="Center" x:Name="upload_logo_btn" Click="upload_logo_btn_Click" Margin="20">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="Upload" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="Upload" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>


                        <Border CornerRadius="20" Margin="10" Background="{DynamicResource PrimaryColor}" Grid.Column="0" Grid.Row="1">
                            <GroupBox Header="{DynamicResource Tasks}">
                                <CheckBox Content="{DynamicResource ShowAdministratorsToEveryone}" x:Name="officalsForAllBox" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="officalsForAllBox_Checked" Unchecked="officalsForAllBox_Unchecked"/>
                            </GroupBox>

                        </Border>


                        <Border CornerRadius="20" Margin="10" Background="{DynamicResource PrimaryColor}" 
        Grid.Column="1" Grid.Row="0">
                            <ScrollViewer>
                                <StackPanel Orientation="Vertical" Margin="15">
                                    <TextBlock Text="{DynamicResource Colors}" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                       FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0 0 0 15"/>
                                    <!-- Primary Color -->
                                    <Label Content="{DynamicResource PrimaryColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas Background="Transparent"
UsingAlphaChannel="False"
SelectedColor="{Binding PrimaryColor, Mode=TwoWay}"/>
                                    <!-- Text Color -->
                                    <Label Content="{DynamicResource TextPrimaryColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas Background="Transparent"
UsingAlphaChannel="False"
SelectedColor="{Binding TextPrimaryColor, Mode=TwoWay}"/>

                                    <Label Content="{DynamicResource SecondaryColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas Background="Transparent"
UsingAlphaChannel="False"
SelectedColor="{Binding SecondaryColor, Mode=TwoWay}"/>
                                    <Label Content="{DynamicResource TextSecondaryColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas Background="Transparent"
UsingAlphaChannel="False"
SelectedColor="{Binding TextSecondaryColor, Mode=TwoWay}"/>
                                    <!-- Accent Color -->
                                    <Label Content="{DynamicResource AccentColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas x:Name="accentColorCanvas"
UsingAlphaChannel="False"
SelectedColor="{Binding AccentColor, Mode=TwoWay}"/>


                                    <Label Content="{DynamicResource ThirdColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas Background="Transparent"
UsingAlphaChannel="False"
SelectedColor="{Binding ThirdColor, Mode=TwoWay}"/>


                                    <!-- Sidebar Color -->
                                    <Label Content="{DynamicResource SideBarColorTxt}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    <xctk:ColorCanvas Background="Transparent"
                                        
UsingAlphaChannel="False"
SelectedColor="{Binding SidebarColor, Mode=TwoWay}"/>


                                    <!-- Save Button -->
                                    <Button x:Name="saveColors_btn" 
                    Click="SaveColors_Click"
                                            Margin="10"
                    Style="{DynamicResource SaveButtonStyle}"
                    HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Palette" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{DynamicResource SaveColors}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                    </Grid>
                </TabItem>


                <TabItem Background="Transparent" Header="{DynamicResource CompanyData}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="20" Margin="10" Background="{DynamicResource PrimaryColor}"  >
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- تفاصيل الشهر -->
                                <TextBox Tag="{DynamicResource TagCompanyName}" x:Name="company_name_txt" Margin="10"/>
                                <!-- زر الحفظ -->
                                <Button Style="{DynamicResource SaveButtonStyle}" HorizontalAlignment="Center" x:Name="save_company_Btn" Click="save_company_Btn_Click" Margin="20">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </TabItem>


            </TabControl>
        </Grid>
    </Border>
</Window>