<Window x:Class="HR_Application.AddShift"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Height="500" Width="700" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="Window_Loaded"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للسيده بار -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource ShiftData}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- الجانب الأيمن: نموذج الإدخال -->
            <Border Grid.Row="1" Grid.Column="1" CornerRadius="20 0 0 20" Background="{DynamicResource BorderColor}"  >
                <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="280">
                    <!-- Time Picker للوقت من -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource From}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>

                        <materialDesign:TimePicker Name="fromTimePicker" Width="100" Height="30"
                                                   BorderThickness="1"
                                                   Padding="3"
                                                   HorizontalAlignment="Center"
                                                   Margin="10"
                                                   VerticalContentAlignment="Center"
                                                   BorderBrush="{DynamicResource SecondaryColor}"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   Background="{DynamicResource SecondaryColor}"/>
                    </StackPanel>

                    <!-- Time Picker للوقت إلى -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 10 5 0" HorizontalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{DynamicResource To2}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThirdColorBrushBrush}"/>

                        <materialDesign:TimePicker Name="toTimePicker" Width="100" Height="30"
                                                   BorderThickness="1"
                                                   Padding="3"
                                                   HorizontalAlignment="Center"
                                                   Margin="10"
                                                   VerticalContentAlignment="Center"
                                                   BorderBrush="{DynamicResource SecondaryColor}"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   Background="{DynamicResource SecondaryColor}"/>

                    </StackPanel>

                    <UniformGrid Margin="10" HorizontalAlignment="Center" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <Button BorderThickness="2" x:Name="saveBtn" BorderBrush="{DynamicResource ThirdColorBrush}" Background="Transparent" Height="40" Width="100" Margin="5" Click="save_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" >
                                    <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{DynamicResource ThirdColorBrushBrush}" Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="editBtn" Visibility="Collapsed"  BorderThickness="2" BorderBrush="{DynamicResource ThirdColorBrush}" Background="Transparent" Height="40" Width="100" Margin="5" Click="edit_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource Amendment}" Foreground="{DynamicResource ThirdColorBrushBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button BorderThickness="2" BorderBrush="{DynamicResource ThirdColorBrush}" Background="Transparent" Width="100" Margin="5" Height="40" Click="exit_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{DynamicResource ThirdColorBrushBrush}" Text="{DynamicResource Exit}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="deleteBtn" Visibility="Collapsed" BorderThickness="2" BorderBrush="{DynamicResource ThirdColorBrush}" Background="Transparent" Width="100" Margin="5" Height="40" Click="delete_Btn" >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{DynamicResource ThirdColorBrushBrush}" Text="{DynamicResource Delete}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="clearBtn" BorderThickness="2" BorderBrush="{DynamicResource ThirdColorBrush}" Background="Transparent" Width="100" Margin="5" Height="40" Click="clearBtn_Click" >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{DynamicResource ThirdColorBrushBrush}" Text="{DynamicResource New}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </UniformGrid>

                </StackPanel>
            </Border>

            <!-- الجانب الأيسر: قائمة الورديات -->
            <Border Grid.Row="1" Grid.Column="0" CornerRadius="0 20 20 0" Opacity="0.95"   Margin="20">
                <ListView FlowDirection="LeftToRight" 
                          Margin="10" 
                          SelectionChanged="list_SelectionChanged"
                          x:Name="list" 
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Background="Transparent" 
                          BorderBrush="#1976D2" 
                          BorderThickness="1" >
                    <!-- تحسين مظهر العناصر في ListView -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#424242"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>
        </Grid>
    </Border>
</Window>