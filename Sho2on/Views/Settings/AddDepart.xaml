<Window x:Class="HR_Application.AddDepart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:uc="clr-namespace:HR_Application.UserControls"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Height="450" Width="600" MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen" 
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>



        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource SecondaryColor}"  >
        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock 
                    Text="بيانات الادارات" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Foreground="{StaticResource PrimaryColor}" 
                         
                    Grid.ColumnSpan="2"/>



            <Border Grid.Row="1" Grid.Column="1" CornerRadius="20 0 0 20" Background="{DynamicResource HeaderBackground}"  >
              
                    <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBox 
                            x:Name="name_box" 
                            Margin="0 20 0 20" 
                            Tag="اسم الادارة" 
                             Width="250" 
                             Height="40" 
                             FlowDirection="RightToLeft" 
                             HorizontalAlignment="Center" 
                             FontSize="14" 
                             Padding="10" 
                             BorderThickness="2"/>

                    <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button BorderThickness="2" BorderBrush="{StaticResource ThirdColor}" Background="Transparent" Height="40" Width="100" Margin="5" Click="edit_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="تعديل" Foreground="{StaticResource ThirdColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button BorderThickness="2" BorderBrush="{StaticResource ThirdColor}" Background="Transparent" Height="40" Width="100" Margin="5" Click="save_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" >
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{StaticResource ThirdColor}" Text="حفظ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        </StackPanel>
                        <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button BorderThickness="2" BorderBrush="{StaticResource ThirdColor}" Background="Transparent" Width="100" Margin="5" Height="40" Click="exit_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{StaticResource ThirdColor}" Text="خروج" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button BorderThickness="2" BorderBrush="{StaticResource ThirdColor}" Background="Transparent" Width="100" Margin="5" Height="40" Click="delete_Btn" >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{StaticResource ThirdColor}" Text="حذف" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            <Border Grid.Row="1" Grid.Column="0" CornerRadius="0 20 20 0" Opacity="0.95"   Margin="20">
                
                    <ListView x:Name="list" 
          FlowDirection="RightToLeft"
          SelectionChanged="list_SelectionChanged"
          DisplayMemberPath="Name"
          Margin="10"
          Background="Transparent"
          BorderBrush="#1976D2"
          BorderThickness="1">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="#424242"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="#1976D2"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
        </Grid>
        </Border>
</Window>
