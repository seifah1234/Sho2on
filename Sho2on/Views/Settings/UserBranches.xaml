<Window x:Class="HR_Application.UserBranches"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HR_Application"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="UserBranches" Height="500" Width="650" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم العلوي -->
        <LinearGradientBrush x:Key="TopSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للزر -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ThirdColorBrushBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ ComboBox -->
        <Style x:Key="UserComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للـ CheckBox في DataGrid -->
        <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource BranchPermissions}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Grid.Row="1" CornerRadius="0 0 20 20" Background="{DynamicResource PrimaryColor}"  >
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                    <!-- زر الحفظ المحسن -->
                        <Button Style="{DynamicResource SaveButtonStyle}" IsDefault="True" x:Name="save_btn" Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    <!-- ComboBox والـ Label المحسنين -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="10">
                        <ComboBox DisplayMemberPath="FullName" SelectedValuePath="Id" x:Name="userComboBox" SelectionChanged="UserComboBox_SelectionChanged"/>
                        <Label Content="{DynamicResource User2}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="SemiBold" Margin="10 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="2" Margin="20" CornerRadius="10" Opacity="0.95"  >
                <DataGrid Name="dataTable" AutoGenerateColumns="False" FlowDirection="RightToLeft" ItemsSource="{Binding BranchesList}" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Branch}" Binding="{Binding Name}" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{DynamicResource DataGridCheckBoxStyle}">
                            <DataGridCheckBoxColumn.Header>
                                <CheckBox Name="All_check" Checked="All_check_Checked" Unchecked="All_check_Unchecked" Style="{DynamicResource DataGridCheckBoxStyle}"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>