<Window x:Class="HR_Application.AddHoliType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:uc="clr-namespace:HR_Application.UserControls"
xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
Height="450" Width="600" MinHeight="450" MinWidth="600" WindowStartupLocation="CenterScreen" Background="Transparent">
   
    <Border CornerRadius="15" Background="{StaticResource MainBackgroundBrush}"  >
        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


            <TextBlock 
     Text="أنواع الاجازات" 
     HorizontalAlignment="Center" 
     VerticalAlignment="Center" 
     FontSize="20" 
     FontWeight="Bold" 
     Foreground="{StaticResource PrimaryColor}" 
          
     Grid.ColumnSpan="2"/>

            <Border Grid.Row="1" Grid.Column="1" CornerRadius="20 0 0 20" Background="{StaticResource HeaderBackground}"  >

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" >
                        <TextBox x:Name="name_box" Margin="0 10 0 10" Tag="البيان" FlowDirection="RightToLeft" Width="200" HorizontalAlignment="Center"/>


                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Orientation="Horizontal">
                        <Button BorderThickness="2" Background="Transparent" BorderBrush="{StaticResource ThirdColor}" Height="45"  Width="110" Margin="5" Click="edit_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="Pencil" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{StaticResource ThirdColor}" Text="تعديل" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button BorderThickness="2" Background="Transparent" BorderBrush="{StaticResource ThirdColor}" Height="45"  Width="110" Margin="5" Click="save_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="حفظ" Foreground="{StaticResource ThirdColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        </StackPanel>
                        <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button BorderThickness="2" Background="Transparent" BorderBrush="{StaticResource ThirdColor}" Width="110" Margin="5" Height="45" Click="exit_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{StaticResource ThirdColor}" Text="خروج" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button BorderThickness="2" Background="Transparent" BorderBrush="{StaticResource ThirdColor}"  Width="110" Margin="5" Height="45" Click="delete_Btn">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="Delete" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{StaticResource ThirdColor}" Text="حذف" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" CornerRadius="0 20 20 0" Opacity="0.95"   Margin="20">

                    <ListView x:Name="list" 
FlowDirection="RightToLeft"
SelectionChanged="list_SelectedIndexChanged"
DisplayMemberPath="Name"
Margin="10"
Background="Transparent"
BorderBrush="#1976D2"
BorderThickness="1">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="#424242"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="#1976D2"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
            </Grid>
        </Border>
</Window>
