<Window x:Class="HR_Application.Views.CompanyDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة ملفات الشركة" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="WhiteSmoke">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock Text="إدارة ملفات الشركة" Foreground="White" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Documents List -->
            <Border FlowDirection="RightToLeft" Grid.Column="0" Background="White" CornerRadius="5" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="categoryFilter" Width="150" Margin="0,0,10,0"
                                  SelectionChanged="categoryFilter_SelectionChanged"
                                  ToolTip="فلترة حسب التصنيف"/>

                        <ComboBox x:Name="jobTitleFilterComboBox" Width="180" Margin="0,0,10,0"
                                  SelectionChanged="jobTitleFilterComboBox_SelectionChanged"
                                  ToolTip="فلترة حسب الوظيفة"
                                  Visibility="Collapsed"/>

                        <Button x:Name="clearJobTitleFilter" Content="🗙" 
                                Click="clearJobTitleFilter_Click" Width="30" Height="30"
                                ToolTip="مسح فلتر الوظيفة"
                                Visibility="Collapsed"
                                Background="#95a5a6" Foreground="White"/>

                        <CheckBox VerticalAlignment="Center" x:Name="activeOnlyCheck" Content="الملفات النشطة فقط" 
                                  Checked="activeOnlyCheck_Changed" 
                                  Unchecked="activeOnlyCheck_Changed"/>
                    </StackPanel>

                    <!-- Documents DataGrid -->
                    <DataGrid x:Name="documentsGrid" Grid.Row="1" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="documentsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="200"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="الوظيفة" Binding="{Binding JobTitle.Name}" Width="150"/>
                            <DataGridCheckBoxColumn Header="مطلوب" Binding="{Binding IsRequired}" Width="60"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                            <DataGridTextColumn Header="تاريخ الرفع" Binding="{Binding UploadDate, StringFormat=yyyy/MM/dd}" Width="120"/>
                            <DataGridTemplateColumn Header="الإجراءات" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="معاينة" 
                                                Click="previewBtn_Click" 
                                                Background="#3498db" 
                                                Foreground="White" 
                                                Padding="8,2"
                                                FontSize="11"
                                                Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Actions Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="10">
                <ScrollViewer>
                    
                    <StackPanel>
                    <TextBlock Text="إجراءات الملفات" FontWeight="Bold" FontSize="14" 
                               Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <!-- Upload Section -->
                    <GroupBox Header="رفع ملف جديد" Margin="0,0,0,10" FlowDirection="RightToLeft">
                        <StackPanel>
                            <TextBlock Text="عنوان الملف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox x:Name="titleBox" Margin="0,0,0,5"/>

                            <TextBlock Text="التصنيف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <ComboBox x:Name="categoryBox" Margin="0,0,0,5"
                                      SelectionChanged="categoryBox_SelectionChanged"/>

                            <!-- Job Title Section (يظهر فقط لـ Job Description) -->
                            <StackPanel x:Name="jobTitleSection" Visibility="Collapsed" Margin="0,0,0,5">
                                <TextBlock Text="الوظيفة المرفوعة لها" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <ComboBox x:Name="jobTitleComboBox" 
                                          ToolTip="اختر الوظيفة المرتبطة بملف وصف الوظيفة"/>
                                <TextBlock Text="ملاحظة: هذا الحقل إلزامي لملفات وصف الوظيفة" 
                                           FontSize="10" Foreground="Gray" FontStyle="Italic"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Text="الوصف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox x:Name="descriptionBox" Height="60" TextWrapping="Wrap" Margin="0,0,0,5"/>

                            <CheckBox x:Name="isRequiredCheck" Content="مطلوب للتوقيع" Margin="0,0,0,5"/>

                            <Button x:Name="browseBtn" Content="اختر الملف" 
                                    Click="browseBtn_Click" Margin="0,5,0,5"/>
                            <TextBlock x:Name="selectedFileText" TextWrapping="Wrap" 
                                       FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

                            <Button x:Name="uploadBtn" Content="رفع الملف" 
                                    Click="uploadBtn_Click" Background="#27ae60" 
                                    Foreground="White" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Document Actions -->
                    <GroupBox Header="إجراءات على الملف المحدد" FlowDirection="RightToLeft">
                        <StackPanel>
                            <Button x:Name="previewBtn" Content="معاينة الملف" 
                                    Click="previewBtn_Click" Background="#3498db" 
                                    Foreground="White" Margin="0,0,0,5"/>
                            <Button x:Name="downloadBtn" Content="تحميل الملف" 
                                    Click="downloadBtn_Click" Background="#2980b9" 
                                    Foreground="White" Margin="0,0,0,5"/>
                            <Button x:Name="toggleActiveBtn" Content="تفعيل/تعطيل" 
                                    Click="toggleActiveBtn_Click" Background="#f39c12" 
                                    Foreground="White" Margin="0,0,0,5"/>
                            <Button x:Name="deleteBtn" Content="حذف الملف" 
                                    Click="deleteBtn_Click" Background="#e74c3c" 
                                    Foreground="White" Margin="0,0,0,5"/>
                            <Button x:Name="viewSignaturesBtn" Content="عرض التوقيعات" 
                                    Click="viewSignaturesBtn_Click" Background="#9b59b6" 
                                    Foreground="White" Margin="0,0,0,5"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" FlowDirection="RightToLeft" Background="#34495e" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="جاهز"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>