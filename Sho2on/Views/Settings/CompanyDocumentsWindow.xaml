<Window x:Class="HR_Application.Views.CompanyDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة ملفات الشركة" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        xmlns:local="clr-namespace:HR_Application.Views"
        Loaded="Window_Loaded"
        Background="{DynamicResource InputBackground}">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Folder Header Style -->
        <Style x:Key="FolderHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0A500"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- File Row Style -->
        <Style x:Key="FileRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#22000000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock Text="إدارة ملفات الشركة" Foreground="{DynamicResource ThirdColor}" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="{DynamicResource InputBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Documents Folders Panel -->
            <Border FlowDirection="RightToLeft" Grid.Column="0"
                    Background="{DynamicResource HeaderBackground}"
                    CornerRadius="5" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="categoryFilter" Width="150" Margin="0,0,10,0"
                                  SelectionChanged="categoryFilter_SelectionChanged"
                                  ToolTip="فلترة حسب التصنيف"/>

                        <ComboBox x:Name="jobTitleFilterComboBox" Width="180" Margin="0,0,10,0"
                                  SelectionChanged="jobTitleFilterComboBox_SelectionChanged"
                                  ToolTip="فلترة حسب الوظيفة"
                                  Visibility="Collapsed"/>

                        <Button x:Name="clearJobTitleFilter" Content="🗙"
                                Click="clearJobTitleFilter_Click" Width="30" Height="30"
                                ToolTip="مسح فلتر الوظيفة"
                                Visibility="Collapsed"
                                Background="#95a5a6" Foreground="White"/>

                        <CheckBox VerticalAlignment="Center" x:Name="activeOnlyCheck"
                                  Content="الملفات النشطة فقط"
                                  Checked="activeOnlyCheck_Changed"
                                  Unchecked="activeOnlyCheck_Changed"/>
                    </StackPanel>

                    <!-- Folders ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="foldersPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Single Folder -->
                                    <Border Margin="0,0,0,10" CornerRadius="6"
                                            BorderThickness="1" BorderBrush="#33000000">
                                        <StackPanel>

                                            <!-- Folder Header (clickable to expand/collapse) -->
                                            <Border Style="{StaticResource FolderHeaderStyle}"
                                                    MouseLeftButtonUp="FolderHeader_Click"
                                                    Tag="{Binding CategoryName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Folder Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="📁" FontSize="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>

                                                    <!-- Category Name -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CategoryName}"
                                                               FontWeight="Bold" FontSize="14"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Count Badge -->
                                                    <Border Grid.Column="2"
                                                            Background="#CC000000"
                                                            CornerRadius="10"
                                                            Padding="7,2"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CountText}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Expand/Collapse Arrow -->
                                                    <TextBlock Grid.Column="3"
                                                               x:Name="arrowIndicator"
                                                               Text="{Binding ArrowText}"
                                                               Foreground="White"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Files List inside folder -->
                                            <Border x:Name="filesContainer"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#F9F9F9"
                                                    CornerRadius="0,0,6,6">
                                                <ItemsControl ItemsSource="{Binding Documents}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource FileRowStyle}"
                                                                    MouseLeftButtonUp="FileRow_Click"
                                                                    Tag="{Binding Id}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- File Type Icon -->
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding FileIcon}"
                                                                               FontSize="16"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,8,0"/>

                                                                    <!-- Title + Job Title -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="12"
                                                                                   Foreground="#222"/>
                                                                        <TextBlock Text="{Binding JobTitle.Name}"
                                                                                   FontSize="10"
                                                                                   Foreground="#888"
                                                                                   Visibility="{Binding HasJobTitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    </StackPanel>

                                                                    <!-- Required Badge -->
                                                                    <Border Grid.Column="2"
                                                                            Background="#e74c3c"
                                                                            CornerRadius="3"
                                                                            Padding="4,1"
                                                                            Margin="4,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="مطلوب" Foreground="White" FontSize="9"/>
                                                                    </Border>

                                                                    <!-- Active/Inactive Badge -->
                                                                    <Border Grid.Column="3"
                                                                            CornerRadius="3"
                                                                            Padding="4,1"
                                                                            Margin="4,0"
                                                                            VerticalAlignment="Center"
                                                                            Background="{Binding ActiveColor}">
                                                                        <TextBlock Text="{Binding ActiveText}"
                                                                                   Foreground="White"
                                                                                   FontSize="9"/>
                                                                    </Border>

                                                                    <!-- Date -->
                                                                    <TextBlock Grid.Column="4"
                                                                               Text="{Binding UploadDate, StringFormat=yyyy/MM/dd}"
                                                                               FontSize="10"
                                                                               Foreground="#aaa"
                                                                               VerticalAlignment="Center"
                                                                               Margin="4,0"/>

                                                                    <!-- Preview Button -->
                                                                    <Button Grid.Column="5"
                                                                            Content="معاينة"
                                                                            Click="previewBtn_Click"
                                                                            Background="#3498db"
                                                                            Foreground="White"
                                                                            Padding="6,2"
                                                                            FontSize="10"
                                                                            Margin="2,0"
                                                                            VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Actions Panel (unchanged) -->
            <Border Grid.Column="1" Background="{DynamicResource HeaderBackground}" CornerRadius="5" Padding="10">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="إجراءات الملفات" FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <!-- Upload Section -->
                        <GroupBox Header="رفع ملف جديد" Margin="0,0,0,10" FlowDirection="RightToLeft">
                            <StackPanel>
                                <TextBlock Text="عنوان الملف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBox x:Name="titleBox" Margin="0,0,0,5"/>

                                <TextBlock Text="التصنيف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <ComboBox x:Name="categoryBox" Margin="0,0,0,5"
                                          SelectionChanged="categoryBox_SelectionChanged"/>

                                <StackPanel x:Name="jobTitleSection" Visibility="Collapsed" Margin="0,0,0,5">
                                    <TextBlock Text="الوظيفة المرفوعة لها" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="jobTitleComboBox"
                                              ToolTip="اختر الوظيفة المرتبطة بملف وصف الوظيفة"/>
                                    <TextBlock Text="ملاحظة: هذا الحقل إلزامي لملفات وصف الوظيفة"
                                               FontSize="10" Foreground="Gray" FontStyle="Italic"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Text="الوصف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBox x:Name="descriptionBox" Height="60" TextWrapping="Wrap" Margin="0,0,0,5"/>

                                <CheckBox x:Name="isRequiredCheck" Content="مطلوب للتوقيع" Margin="0,0,0,5"/>

                                <Button x:Name="browseBtn" Content="اختر الملف"
                                        Click="browseBtn_Click" Margin="0,5,0,5"/>
                                <TextBlock x:Name="selectedFileText" TextWrapping="Wrap"
                                           FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>

                                <Button x:Name="uploadBtn" Content="رفع الملف"
                                        Click="uploadBtn_Click" Background="#27ae60"
                                        Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Document Actions -->
                        <GroupBox Header="إجراءات على الملف المحدد" FlowDirection="RightToLeft">
                            <StackPanel>
                                <Button x:Name="previewBtn" Content="معاينة الملف"
                                        Click="previewBtn_Click" Background="#3498db"
                                        Foreground="White" Margin="0,0,0,5"/>
                                <Button x:Name="downloadBtn" Content="تحميل الملف"
                                        Click="downloadBtn_Click" Background="#2980b9"
                                        Foreground="White" Margin="0,0,0,5"/>
                                <Button x:Name="toggleActiveBtn" Content="تفعيل/تعطيل"
                                        Click="toggleActiveBtn_Click" Background="#f39c12"
                                        Foreground="White" Margin="0,0,0,5"/>
                                <Button x:Name="deleteBtn" Content="حذف الملف"
                                        Click="deleteBtn_Click" Background="#e74c3c"
                                        Foreground="White" Margin="0,0,0,5"/>
                                <Button x:Name="viewSignaturesBtn" Content="عرض التوقيعات"
                                        Click="viewSignaturesBtn_Click" Background="#9b59b6"
                                        Foreground="White" Margin="0,0,0,5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" FlowDirection="RightToLeft"
                   Background="{DynamicResource PrimaryColor}"
                   Foreground="{DynamicResource ThirdColor}">
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="جاهز"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
