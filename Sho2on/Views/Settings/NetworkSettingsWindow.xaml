<Window x:Class="HR_Application.Views.Settings.NetworkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NetworkAndStorageSettings}" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource InputBackground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource FileStorageSettings}" Foreground="{DynamicResource ThirdColorBrushBrush}" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- المحتوى -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- قسم المسار الشبكي -->
                <GroupBox Header="{DynamicResource CentralRetinalPath}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CentralServerPath}" 
                                   FontWeight="SemiBold" Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="networkPathTextBox" Grid.Column="0"
                                     FlowDirection="LeftToRight"
                                     Text="\\SERVER\HR_Documents" Width="300"
                                     ToolTip="{DynamicResource EnterTheNetworkPathToTheCentralServer}"/>

                            <Button x:Name="testNetworkBtn" Grid.Column="1" 
                                    Content="{DynamicResource ConnectionTest}" Margin="5,0,0,0"
                                    Click="testNetworkBtn_Click"/>
                        </Grid>

                        <TextBlock x:Name="networkStatusText" Margin="0,5,0,0"
                                   FontSize="11" TextWrapping="Wrap"/>

                        <!-- خيارات سريعة -->
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="btnLocalIP" Content="{DynamicResource UseLocalIp}" 
                                    Click="btnLocalIP_Click" Margin="0,0,5,5"
                                    ToolTip="{DynamicResource UseTheCurrentDeviceIp}"/>
                            <Button x:Name="btnServerName" Content="{DynamicResource UseTheServerName}" 
                                    Click="btnServerName_Click" Margin="0,0,5,5"
                                    ToolTip="{DynamicResource UseServerHrDocuments}"/>
                            <Button x:Name="btnLocalPath" Content="{DynamicResource LocalPath}" 
                                    Click="btnLocalPath_Click"
                                    ToolTip="{DynamicResource UseALocalFolder}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- قسم اختبار الاتصال -->
                <GroupBox Header="{DynamicResource ConnectionTest}" Margin="0,0,0,10">
                    <StackPanel>
                        <Button x:Name="pingTestBtn" Content="{DynamicResource PingTestForTheServer}" 
                                Click="pingTestBtn_Click" Margin="0,0,0,5"/>

                        <Button x:Name="shareTestBtn" Content="{DynamicResource TestFolderSharing}" 
                                Click="shareTestBtn_Click" Margin="0,0,0,5"/>

                        <Button x:Name="permissionTestBtn" Content="{DynamicResource AuthorityTesting}" 
                                Click="permissionTestBtn_Click"/>

                        <Border x:Name="testResultsBorder" Margin="0,10,0,0" 
                                Background="#f8f9fa" Padding="10" CornerRadius="5"
                                Visibility="Collapsed">
                            <TextBlock x:Name="testResultsText" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- قسم الإحصائيات -->
                <GroupBox Header="{DynamicResource StorageStatistics}" Margin="0,0,0,10">
                    <StackPanel>
                        <Button x:Name="loadStatsBtn" Content="{DynamicResource DownloadStatistics}" 
                                Click="loadStatsBtn_Click" Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource CurrentPath}" Grid.Column="0" 
                                       FontWeight="SemiBold" Margin="0,0,5,0"/>
                            <TextBlock x:Name="currentPathText" Grid.Column="1" 
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource AvailableSpace}" Grid.Column="0" 
                                       FontWeight="SemiBold" Margin="0,0,5,0"/>
                            <TextBlock x:Name="freeSpaceText" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource ConnectionStatus}" Grid.Column="0" 
                                       FontWeight="SemiBold" Margin="0,0,5,0"/>
                            <TextBlock x:Name="connectionStatusText" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- قسم التهيئة -->
                <GroupBox Header="{DynamicResource SystemInitialization}" Margin="0,0,0,10">
                    <StackPanel>
                        <Button x:Name="initFoldersBtn" Content="{DynamicResource CreateStructuredFolders}" 
                                Click="initFoldersBtn_Click" Margin="0,0,0,5"
                                ToolTip="{DynamicResource CreateAllRequiredFolders}"/>

                        <Button x:Name="migrateFilesBtn" Content="{DynamicResource TransferExistingFiles}" 
                                Click="migrateFilesBtn_Click"
                                ToolTip="{DynamicResource MoveFilesFromLocalPathToCentralPath}"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- أزرار التحكم -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" Padding="10" CornerRadius="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="saveBtn" Content="{DynamicResource SaveSettings}" 
                        Click="saveBtn_Click" Background="#27ae60" 
                        Foreground="White" Padding="15,5" Margin="0,0,10,0"/>

                <Button x:Name="cancelBtn" Content="{DynamicResource Cancellation}" 
                        Click="cancelBtn_Click" Background="#95a5a6" 
                        Foreground="White" Padding="15,5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>