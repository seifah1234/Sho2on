<Window x:Class="HR_Application.DataLoad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="580" Width="900" MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource InputBackground}">

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم السفلي -->
        <LinearGradientBrush x:Key="BottomSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>

        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="DarkRed"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- نمط للأزرار الثانوية -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ThirdColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- نمط للـ CheckBox -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- نمط للـ TextBlock -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThirdColor}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- نمط للـ GroupBox -->
        <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource ThirdColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThirdColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource InputBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="تحميل بيانات" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم السفلي المحسن -->
            <Border CornerRadius="10" Background="{DynamicResource PrimaryColor}" Margin="5" Grid.Row="2"  >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- قسم إعدادات التحميل -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">

                        <!-- GroupBox للإعدادات -->
                        <GroupBox FlowDirection="RightToLeft" Style="{DynamicResource SettingsGroupBoxStyle}" Header="إعدادات التحميل">
                            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center">

                                <!-- تاريخ البدء -->
                                <StackPanel Orientation="Vertical" Margin="10,0">
                                    <TextBlock Text="تاريخ البدء:" Style="{DynamicResource LabelStyle}"/>
                                    <DatePicker x:Name="startDatePicker" 
                                                SelectedDateFormat="Short"/>
                                </StackPanel>



                                <!-- زر تحميل بيانات الفرع -->
                                <Button Style="{DynamicResource SecondaryButtonStyle}" 
                                Width="180" 
                                Margin="10,5" 
                                Click="LoadBranch_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="Download" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="تحميل بيانات الفرع" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}"/>
                                    </StackPanel>
                                </Button>

                                <!-- زر الخروج -->
                                <Button Style="{DynamicResource ActionButtonStyle}" 
                                Width="180" 
                                Margin="10,5" 
                                Click="exit_Clicked">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="خروج" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </GroupBox>

                      

                    </StackPanel>

                    <!-- أزرار التحكم -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Vertical" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">

                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="1" Margin="5"  Opacity="0.95"  >
                <DataGrid
                          AutoGenerateColumns="False" 
                          FlowDirection="RightToLeft" 
                          Margin="10" 
                          x:Name="list"
                          SelectionChanged="list_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="#" Width="30" Binding="{Binding RowNumber}"/>
                        <DataGridTextColumn IsReadOnly="True" Header="كود الفرع" Width="80" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="اسم الفرع" IsReadOnly="True" Width="150" Binding="{Binding Branch}"/>
                        <DataGridTextColumn Header="Machine IP" Width="120" IsReadOnly="True" Binding="{Binding MIP}"/>
                        <DataGridTextColumn Header="Server IP" Width="120" IsReadOnly="True" Binding="{Binding SIP}"/>
                        <DataGridTextColumn Header="تاريخ آخر تحميل" Width="120" IsReadOnly="True" Binding="{Binding LastLoadDate, StringFormat=yyyy/MM/dd}"/>
                        <DataGridTextColumn Header="عدد السجلات" Width="80" IsReadOnly="True" Binding="{Binding RecordCount}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- الصورة المتحركة المحسنة -->
            <Image x:Name="loadingProgressBar" 
                   Source="pack://application:,,,/assets/images/loading.png" 
                   Grid.Row="1"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Width="0" 
                   Height="0"
                    >
                <Image.RenderTransform>
                    <RotateTransform x:Name="rotateTransform" CenterX="25" CenterY="25"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Image.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                 Storyboard.TargetName="rotateTransform" 
                                 Storyboard.TargetProperty="Angle" 
                                 From="0" 
                                 To="350" 
                                 Duration="0:0:1"
                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
        </Grid>
    </Border>
</Window>