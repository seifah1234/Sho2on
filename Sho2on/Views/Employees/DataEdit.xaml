<Window x:Class="HR_Application.DataEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:design="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="600" Width="1300" MinHeight="500" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        Background="Transparent"
        >

    <Window.Resources>
        <!-- تدرج لوني للخلفية الرئيسية -->
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
        <!-- تدرج للقسم العلوي -->
        <LinearGradientBrush x:Key="TopSectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="1"/>
        </LinearGradientBrush>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideInputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ThirdColorBrushBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ RadioButton -->
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource WindowRootBackground}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="{DynamicResource ModifyData}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryColor}" 
                         
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Grid.Row="1" CornerRadius="0 0 20 20" Background="{DynamicResource PrimaryColor}"  >
                <Grid>
                    <Image Visibility="Collapsed" Name="GIFTop" Source="pack://application:,,,/assets/images/Top.gif" Stretch="UniformToFill" Opacity="0.3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <!-- الفلاتر الرئيسية -->
                        <StackPanel FlowDirection="LeftToRight" Orientation="Vertical" HorizontalAlignment="Center" Margin="10 20">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="5">
                                        <DatePicker Width="150" Language="en-GB" Name="from_picker" FlowDirection="RightToLeft"/>
                                        <Label Content="{DynamicResource From2}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}" Margin="10 0 0 0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="5">
                                        <DatePicker Width="150" Language="en-GB" Name="to_picker" FlowDirection="RightToLeft"/>
                                        <Label Content="{DynamicResource To3}" FlowDirection="RightToLeft" Foreground="{DynamicResource ThirdColorBrushBrush}" Margin="10 0 0 0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="5 0 0 5">
                                            <TextBox Visibility="Collapsed" Style="{DynamicResource InputFieldStyle}" Name="job_box" Margin="5"/>
                                            <!--<TextBox Width="250" Name="name_box" Tag="اسم الموظف" FlowDirection="RightToLeft" Margin="5"/>-->
                                            <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                                                <ComboBox Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" SelectedValuePath="Code" DisplayMemberPath="FullName" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>
                                                <Label Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold" Content="{DynamicResource EmployeeName}" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                            </StackPanel>
                                            <TextBox Name="code_box" Tag="كود الموظف" FlowDirection="RightToLeft" Margin="5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel FlowDirection="RightToLeft" VerticalAlignment="Center" Orientation="Horizontal" Margin="0 0 10 0">
                                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Label VerticalAlignment="Center" Content="{DynamicResource Branch}" Foreground="{DynamicResource ThirdColorBrushBrush}" HorizontalAlignment="Center"/>
                                            <ComboBox FlowDirection="LeftToRight" Name="branch_box" Margin="5 0 0 0"/>
                                        </StackPanel>
                                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Label VerticalAlignment="Center" Content="{DynamicResource Sunnah}" Foreground="{DynamicResource ThirdColorBrushBrush}" HorizontalAlignment="Center"/>
                                            <ComboBox FlowDirection="LeftToRight" Name="year_box" Margin="5 0 0 0"/>
                                        </StackPanel>
                                        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Label VerticalAlignment="Center" Content="{DynamicResource Month}" Foreground="{DynamicResource ThirdColorBrushBrush}" HorizontalAlignment="Center"/>
                                            <ComboBox FlowDirection="LeftToRight" Name="month_box" Margin="5 0 0 0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- الأزرار الرئيسية -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Button Style="{DynamicResource ActionButtonStyle}" IsDefault="True" x:Name="data_load_btn" Click="data_load_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Eye" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource DisplayData}" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource ActionButtonStyle}" x:Name="save_btn" Click="save_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource Save}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- الأزرار الإضافية -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Button Style="{DynamicResource ActionButtonStyle}" x:Name="add_btn" Click="add_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource Addition}" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource ActionButtonStyle}" x:Name="get_btn" Click="get_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Download" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Foreground="{DynamicResource PrimaryColor}" Text="{DynamicResource ToWithdraw}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- الأزرار الثانوية -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10 0">
                            <Button Style="{DynamicResource ActionButtonStyle}" Background="#D32F2F" x:Name="delete_btn" Click="exit_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Delete" VerticalAlignment="Center" Foreground="{DynamicResource ThirdColorBrushBrush}" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource Delete}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource ActionButtonStyle}" Background="#D32F2F" x:Name="deleteDuplicate_btn" Click="deleteDuplicate_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="DeleteSweep" Foreground="{DynamicResource ThirdColorBrushBrush}" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource DeleteDuplicate}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- الأزرار الأخيرة -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5 0">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="excel_btn" Click="excel_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="FileExcel" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryColor}" Margin="0 0 5 0"/>
                                    <TextBlock Text="Excel" Foreground="{DynamicResource SecondaryColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SecondaryButtonStyle}" x:Name="night_btn" Click="night_btn_Click" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="WeatherNight" Foreground="{DynamicResource SecondaryColor}" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{DynamicResource EveningShift}" Foreground="{DynamicResource SecondaryColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- الـ add_print_grid المحسن -->
            <Grid x:Name="add_print_grid" Grid.Row="2" Visibility="Collapsed">
                <Border Background="#FFFFFF" Opacity="0.95" CornerRadius="10"   Margin="20">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <design:TimePicker Name="time_picker" VerticalAlignment="Center" Margin="5" Background="Black" Foreground="Black" BorderBrush="Black" BorderThickness="1" Padding="2" FontSize="12"/>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="5">
                                <DatePicker Style="{DynamicResource DatePickerStyle}" VerticalAlignment="Center" Language="en-GB" Name="add_date_picker" FlowDirection="RightToLeft"/>
                                <Label Content="{DynamicResource TheDate2}" FlowDirection="RightToLeft" Foreground="#424242" Margin="10 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton Style="{DynamicResource RadioButtonStyle}" Content="{DynamicResource Departure}" Name="dep_radio"/>
                            <RadioButton Style="{DynamicResource RadioButtonStyle}" IsChecked="True" Content="{DynamicResource Presence}" Name="att_radio"/>
                        </StackPanel>
                        <Button Style="{DynamicResource ActionButtonStyle}" x:Name="add_print_btn" Click="add_print_btn_Click" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                <TextBlock Text="{DynamicResource Addition}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="2" Opacity="0.95" Margin="20">
                <DataGrid LoadingRow="list_LoadingRow" KeyDown="list_KeyDown" SelectionUnit="FullRow" Visibility="Visible" FlowDirection="RightToLeft" AutoGenerateColumns="False" Name="list" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" CanUserResize="False" Width="50" Header="{DynamicResource M}" Binding="{Binding rowNumber}"/>
                        <DataGridTextColumn CanUserSort="False" IsReadOnly="True" CanUserResize="False" Width="130" Header="{DynamicResource TheDate}" Binding="{Binding date}"/>
                        <DataGridTemplateColumn CanUserSort="False" CanUserResize="False" Header="{DynamicResource EditDate}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource PrimaryColor}" Text="{Binding dateEdit, StringFormat=HH:mm:ss}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Height="25" Foreground="{DynamicResource PrimaryColor}" Margin="0" Width="130" Text="{Binding dateEdit, StringFormat=dd/MM/yyyy HH:mm:ss, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn CanUserSort="False" Header="{DynamicResource TheCondition}" Width="100" CanUserResize="False" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding status}" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding statusNo}" Value="0">
                                                        <Setter Property="Background" Value="Red"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding statusNo}" Value="1">
                                                        <Setter Property="Background" Value="Green"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Requests}" Width="100" CanUserResize="False" IsReadOnly="True" Binding="{Binding procedures}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Branch}" Width="100" CanUserResize="False" IsReadOnly="True" Binding="{Binding branch}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Today}" Width="100" CanUserResize="False" IsReadOnly="True" Binding="{Binding day}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource User}" Width="100" CanUserResize="False" IsReadOnly="True" Binding="{Binding user}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>