<Window x:Class="HR_Application.Views.Employees.Holidays.LeaveDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:HR_Application.Views.Employees.Holidays"
        mc:Ignorable="d"
        Title="تفاصيل طلب الإجازة" 
        FlowDirection="RightToLeft"
        Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- نمط البطاقات -->
        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- نمط التسميات -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- نمط القيم -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- محول للحالة -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>

        <!-- محول للتاريخ -->
        <local:DateTimeToPersianConverter x:Key="DateTimeToPersianConverter"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الهيدر -->
        <Border Grid.Row="0" Background="#1976D2" Padding="20">
            <StackPanel>
                <TextBlock Text="تفاصيل طلب الإجازة" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="رقم الطلب:" 
                               Foreground="White" 
                               FontWeight="SemiBold"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtRequestId" 
                               Text="" 
                               Foreground="White" 
                               FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- المحتوى -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- معلومات الموظف -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="Account" 
                                                  Foreground="#1976D2" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="معلومات الموظف" 
                                       Foreground="#1976D2" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="كود الموظف" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtEmployeeId" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="اسم الموظف" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtEmployeeName" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="الإدارة" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtDepartment" Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="الفرع" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtBranch" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="تاريخ التعيين" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtHireDate" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="الإجازة الأسبوعية" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtWeekend" Style="{StaticResource ValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- معلومات الإجازة -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="Calendar" 
                                                  Foreground="#4CAF50" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="معلومات الإجازة" 
                                       Foreground="#4CAF50" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع الإجازة" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtLeaveType" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="من تاريخ" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtStartDate" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="المدة (أيام)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtDuration" Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="تاريخ الطلب" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtRequestDate" Style="{StaticResource ValueStyle}"/>
                                
                                <TextBlock Text="إلى تاريخ" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtEndDate" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="التأثير على الرصيد" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="txtBalanceEffect" Style="{StaticResource ValueStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- السبب -->
                        <TextBlock Text="سبب الإجازة" Style="{StaticResource LabelStyle}" Margin="0,10,0,10"/>
                        <Border Background="#F8F9FA" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                            <TextBlock x:Name="txtReason" 
                                       Foreground="#333333" 
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- حالة الطلب -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="ClipboardCheck" 
                                                  Foreground="#FF9800" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="حالة الطلب" 
                                       Foreground="#FF9800" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- مؤشر الحالة -->
                            <Border Grid.Column="0" 
                                    Width="100" Height="35" 
                                    CornerRadius="5" 
                                    Margin="0,0,15,0">
                                <Border.Background>
                                    <Binding Path="StatusId" Converter="{StaticResource StatusToColorConverter}"/>
                                </Border.Background>
                                <TextBlock x:Name="txtStatus" 
                                           Text="" 
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="تاريخ الموافقة/الرفض" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="txtApprovalDate" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Text="تمت الموافقة بواسطة" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="txtApprovedBy" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="سبب الرفض" Style="{StaticResource LabelStyle}"/>
                                        <Border Background="#FFF3E0" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtRejectionReason" 
                                                       Foreground="#E65100" 
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- معلومات الرصيد -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="Calculator" 
                                                  Foreground="#9C27B0" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="معلومات الرصيد" 
                                       Foreground="#9C27B0" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- الرصيد الكلي -->
                            <Border Grid.Column="0" 
                                    Background="#E8F5E8" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="5">
                                <StackPanel>
                                    <TextBlock Text="الرصيد الكلي" 
                                               Foreground="#2E7D32" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalBalance" 
                                               Text="0 يوم" 
                                               Foreground="#2E7D32" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- المستخدم -->
                            <Border Grid.Column="1" 
                                    Background="#FFEBEE" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="5">
                                <StackPanel>
                                    <TextBlock Text="المستخدم" 
                                               Foreground="#C62828" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtUsedBalance" 
                                               Text="0 يوم" 
                                               Foreground="#C62828" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- المتبقي -->
                            <Border Grid.Column="2" 
                                    Background="#E3F2FD" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="5">
                                <StackPanel>
                                    <TextBlock Text="المتبقي" 
                                               Foreground="#1565C0" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtRemainingBalance" 
                                               Text="0 يوم" 
                                               Foreground="#1565C0" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ملاحظات -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="NoteText" 
                                                  Foreground="#607D8B" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="ملاحظات" 
                                       Foreground="#607D8B" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Border Background="#F8F9FA" CornerRadius="5" Padding="15">
                            <TextBlock x:Name="txtNotes" 
                                       Foreground="#666666" 
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderThickness="1,0,0,0" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnPrint" 
                        Width="120" Height="40" 
                        Background="#2196F3" 
                        Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Click="btnPrint_Click"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Printer" Width="18" Height="18" Margin="0,0,5,0"/>
                        <TextBlock Text="طباعة"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnClose" 
                        Width="100" Height="40" 
                        Background="#757575" 
                        Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Click="btnClose_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Close" Width="18" Height="18" Margin="0,0,5,0"/>
                        <TextBlock Text="إغلاق"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>