<Window x:Class="HR_Application.Views.Employees.Holidays.LeaveDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:HR_Application.Views.Employees.Holidays"
        mc:Ignorable="d"
        Title="{DynamicResource LeaveRequestDetails}" 
        FlowDirection="RightToLeft"
        Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SecondaryColor}"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- نمط البطاقات -->
        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- نمط التسميات -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- نمط القيم -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- محول للحالة -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>

        <!-- محول للتاريخ -->
        <local:DateTimeToPersianConverter x:Key="DateTimeToPersianConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowRootBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الهيدر -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="20">
            <StackPanel>
                <TextBlock Text="{DynamicResource LeaveRequestDetails}" 
                           Foreground="{DynamicResource ThirdColorBrushBrush}" 
                           FontSize="20" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource OrderNumber}" 
                               Foreground="{DynamicResource ThirdColorBrushBrush}" 
                               FontWeight="SemiBold"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtRequestId" 
                               Text="" 
                               Foreground="White" 
                               FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- المحتوى -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="20">
            <StackPanel>
                <!-- معلومات الموظف -->
                <Border Style="{DynamicResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="Account" 
                                                  Foreground="#1976D2" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource EmployeeInformation}" 
                                       Foreground="#1976D2" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource EmployeeCode}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtEmployeeId" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource EmployeeName}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtEmployeeName" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource Management}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtDepartment" Style="{DynamicResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Branch}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtBranch" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource AppointmentDate}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtHireDate" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource WeeklyVacation}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtWeekend" Style="{DynamicResource ValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- معلومات الإجازة -->
                <Border Style="{DynamicResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="Calendar" 
                                                  Foreground="#4CAF50" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource LeaveInformation}" 
                                       Foreground="#4CAF50" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource LeaveType2}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtLeaveType" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource FromDate}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtStartDate" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource DurationDays}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtDuration" Style="{DynamicResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="{DynamicResource OrderDate}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtRequestDate" Style="{DynamicResource ValueStyle}"/>
                                
                                <TextBlock Text="{DynamicResource ToDate}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtEndDate" Style="{DynamicResource ValueStyle}"/>

                                <TextBlock Text="{DynamicResource ImpactOnBalance}" Style="{DynamicResource LabelStyle}"/>
                                <TextBlock x:Name="txtBalanceEffect" Style="{DynamicResource ValueStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- السبب -->
                        <TextBlock Text="{DynamicResource ReasonForLeave}" Style="{DynamicResource LabelStyle}" Margin="0,10,0,10"/>
                        <Border Background="#F8F9FA" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                            <TextBlock x:Name="txtReason" 
                                       Foreground="#333333" 
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- حالة الطلب -->
                <Border Style="{DynamicResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="ClipboardCheck" 
                                                  Foreground="#FF9800" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource OrderStatus}" 
                                       Foreground="#FF9800" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- مؤشر الحالة -->
                            <Border Grid.Column="0" 
                                    Width="100" Height="35" 
                                    CornerRadius="5" 
                                    Margin="0,0,15,0">
                                <Border.Background>
                                    <Binding Path="StatusId" Converter="{DynamicResource StatusToColorConverter}"/>
                                </Border.Background>
                                <TextBlock x:Name="txtStatus" 
                                           Text="" 
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource DateOfApprovalRejection}" Style="{DynamicResource LabelStyle}"/>
                                        <TextBlock x:Name="txtApprovalDate" Style="{DynamicResource ValueStyle}"/>

                                        <TextBlock Text="{DynamicResource ApprovedBy}" Style="{DynamicResource LabelStyle}"/>
                                        <TextBlock x:Name="txtApprovedBy" Style="{DynamicResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource ReasonForRejection}" Style="{DynamicResource LabelStyle}"/>
                                        <Border Background="#FFF3E0" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtRejectionReason" 
                                                       Foreground="#E65100" 
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- معلومات الرصيد -->
                <Border Style="{DynamicResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="Calculator" 
                                                  Foreground="#9C27B0" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource BalanceInformation}" 
                                       Foreground="#9C27B0" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- الرصيد الكلي -->
                            <Border Grid.Column="0" 
                                    Background="#E8F5E8" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource TotalBalance2}" 
                                               Foreground="#2E7D32" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalBalance" 
                                               Text="{DynamicResource 0Days}" 
                                               Foreground="#2E7D32" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- المستخدم -->
                            <Border Grid.Column="1" 
                                    Background="#FFEBEE" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource User}" 
                                               Foreground="#C62828" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtUsedBalance" 
                                               Text="{DynamicResource 0Days}" 
                                               Foreground="#C62828" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- المتبقي -->
                            <Border Grid.Column="2" 
                                    Background="#E3F2FD" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Residual}" 
                                               Foreground="#1565C0" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtRemainingBalance" 
                                               Text="{DynamicResource 0Days}" 
                                               Foreground="#1565C0" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ملاحظات -->
                <Border Style="{DynamicResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Icon:PackIconMaterial Kind="NoteText" 
                                                  Foreground="#607D8B" 
                                                  Width="24" Height="24"
                                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Comments}" 
                                       Foreground="#607D8B" 
                                       FontSize="16" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Border Background="#F8F9FA" CornerRadius="5" Padding="15">
                            <TextBlock x:Name="txtNotes" 
                                       Foreground="#666666" 
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2" Padding="15" BorderThickness="1,0,0,0" Background="{DynamicResource PrimaryColor}" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnPrint" 
                        Width="120" Height="40" 
                        Background="#2196F3" 
                        Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Click="btnPrint_Click"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="Printer" Width="18" Height="18" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource Print}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnClose" 
                        Width="100" Height="40" 
                        Background="#757575" 
                        Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Click="btnClose_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Close" Foreground="{DynamicResource ThirdColorBrushBrush}" Width="18" Height="18" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource Closing}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>