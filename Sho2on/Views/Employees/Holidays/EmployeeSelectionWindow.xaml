<Window x:Class="HR_Application.Views.Employees.Holidays.EmployeeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختر موظف" Height="600" Width="900"
        xmlns:local="clr-namespace:HR_Application.Views.Employees.Holidays"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        FlowDirection="RightToLeft" Background="{DynamicResource WindowRootBackground}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- نمط للنافذة -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource SecondaryColor}"/>
        </Style>

        <!-- نمط للأزرار -->
        <Style x:Key="SelectButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock x:Name="txtTitle" Grid.Row="0" 
                   Text="اختر موظف" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource TextPrimaryColor}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- شريط البحث -->
        <StackPanel Grid.Row="1" FlowDirection="RightToLeft" Background="{DynamicResource PrimaryColor}" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="بحث:" 
                       VerticalAlignment="Center" 
                       Margin="10" Foreground="{DynamicResource ThirdColor}"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="txtSearch" 
                     Width="300" 
                     VerticalAlignment="Center"
                     Height="30" 
                     Padding="5"
                     Margin="20"
                     TextChanged="txtSearch_TextChanged"/>
            <TextBlock x:Name="txtNoResults" 
                       Text="لا توجد نتائج" 
                       Foreground="Red" 
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- جدول الموظفين -->
        <DataGrid x:Name="dgEmployees" 
                  Grid.Row="2" 
                  MouseDoubleClick="dgEmployees_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="كود الموظف" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="اسم الموظف" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding JobTitle.Name}" Width="150"/>
                <DataGridTextColumn Header="الإدارة" Binding="{Binding Department.Name}" Width="150"/>
                <DataGridTextColumn Header="الفرع" Binding="{Binding Branch.Name}" Width="120"/>
                <DataGridCheckBoxColumn Header="مدير" Binding="{Binding IsManager}" Width="60"/>
                <DataGridTextColumn Header="حالة الحساب" Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="IsActive">
                            <Binding.Converter>
                                <local:BoolToActiveStatusConverter/>
                            </Binding.Converter>
                        </Binding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- أزرار التحكم -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,0">
            <Button x:Name="btnSelect" 
                    Style="{DynamicResource SelectButtonStyle}" 
                    Content="اختيار" 
                    Click="btnSelect_Click"/>
            <Button x:Name="btnCancel" 
                    Style="{DynamicResource CancelButtonStyle}" 
                    Content="إلغاء" 
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>