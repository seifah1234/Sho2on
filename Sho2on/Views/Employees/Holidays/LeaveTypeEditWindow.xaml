<Window x:Class="HR_Application.Views.Employees.Holidays.LeaveTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="{DynamicResource LeaveType}" 
        Height="600" Width="500"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- نمط النص -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- نمط الحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط CheckBox -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- نمط أزرار الإجراء -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource InputBackground}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- العنوان -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Icon:PackIconMaterial Kind="FileDocumentEdit" 
                                          Foreground="{DynamicResource TextPrimaryColor}" 
                                          Width="24" Height="24"
                                          Margin="0,0,10,0"/>
                    <TextBlock x:Name="windowTitle" 
                               Text="{DynamicResource NewLeaveType}" 
                               Foreground="{DynamicResource TextPrimaryColor}" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- محتوى النموذج -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- معلومات أساسية -->
                    <Border Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource BasicInformation}" 
                                       FontSize="16" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,15"/>

                            <!-- الاسم -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="{DynamicResource LeaveTypeName}" Style="{DynamicResource LabelStyle}"/>
                                <TextBox x:Name="txtName" 
                                         Style="{DynamicResource InputFieldStyle}"
                                         MaxLength="100"/>
                            </StackPanel>

                            <!-- الكود -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="{DynamicResource TypeCode}" Style="{DynamicResource LabelStyle}"/>
                                <TextBox x:Name="txtCode" 
                                         Style="{DynamicResource InputFieldStyle}"
                                         MaxLength="10"/>
                            </StackPanel>

                            <!-- الرصيد الافتراضي -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="{DynamicResource DefaultBalanceDays}" Style="{DynamicResource LabelStyle}"/>
                                <TextBox x:Name="txtDefaultBalance" 
                                         Style="{DynamicResource InputFieldStyle}"
                                         Text="0"
                                         PreviewTextInput="NumberValidationTextBox"/>
                            </StackPanel>

                            <!-- الحد الأقصى للأيام المتتالية -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="{DynamicResource MaximumConsecutiveDays}" Style="{DynamicResource LabelStyle}"/>
                                <TextBox x:Name="txtMaxConsecutiveDays" 
                                         Style="{DynamicResource InputFieldStyle}"
                                         Text="0"
                                         PreviewTextInput="NumberValidationTextBox"
                                         ToolTip="{DynamicResource 0MeansNoLimit}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- الإعدادات -->
                    <Border Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TypeSettings}" 
                                       FontSize="16" FontWeight="Bold" 
                                       Foreground="#1976D2" Margin="0,0,0,15"/>

                            <!-- CheckBoxes -->
                            <StackPanel>
                                <CheckBox x:Name="chkIsActive" 
                                          Content="{DynamicResource Active}" 
                                          Style="{DynamicResource CheckBoxStyle}"
                                          IsChecked="True"/>

                                <CheckBox x:Name="chkDeductFromBalance" 
                                          Content="{DynamicResource DeductedFromTheBalance}" 
                                          Style="{DynamicResource CheckBoxStyle}"
                                          IsChecked="True"/>

                                <CheckBox x:Name="chkRequiresApproval" 
                                          Content="{DynamicResource RequiresAdministratorApproval}" 
                                          Style="{DynamicResource CheckBoxStyle}"
                                          IsChecked="True"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- الملاحظات -->
                    <Border Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Comments}" 
                                       FontSize="16" FontWeight="Bold" 
                                       Foreground="#1976D2" Margin="0,0,0,15"/>

                            <TextBox x:Name="txtNotes" 
                                     Height="100" 
                                     Style="{DynamicResource InputFieldStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- الأزرار -->
            <Border Grid.Row="2" Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnSave" 
                            Style="{DynamicResource ActionButtonStyle}"
                            Background="#4CAF50" 
                            Foreground="White"
                            Click="btnSave_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Icon:PackIconMaterial Kind="ContentSave" Width="20" Height="20" Foreground="{DynamicResource ThirdColorBrushBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Save}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnCancel" 
                            Style="{DynamicResource ActionButtonStyle}"
                            Background="#F44336" 
                            Foreground="White"
                            Click="btnCancel_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Icon:PackIconMaterial Kind="Close" Width="20" Height="20" Foreground="{DynamicResource ThirdColorBrushBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Cancellation}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>