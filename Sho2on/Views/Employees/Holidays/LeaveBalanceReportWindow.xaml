<Window x:Class="HR_Application.Views.Employees.Holidays.LeaveBalanceReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="تقرير رصيد الإجازات" 
        Height="800" Width="1200"
        WindowState="Maximized"
        Background="{DynamicResource WindowRootBackground}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Grid.Row="0" Text="تقرير رصيد الإجازات" 
                   FontSize="18" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- الفلاتر -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="كود الموظف" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColor}"/>
                    <TextBox x:Name="txtEmployeeId" Width="120" Foreground="{DynamicResource ThirdColor}"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="اسم الموظف" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColor}"/>
                    <TextBox x:Name="txtEmployeeName" Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="5">
                    <TextBlock Text="الإدارة" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColor}"/>
                    <ComboBox x:Name="cmbDepartment" Width="150" VerticalAlignment="Bottom" Height="30"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="5" VerticalAlignment="Bottom">
                    <Button x:Name="btnSearch" Content="بحث" Width="80" Height="30" Click="btnSearch_Click" Background="{DynamicResource ButtonHoverBackground}" Foreground="{DynamicResource ButtonHoverForeground}"/>
                </StackPanel>

            </StackPanel>
                <Label Name="statusTxt" Content="يتم تحميل البيانات..." Foreground="{DynamicResource ThirdColor}" HorizontalAlignment="Center" FontSize="14" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- تقرير رصيد الإجازات باستخدام ItemsControl -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="itemsReport">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,5" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- معلومات الموظف -->
                                <Border Grid.Column="0" BorderBrush="{DynamicResource SecondaryColor}" BorderThickness="2" Background="{DynamicResource PrimaryColor}" Width="250" Padding="10" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThirdColor}"/>
                                        <TextBlock Text="{Binding EmployeeId, StringFormat='كود: {0}'}" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,5"/>
                                        <TextBlock Text="{Binding DepartmentName, StringFormat='الإدارة: {0}'}" Foreground="{DynamicResource TextPrimaryColor}"/>
                                    </StackPanel>
                                </Border>

                                <!-- أنواع الإجازات -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding LeaveBalances}" Margin="10,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#007ACC" BorderThickness="1" 
                                                    CornerRadius="5" Margin="5" Padding="10" 
                                                    Width="250" Background="{DynamicResource PrimaryColor}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- اسم نوع الإجازة -->
                                                    <TextBlock Grid.Row="0" 
                                                               Text="{Binding LeaveTypeName}" 
                                                               FontWeight="Bold" 
                                                               Foreground="#007ACC"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,5"/>

                                                    <!-- تفاصيل الرصيد -->
                                                    <StackPanel Grid.Row="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock>
                                                                    <Run Text="المجموع:" FontWeight="Bold"/>
                                                                    <Run Text="{Binding Total}"/>
                                                                </TextBlock>
                                                                <TextBlock>
                                                                    <Run Text="المستخدم:" FontWeight="Bold"/>
                                                                    <Run Text="{Binding Used}"/>
                                                                </TextBlock>
                                                                <TextBlock>
                                                                    <Run Text="المتبقي:" FontWeight="Bold"/>
                                                                    <Run Text="{Binding Remaining, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>


                                                        </Grid>

                                                        <!-- نسبة الاستخدام -->
                                                        <TextBlock Text="{Binding UsedPercentage, StringFormat='{}{0}% مستخدم'}" 
                                                                   FontSize="11" 
                                                                   Foreground="#666"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- أزرار التصدير والإغلاق -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Visibility="Collapsed" x:Name="btnExport" Content="📊 تصدير إلى Excel" Width="140" Height="35" Margin="5" Click="btnExport_Click" Background="#28A745" Foreground="White"/>
            <Button Visibility="Collapsed" x:Name="btnPrint" Content="🖨️ طباعة" Width="100" Height="35" Margin="5" Click="btnPrint_Click" Background="#007ACC" Foreground="White"/>
            <Button x:Name="btnClose" Content="❌ إغلاق" Width="100" Height="35" Margin="5" Click="btnClose_Click" Background="#DC3545" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>