<Window x:Class="HR_Application.Views.Employees.Holidays.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة الطباعة" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <DockPanel>
        <!-- شريط الأدوات -->
        <ToolBarTray DockPanel.Dock="Top" Background="WhiteSmoke">
            <ToolBar>
                <Button x:Name="btnPrint" Content="🖨️ طباعة" 
                        Click="btnPrint_Click" Padding="10,5" Margin="5"/>
                <Separator/>
                <Button x:Name="btnClose" Content="❌ إغلاق" 
                        Click="btnClose_Click" Padding="10,5" Margin="5"/>
            </ToolBar>
        </ToolBarTray>

        <!-- DocumentViewer -->
        <DocumentViewer x:Name="DocumentViewer">
            <DocumentViewer.Resources>
                <!-- تخصيص مظهر DocumentViewer -->
                <Style TargetType="DocumentViewer">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </DocumentViewer.Resources>
        </DocumentViewer>
    </DockPanel>
</Window>