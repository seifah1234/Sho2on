<Window x:Class="HR_Application.Views.Employees.Holidays.LeavePrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="خيارات الطباعة" 
        FlowDirection="RightToLeft"
        Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="#F5F5F5" Padding="20">
        <StackPanel>
            <TextBlock Text="اختر خيار الطباعة:" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="#1976D2"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <StackPanel>
                <!-- طباعة مباشرة -->
                <Button x:Name="btnPrint" 
                        Click="btnPrint_Click"
                        Height="50" 
                        Margin="0,0,0,10"
                        Background="#2196F3"
                        BorderThickness="0"
                        BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Printer" 
                                              Foreground="White" 
                                              Width="24" Height="24"
                                              Margin="0,0,10,0"/>
                        <TextBlock Text="طباعة مباشرة على الطابعة" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>


                <!-- معاينة قبل الطباعة -->
                <Button x:Name="btnPreview" 
                        Click="btnPreview_Click"
                        Height="50" 
                        Margin="0,0,0,10"
                        Background="#FF9800"
                        BorderThickness="0"
                        BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Eye" 
                                              Foreground="White" 
                                              Width="24" Height="24"
                                              Margin="0,0,10,0"/>
                        <TextBlock Text="معاينة قبل الطباعة" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- إلغاء -->
                <Button x:Name="btnCancel" 
                        Click="btnCancel_Click"
                        Height="40" 
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="#757575">
                    <TextBlock Text="إلغاء" 
                               Foreground="#757575" 
                               FontSize="13"
                               FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>