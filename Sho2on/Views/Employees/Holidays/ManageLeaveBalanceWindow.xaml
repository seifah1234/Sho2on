<Window x:Class="HR_Application.Views.Employees.Holidays.ManageLeaveBalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:HR_Application.Views.Employees.Holidays"
        mc:Ignorable="d"
        Title="{DynamicResource ManagingLeaveBalance}" 
        FlowDirection="RightToLeft"
        Height="700" Width="1000"
        Loaded="Window_Loaded"
        WindowState="Maximized"
        Background="{DynamicResource WindowRootBackground}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- نمط للأرقام -->
        <Style x:Key="NumericTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, 
                        Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="LightPink"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- محول للون الرصيد -->
        <local:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Grid.Row="0" Text="{DynamicResource ManagingLeaveBalance}" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{DynamicResource TextPrimaryColor}"
                   Margin="0,0,0,20"/>

        <!-- شريط البحث -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- كود الموظف -->
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="{DynamicResource EmployeeCode}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                    <TextBox x:Name="txtSearchEmployeeId" Width="120" Height="30" Padding="5,0"/>
                </StackPanel>

                <!-- اسم الموظف -->
                <StackPanel FlowDirection="RightToLeft" Orientation="Vertical">
                    <Label Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold" Content="{DynamicResource EmployeeName}" VerticalAlignment="Center" Margin="10 0 0 0"/>
                    <ComboBox Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" SelectedValuePath="Code" DisplayMemberPath="FullName" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>
                </StackPanel>

                <!-- أزرار البحث -->
                <StackPanel Orientation="Vertical" Margin="10" VerticalAlignment="Bottom">
                    <Button x:Name="btnSearch" Content="{DynamicResource Research}" 
                            Width="80" Height="30" 
                            Background="{DynamicResource ButtonHoverBackground}" Foreground="{DynamicResource ButtonHoverForeground}"
                            Click="btnSearch_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- معلومات الموظف -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- معلومات الموظف المختار -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Icon:PackIconMaterial Grid.Column="0" 
                                              Kind="AccountCircle" 
                                              Foreground="{DynamicResource ThirdColorBrushBrush}" 
                                              Width="40" Height="40"
                                              Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="txtEmployeeInfo" 
                                       Text="{DynamicResource NoEmployeeHasBeenSelected}" 
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                            <TextBlock x:Name="txtEmployeeDetails" 
                                       Text="{DynamicResource PleaseSearchForAnEmployee}" 
                                       FontSize="12"
                                       Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                x:Name="btnClearSelection" 
                                Content="{DynamicResource CancelSelection}"
                                Width="100" Height="30"
                                Background="#F44336" Foreground="White"
                                Click="btnClearSelection_Click"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- جدول رصيد الإجازات -->
                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource LeaveBalance}" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryColor}"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgLeaveBalances" 
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              RowHeight="40"
                              HeadersVisibility="Column"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <!-- نوع الإجازة -->
                            <DataGridTextColumn Header="{DynamicResource LeaveType2}" 
                                                Binding="{Binding LeaveTypeName}" 
                                                Width="150" IsReadOnly="True"/>

                            <!-- الكود -->
                            <DataGridTextColumn Header="{DynamicResource Code}" 
                                                Binding="{Binding LeaveTypeCode}" 
                                                Width="80" IsReadOnly="True"/>

                            <!-- الرصيد الكلي -->
                            <DataGridTemplateColumn Header="{DynamicResource TotalBalance2}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TotalBalance, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource NumericTextBox}"
                                                 PreviewTextInput="NumberValidationTextBox"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المستخدم -->
                            <DataGridTextColumn Header="{DynamicResource User}" 
                                                Binding="{Binding UsedBalance}" 
                                                Width="80" IsReadOnly="True"/>

                            <!-- المتبقي -->
                            <DataGridTemplateColumn Header="{DynamicResource Residual}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RemainingBalance}" 
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BalanceToColorConverter}">
                                                    <Binding Path="RemainingBalance"/>
                                                    <Binding Path="TotalBalance"/>
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- آخر تحديث -->
                            <DataGridTextColumn Header="{DynamicResource LatestUpdate}" 
                                                Binding="{Binding UpdatedAt, StringFormat='yyyy/MM/dd'}" 
                                                Width="100" IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ملاحظات عامة -->
                <Border Grid.Row="2" Visibility="Collapsed" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource GeneralNotes}" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtGeneralNotes" 
                                 Height="60" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- الأزرار -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="{DynamicResource SaveModifications}" 
                    Width="120" Height="40"
                    Background="{DynamicResource ButtonHoverBackground}" Foreground="{DynamicResource ButtonHoverForeground}"
                    FontSize="14" FontWeight="Bold"
                    Click="btnSave_Click">
            </Button>

            <Button x:Name="btnReset" Content="{DynamicResource Reset2}" 
                    Width="120" Height="40"
                    Background="{DynamicResource ButtonHoverBackground}" Foreground="{DynamicResource ButtonHoverForeground}"
                    FontSize="14" FontWeight="Bold"
                    Click="btnReset_Click"
                    Margin="20,0,0,0">
            </Button>

            <Button x:Name="btnClose" Content="{DynamicResource Closing}" 
                    Width="100" Height="40"
                    Background="#757575" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Click="btnClose_Click"
                    Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>