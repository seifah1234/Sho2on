<Window x:Class="HR_Application.Views.Employees.Holidays.ManageLeaveBalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:HR_Application.Views.Employees.Holidays"
        mc:Ignorable="d"
        Title="إدارة رصيد الإجازات" 
        FlowDirection="RightToLeft"
        Height="700" Width="1000"
        Background="{StaticResource SecondaryColor}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- نمط للأرقام -->
        <Style x:Key="NumericTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, 
                        Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="LightPink"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- محول للون الرصيد -->
        <local:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Grid.Row="0" Text="إدارة رصيد الإجازات" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource PrimaryColor}"
                   Margin="0,0,0,20"/>

        <!-- شريط البحث -->
        <Border Grid.Row="1" Background="{StaticResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- كود الموظف -->
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="كود الموظف" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource ThirdColor}"/>
                    <TextBox x:Name="txtSearchEmployeeId" Width="120" Height="30" Padding="5"/>
                </StackPanel>

                <!-- اسم الموظف -->
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="اسم الموظف" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource ThirdColor}"/>
                    <TextBox x:Name="txtSearchEmployeeName" Width="200" Height="30" Padding="5"/>
                </StackPanel>

                <!-- أزرار البحث -->
                <StackPanel Orientation="Vertical" Margin="10" VerticalAlignment="Bottom">
                    <Button x:Name="btnSearch" Content="بحث" 
                            Width="80" Height="30" 
                            Background="{StaticResource ThirdColor}" Foreground="{StaticResource PrimaryColor}"
                            Click="btnSearch_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- معلومات الموظف -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- معلومات الموظف المختار -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Icon:PackIconMaterial Grid.Column="0" 
                                              Kind="AccountCircle" 
                                              Foreground="{StaticResource ThirdColor}" 
                                              Width="40" Height="40"
                                              Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="txtEmployeeInfo" 
                                       Text="لم يتم اختيار موظف" 
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource ThirdColor}"/>
                            <TextBlock x:Name="txtEmployeeDetails" 
                                       Text="الرجاء البحث عن موظف" 
                                       FontSize="12"
                                       Foreground="{StaticResource ThirdColor}"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                x:Name="btnClearSelection" 
                                Content="إلغاء الاختيار"
                                Width="100" Height="30"
                                Background="#F44336" Foreground="White"
                                Click="btnClearSelection_Click"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- جدول رصيد الإجازات -->
                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="رصيد الإجازات" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="#424242"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgLeaveBalances" 
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              RowHeight="40"
                              HeadersVisibility="Column"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <!-- نوع الإجازة -->
                            <DataGridTextColumn Header="نوع الإجازة" 
                                                Binding="{Binding LeaveTypeName}" 
                                                Width="150" IsReadOnly="True"/>

                            <!-- الكود -->
                            <DataGridTextColumn Header="الكود" 
                                                Binding="{Binding LeaveTypeCode}" 
                                                Width="80" IsReadOnly="True"/>

                            <!-- الرصيد الكلي -->
                            <DataGridTemplateColumn Header="الرصيد الكلي" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TotalBalance, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource NumericTextBox}"
                                                 PreviewTextInput="NumberValidationTextBox"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المستخدم -->
                            <DataGridTextColumn Header="المستخدم" 
                                                Binding="{Binding UsedBalance}" 
                                                Width="80" IsReadOnly="True"/>

                            <!-- المتبقي -->
                            <DataGridTemplateColumn Header="المتبقي" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RemainingBalance}" 
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BalanceToColorConverter}">
                                                    <Binding Path="RemainingBalance"/>
                                                    <Binding Path="TotalBalance"/>
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- آخر تحديث -->
                            <DataGridTextColumn Header="آخر تحديث" 
                                                Binding="{Binding UpdatedAt, StringFormat='yyyy/MM/dd'}" 
                                                Width="100" IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ملاحظات عامة -->
                <Border Grid.Row="2" Visibility="Collapsed" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="ملاحظات عامة:" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtGeneralNotes" 
                                 Height="60" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- الأزرار -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="حفظ التعديلات" 
                    Width="120" Height="40"
                    Background="{StaticResource PrimaryColor}" Foreground="{StaticResource ThirdColor}"
                    FontSize="14" FontWeight="Bold"
                    Click="btnSave_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=dgLeaveBalances, Path=HasItems}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="btnReset" Content="إعادة تعيين" 
                    Width="120" Height="40"
                    Background="{StaticResource PrimaryColor}" Foreground="{StaticResource ThirdColor}"
                    FontSize="14" FontWeight="Bold"
                    Click="btnReset_Click"
                    Margin="20,0,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=dgLeaveBalances, Path=HasItems}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="btnClose" Content="إغلاق" 
                    Width="100" Height="40"
                    Background="#757575" Foreground="White"
                    FontSize="14" FontWeight="Bold"
                    Click="btnClose_Click"
                    Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>