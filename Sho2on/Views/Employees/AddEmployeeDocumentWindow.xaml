<Window x:Class="HR_Application.Views.AddEmployeeDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة وثيقة للموظف" Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowRootBackground}"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock Text="إضافة وثيقة للموظف" Foreground="{DynamicResource ThirdColor}" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Foreground="{DynamicResource TextPrimaryColor}" Text="عنوان الوثيقة:" FontWeight="Bold" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="titleTextBox" Width="300" Padding="5"
                             FontSize="14" VerticalContentAlignment="Center"
                             ToolTip="أدخل عنواناً واضحاً للوثيقة"/>
                </StackPanel>

                <!-- Document Type -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Foreground="{DynamicResource TextPrimaryColor}" Text="نوع الوثيقة:" FontWeight="Bold" Width="120" VerticalAlignment="Center"/>
                    <ComboBox x:Name="documentTypeComboBox" Width="300" Height="35"
                              FontSize="14" VerticalContentAlignment="Center"
                              ToolTip="اختر نوع الوثيقة المناسب"/>
                </StackPanel>

                <!-- File Selection -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Foreground="{DynamicResource TextPrimaryColor}" Text="الملف:" FontWeight="Bold" Width="120" VerticalAlignment="Center"/>
                    <StackPanel Width="300">
                        <Button x:Name="browseBtn" Content="📁 اختر الملف" 
                                Click="browseBtn_Click" Width="120" Height="30"
                                Background="{DynamicResource ButtonHoverBackground}"
                                HorizontalAlignment="Left"
                                ToolTip="اختر ملف من جهازك"/>
                        <TextBlock Foreground="{DynamicResource TextPrimaryColor}" x:Name="selectedFileText" TextWrapping="Wrap" 
                                   FontSize="12" Margin="0,5,0,0"
                                   Text="لم يتم اختيار ملف"/>
                    </StackPanel>
                </StackPanel>

                <!-- Expiry Date -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Foreground="{DynamicResource TextPrimaryColor}" Text="تاريخ الانتهاء:" FontWeight="Bold" Width="120" VerticalAlignment="Center"/>
                    <DatePicker x:Name="expiryDatePicker" Width="150" Height="40"
                                FontSize="14" VerticalContentAlignment="Center"
                                ToolTip="اختر تاريخ انتهاء الصلاحية (اختياري)"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Grid.Row="4" Margin="0,0,0,15">
                    <TextBlock Foreground="{DynamicResource TextPrimaryColor}" Text="الوصف:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="descriptionTextBox" Height="80" Width="300"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14" Padding="5"
                             ToolTip="أدخل وصفاً للوثيقة (اختياري)"/>
                </StackPanel>

                <!-- Supported Files Info -->
                <StackPanel Grid.Row="5">
                    <TextBlock Foreground="{DynamicResource PrimaryColor}" Text="الملفات المدعومة:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="📷 الصور: JPG, JPEG, PNG, BMP, GIF, TIFF" 
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                    <TextBlock Text="📄 المستندات: DOC, DOCX, XLS, XLSX, PPT, PPTX" 
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                    <TextBlock Text="📋 أخرى: PDF, TXT" 
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                    <TextBlock Text="الحد الأقصى للحجم: 10MB" 
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="saveBtn" Content="💾 حفظ" Click="saveBtn_Click" 
                    Width="100" Height="35" Background="#27ae60" Foreground="White" Margin="5"
                    ToolTip="حفظ الوثيقة"/>
            <Button x:Name="cancelBtn" Content="❌ إلغاء" Click="cancelBtn_Click" 
                    Width="100" Height="35" Background="#95a5a6" Foreground="White" Margin="5"
                    ToolTip="إلغاء العملية"/>
        </StackPanel>
    </Grid>
</Window>