<!-- في ملف DocumentPreviewWindow.xaml -->
<Window x:Class="HR_Application.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DocumentPreview}" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow">

    <Grid Margin="10" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان والأزرار -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="printBtn" Content="{DynamicResource Print}" Margin="0,0,5,0" Padding="10,5" Click="printBtn_Click"/>
                    <Button x:Name="downloadBtn" Content="{DynamicResource Download}" Margin="5,0" Padding="10,5" Click="downloadBtn_Click"/>
                </StackPanel>

                <TextBlock x:Name="txtTitle" Grid.Column="1" FontSize="16" FontWeight="Bold" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Button x:Name="closeBtn" Grid.Column="2" Content="{DynamicResource Closing}" Margin="5,0,0,0" 
                        Padding="10,5" Click="closeBtn_Click"/>
            </Grid>
        </Border>

        <!-- منطقة عرض المستند -->
        <Grid Grid.Row="1" Margin="0,10">
            <!-- معاينة PDF -->
            <ScrollViewer x:Name="pdfHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" 
                         VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image x:Name="pdfImageDisplay" Grid.Row="0" Stretch="Uniform" 
                           MaxWidth="1200" Margin="10"/>

                    <StackPanel x:Name="pdfNavigationPanel" Grid.Row="1" 
                                Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <Button x:Name="btnFirstPage" Content="{DynamicResource TheFirst}" Margin="2" Padding="5"/>
                        <Button x:Name="btnPrevPage" Content="{DynamicResource Previous}" Margin="2" Padding="5"/>
                        <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center" Margin="10,0"/>
                        <Button x:Name="btnNextPage" Content="{DynamicResource Next}" Margin="2" Padding="5"/>
                        <Button x:Name="btnLastPage" Content="{DynamicResource TheLast}" Margin="2" Padding="5"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- معاينة الصور -->
            <ScrollViewer x:Name="imageViewer" Visibility="Collapsed">
                <Image x:Name="imageDisplay" Stretch="Uniform" MaxWidth="1200" Margin="10"/>
            </ScrollViewer>

            <!-- معاينة النصوص -->
            <ScrollViewer x:Name="textViewer" Visibility="Collapsed">
                <TextBox x:Name="textContent" IsReadOnly="True" TextWrapping="Wrap" 
                         FontFamily="Courier New" Margin="10" Padding="10"/>
            </ScrollViewer>

            <!-- رسالة الخطأ -->
            <Border x:Name="fallbackContainer" Visibility="Collapsed" Background="#FFF0F0F0" 
                    CornerRadius="5" Padding="20"/>
        </Grid>

        <!-- شريط الحالة -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10" CornerRadius="5">
            <ProgressBar x:Name="loadingIndicator" Height="20" IsIndeterminate="True" 
                        Visibility="Collapsed"/>
        </Border>
    </Grid>
</Window>