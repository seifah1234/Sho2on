<Window x:Class="HR_Application.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700" Width="900" WindowStartupLocation="CenterScreen"
        Background="WhiteSmoke">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtTitle" Text="معاينة الوثيقة" Foreground="{StaticResource ThirdColor}" FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="0">
            <Grid>
                <!-- PDF Container -->
                <WindowsFormsHost x:Name="pdfHost" 
                                  HorizontalAlignment="Stretch" 
                                  VerticalAlignment="Stretch"
                                  Visibility="Visible"/>

                <!-- Image Viewer -->
                <ScrollViewer x:Name="imageViewer" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Image x:Name="imageDisplay" Stretch="None"/>
                </ScrollViewer>

                <!-- Text Viewer -->
                <ScrollViewer x:Name="textViewer" 
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="textContent" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             BorderThickness="0"
                             FontFamily="Arial" 
                             FontSize="14"
                             Padding="20"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>

                <!-- Fallback Container for unsupported files -->
                <Border x:Name="fallbackContainer" 
                        Background="White" 
                        CornerRadius="3" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        Visibility="Collapsed"/>

                <!-- Loading Indicator -->
                <Border x:Name="loadingIndicator" Background="#CCFFFFFF" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="جاري تحميل الوثيقة..." FontSize="14" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="{StaticResource SecondaryColor}" CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Page Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txtPageInfo" Text="جاري التحميل..." 
                               VerticalAlignment="Center" Margin="5,0" Foreground="{StaticResource PrimaryColor}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="printBtn" Content="🖨️ طباعة" Click="printBtn_Click" 
                            Width="100" Height="35" Background="#3498db" Foreground="White" Margin="5"
                            ToolTip="طباعة الوثيقة"/>
                    <Button x:Name="downloadBtn" Content="📥 تحميل" Click="downloadBtn_Click" 
                            Width="100" Height="35" Background="{StaticResource AccentColor}" Foreground="White" Margin="5"
                            ToolTip="تحميل الوثيقة"/>
                </StackPanel>

                <!-- Close Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="closeBtn" Content="❌ إغلاق" Click="closeBtn_Click" 
                            Width="100" Height="35" Background="Red" Foreground="White" Margin="5"
                            ToolTip="إغلاق النافذة"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>