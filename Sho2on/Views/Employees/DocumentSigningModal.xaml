<Window x:Class="HR_Application.Views.DocumentSigningModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="توقيع الوثائق" 
        Height="600" 
        Width="800"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="WhiteSmoke"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Document Item Style -->
        <Style x:Key="DocumentItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="Black" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e74c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c0392b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980b9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#95a5a6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7f8c8d"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Colors -->
        <Style x:Key="CategoryBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#f8f9fa"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="20" CornerRadius="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝" FontSize="24" Margin="0,0,15,0"/>
                    <TextBlock Text="توقيع الوثائق" Foreground="Black" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" 
                        Click="closeBtn_Click"
                        Background="Transparent" 
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Width="30" Height="30"
                        Padding="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Documents List -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Header -->
                <Border Grid.Row="0" Background="#f8f9fa" CornerRadius="10,10,0,0" 
                        Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <TextBlock Text="الوثائق المتاحة للتوقيع" FontWeight="SemiBold" 
                               Foreground="#2c3e50" FontSize="14"/>
                </Border>

                <!-- Documents List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl x:Name="documentsListBox" Padding="15">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DocumentItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Document Info -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="14"
                                                       Foreground="#2c3e50"
                                                       Margin="0,0,0,5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Style="{StaticResource CategoryBadgeStyle}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Category}" 
                                                               FontSize="11" 
                                                               Foreground="#7f8c8d"/>
                                                </Border>

                                                <Border Style="{StaticResource CategoryBadgeStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📄" FontSize="10" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding FileType, StringFormat={}{0} ملف}"
                                                                   FontSize="11" 
                                                                   Foreground="#7f8c8d"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="12" 
                                                       Foreground="#95a5a6"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                                    VerticalAlignment="Center">
                                            <Button Content="👁️ معاينة" 
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="previewBtn_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="✍️ توقيع" 
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="signBtn_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <Border Grid.Row="1" x:Name="emptyState" 
                        Background="White" 
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Orientation="Vertical" Margin="20">
                        <TextBlock Text="📭" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="لا توجد وثائق متاحة للتوقيع" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#95a5a6" HorizontalAlignment="Center"/>
                        <TextBlock Text="جميع الوثائق المطلوبة موقعة بالفعل" 
                                   FontSize="12" 
                                   Foreground="#bdc3c7" 
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status & Actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="0,0,10,10" 
                Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status -->
                <TextBlock Grid.Column="0" x:Name="statusText" 
                           Text="جاري تحميل الوثائق..." 
                           FontSize="12" 
                           Foreground="#7f8c8d"
                           VerticalAlignment="Center"/>

                <!-- Close Button -->
                <Button Grid.Column="1" Content="إغلاق" 
                        Style="{StaticResource CloseButtonStyle}"
                        Click="closeBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>