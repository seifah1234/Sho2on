<Window x:Class="HR_Application.Views.EmployeeEvaluationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تقييم موظف" 
        Height="800" 
        Loaded="Window_Loaded"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowRootBackground}"
        WindowState="Maximized"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="HeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="Black" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="SuccessTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#27ae60"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="UnsuccessTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e74c3c"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="#3498db"/>
                    <Setter Property="BorderBrush" Value="#2980b9"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980b9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e74c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Radio Button Styles -->
        <Style x:Key="SuccessRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#27ae60"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UnsuccessRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#e74c3c"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Notes TextBox Style -->
        <Style x:Key="NotesTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MaxHeight" Value="60"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Employee Info -->
        <Border Grid.Row="0" Style="{DynamicResource SectionStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource ThirdColor}" CornerRadius="8" VerticalAlignment="Center" Padding="10" Margin="0,0,15,0">
                        <TextBlock Text="👤" FontSize="16" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10" VerticalAlignment="Center">
                        <TextBlock x:Name="txtEmployeeName" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThirdColor}"/>
                        <TextBlock x:Name="txtEmployeeCode" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThirdColor}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{DynamicResource ThirdColor}" CornerRadius="8" VerticalAlignment="Center" Padding="10">
                        <TextBlock Text="🔍" FontSize="16" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                        <TextBox x:Name="txtEmployeeCodeSearch" 
                                 Margin="5"
                                 Tag="الكود"
                                 KeyDown="txtEmployeeCodeSearch_KeyDown"
                                 Width="100"
                                   Foreground="{DynamicResource ThirdColor}"/>
                        <!--<TextBox x:Name="txtEmployeeNameSearch" 
                                 Margin="5"
                                 Tag="الاسم"
                                 KeyDown="txtEmployeeNameSearch_KeyDown"
                                   FontWeight="SemiBold" 
                                 Width="300" Visibility="Collapsed"
                                   Foreground="{DynamicResource ThirdColor}"/>-->
                        <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                            <ComboBox Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" SelectedValuePath="Code" DisplayMemberPath="FullName" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>
                            <Label Foreground="{DynamicResource ThirdColor}" FontSize="14" FontWeight="Bold" Content="اسم الموظف" VerticalAlignment="Center" Margin="10 0 0 0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
            </Grid>
        </Border>

        <!-- Tabs for Evaluation Types -->
        <Border Grid.Row="1" Style="{DynamicResource SectionStyle}" Margin="0,10,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="نوع التقييم" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbAdministrative" 
                                 Content="📋 تقييم إداري" 
                                 Style="{DynamicResource TabButtonStyle}"
                                 GroupName="EvaluationType"
                                IsChecked="True"
                                 Checked="EvaluationType_Changed"/>
                    <RadioButton x:Name="rbTechnical" 
                                 Content="⚙️ تقييم فني" 
                                 Style="{DynamicResource TabButtonStyle}"
                                 GroupName="EvaluationType"
                                 Margin="10,0,0,0"
                                 Checked="EvaluationType_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area with Tabs -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Administrative Evaluation Section -->
            <Border Grid.Column="0" Style="{DynamicResource TabSectionStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Administrative Header -->
                    <Border Grid.Row="0" Style="{DynamicResource TabHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="التقييم الإداري" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThirdColor}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Administrative Content -->
                    <Border Grid.Row="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Add New Administrative Criteria -->
                            <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtNewAdministrativeCriteria" 
                                                 Width="300" 
                                                 Tag="إضافة معيار إداري جديد"
                                                 Height="35" 
                                                 Padding="5"
                                                 Margin="0,0,10,0"
                                                 VerticalContentAlignment="Center"/>
                                        <Button x:Name="btnAddAdministrative" 
                                                Content="➕ إضافة" 
                                                Click="AddAdministrativeCriteria_Click"
                                                Style="{DynamicResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Administrative Criteria List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="administrativeItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowColor}" 
                                                    CornerRadius="4" 
                                                    Padding="10" 
                                                    Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Criteria Name -->
                                                    <TextBox Grid.Column="0" 
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             Margin="5,0"
                                                             Padding="5"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             TextChanged="CriteriaName_TextChanged"
                                                             ToolTip="اسم المعيار"/>

                                                    <!-- Success Radio -->
                                                    <RadioButton Grid.Column="1" 
                                                                 IsChecked="{Binding IsSuccessful, Mode=OneWay}"
                                                                 Style="{DynamicResource SuccessRadioStyle}"
                                                                 Content="موفق"
                                                                 GroupName="{Binding GroupName}"
                                                                 Tag="{Binding}"
                                                                 Checked="CriteriaRadio_Checked"/>

                                                    <!-- Unsuccess Radio -->
                                                    <RadioButton Grid.Column="2" 
                                                                 IsChecked="{Binding IsUnsuccessful, Mode=OneWay}"
                                                                 Style="{DynamicResource UnsuccessRadioStyle}"
                                                                 Content="غير موفق"
                                                                 GroupName="{Binding GroupName}"
                                                                 Tag="{Binding}"
                                                                 Checked="CriteriaRadio_Checked"/>

                                                    <!-- Percentage Input -->
                                                    <TextBox Grid.Column="3" 
                                                             Text="{Binding Percentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             Padding="5"
                                                             TextAlignment="Center"
                                                             TextChanged="Percentage_TextChanged"
                                                             Tag="{Binding}"
                                                             Width="70"
                                                             PreviewTextInput="PercentageValidationTextBox"
                                                             ToolTip="أدخل النسبة من 0 إلى 100%">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                                                        <Setter Property="Foreground" Value="#27ae60"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="Background" Value="#f8fff8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                                                        <Setter Property="Foreground" Value="#e74c3c"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="Background" Value="#fff8f8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>


                                                    <!-- Delete -->
                                                    <Button Grid.Column="4" 
                                                            Content="X" 
                                                            Style="{DynamicResource DeleteButtonStyle}"
                                                            Click="DeleteAdministrativeCriteria_Click"
                                                            Tag="{Binding}"
                                                            Width="30"
                                                            Height="30"
                                                            ToolTip="حذف المعيار"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Separator -->
            <Border Grid.Column="1" Background="#ecf0f1" Width="2" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>

            <!-- Technical Evaluation Section -->
            <Border Grid.Column="2" Style="{DynamicResource TabSectionStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Technical Header -->
                    <Border Grid.Row="0" Style="{DynamicResource TabHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="التقييم الفني" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThirdColor}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Technical Content -->
                    <Border Grid.Row="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Add New Technical Criteria -->
                            <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtNewTechnicalCriteria" 
                                                 Width="300" 
                                                 Tag="إضافة معيار فني جديد"
                                                 Height="35" 
                                                 Padding="5"
                                                 Margin="0,0,10,0"
                                                 VerticalContentAlignment="Center"/>
                                        <Button x:Name="btnAddTechnical" 
                                                Content="➕ إضافة" 
                                                Click="AddTechnicalCriteria_Click"
                                                Style="{DynamicResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Technical Criteria List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="technicalItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowColor}" 
                                                    CornerRadius="4" 
                                                    Padding="10" 
                                                    Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>


                                                    <!-- Criteria Name -->
                                                    <TextBox Grid.Column="0" 
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             Margin="5,0"
                                                             Padding="5"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             TextChanged="CriteriaName_TextChanged"
                                                             ToolTip="اسم المعيار"/>

                                                    <!-- Success Radio -->
                                                    <RadioButton Grid.Column="1" 
                                                                 IsChecked="{Binding IsSuccessful, Mode=OneWay}"
                                                                 Style="{DynamicResource SuccessRadioStyle}"
                                                                 Content="موفق"
                                                                 
                                                                 GroupName="{Binding GroupName}"
                                                                 Tag="{Binding}"
                                                                 Checked="CriteriaRadio_Checked"/>

                                                    <!-- Unsuccess Radio -->
                                                    <RadioButton Grid.Column="2" 
                                                                 IsChecked="{Binding IsUnsuccessful, Mode=OneWay}"
                                                                 Style="{DynamicResource UnsuccessRadioStyle}"
                                                                 Content="غير موفق"
                                                                 GroupName="{Binding GroupName}"
                                                                 Tag="{Binding}"
                                                                 Checked="CriteriaRadio_Checked"/>

                                                    <!-- Percentage Input -->
                                                    <TextBox Grid.Column="3" 
                                                             Text="{Binding Percentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             Padding="5"
                                                             TextAlignment="Center"
                                                             TextChanged="Percentage_TextChanged"
                                                             Tag="{Binding}"
                                                             Width="70"
                                                             PreviewTextInput="PercentageValidationTextBox"
                                                             ToolTip="أدخل النسبة من 0 إلى 100%">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                                                        <Setter Property="Foreground" Value="#27ae60"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="Background" Value="#f8fff8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                                                        <Setter Property="Foreground" Value="#e74c3c"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="Background" Value="#fff8f8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>


                                                    <!-- Delete -->
                                                    <Button Grid.Column="4" 
                                                            Content="X" 
                                                            Style="{DynamicResource DeleteButtonStyle}"
                                                            Click="DeleteTechnicalCriteria_Click"
                                                            Tag="{Binding}"
                                                            Width="30"
                                                            Height="30"
                                                            ToolTip="حذف المعيار"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Summary Section -->
        <Border Grid.Row="3"  Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Administrative Summary -->
                <Border Grid.Column="0" Style="{DynamicResource TabSectionStyle}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="ملخص التقييم الإداري" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,10"
                                   Foreground="#3498db"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="عدد المعايير:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtAdministrativeTotal" Text="0" FontWeight="SemiBold" Margin="0,0,10,5"/>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="المعايير الناجحة:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtAdministrativeSuccess" Text="0" Style="{DynamicResource SuccessTextStyle}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="المعايير غير الناجحة:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtAdministrativeUnsuccess" Text="0" Style="{DynamicResource UnsuccessTextStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="النسبة الإجمالية:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtAdministrativePercentage" Text="0%" FontWeight="Bold" FontSize="16"/>
                        </Grid>

                        <!-- Administrative Notes -->
                        <StackPanel Grid.Row="2" Margin="5">
                            
                            <TextBox x:Name="txtAdministrativeNotes" 
              Height="50" 
              TextWrapping="Wrap" 
              Width="300"
                                     Tag="ملاحظات إدارية"
              AcceptsReturn="True"
              VerticalScrollBarVisibility="Auto"
              FontSize="12"
              Padding="8"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Technical Summary -->
                <Border Grid.Column="1" Style="{DynamicResource TabSectionStyle}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="ملخص التقييم الفني" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,10"
                                   Foreground="#e67e22"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="عدد المعايير:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtTechnicalTotal" Margin="0,0,10,5" Text="0" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="المعايير الناجحة:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTechnicalSuccess" Text="0" Style="{DynamicResource SuccessTextStyle}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="المعايير غير الناجحة:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtTechnicalUnsuccess" Text="0" Style="{DynamicResource UnsuccessTextStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="النسبة الإجمالية:" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtTechnicalPercentage" Text="0%" FontWeight="Bold" FontSize="16"/>
                        </Grid>

                        <!-- Technical Notes -->
                        <StackPanel Grid.Row="3" Margin="5">
                            <TextBox x:Name="txtTechnicalNotes" 
                                     Height="50" 
                                    Tag="ملاحظات فنية"
                                     TextWrapping="Wrap" 
                                     Width="300"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="12"
                                     Padding="8"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Final Result and Actions -->
                <Border Grid.Column="2" Style="{DynamicResource TabSectionStyle}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Overall Result -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,0">
                            <TextBlock Text="النتيجة النهائية" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="بوجه عام:" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbSuccessful" 
                                                 Content="✅ موفق" 
                                                 GroupName="FinalResult"
                                                 FontWeight="SemiBold"
                                                 Foreground="#27ae60"
                                                 Margin="20,0,0,10"
                                                 Checked="FinalResult_Checked"/>
                                    <RadioButton x:Name="rbUnsuccessful" 
                                                 Content="❌ غير موفق" 
                                                 Foreground="#e74c3c"
                                                 GroupName="FinalResult"
                                                 FontWeight="SemiBold"
                                                 Margin="20,0,0,0"
                                                 Checked="FinalResult_Checked"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="المجموع الكلي:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtFinalPercentage" Text="0%" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- General Notes -->
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBox x:Name="txtGeneralNotes" 
                                     Height="50" 
                                     TextWrapping="Wrap" 
                                     Tag="ملاحظات عامة"
                                     Width="300"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="13"
                                     Padding="8"/>
                        </StackPanel>

                       
                        <!-- Actions -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <Button x:Name="btnSave" 
                                    Content="💾 حفظ التقييم" 
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Click="btnSave_Click"/>
                            <Button x:Name="btnCancel" 
                                    Content="❌ إلغاء" 
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Background="#95a5a6"
                                    Click="btnCancel_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>