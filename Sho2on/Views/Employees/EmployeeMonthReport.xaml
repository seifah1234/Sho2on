<Window x:Class="HR_Application.EmployeeMonthReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="600" Width="1000" MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>

        <!-- Action button used in the toolbar -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#0D2233"/>
            <Setter Property="Foreground"      Value="{DynamicResource ButtonHoverForeground}"/>
            <Setter Property="Background"      Value="{DynamicResource ButtonHoverBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#0D3344"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Local ComboBox override to keep white text on dark header -->
        <Style x:Key="HeaderComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width"  Value="110"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Window.Resources>

    <!-- ════ Window root ════ -->
    <Border CornerRadius="15" Background="{DynamicResource WindowRootBackground}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0" CornerRadius="15 15 0 0">
                <Grid>
                    <Rectangle VerticalAlignment="Bottom" Height="1" Opacity="0.2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00BCD4"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Icon:PackIconMaterial Kind="CalendarMonth" Width="20" Height="20"
                                               Foreground="{DynamicResource TextPrimaryColor}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource MonthlyEmployees}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Toolbar / Filters ── -->
            <Border Grid.Row="1" Padding="16,12" Background="{DynamicResource InputBackground}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                </Border.Effect>
                <!-- Bottom hairline -->
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Action buttons -->
                    <UniformGrid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{DynamicResource ToolbarButtonStyle}"
                                x:Name="excel_btn" Click="excel_btn_Click" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="FileExcel" Width="16" Height="16"
                                                       Foreground="{DynamicResource SuccessColor}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ToolbarButtonStyle}" IsDefault="True"
                                x:Name="data_load_btn" Click="data_load_btn_Click" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Eye" Width="16" Height="16"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource DisplayData}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ToolbarButtonStyle}"
                                x:Name="clear_btn" Click="clear_btn_Click" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="EraserVariant" Width="16" Height="16"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource New}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource ToolbarButtonStyle}" Margin="0,0,6,6"
                                x:Name="print_btn" Click="print_btn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Printer" Width="16" Height="16"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Print}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Filters -->
                    <UniformGrid Grid.Column="1" 
                               VerticalAlignment="Center" >

                        <StackPanel Width="200" HorizontalAlignment="Right" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Label Width="80" Content="{DynamicResource Branch2}" VerticalAlignment="Center"/>
                            <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Name="branch_box" Style="{DynamicResource HeaderComboStyle}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Width="200" HorizontalAlignment="Right" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Label Width="80" Content="{DynamicResource Administration3}" VerticalAlignment="Center"/>
                            <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Name="dept_box" Style="{DynamicResource HeaderComboStyle}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Width="200" HorizontalAlignment="Right" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Label Width="80" Content="{DynamicResource Sector2}" VerticalAlignment="Center"/>
                            <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Name="section_box" Style="{DynamicResource HeaderComboStyle}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Width="200" HorizontalAlignment="Right" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Label Width="80" Content="{DynamicResource Job2}" VerticalAlignment="Center"/>
                            <ComboBox DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Name="job_box" Style="{DynamicResource HeaderComboStyle}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Width="200" HorizontalAlignment="Right" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Label Width="80" Content="{DynamicResource Month2}" VerticalAlignment="Center"/>
                            <ComboBox Name="month_box" Style="{DynamicResource HeaderComboStyle}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Width="200" HorizontalAlignment="Right" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Label Width="80" Content="{DynamicResource Sunnah2}" VerticalAlignment="Center"/>
                            <ComboBox Name="year_box" Style="{DynamicResource HeaderComboStyle}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ── DataGrid ── -->
            <Border Grid.Row="2" Margin="16,12,16,16" CornerRadius="16"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                </Border.Effect>
                <DataGrid AutoGenerateColumns="False"
                          FlowDirection="RightToLeft"
                          Margin="0"
                          x:Name="dataGrid"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Code}"
                                            Width="110" IsReadOnly="True"
                                            Binding="{Binding dataTotal.Code}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource TheName}"
                                            Width="130" IsReadOnly="True"
                                            Binding="{Binding dataTotal.Name}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource WorkingHours}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalWorkTime, StringFormat={}{0:hh\\:mm}}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Delay}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalLate, StringFormat={}{0:hh\\:mm}}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource ItSEarly}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalEarly, StringFormat={}{0:hh\\:mm}}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Extra}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalOT, StringFormat={}{0:hh\\:mm}}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource ActualHours}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalAttendTime, StringFormat={}{0:hh\\:mm}}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Vacations}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalHoliday}"/>
                        <DataGridTextColumn CanUserSort="False" Header="{DynamicResource Absence}"
                                            IsReadOnly="True"
                                            Binding="{Binding dataTotal.TotalAbsence}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>
