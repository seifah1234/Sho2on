<!-- DocumentSignatureWindow.xaml -->
<Window x:Class="HR_Application.Views.DocumentSignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        Height="500" Width="600" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowRootBackground}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource SignTheDocument}" Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Document and Employee Info -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Document}" FontWeight="Bold" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryColor}"/>
                <TextBlock Grid.Column="1" x:Name="txtDocumentTitle" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}"/>

                <TextBlock Grid.Column="2" Text="{DynamicResource Employee2}" FontWeight="Bold" Margin="20,0,10,0" Foreground="{DynamicResource TextPrimaryColor}"/>
                <TextBlock Grid.Column="3" x:Name="txtEmployeeName" Foreground="{DynamicResource TextPrimaryColor}"/>
            </Grid>
        </Border>

        <!-- Signature Form -->
        <Border Grid.Row="2" Background="{DynamicResource PrimaryColor}" CornerRadius="5" Padding="15">
            <StackPanel>
                <TextBlock Text="{DynamicResource UploadTheSignedDocument}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="browseSignedFileBtn" Content="{DynamicResource ChooseTheFileLocation}" 
                            Click="browseSignedFileBtn_Click" Width="120" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtSignedFile" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="12"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource Comments2}" Foreground="{DynamicResource TextPrimaryColor}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" MinWidth="500"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                <TextBlock Text="{DynamicResource TheSignedDocumentWillBeSavedInTheEmployeeSArchive}" 
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="signBtn" Content="{DynamicResource Signature}" Click="signBtn_Click" 
                    Width="100" Height="35" Background="{DynamicResource AccentColor}" Foreground="White" Margin="5"/>
            <Button x:Name="cancelBtn" Content="{DynamicResource Cancellation}" Click="cancelBtn_Click" 
                    Width="100" Height="35" Background="#95a5a6" Foreground="White" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>