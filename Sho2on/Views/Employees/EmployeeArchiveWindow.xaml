<Window x:Class="HR_Application.Views.EmployeeArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أرشيف الموظف" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        WindowState="Maximized"
        Background="WhiteSmoke"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="DocumentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Black" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Document Type Colors -->
        <SolidColorBrush x:Key="SignedColor" Color="#27ae60"/>
        <SolidColorBrush x:Key="PersonalColor" Color="#3498db"/>
        <SolidColorBrush x:Key="CVColor" Color="#e74c3c"/>
        <SolidColorBrush x:Key="CertificateColor" Color="#f39c12"/>
        <SolidColorBrush x:Key="IDColor" Color="#9b59b6"/>
        <SolidColorBrush x:Key="DefaultColor" Color="#95a5a6"/>

        <!-- Icon Styles -->
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#2c3e50"/>
                    <Setter Property="Background" Value="#f8f9fa"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Padding="20" CornerRadius="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="24" Margin="0,0,15,0"/>
                    <TextBlock Text="أرشيف الموظف" Foreground="Black" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="showSigningModalBtn" Content="📝 توقيع وثائق" 
                            Click="showSigningModalBtn_Click"
                            Background="#e74c3c" Foreground="White" 
                            Padding="15,8" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0"
                            Margin="0,0,10,0"/>
                    <Button x:Name="addPersonalDocBtn" Content="➕ إضافة وثيقة" 
                            Click="addPersonalDocBtn_Click"
                            Background="#3498db" Foreground="White" 
                            Padding="15,8" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Employee Info -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Border Background="#f8f9fa" CornerRadius="8" Padding="10" Margin="0,0,15,0">
                    <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="txtEmployeeName" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#2c3e50" Text="جاري التحميل..."/>
                    <TextBlock x:Name="txtEmployeeCode" FontSize="12" Foreground="#7f8c8d"
                               Text="كود: جاري التحميل..."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content - Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="5">
            <ItemsControl x:Name="documentsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DocumentCardStyle}" Width="300" Height="180">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Background="{Binding DocumentTypeColor}" 
                                        CornerRadius="8,8,0,0" Padding="10" Margin="-15,-15,-15,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DocumentIcon}" 
                                                   Style="{StaticResource IconStyle}" 
                                                   Foreground="White" Margin="0,0,8,0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding DocumentTypeName}" 
                                                   Foreground="White" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" FontSize="12"/>

                                        <Border Grid.Column="2" Background="White" CornerRadius="10" 
                                                Padding="4,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusName}" FontSize="10" 
                                                       FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" 
                                               FontSize="14" Foreground="#2c3e50" 
                                               TextWrapping="Wrap" MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Description}" FontSize="11" 
                                               Foreground="#7f8c8d" TextWrapping="Wrap"
                                               Margin="0,5,0,0" MaxHeight="30"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="📅" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding UploadDate, StringFormat='yyyy/MM/dd'}" 
                                                   FontSize="10" Foreground="#95a5a6"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                            HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionButtonStyle}" 
                                            Tag="{Binding}" Click="CardView_Click"
                                            Content="👁️ عرض"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" 
                                            Tag="{Binding}" Click="CardDownload_Click"
                                            Content="📥 تحميل"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" 
                                            Tag="{Binding}" Click="CardPrint_Click" Visibility="Collapsed"
                                            Content="🖨️ طباعة"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" 
                                            Tag="{Binding}" Click="CardDelete_Click"
                                            Content="🗑️ حذف"
                                            Foreground="#e74c3c"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#34495e" CornerRadius="8" Padding="10" Margin="0,15,0,0">
            <TextBlock x:Name="statusText" Text="جاهز" Foreground="White" 
                       HorizontalAlignment="Center" FontSize="12"/>
        </Border>
    </Grid>
</Window>