<Window x:Class="HR_Application.Views.Employees.PermissionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"  
        xmlns:local="clr-namespace:HR_Application.Views.Employees"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        WindowState="Maximized"
        Background="{DynamicResource WindowRootBackground}"
        Title="{DynamicResource ManagePermissionRequests}" Height="450" Width="800">

    <Window.Resources>
        <!-- الأنماط -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- محول للون الحالة -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>

        <!-- محول لتنسيق التاريخ -->
        <local:DateTimeToPersianConverter x:Key="DateTimeToPersianConverter"/>
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <local:TupleConverter x:Key="TupleConverter"/>

        <!-- نمط لحقول البحث -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط للـ DatePicker -->
        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط للـ ComboBox -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- نمط لأزرار الفلترة -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TabControl>
            <TabItem Name="employeesTab">

                <TabItem.Header>
                    <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                        <Label Content="{DynamicResource EmployeeRequests}" Foreground="{DynamicResource PrimaryColor}"/>

                    </Border>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث والفلاتر -->
                    <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource SearchAndFilterPermissionRequests}" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThirdColorBrushBrush}"
                           Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- كود الموظف -->

                                <StackPanel VerticalAlignment="Bottom" Orientation="Vertical" Margin="10">
                                    <TextBox x:Name="txtEmployeeId" 
                                 PreviewTextInput="NumberValidationTextBox"
                                 Tag="{DynamicResource TagEmployeeCode}"/>
                                </StackPanel>

                                <StackPanel FlowDirection="RightToLeft" Orientation="Vertical">
                                    <Label Foreground="{DynamicResource ThirdColorBrushBrush}" FontSize="14" FontWeight="Bold" Content="{DynamicResource EmployeeName}" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <ComboBox Width="250" SelectionChanged="userComboBox_SelectionChanged" Loaded="searchComboBox_Loaded" SelectedValuePath="Code" DisplayMemberPath="FullName" HorizontalContentAlignment="Right" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" Name="user_box" Margin="5"/>
                                </StackPanel>

                                <!-- من تاريخ -->
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <TextBlock Text="{DynamicResource FromDate}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <DatePicker x:Name="dpFromDate" />
                                </StackPanel>

                                <!-- إلى تاريخ -->
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <TextBlock Text="{DynamicResource ToDate}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <DatePicker x:Name="dpToDate"/>
                                </StackPanel>

                                <!-- الحالة -->
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <TextBlock Text="{DynamicResource TheCondition}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox x:Name="cmbStatus" >
                                        <ComboBoxItem Content="{DynamicResource AllCases}" Tag=""/>
                                        <ComboBoxItem Content="{DynamicResource OnHold}" Tag="Pending"/>
                                        <ComboBoxItem Content="{DynamicResource Approved2}" Tag="Approved"/>
                                        <ComboBoxItem Content="{DynamicResource Unacceptable}" Tag="Rejected"/>
                                    </ComboBox>
                                </StackPanel>

                            </StackPanel>
                            <!-- أزرار البحث -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button x:Name="btnSearch" 
                                Style="{DynamicResource FilterButtonStyle}"
                                Background="{DynamicResource ButtonHoverBackground}" Foreground="{DynamicResource ButtonHoverForeground}"
                                Margin="5"
                                Click="btnSearch_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Foreground="{DynamicResource ButtonHoverForeground}" Kind="Magnify" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource Research}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnClearFilters" 
                                Style="{DynamicResource FilterButtonStyle}"
                                Background="#757575" Foreground="White" Margin="5"
                                Click="btnClearFilters_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="Refresh" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource New}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- جدول طلبات الإجازة -->
                    <Border Grid.Row="1" Padding="10" Background="{DynamicResource PrimaryColor}">
                        <DataGrid x:Name="dgPermissions" 
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      RowHeight="40"
                      HeadersVisibility="Column"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <!-- كود الموظف -->
                                <DataGridTextColumn Header="{DynamicResource EmployeeCode}" 
                                        Binding="{Binding EmployeeId}" 
                                        Width="100"/>

                                <!-- اسم الموظف -->
                                <DataGridTextColumn Header="{DynamicResource EmployeeName}" 
                                        Binding="{Binding EmployeeName}" 
                                        Width="200"/>

                                <!-- نوع الإجازة -->
                                <DataGridTextColumn Header="{DynamicResource EarType}" 
                                        Binding="{Binding PermissionTypeName}" 
                                        Width="120"/>

                                <!-- الفترة -->
                                <DataGridTemplateColumn Header="{DynamicResource Period}" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StartDate, Converter={StaticResource DateTimeToPersianConverter}}"/>
                                                <TextBlock Text=" - " Margin="5,0"/>
                                                <TextBlock Text="{Binding EndDate, Converter={StaticResource DateTimeToPersianConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- المدة -->
                                <DataGridTextColumn Header="{DynamicResource DurationHours}" 
                                        Binding="{Binding Duration}" 
                                        Width="100"/>

                                <!-- الحالة -->
                                <DataGridTemplateColumn Header="{DynamicResource TheCondition}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource StatusIndicatorStyle}" 
                                        Background="{Binding StatusEn, Converter={StaticResource StatusToColorConverter}}">
                                                <TextBlock Style="{DynamicResource StatusTextStyle}" 
                                               Text="{Binding Status}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- تاريخ الطلب -->
                                <DataGridTextColumn Header="{DynamicResource OrderDate}" 
                                        Binding="{Binding CreatedAt, Converter={StaticResource DateTimeToPersianConverter}}" 
                                        Width="100"/>

                                <!-- السبب -->
                                <DataGridTextColumn Header="{DynamicResource TheReason}" 
                                        Binding="{Binding Reason}" 
                                        Width="200"/>

                                <!-- الإجراءات -->
                                <DataGridTemplateColumn Header="{DynamicResource Procedures}" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- عرض التفاصيل -->
                                                <!-- عرض التفاصيل -->
                                                <Button Style="{DynamicResource ActionButtonStyle}" 
        Background="#2196F3" 
        Foreground="White"
                                            Tag="{Binding Id}"
                                            Width="50"
        Click="btnViewDetails_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Icon:PackIconMaterial Kind="Eye" Width="14" Height="14"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- موافقة -->
                                                <Button x:Name="btnApprove" 
                                            Style="{DynamicResource ActionButtonStyle}" 
                                            Background="#4CAF50" 
                                            Foreground="White"
                                            Click="btnApprove_Click" Width="50"
                                            Visibility="{Binding StatusEn, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Pending}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Icon:PackIconMaterial Kind="Check" Width="14" Height="14"/>
                                                    </StackPanel>
                                                    <Button.Tag>
                                                        <Binding Path="Id"/>
                                                    </Button.Tag>
                                                </Button>

                                                <!-- رفض -->
                                                <Button x:Name="btnReject" 
                                            Style="{DynamicResource ActionButtonStyle}" 
                                            Background="#F44336" 
                                            Foreground="White"
                                            Click="btnReject_Click" Width="50"
                                            Visibility="{Binding StatusEn, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Pending}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Icon:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                                    </StackPanel>
                                                    <Button.Tag>
                                                        <Binding Path="Id"/>
                                                    </Button.Tag>
                                                </Button>


                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Name="ownTab">
                <TabItem.Header>
                    <Border Margin="0"  Padding="0" Background="{DynamicResource InputBackground}"  CornerRadius="8" >
                        <Label Content="{DynamicResource MyRequests}" Foreground="{DynamicResource PrimaryColor}"/>

                    </Border>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث والفلاتر -->
                    <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource SearchAndFilterMyOrders}" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    Foreground="{DynamicResource ThirdColorBrushBrush}"
                    Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">


                                <!-- من تاريخ -->
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <TextBlock Text="{DynamicResource FromDate}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <DatePicker x:Name="dpOwnFromDate" />
                                </StackPanel>

                                <!-- إلى تاريخ -->
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <TextBlock Text="{DynamicResource ToDate}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <DatePicker x:Name="dpOwnToDate"/>
                                </StackPanel>

                                <!-- الحالة -->
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <TextBlock Text="{DynamicResource TheCondition}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    <ComboBox x:Name="cmbOwnStatus" >
                                        <ComboBoxItem Content="{DynamicResource AllCases}" Tag=""/>
                                        <ComboBoxItem Content="{DynamicResource OnHold}" Tag="Pending"/>
                                        <ComboBoxItem Content="{DynamicResource UnderReview}" Tag="UnderReview"/>
                                        <ComboBoxItem Content="{DynamicResource Approved2}" Tag="Approved"/>
                                        <ComboBoxItem Content="{DynamicResource Unacceptable}" Tag="Rejected"/>
                                    </ComboBox>
                                </StackPanel>

                            </StackPanel>
                            <!-- أزرار البحث -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button x:Name="btnOwnSearch" 
                         Style="{DynamicResource FilterButtonStyle}"
                         Background="{DynamicResource ThirdColorBrushBrush}" Foreground="{DynamicResource PrimaryColor}"
                         Margin="5"
                         Click="btnOwnSearch_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Foreground="{DynamicResource PrimaryColor}" Kind="Magnify" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource Research}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnOwnClearFilters" 
                         Style="{DynamicResource FilterButtonStyle}"
                         Background="#757575" Foreground="White" Margin="5"
                         Click="btnOwnClearFilters_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Foreground="{DynamicResource ThirdColorBrushBrush}" Kind="Refresh" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource New}" Foreground="{DynamicResource ThirdColorBrushBrush}"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- جدول طلبات الإجازة -->
                    <Border Grid.Row="1" Padding="10" Background="{DynamicResource PrimaryColor}">
                        <DataGrid x:Name="dgOwnPermissions" 
               AutoGenerateColumns="False"
               CanUserAddRows="False"
               CanUserDeleteRows="False"
               SelectionMode="Single"
               SelectionUnit="FullRow"
               IsReadOnly="True"
               RowHeight="40"
               HeadersVisibility="Column"
               BorderBrush="#E0E0E0"
               BorderThickness="1"
               GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>

                                <!-- نوع الإجازة -->
                                <DataGridTextColumn Header="{DynamicResource EarType}" 
                                        Binding="{Binding PermissionTypeName}" 
                                        Width="120"/>

                                <!-- الفترة -->
                                <DataGridTemplateColumn Header="{DynamicResource Period}" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StartDate, Converter={StaticResource DateTimeToPersianConverter}}"/>
                                                <TextBlock Text=" - " Margin="5,0"/>
                                                <TextBlock Text="{Binding EndDate, Converter={StaticResource DateTimeToPersianConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- المدة -->
                                <DataGridTextColumn Header="{DynamicResource DurationHours}" 
                                        Binding="{Binding Duration}" 
                                        Width="100"/>

                                <!-- الحالة -->
                                <DataGridTemplateColumn Header="{DynamicResource TheCondition}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource StatusIndicatorStyle}" 
                                        Background="{Binding StatusEn, Converter={StaticResource StatusToColorConverter}}">
                                                <TextBlock Style="{DynamicResource StatusTextStyle}" 
                                               Text="{Binding Status}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- تاريخ الطلب -->
                                <DataGridTextColumn Header="{DynamicResource OrderDate}" 
                                        Binding="{Binding CreatedAt, Converter={StaticResource DateTimeToPersianConverter}}" 
                                        Width="100"/>

                                <!-- السبب -->
                                <DataGridTextColumn Header="{DynamicResource TheReason}" 
                                        Binding="{Binding Reason}" 
                                        Width="200"/>

                                <!-- الإجراءات -->
                                <DataGridTemplateColumn Header="{DynamicResource Procedures}" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- عرض التفاصيل -->
                                                <!-- عرض التفاصيل -->
                                                <Button Style="{DynamicResource ActionButtonStyle}" 
 Background="#2196F3" 
 Foreground="White"
                                     Tag="{Binding Id}"
                                     Width="50"
 Click="btnViewDetails_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Icon:PackIconMaterial Kind="Eye" Width="14" Height="14"/>
                                                    </StackPanel>
                                                </Button>


                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- الأزرار الرئيسية -->
                    <Border Grid.Row="2" Background="{DynamicResource PrimaryColor}" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- طلب إجازة جديد -->


                            <!-- أنواع الإجازات -->




                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>



        <!-- الأزرار الرئيسية -->
        <Border Grid.Row="2" Background="{DynamicResource PrimaryColor}" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- إغلاق -->
                <Button x:Name="btnClose" 
                        Width="120" Height="45" 
                        Background="#757575" Foreground="{DynamicResource ThirdColorBrushBrush}"
                        FontSize="14" FontWeight="Bold"
                        Click="btnClose_Click"
                        Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Close" Width="20" Height="20" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Closing}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
