<Window x:Class="HR_Application.Views.Employees.PermissionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:HR_Application.Views.Employees"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        WindowState="Maximized"
        Title="ادارة طلبات الاذن" Height="450" Width="800">

    <Window.Resources>
        <!-- الأنماط -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- محول للون الحالة -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>

        <!-- محول لتنسيق التاريخ -->
        <local:DateTimeToPersianConverter x:Key="DateTimeToPersianConverter"/>
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <local:TupleConverter x:Key="TupleConverter"/>

        <!-- نمط لحقول البحث -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط للـ DatePicker -->
        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط للـ ComboBox -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- نمط لأزرار الفلترة -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط البحث والفلاتر -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="بحث وتصفية طلبات الاذن" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource ThirdColor}"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- كود الموظف -->
                    <StackPanel Orientation="Vertical" Margin="10">
                        <TextBox x:Name="txtEmployeeId" 
                                 PreviewTextInput="NumberValidationTextBox"
                                 Tag="كود الموظف"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="10">

                        <TextBox Width="250" Name="employeeName_box" Tag="اسم الموظف" 
             FlowDirection="RightToLeft" KeyDown="employeeName_box_KeyDown" />
                    </StackPanel>

                    <!-- من تاريخ -->
                    <StackPanel Orientation="Vertical" Margin="10">
                        <TextBlock Text="من تاريخ" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource ThirdColor}"/>
                        <DatePicker x:Name="dpFromDate" />
                    </StackPanel>

                    <!-- إلى تاريخ -->
                    <StackPanel Orientation="Vertical" Margin="10">
                        <TextBlock Text="إلى تاريخ" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource ThirdColor}"/>
                        <DatePicker x:Name="dpToDate"/>
                    </StackPanel>

                    <!-- الحالة -->
                    <StackPanel Orientation="Vertical" Margin="10">
                        <TextBlock Text="الحالة" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource ThirdColor}"/>
                        <ComboBox x:Name="cmbStatus" >
                            <ComboBoxItem Content="جميع الحالات" Tag=""/>
                            <ComboBoxItem Content="قيد الانتظار" Tag="Pending"/>
                            <ComboBoxItem Content="موافق عليه" Tag="Approved"/>
                            <ComboBoxItem Content="مرفوض" Tag="Rejected"/>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>
                <!-- أزرار البحث -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button x:Name="btnSearch" 
                                Style="{StaticResource FilterButtonStyle}"
                                Background="{StaticResource ThirdColor}" Foreground="{StaticResource PrimaryColor}"
                                Margin="5"
                                Click="btnSearch_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Icon:PackIconMaterial Foreground="{StaticResource PrimaryColor}" Kind="Magnify" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="بحث"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnClearFilters" 
                                Style="{StaticResource FilterButtonStyle}"
                                Background="#757575" Foreground="White" Margin="5"
                                Click="btnClearFilters_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Icon:PackIconMaterial Foreground="{StaticResource ThirdColor}" Kind="Refresh" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="جديد" Foreground="{StaticResource ThirdColor}"/>
                        </StackPanel>
                    </Button>


                </StackPanel>
            </StackPanel>
        </Border>

        <!-- جدول طلبات الإجازة -->
        <Border Grid.Row="1" Padding="10" Background="{StaticResource SecondaryColor}">
            <DataGrid x:Name="dgPermissions" 
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      RowHeight="40"
                      HeadersVisibility="Column"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <!-- كود الموظف -->
                    <DataGridTextColumn Header="كود الموظف" 
                                        Binding="{Binding EmployeeId}" 
                                        Width="100"/>

                    <!-- اسم الموظف -->
                    <DataGridTextColumn Header="اسم الموظف" 
                                        Binding="{Binding EmployeeName}" 
                                        Width="200"/>

                    <!-- نوع الإجازة -->
                    <DataGridTextColumn Header="نوع الاذن" 
                                        Binding="{Binding PermissionTypeName}" 
                                        Width="120"/>

                    <!-- الفترة -->
                    <DataGridTemplateColumn Header="الفترة" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartDate, Converter={StaticResource DateTimeToPersianConverter}}"/>
                                    <TextBlock Text=" - " Margin="5,0"/>
                                    <TextBlock Text="{Binding EndDate, Converter={StaticResource DateTimeToPersianConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- المدة -->
                    <DataGridTextColumn Header="المدة (أيام)" 
                                        Binding="{Binding Duration}" 
                                        Width="100"/>

                    <!-- الحالة -->
                    <DataGridTemplateColumn Header="الحالة" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusIndicatorStyle}" 
                                        Background="{Binding StatusEn, Converter={StaticResource StatusToColorConverter}}">
                                    <TextBlock Style="{StaticResource StatusTextStyle}" 
                                               Text="{Binding Status}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- تاريخ الطلب -->
                    <DataGridTextColumn Header="تاريخ الطلب" 
                                        Binding="{Binding CreatedAt, Converter={StaticResource DateTimeToPersianConverter}}" 
                                        Width="100"/>

                    <!-- السبب -->
                    <DataGridTextColumn Header="السبب" 
                                        Binding="{Binding Reason}" 
                                        Width="200"/>

                    <!-- الإجراءات -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- عرض التفاصيل -->
                                    <!-- عرض التفاصيل -->
                                    <Button Style="{StaticResource ActionButtonStyle}" 
        Background="#2196F3" 
        Foreground="White"
                                            Tag="{Binding Id}"
                                            Width="50"
        Click="btnViewDetails_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Eye" Width="14" Height="14"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- موافقة -->
                                    <Button x:Name="btnApprove" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#4CAF50" 
                                            Foreground="White"
                                            Click="btnApprove_Click" Width="50"
                                            Visibility="{Binding StatusEn, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Pending}">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Check" Width="14" Height="14"/>
                                        </StackPanel>
                                        <Button.Tag>
                                            <Binding Path="Id"/>
                                        </Button.Tag>
                                    </Button>

                                    <!-- رفض -->
                                    <Button x:Name="btnReject" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#F44336" 
                                            Foreground="White"
                                            Click="btnReject_Click" Width="50"
                                            Visibility="{Binding StatusEn, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Pending}">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                        </StackPanel>
                                        <Button.Tag>
                                            <Binding Path="Id"/>
                                        </Button.Tag>
                                    </Button>

                                    
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الأزرار الرئيسية -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryColor}" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- طلب إجازة جديد -->


                <!-- أنواع الإجازات -->




                <!-- إغلاق -->
                <Button x:Name="btnClose" 
                        Width="120" Height="45" 
                        Background="#757575" Foreground="{StaticResource ThirdColor}"
                        FontSize="14" FontWeight="Bold"
                        Click="btnClose_Click"
                        Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Icon:PackIconMaterial Kind="Close" Width="20" Height="20" Margin="0,0,10,0"/>
                        <TextBlock Text="إغلاق"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
