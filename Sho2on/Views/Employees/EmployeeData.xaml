<Window x:Class="HR_Application.EmployeeData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="650" Width="1200" MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Transparent"
        Title="بيانات العاملين">

    <Window.Resources>
        <!-- تدرج للقسم العلوي -->
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <!-- نمط للحقول -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideInputFieldStyle" TargetType="TextBox">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- نمط للأزرار -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ThirdColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#1976D2" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- نمط للـ DataGrid -->
        <Style x:Key="EmployeeDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThirdColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <!-- نمط لعناوين DataGrid -->
        
        <!-- نمط لصفوف DataGrid -->
        <Style x:Key="EmployeeRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource MainBackgroundBrush}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- العنوان المحسن -->
            <TextBlock Text="بيانات العاملين" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="14" 
                       FontWeight="Bold" 
                         Foreground="{StaticResource PrimaryColor}"
                       Grid.ColumnSpan="2"/>

            <!-- القسم العلوي المحسن -->
            <Border Grid.Row="1" CornerRadius="0 0 20 20" Background="{StaticResource PrimaryColor}"  >
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center" Margin="10">
                            <!-- الفلاتر الرئيسية -->
                            <StackPanel>
                                <StackPanel Margin="10" Orientation="Horizontal">
                                    <TextBox  VerticalAlignment="Bottom" Name="code_box" Tag="الكود" FlowDirection="RightToLeft" Margin="5 0"/>
                                    <TextBox  VerticalAlignment="Bottom" Name="cardId_box" Tag="الرقم القومي" FlowDirection="RightToLeft" Margin="5 0"/>
                                    <TextBox VerticalAlignment="Bottom" Width="390" Name="name_box" Tag="الاسم" FlowDirection="RightToLeft" Margin="5 0"/>
                                    <TextBox VerticalAlignment="Bottom" Name="holiday_balance_box" Tag="رصيد الاجازات" FlowDirection="RightToLeft" Margin="0 0 0 0"/>

                                    <StackPanel Orientation="Horizontal" Margin="5 0">
                                        <Label VerticalAlignment="Center" Content="تاريخ الميلاد" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                        <DatePicker Width="120" Name="birth_picker" FlowDirection="RightToLeft" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- DatePickers للتعيين -->
                                    <StackPanel Orientation="Horizontal">
                                    <GroupBox BorderBrush="{StaticResource ThirdColor}" Foreground="{StaticResource ThirdColor}" Header="انتهاء" Margin="5">

                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" >
                                            <StackPanel>
                                                <Label Content="التعيين من" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                            <DatePicker Width="120"  Name="from_picker" FlowDirection="RightToLeft" Margin="5"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="الى" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                            <DatePicker Width="120" Name="to_picker" FlowDirection="RightToLeft" Margin="5"/>
                                                
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <!-- DatePickers للانتهاء -->
                                    <GroupBox BorderBrush="{StaticResource ThirdColor}" Foreground="{StaticResource ThirdColor}" Header="انتهاء" Margin="5">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" >
                                            <StackPanel>
                                                <Label Content="من" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                            <DatePicker Width="120" Name="end_from_picker" FlowDirection="RightToLeft" Margin="5"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="الى" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                            <DatePicker Width="120" Name="end_to_picker" FlowDirection="RightToLeft" Margin="5"/>
                                                
                                            </StackPanel>
                                        </StackPanel>
                                        
                                    </GroupBox>

                                    <!-- ComboBoxes والفلاتر الأخرى -->
                                    <StackPanel VerticalAlignment="Top" Orientation="Vertical" Margin="10" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <Label Content="الفرع" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                                <ComboBox x:Name="branchComboBox"  FlowDirection="RightToLeft" Margin="5"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="الوظيفة" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                                <ComboBox x:Name="jobComboBox"  FlowDirection="RightToLeft" Margin="5"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Vertical">
                                                <Label Content="في الخدمة" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                                <ComboBox x:Name="inDutyComboBox" FlowDirection="RightToLeft" Margin="5"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <Label Content="مؤمن عليه" FlowDirection="RightToLeft" Foreground="{StaticResource ThirdColor}"/>
                                                <ComboBox x:Name="insuredComboBox"  FlowDirection="RightToLeft" Margin="5"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- الأزرار -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionButtonStyle}" x:Name="data_load_btn" Click="data_load_btn_Click" Margin="5" ToolTip="بحث في بيانات الموظفين">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Magnify" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="بحث" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" x:Name="clear_btn" Click="clear_btn_Click" Margin="5" ToolTip="مسح جميع الفلاتر">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Refresh" VerticalAlignment="Center" Margin="0 0 5 0"/>

                                            <TextBlock Text="جديد" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" x:Name="excel_btn" Click="excel_btn_Click" Margin="5" ToolTip="تصدير البيانات إلى Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="FileExcel" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="Excel" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DataGrid المحسن -->
            <Border Grid.Row="2" Margin="20" BorderBrush="{StaticResource AccentColor}" BorderThickness="2" Opacity="0.95" CornerRadius="10"  >
                <DataGrid x:Name="list"
                          Style="{StaticResource EmployeeDataGridStyle}"
                          AutoGenerateColumns="False"
                          FlowDirection="RightToLeft"
                          Margin="10"
                          SelectionChanged="list_SelectionChanged"
                          MouseDoubleClick="list_MouseDoubleClick"
                          RowStyle="{StaticResource EmployeeRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="م" Width="40" Binding="{Binding RowNumber}"/>
                        <DataGridTextColumn Header="الكود" Width="60" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="الاسم" Width="200" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="الوظيفة" Width="150" Binding="{Binding Job}"/>
                        <DataGridTextColumn Header="الفرع" Width="120" Binding="{Binding Br}"/>
                        <DataGridTextColumn Header="الإدارة" Width="150" Binding="{Binding Department}"/>
                        <DataGridTextColumn Header="الرقم القومي" Width="120" Binding="{Binding CardNo}"/>
                        <DataGridTextColumn Header="النوع" Width="60" Binding="{Binding Gender}"/>
                        <DataGridTextColumn Header="تاريخ الميلاد" Width="100" Binding="{Binding BirthD, StringFormat=dd/MM/yyyy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="العمر" Width="60" Binding="{Binding Age}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="تاريخ التعيين" Width="100" Binding="{Binding DateT, StringFormat=dd/MM/yyyy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="تاريخ نهاية العمل" Width="100" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="العنوان" Width="200" Binding="{Binding Address}"/>
                        <DataGridTextColumn Header="المرتب" Width="100" Binding="{Binding Salary, StringFormat={}{0:N0}}" Visibility="Visible">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="رصيد الاجازات" Width="100" Binding="{Binding HolidayBalance}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="مؤمن عليه" Width="80" Binding="{Binding Insured}"/>
                        <DataGridTextColumn Header="الهاتف" Width="120" Binding="{Binding Phone}"/>
                        <DataGridTextColumn Header="البريد الإلكتروني" Width="180" Binding="{Binding Email}"/>
                        <DataGridTextColumn Header="الرقم التأميني" Width="120" Binding="{Binding SSN}"/>
                        <DataGridTextColumn Header="التأمين الصحي" Width="120" Binding="{Binding HealthInsurance}"/>
                        <DataGridTextColumn Header="في الخدمة" Width="80" Binding="{Binding InDuty}"/>
                        <DataGridTextColumn Header="تحت التدريب" Width="90" Binding="{Binding UnderTraining}"/>
                        <DataGridTextColumn Header="تحت التوظيف" Width="90" Binding="{Binding UnderEmployment}"/>
                        <DataGridTextColumn Header="القائمة السوداء" Width="90" Binding="{Binding Blacklist}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer مع العدد الإجمالي -->
            <Border Grid.Row="3" Background="{StaticResource PrimaryColor}" CornerRadius="0,0,15,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="معلومات: اضغط مرتين على الصف لفتح بيانات الموظف للتعديل"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="10,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                        <TextBlock Text="العدد الإجمالي: " VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalCount" Text="0"  FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>