<!-- ThemeToggleButton.xaml  —  Drop this anywhere in any Window/UserControl -->
<UserControl x:Class="HR_Application.UserControls.ThemeToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="44" Height="44">

    <UserControl.Resources>
        <!-- Override global Button style for this pill only -->
        <Style x:Key="TogglePillStyle" TargetType="Button">
            <Setter Property="Width"          Value="44"/>
            <Setter Property="Height"         Value="44"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"     Value="{DynamicResource SurfaceLightColor}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderColor}"/>
            <Setter Property="ToolTip"        Value="تبديل الثيم"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="44" Height="44"
                                CornerRadius="22"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                  Color="#00BCD4" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Button x:Name="PART_ToggleBtn"
            Style="{DynamicResource TogglePillStyle}"
            Click="PART_ToggleBtn_Click">
        <!-- Sun icon = currently dark → switch to light -->
        <Icon:PackIconMaterial x:Name="ThemeIcon"
                               Kind="WeatherSunny"
                               Width="20" Height="20"
                               Foreground="{DynamicResource AccentColor}"/>
    </Button>
</UserControl>
