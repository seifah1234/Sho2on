<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════
         DARK THEME  —  Deep Navy + Cyan
    ═══════════════════════════════════════════ -->

    <!-- Identity token so ThemeManager can read current theme -->
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="ThemeName">Dark</sys:String>

    <!-- Core palette -->
    <SolidColorBrush x:Key="PrimaryColor"       Color="#060E17"/>
    <SolidColorBrush x:Key="AccentColor"         Color="#00BCD4"/>
    <SolidColorBrush x:Key="AccentDeepColor"     Color="#0D47A1"/>
    <SolidColorBrush x:Key="SecondaryColor"      Color="#E0F7FA"/>
    <SolidColorBrush x:Key="ThirdColorBrushBrush"          Color="#80DEEA"/>
    <SolidColorBrush x:Key="SurfaceColor"        Color="#0B1929"/>
    <SolidColorBrush x:Key="SurfaceLightColor"   Color="#0D2233"/>
    <SolidColorBrush x:Key="TextMenuColor"       Color="#CFD8DC"/>
    <SolidColorBrush x:Key="BorderColor"         Color="#1E3040"/>
    <SolidColorBrush x:Key="MutedColor"          Color="#546E7A"/>
    <SolidColorBrush x:Key="TextPrimaryColor"    Color="#E0F7FA"/>
    <SolidColorBrush x:Key="TextSecondaryColor"  Color="#E0F7FA"/>
    <SolidColorBrush x:Key="DangerColor"         Color="#EF5350"/>
    <SolidColorBrush x:Key="SuccessColor"        Color="#66BB6A"/>
    <SolidColorBrush x:Key="WarningColor"        Color="#FFA726"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackground"     Color="#0D1F2D"/>
    <SolidColorBrush x:Key="InputForeground"     Color="#E0F7FA"/>
    <SolidColorBrush x:Key="InputHoverBorder"    Color="#2A4A5A"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonHoverBackground"  Color="#0D3344"/>
    <SolidColorBrush x:Key="ButtonHoverForeground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#07111C"/>

    <!-- Lists / DataGrid -->
    <SolidColorBrush x:Key="ListSelectedBackground" Color="#0D2233"/>
    <SolidColorBrush x:Key="ListSelectedForeground" Color="#E0F7FA"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#07111C"/>
    <SolidColorBrush x:Key="DataGridAltRow"         Color="#07111C"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#060E17" Offset="0"/>
        <GradientStop Color="#0A1929" Offset="0.6"/>
        <GradientStop Color="#071520" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#060E17" Offset="0"/>
        <GradientStop Color="#0A1929" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#080F18" Offset="0"/>
        <GradientStop Color="#0B1A28" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#080F18" Offset="0"/>
        <GradientStop Color="#0B1A28" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00BCD4" Offset="0"/>
        <GradientStop Color="#0D47A1" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanHairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="Transparent" Offset="0"/>
        <GradientStop Color="#00BCD4"     Offset="0.5"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <!-- Window root background -->
    <LinearGradientBrush x:Key="WindowRootBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#060E17" Offset="0"/>
        <GradientStop Color="#0A1929" Offset="1"/>
    </LinearGradientBrush>

    <!-- Effects -->
    <DropShadowEffect x:Key="ShadowEffect"  BlurRadius="5"  ShadowDepth="2" Color="Gray"/>
    <DropShadowEffect x:Key="CardShadow"    BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.45"/>
    <DropShadowEffect x:Key="CyanGlow"      BlurRadius="16" ShadowDepth="0" Color="#00BCD4" Opacity="0.45"/>
    <DropShadowEffect x:Key="HeaderShadow"  BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.5"/>

    <ResourceDictionary.MergedDictionaries>

        <materialDesign:CustomColorTheme BaseTheme="Dark" 
                                                PrimaryColor="Blue" 
                                                SecondaryColor="Blue"/>
        <materialDesign:BundledTheme BaseTheme="Dark" 
                                            PrimaryColor="Blue" 
                                            SecondaryColor="Blue" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
