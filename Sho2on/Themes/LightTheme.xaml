<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════
         LIGHT THEME  —  Clean White + Cyan
    ═══════════════════════════════════════════ -->

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib"
                x:Key="ThemeName">Light</sys:String>

    <!-- Core palette -->
    <SolidColorBrush x:Key="PrimaryColor"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentColor"          Color="#0097A7"/>
    <SolidColorBrush x:Key="SecondaryColor"       Color="#006064"/>
    <SolidColorBrush x:Key="TextPrimaryColor"     Color="#1A3C40"/>
    <SolidColorBrush x:Key="ThirdColorBrushBrush" Color="#00838F"/>
    <SolidColorBrush x:Key="TextSecondaryColor"   Color="#37474F"/>
    <SolidColorBrush x:Key="SurfaceColor"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceLightColor"    Color="#E0F7FA"/>
    <SolidColorBrush x:Key="TextMenuColor"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor"          Color="#B2EBF2"/>
    <SolidColorBrush x:Key="MutedColor"           Color="#80CBC4"/>
    <SolidColorBrush x:Key="AccentDeepColor"      Color="#006064"/>
    <SolidColorBrush x:Key="SuccessColor"         Color="#388E3C"/>
    <SolidColorBrush x:Key="WarningColor"         Color="#F57C00"/>
    <SolidColorBrush x:Key="DangerColor"          Color="#D32F2F"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackground"     Color="#F5FDFE"/>
    <SolidColorBrush x:Key="InputForeground"     Color="#1A3C40"/>
    <SolidColorBrush x:Key="InputHoverBorder"    Color="#0097A7"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonHoverBackground"  Color="#B2EBF2"/>
    <SolidColorBrush x:Key="ButtonHoverForeground"  Color="#006064"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#ECEFF1"/>

    <!-- Lists / DataGrid -->
    <SolidColorBrush x:Key="ListSelectedBackground" Color="#B2EBF2"/>
    <SolidColorBrush x:Key="ListSelectedForeground" Color="#006064"/>
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#E0F7FA"/>
    <SolidColorBrush x:Key="DataGridAltRow"         Color="#F5FDFE"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0F7FA" Offset="0"/>
        <GradientStop Color="#F5FDFE" Offset="0.6"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0F7FA" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00838F" Offset="0"/>
        <GradientStop Color="#0097A7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#004D56" Offset="0"/>
        <GradientStop Color="#006064" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0097A7" Offset="0"/>
        <GradientStop Color="#006064" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanHairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="Transparent" Offset="0"/>
        <GradientStop Color="#0097A7"     Offset="0.5"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <!-- Window root background -->
    <LinearGradientBrush x:Key="WindowRootBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0F7FA" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Effects -->
    <DropShadowEffect x:Key="ShadowEffect"  BlurRadius="5"  ShadowDepth="2" Color="#B0BEC5"/>
    <DropShadowEffect x:Key="CardShadow"    BlurRadius="20" ShadowDepth="0" Color="#B0BEC5" Opacity="0.3"/>
    <DropShadowEffect x:Key="CyanGlow"      BlurRadius="16" ShadowDepth="0" Color="#0097A7" Opacity="0.3"/>
    <DropShadowEffect x:Key="HeaderShadow"  BlurRadius="12" ShadowDepth="0" Color="#B0BEC5" Opacity="0.4"/>


    <ResourceDictionary.MergedDictionaries>

        <materialDesign:CustomColorTheme BaseTheme="Light" 
                                                PrimaryColor="Blue" 
                                                SecondaryColor="Blue"/>
        <materialDesign:BundledTheme BaseTheme="Light" 
                                            PrimaryColor="Blue" 
                                            SecondaryColor="Blue" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
