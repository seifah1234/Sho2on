<Window x:Class="HR_Application.ConfirmMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert" WindowStartupLocation="CenterScreen" MinWidth="300" MaxWidth="400" MinHeight="150" Width="350" MaxHeight="150">
    <Grid>
        <TextBlock x:Name="MessageText" Text="Your message here" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" Margin="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button x:Name="CancelButton" Content="Cancel" Width="75" Margin="5" Click="CancelButton_Click" />
            <Button x:Name="OkButton" Content="OK" Width="75" Margin="5" Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
