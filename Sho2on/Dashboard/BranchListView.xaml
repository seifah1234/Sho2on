<!-- BranchListView.xaml -->
<UserControl x:Class="HR_Application.Dashboard.BranchListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent"
             FlowDirection="RightToLeft">

    <UserControl.Resources>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeaderBrush" TargetType="Border">
            <Setter Property="CornerRadius" Value="16 16 0 0"/>
            <Setter Property="Padding"      Value="16,12"/>
            <Setter Property="Background"   Value="{DynamicResource DataGridHeaderBackground}"/>
        </Style>

        <Style x:Key="BranchCard" TargetType="Border">
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00BCD4"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#00BCD4" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BackBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1A00BCD4"/>
            <Setter Property="Foreground"      Value="#00BCD4"/>
            <Setter Property="BorderBrush"     Value="#4400BCD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3300BCD4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI mini card -->
        <Style x:Key="KpiMini" TargetType="Border">
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource MainBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Border Grid.Row="0" CornerRadius="0 0 20 20" Padding="24,16"
                    Background="{DynamicResource HeaderBackground}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.28"/>
                </Border.Effect>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Back button -->
                        <Button Style="{StaticResource BackBtn}" Click="BackBtn_Click" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="ArrowRight" Width="14" Height="14"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource BackToSectors}"/>
                            </StackPanel>
                        </Button>

                        <!-- Icon -->
                        <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00838F" Offset="0"/>
                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Icon:PackIconMaterial Kind="OfficeBuildingOutline" Width="18" Height="18"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Breadcrumb -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SectorTitleText"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryColor}"/>
                            <TextBlock x:Name="SectorSubtitleText"
                                       FontSize="12" Foreground="{DynamicResource MutedColor}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Refresh -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BackBtn}" Click="RefreshBtn_Click" Padding="10,7">
                        <Icon:PackIconMaterial Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Content ── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <Grid Margin="20,16,20,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══ Row 0: Sector-wide KPIs ══ -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- إجمالي الموظفين -->
                        <Border Grid.Column="0" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#003843" Offset="0"/>
                                    <GradientStop Color="#00838F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiTotalEmp" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#80DEEA" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TotalEmployees}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- عدد الفروع -->
                        <Border Grid.Column="1" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D2137" Offset="0"/>
                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiBranchCount" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource NumberOfBranches}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- إجازات معلقة -->
                        <Border Grid.Column="2" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A0A3A" Offset="0"/>
                                    <GradientStop Color="#6A1B9A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiPendingLeaves" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#CE93D8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PendingVacations}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- حضور اليوم -->
                        <Border Grid.Column="3" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1B3A1C" Offset="0"/>
                                    <GradientStop Color="#2E7D32" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiTodayPresent" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#A5D6A7" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource AttendToday}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ Row 1: Branches cards ══ -->
                    <Border Grid.Row="1" Style="{DynamicResource StatCard}" Margin="0,16,0,0" Padding="0">
                        <StackPanel>
                            <Border Style="{DynamicResource CardHeaderBrush}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="MapMarkerMultiple" Width="18" Height="18"
                                                               Foreground="{DynamicResource AccentColor}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource BranchesClickOnABranchToViewItsDepartments}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="12" Padding="10,3"
                                            Background="#1A00BCD4" BorderThickness="1" BorderBrush="#3300BCD4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="BranchCountBadge" Text="0"
                                                       FontSize="13" FontWeight="Bold" Foreground="#00BCD4"/>
                                            <TextBlock Text=" فرع" FontSize="13"
                                                       Foreground="{DynamicResource MutedColor}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Rectangle Height="1" Opacity="0.15">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Padding="12,12,12,16">
                                <ItemsControl x:Name="BranchesPanel" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BranchCard}"
                                                    Width="230"
                                                    MouseLeftButtonUp="BranchCard_Click"
                                                    Tag="{Binding BranchId}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{Binding GradientFrom}" Offset="0"/>
                                                        <GradientStop Color="{Binding GradientTo}"   Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>

                                                <Grid>
                                                    <Rectangle Height="4" VerticalAlignment="Top"
                                                               RadiusX="14" RadiusY="14"
                                                               Fill="{Binding AccentBrush}"/>

                                                    <StackPanel Margin="16,18,16,14">
                                                        <!-- Branch name + icon -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <Border Width="38" Height="38" CornerRadius="10"
                                                                    Background="#22FFFFFF" Margin="0,0,10,0">
                                                                <Icon:PackIconMaterial Kind="MapMarker"
                                                                                       Width="20" Height="20"
                                                                                       Foreground="White"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding BranchName}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" MaxWidth="150"/>
                                                        </StackPanel>

                                                        <!-- Stats grid -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Employees -->
                                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding TotalEmployees}"
                                                                           FontSize="22" FontWeight="Bold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource Employee3}"
                                                                           FontSize="10" Foreground="#CCFFFFFF"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Departments -->
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding TotalDepartments}"
                                                                           FontSize="22" FontWeight="Bold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource Administration}"
                                                                           FontSize="10" Foreground="#CCFFFFFF"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Attendance bar -->
                                                        <StackPanel Margin="0,10,0,0">
                                                            <TextBlock Text="{Binding AttendanceRateText}"
                                                                       FontSize="10" Foreground="#CCFFFFFF"
                                                                       Margin="0,0,0,4"/>
                                                            <Border Height="6" CornerRadius="3"
                                                                    Background="#33FFFFFF">
                                                                <Border x:Name="AttBar"
                                                                        HorizontalAlignment="Right"
                                                                        Height="6" CornerRadius="3"
                                                                        Width="{Binding AttendanceBarWidth}"
                                                                        Background="#AAFFFFFF"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Hint -->
                                                        <Border Margin="0,12,0,0" CornerRadius="8"
                                                                Background="#22FFFFFF" Padding="8,4"
                                                                HorizontalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Icon:PackIconMaterial Kind="ArrowLeftCircle"
                                                                                       Width="12" Height="12"
                                                                                       Foreground="White"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,5,0"/>
                                                                <TextBlock Text="{DynamicResource ViewDepartments}"
                                                                           FontSize="10" Foreground="White"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
