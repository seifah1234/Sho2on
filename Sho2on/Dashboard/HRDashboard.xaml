<!-- HRDashboard.xaml -->
<UserControl x:Class="HR_Application.Dashboard.HRDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        Height="700" Width="1000">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Width" Value="15,8"/>
            <Setter Property="Height" Value="3,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#9C27B0" Padding="20">
            <StackPanel>
                <TextBlock Text="لوحة تحكم شؤون الموظفين" 
                         FontSize="22" 
                         FontWeight="Bold"
                         Foreground="White"/>
                <TextBlock x:Name="WelcomeText" 
                         FontSize="14"
                         Foreground="#F3E5F5"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HR Stats -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- الموظفين الجدد -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="🆕" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NewEmployees" Text="0" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#9C27B0" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="موظفين جدد (شهرياً)" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- المغادرين -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="👋" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LeavingEmployees" Text="0" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#F44336" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="مغادرين (شهرياً)" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- طلبات الإجازة -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="📅" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LeaveRequests" Text="0" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#2196F3" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="طلبات إجازة" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- العقود المنتهية -->
                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ExpiringContracts" Text="0" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#FF9800" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="عقود تنتهي قريباً" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Employee Actions -->
                <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- إدارة الموظفين -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,5,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="👥 إدارة الموظفين" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="إضافة موظف جديد" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenAddEmployee"
                                        Margin="2"/>
                                <Button Content="تعديل بيانات الموظفين" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenEditEmployees"
                                        Margin="2"/>
                                <Button Content="الترقيات والنقل" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenPromotions"
                                        Margin="2"/>
                                <Button Content="إنهاء خدمات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenTerminations"
                                        Margin="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- المستحقات -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="5,0,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="💰 المستحقات والمستقطعات" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="إضافة مرتب أساسي" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenAddSalary"
                                        Margin="2"/>
                                <Button Content="الإضافات والخصومات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenBenefitsDeductions"
                                        Margin="2"/>
                                <Button Content="تقرير المرتبات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenSalaryReport"
                                        Margin="2"/>
                                <Button Content="السلف والخصميات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenLoans"
                                        Margin="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent Employee Changes -->
                <Border Grid.Row="2" Style="{StaticResource StatCard}" Margin="0,15,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="🔄 آخر التغييرات على الموظفين" 
                                 FontSize="16" FontWeight="Bold"
                                 Margin="0,0,0,10"/>

                        <DataGrid x:Name="EmployeeChangesGrid" 
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" 
                                                  Binding="{Binding Date, StringFormat='yyyy-MM-dd'}"/>
                                <DataGridTextColumn Header="الموظف" 
                                                  Binding="{Binding EmployeeName}"/>
                                <DataGridTextColumn Header="نوع التغيير" 
                                                  Binding="{Binding ChangeType}"/>
                                <DataGridTextColumn Header="التفاصيل" 
                                                  Binding="{Binding Details}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>