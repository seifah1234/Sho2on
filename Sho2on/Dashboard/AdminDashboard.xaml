<!-- AdminDashboard.xaml -->
<UserControl x:Class="HR_Application.Dashboard.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Background="Transparent"
        FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Width" Value="15,8"/>
            <Setter Property="Height" Value="3,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border CornerRadius="20" Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="15">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="لوحة تحكم رئيس الإدارة" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="WelcomeText" 
                               FontSize="16"
                               Foreground="#E3F2FD"
                               Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Margin="0,0,0,0">
                    <TextBlock Text="{Binding CurrentDateTime}" 
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding UserBranch}" 
                               FontSize="12"
                               Foreground="#BBDEFB"
                               HorizontalAlignment="Right"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quick Stats -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- إجمالي الموظفين -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalEmployees" Text="0" 
                                     FontSize="28" FontWeight="Bold" 
                                     Foreground="{StaticResource PrimaryColor}" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="إجمالي الموظفين" 
                                     FontSize="14" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الحضور اليوم -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TodayAttendance" Text="0" 
                                     FontSize="28" FontWeight="Bold" 
                                     Foreground="#4CAF50" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="الحضور اليوم من Mobile App" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الغياب -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="❌" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TodayAbsence" Text="0" 
                                     FontSize="28" FontWeight="Bold" 
                                     Foreground="#F44336" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="الغياب اليوم من ال Mobile App" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- المرتبات المستحقة -->
                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PendingSalaries" Text="0" 
                                     FontSize="28" FontWeight="Bold" 
                                     Foreground="#FF9800" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="مرتبات مستحقة" 
                                     FontSize="14" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- طلبات الإجازة -->
                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="📅" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PendingLeaves" Text="0" 
                                     FontSize="28" FontWeight="Bold" 
                                     Foreground="#9C27B0" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="طلبات إجازة" 
                                     FontSize="14" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Charts -->
                <Grid Grid.Row="1" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- نسبة الحضور الشهرية -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📊 نسبة الحضور الشهرية" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="15,15,15,10"/>
                            <lvc:PieChart x:Name="AttendanceChart" 
                                        Series="{Binding AttendanceSeries}"
                                        LegendLocation="Bottom"
                                        Height="250"/>
                        </StackPanel>
                    </Border>

                    <!-- توزيع الموظفين حسب الإدارات -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🏢 توزيع الموظفين حسب الإدارات" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="15,15,15,10"/>
                            <lvc:CartesianChart x:Name="DepartmentChart"
                                                Foreground="Black"
                                              Series="{Binding DepartmentSeries}"
                                              Height="250">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="الإدارات" 
                                              Foreground="{StaticResource PrimaryColor}"
                                            Labels="{Binding DepartmentLabels}"
                                        ShowLabels="True"
                LabelsRotation="-45"
                                        FontSize="10"
                MinWidth="30">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="1"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="العدد" Foreground="{StaticResource PrimaryColor}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <Grid Grid.Row="2" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- إجراءات سريعة -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel Margin="15">
                            <TextBlock Text="⚡ إجراءات سريعة" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,15"/>

                            <WrapPanel>
                                <Button Content="تقرير المرتبات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenSalaryReport"
                                        Padding="10,5"
                                        Margin="5"/>
                                <Button Content="إدارة الموظفين" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenEmployeeManagement"
                                        Margin="5"/>
                                <Button Content="الحضور الشهري" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenMonthlyAttendance"
                                        Margin="5"/>
                                <Button Content="صرف المرتبات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenSalaryPayment"
                                        Margin="5"/>
                                <Button Content="الصلاحيات" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenPermissions"
                                        Margin="5"/>
                                <Button Content="النسخ الاحتياطي" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenBackup"
                                        Margin="5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- النظام والإنذارات -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,0,0">
                        <StackPanel Margin="15">
                            <TextBlock Text="🔔 الإنذارات والإشعارات" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,15"/>

                            <ListView x:Name="AlertsList" Height="150" 
                                    Background="Transparent" 
                                      
                                    BorderThickness="0">
                                
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Margin="0,2" 
                                                Background="#FFF3E0" 
                                                CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" 
                                                         FontSize="16" 
                                                         Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Message}" 
                                                         FontSize="14"
                                                         TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent Activity -->
                <Border Grid.Row="3" Style="{StaticResource StatCard}" Margin="0,30,0,0">
                    <StackPanel Margin="15">
                        <TextBlock Text="🔄 آخر النشاطات" 
                                 FontSize="16" FontWeight="Bold"
                                 Margin="0,0,0,15"/>

                        <DataGrid x:Name="RecentActivityGrid" 
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                HeadersVisibility="Column"
                                Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" 
                                                  Binding="{Binding Date, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                <DataGridTextColumn Header="النشاط" 
                                                  Binding="{Binding ActivityType}"/>
                                <DataGridTextColumn Header="المستخدم" 
                                                  Binding="{Binding User}"/>
                                <DataGridTextColumn Header="التفاصيل" 
                                                  Binding="{Binding Details}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>