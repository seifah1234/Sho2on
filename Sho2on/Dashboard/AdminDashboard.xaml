<!-- AdminDashboard.xaml -->
<UserControl x:Class="HR_Application.Dashboard.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:HR_Application.Dashboard"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <UserControl.Resources>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CardHeaderBrush" TargetType="Border">
            <Setter Property="CornerRadius" Value="16 16 0 0"/>
            <Setter Property="Padding"      Value="16,12"/>
            <Setter Property="Background"   Value="{DynamicResource DataGridHeaderBackground}"/>
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceLightColor}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThirdColor}"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ButtonHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Card Style — clickable -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00BCD4"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#00BCD4" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource MainBackgroundBrush}">
        <Grid>

            <!-- ══════════ LAYER 0: Sectors (Master) ══════════ -->
            <Grid x:Name="MasterView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="0 0 20 20" Padding="24,18"
                        Background="{DynamicResource HeaderBackground}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.3"/>
                    </Border.Effect>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#00BCD4"     Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00838F" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Icon:PackIconMaterial Kind="ViewDashboard" Width="18" Height="18"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="لوحة تحكم رئيس الإدارة"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border CornerRadius="20" Padding="14,5"
                                    Background="{DynamicResource SurfaceLightColor}" BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00BCD4" Offset="0"/>
                                        <GradientStop Color="#0D47A1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Calendar" Width="14" Height="14"
                                                           Foreground="{DynamicResource AccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CurrentDateTime}"
                                               FontSize="13" Foreground="{DynamicResource ThirdColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Grid Margin="20,16,20,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ══ Row 0: Sectors Overview ══ -->
                        <Border Grid.Row="0" Style="{DynamicResource StatCard}" Margin="0,0,0,0" Padding="0">
                            <StackPanel>
                                <!-- Section header -->
                                <Border Style="{DynamicResource CardHeaderBrush}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Icon:PackIconMaterial Kind="OfficeBuildingMarker" Width="18" Height="18"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="القطاعات — اضغط على أي قطاع لعرض فروعه"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryColor}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" CornerRadius="12" Padding="10,3"
                                                Background="#1A00BCD4" BorderThickness="1" BorderBrush="#3300BCD4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SectorCountLabel" Text="0"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#00BCD4"/>
                                                <TextBlock Text=" قطاع" FontSize="13"
                                                           Foreground="{DynamicResource MutedColor}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Rectangle Height="1" Opacity="0.15">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#00BCD4"     Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Sectors cards -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Padding="12,12,12,16">
                                    <ItemsControl x:Name="SectorsPanel" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SectionCard}"
                                                        Width="220"
                                                        MouseLeftButtonUp="SectorCard_Click"
                                                        Tag="{Binding SectorId}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{Binding GradientFrom}" Offset="0"/>
                                                            <GradientStop Color="{Binding GradientTo}"   Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>

                                                    <Grid>
                                                        <Rectangle Height="4" VerticalAlignment="Top"
                                                                   RadiusX="16" RadiusY="16"
                                                                   Fill="{Binding AccentBrush}"/>

                                                        <StackPanel Margin="16,18,16,14">
                                                            <!-- Icon + Name -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                <Border Width="38" Height="38" CornerRadius="10"
                                                                        Background="#22FFFFFF" Margin="0,0,10,0">
                                                                    <Icon:PackIconMaterial Kind="OfficeBuildingOutline"
                                                                                           Width="20" Height="20"
                                                                                           Foreground="White"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding SectorName}"
                                                                           FontSize="14" FontWeight="Bold"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="140"/>
                                                            </StackPanel>

                                                            <!-- Stats -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding TotalEmployees}"
                                                                               FontSize="22" FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="موظف"
                                                                               FontSize="10" Foreground="#CCFFFFFF"
                                                                               HorizontalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding TotalBranches}"
                                                                               FontSize="22" FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="فرع"
                                                                               FontSize="10" Foreground="#CCFFFFFF"
                                                                               HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- View hint -->
                                                            <Border Margin="0,12,0,0" CornerRadius="8"
                                                                    Background="#22FFFFFF" Padding="8,4"
                                                                    HorizontalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Icon:PackIconMaterial Kind="ArrowLeftCircle"
                                                                                           Width="12" Height="12"
                                                                                           Foreground="White"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,5,0"/>
                                                                    <TextBlock Text="عرض الفروع"
                                                                               FontSize="10" Foreground="White"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- ══ Row 1: Quick Actions + Alerts ══ -->
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{DynamicResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Style="{DynamicResource CardHeaderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="LightningBolt" Width="18" Height="18"
                                                                   Foreground="{DynamicResource WarningColor}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="إجراءات سريعة"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryColor}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Rectangle Height="1" Opacity="0.15">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#00BCD4" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <WrapPanel Margin="12,12,12,16">
                                        <Button Content="تقرير المرتبات"   Style="{DynamicResource DashboardButton}" Click="OpenSalaryReport"/>
                                        <Button Content="إدارة الموظفين"  Style="{DynamicResource DashboardButton}" Click="OpenEmployeeManagement"/>
                                        <Button Content="الحضور الشهري"   Style="{DynamicResource DashboardButton}" Click="OpenMonthlyAttendance"/>
                                        <Button Content="صرف المرتبات"    Style="{DynamicResource DashboardButton}" Click="OpenSalaryPayment"/>
                                        <Button Content="الصلاحيات"       Style="{DynamicResource DashboardButton}" Click="OpenPermissions"/>
                                        <Button Content="النسخ الاحتياطي" Style="{DynamicResource DashboardButton}" Click="OpenBackup"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{DynamicResource StatCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <Border Style="{DynamicResource CardHeaderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Bell" Width="18" Height="18"
                                                                   Foreground="#CE93D8"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="الإنذارات والإشعارات"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryColor}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Rectangle Height="1" Opacity="0.15">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#00BCD4" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <ListView x:Name="AlertsList" Height="150"
                                              Background="Transparent" BorderThickness="0"
                                              Margin="12,8,12,12">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background"      Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding"         Value="0"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8" Margin="0,3"
                                                        Background="{DynamicResource SurfaceLightColor}"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        BorderThickness="1" CornerRadius="10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="15"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="13"
                                                                   Foreground="{DynamicResource TextSecondaryColor}"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ══════════ LAYER 1: Branches Detail ══════════ -->
            <Grid x:Name="BranchView" Visibility="Collapsed">
                <local:BranchListView x:Name="BranchDetail"
                                      BackRequested="BranchView_BackRequested"
                                      BranchSelected="BranchView_BranchSelected"/>
            </Grid>

            <!-- ══════════ LAYER 2: Department Detail ══════════ -->
            <Grid x:Name="DepartmentView" Visibility="Collapsed">
                <local:DepartmentDetailView x:Name="DepartmentDetail"
                                            BackRequested="DepartmentView_BackRequested"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>
