<!-- BranchDetailView.xaml -->
<UserControl x:Class="HR_Application.Dashboard.SectionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent"
             FlowDirection="RightToLeft">

    <UserControl.Resources>

        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#000000" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailCardHeader" TargetType="Border">
            <Setter Property="CornerRadius" Value="14 14 0 0"/>
            <Setter Property="Padding"      Value="14,10"/>
            <Setter Property="Background"   Value="{DynamicResource DataGridHeaderBackground}"/>
        </Style>

        <Style x:Key="KpiMini" TargetType="Border">
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
        </Style>

        <Style x:Key="BackBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1A00BCD4"/>
            <Setter Property="Foreground"      Value="#00BCD4"/>
            <Setter Property="BorderBrush"     Value="#4400BCD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3300BCD4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailGrid" TargetType="DataGrid">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextSecondaryColor}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="RowBackground"            Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAltRow}"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
            <Setter Property="ColumnHeaderHeight"       Value="34"/>
            <Setter Property="FontSize"                 Value="12"/>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource MainBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Detail Header ── -->
            <Border Grid.Row="0" CornerRadius="0 0 20 20" Padding="24,16"
                    Background="{DynamicResource HeaderBackground}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.28"/>
                </Border.Effect>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

                <Grid>
                    <!-- Back + Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BackBtn}"
                                Click="BackBtn_Click"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="ArrowRight" Width="14" Height="14"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource BackToTheControlPanel}"/>
                            </StackPanel>
                        </Button>

                        <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00838F" Offset="0"/>
                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Icon:PackIconMaterial Kind="OfficeBuildingMarker" Width="18" Height="18"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SectionTitleText"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryColor}"/>
                            <TextBlock x:Name="SectionSubtitleText"
                                       FontSize="12" Foreground="{DynamicResource MutedColor}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Refresh button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BackBtn}"
                            Click="RefreshBtn_Click" Padding="10,7">
                        <Icon:PackIconMaterial Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Scrollable detail content ── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <Grid Margin="20,16,20,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══ Row 0: KPI strip ══ -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- موظفين -->
                        <Border Grid.Column="0" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#003843" Offset="0"/>
                                    <GradientStop Color="#00838F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiEmployees" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#80DEEA" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TotalEmployees}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ذكور -->
                        <Border Grid.Column="1" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1B3A1C" Offset="0"/>
                                    <GradientStop Color="#2E7D32" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Icon:PackIconMaterial Foreground="#A5D6A7" Kind="HumanMale" Height="40" VerticalAlignment="Center" />
                                <TextBlock x:Name="KpiMaleEmployees" Text="0"
                                           FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="#A5D6A7" HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <!-- اناث -->
                        <Border Grid.Column="2" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B1010" Offset="0"/>
                                    <GradientStop Color="#B71C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Icon:PackIconMaterial Foreground="#EF9A9A" Kind="HumanFemale" Height="40" VerticalAlignment="Center"/>
                                <TextBlock x:Name="KpiFemaleEmployees" Text="0"
                                           FontSize="28" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="#EF9A9A" HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <!-- حضور اليوم -->
                        <Border Visibility="Collapsed" Grid.Column="1" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1B3A1C" Offset="0"/>
                                    <GradientStop Color="#2E7D32" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiPresent" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#A5D6A7" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PresentToday}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- غياب اليوم -->
                        <Border Visibility="Collapsed" Grid.Column="2" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B1010" Offset="0"/>
                                    <GradientStop Color="#B71C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiAbsent" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#EF9A9A" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource AbsentToday}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- طلبات إجازة -->
                        <Border Grid.Column="3" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A0A3A" Offset="0"/>
                                    <GradientStop Color="#6A1B9A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiLeaves" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#CE93D8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PendingVacations}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- مرتبات -->
                        <Border Grid.Column="5" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3A1F00" Offset="0"/>
                                    <GradientStop Color="#E65100" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiSalaries" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#FFCC80" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SalariesOwed}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- إدارات -->
                        <Border Grid.Column="4" Style="{DynamicResource KpiMini}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D2137" Offset="0"/>
                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="KpiApprovedLeaves" Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource AcceptableVacations}"
                                           FontSize="11" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ Row 1: Charts ══ -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attendance pie (section-specific) -->
                        <Border Visibility="Collapsed" Grid.Column="0" Style="{DynamicResource DetailCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <Border Style="{DynamicResource DetailCardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ChartDonut" Width="16" Height="16"
                                                               Foreground="{DynamicResource AccentColor}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource AttendTheSectorToday}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <lvc:PieChart x:Name="SectionAttendancePie"
                                              LegendLocation="Bottom"
                                              Foreground="{DynamicResource TextSecondaryColor}"
                                              Height="230" Margin="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Dept distribution (section-specific) -->
                        <Border Grid.Column="0" Style="{DynamicResource DetailCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <Border Style="{DynamicResource DetailCardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ChartBar" Width="16" Height="16"
                                                               Foreground="{DynamicResource AccentColor}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource DistributionOfEmployeesAmongDepartments}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <lvc:CartesianChart x:Name="SectionDeptBar"
                                                    Foreground="{DynamicResource TextSecondaryColor}"
                                                    Height="230" Margin="10">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis x:Name="SectionDeptAxisX"
                                                  Foreground="{DynamicResource MutedColor}"
                                                  ShowLabels="True" LabelsRotation="-45"
                                                  FontSize="10" MinWidth="30">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="1"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="{DynamicResource Number}"
                                                  Foreground="{DynamicResource MutedColor}"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>

                        <!-- All employees in section -->
                        <Border Grid.Column="1" Style="{DynamicResource DetailCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <Border Style="{DynamicResource DetailCardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="AccountGroup" Width="16" Height="16"
                                        Foreground="{DynamicResource AccentColor}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource BranchEmployees2}"
                            FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryColor}"
                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid x:Name="EmployeesGrid"
                   AutoGenerateColumns="False"
                   IsReadOnly="True" Height="220"
                   Margin="10,8,10,10"
                   Style="{DynamicResource DetailGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource TheName}"
                                     Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Management}"
                                     Binding="{Binding Department.Name}" Width="130"/>
                                        <DataGridTextColumn Header="{DynamicResource Job}"
                                     Binding="{Binding JobTitle.Name}" Width="120"/>
                                        <DataGridTextColumn Header="{DynamicResource BasicSalary}"
                                     Binding="{Binding BasicSalary, StringFormat='{}{0:N0} ج'}"
                                     Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ══ Row 2: Employees grid + Today attendance ══ -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                       
                        <!-- Today attendance list -->
                        <Border Visibility="Collapsed" Grid.Column="1" Style="{DynamicResource DetailCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <Border Style="{DynamicResource DetailCardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="ClipboardCheckOutline" Width="16" Height="16"
                                                               Foreground="#A5D6A7"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource AttendToday}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid x:Name="TodayAttendanceGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True" Height="220"
                                          Margin="10,8,10,10"
                                          Style="{DynamicResource DetailGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Employee}"
                                                            Binding="{Binding User.FullName}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Login2}"
                                                            Binding="{Binding CheckInTime, StringFormat='HH:mm'}"
                                                            Width="70"/>
                                        <DataGridTemplateColumn Header="{DynamicResource TheCondition}" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="6,2"
                                                            HorizontalAlignment="Center"
                                                            Background="{Binding StatusColor}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="11" Foreground="White"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ Row 3: Pending leaves ══ -->
                    <Border Grid.Row="3" Style="{DynamicResource DetailCard}" Margin="0,14,0,0">
                        <StackPanel>
                            <Border Style="{DynamicResource DetailCardHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="CalendarClock" Width="16" Height="16"
                                                           Foreground="#CE93D8"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource PendingLeaveRequests}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="LeavesGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True" Height="180"
                                      Margin="10,8,10,10"
                                      Style="{DynamicResource DetailGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Employee}"
                                                        Binding="{Binding User.FullName}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource LeaveType2}"
                                                        Binding="{Binding LeaveType.Name}" Width="130"/>
                                    <DataGridTextColumn Header="{DynamicResource From}"
                                                        Binding="{Binding StartDate, StringFormat=yyyy/MM/dd}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource To}"
                                                        Binding="{Binding EndDate, StringFormat=yyyy/MM/dd}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource TheDays}"
                                                        Binding="{Binding TotalDays}" Width="60"/>
                                    <DataGridTextColumn Header="{DynamicResource Comments}"
                                                        Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
