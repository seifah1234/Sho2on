<!-- EmployeeDashboard.xaml -->
<UserControl x:Class="HR_Application.Dashboard.EmployeeDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="900"
        FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Width" Value="15,8"/>
            <Setter Property="Height" Value="3,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                    CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#607D8B" Padding="20">
            <StackPanel>
                <TextBlock Text="لوحة تحكم الموظف" 
                         FontSize="20" 
                         FontWeight="Bold"
                         Foreground="White"/>
                <TextBlock x:Name="WelcomeText" 
                         FontSize="14"
                         Foreground="#ECEFF1"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Personal Info -->
                <Border Grid.Row="0" Style="{DynamicResource StatCard}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Profile Image -->
                        <Border Grid.Column="0" 
                                Width="80" Height="80" 
                                CornerRadius="40" 
                                Background="#E0E0E0"
                                Margin="0,0,15,0">
                            <Image x:Name="ProfileImage" Stretch="Uniform"/>
                        </Border>

                        <!-- Employee Details -->
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="EmployeeName" 
                                     FontSize="18" FontWeight="Bold"
                                     Foreground="#333"/>
                            <TextBlock x:Name="EmployeeJob" 
                                     FontSize="14" Foreground="#666"
                                     Margin="0,5,0,0"/>
                            <TextBlock x:Name="EmployeeDepartment" 
                                     FontSize="12" Foreground="#999"
                                     Margin="0,2,0,0"/>
                            <TextBlock x:Name="EmployeeCode" 
                                     FontSize="12" Foreground="#999"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Personal Stats -->
                <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- رصيد الإجازات -->
                    <Border Grid.Column="0" Style="{DynamicResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="🏖️" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LeaveBalance" Text="0" 
                                     FontSize="18" FontWeight="Bold" 
                                     Foreground="#2196F3" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="رصيد الإجازات" 
                                     FontSize="11" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الحضور الشهري -->
                    <Border Grid.Column="1" Style="{DynamicResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="MonthlyAttendance" Text="0%" 
                                     FontSize="18" FontWeight="Bold" 
                                     Foreground="#4CAF50" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="الحضور الشهري" 
                                     FontSize="11" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الراتب الأخير -->
                    <Border Grid.Column="2" Style="{DynamicResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LastSalary" Text="0" 
                                     FontSize="18" FontWeight="Bold" 
                                     Foreground="#FF9800" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="آخر راتب" 
                                     FontSize="11" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ساعات العمل -->
                    <Border Grid.Column="3" Style="{DynamicResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="⏰" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="WorkHours" Text="0" 
                                     FontSize="18" FontWeight="Bold" 
                                     Foreground="#9C27B0" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="ساعات العمل" 
                                     FontSize="11" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Personal Actions -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- الخدمات الذاتية -->
                    <Border Grid.Column="0" Style="{DynamicResource StatCard}" Margin="0,0,5,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="🛠️ الخدمات الذاتية" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="طلب إجازة" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenLeaveRequest"
                                        Margin="2"/>
                                <Button Content="طلب سلفة" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenLoanRequest"
                                        Margin="2"/>
                                <Button Content="بياناتي الشخصية" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenMyProfile"
                                        Margin="2"/>
                                <Button Content="كشف المرتب" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenMySalary"
                                        Margin="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- التقارير -->
                    <Border Grid.Column="1" Style="{DynamicResource StatCard}" Margin="5,0,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="📊 تقاريري" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="حضوري الشهري" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenMyAttendance"
                                        Margin="2"/>
                                <Button Content="مستحقاتي" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenMyBenefits"
                                        Margin="2"/>
                                <Button Content="سجلي الوظيفي" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenMyHistory"
                                        Margin="2"/>
                                <Button Content="مستنداتي" 
                                        Style="{DynamicResource DashboardButton}"
                                        Click="OpenMyDocuments"
                                        Margin="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>