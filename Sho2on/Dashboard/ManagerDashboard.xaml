<!-- ManagerDashboard.xaml -->
<UserControl x:Class="HR_Application.Dashboard.ManagerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        Height="700" Width="1000">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Width" Value="15,8"/>
            <Setter Property="Height" Value="3,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="20">
            <StackPanel>
                <TextBlock Text="لوحة تحكم المدير" 
                         FontSize="22" 
                         FontWeight="Bold"
                         Foreground="White"/>
                <TextBlock x:Name="WelcomeText" 
                         FontSize="14"
                         Foreground="#E8F5E9"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quick Stats -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- فريق العمل -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TeamCount" Text="0" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#4CAF50" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="فريق العمل" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الإنتاجية -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="📈" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="Productivity" Text="0%" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#2196F3" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="معدل الإنتاجية" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- المهام المستحقة -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel Margin="10" HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PendingTasks" Text="0" 
                                     FontSize="22" FontWeight="Bold" 
                                     Foreground="#FF9800" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="مهام مستحقة" 
                                     FontSize="12" Foreground="#666" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Team Management -->
                <Border Grid.Row="1" Style="{StaticResource StatCard}" Margin="0,15,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="فريق العمل" 
                                 FontSize="16" FontWeight="Bold"
                                 Margin="0,0,0,10"/>

                        <DataGrid x:Name="TeamGrid" 
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" 
                                                  Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="الوظيفة" 
                                                  Binding="{Binding Job}"/>
                                <DataGridTextColumn Header="الحضور اليوم" 
                                                  Binding="{Binding TodayAttendance}"/>
                                <DataGridTextColumn Header="حالة المهام" 
                                                  Binding="{Binding TaskStatus}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- تقارير -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,5,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="📊 التقارير" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="تقرير الحضور" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenAttendanceReport"
                                        Margin="2"/>
                                <Button Content="تقرير الإنتاجية" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenProductivityReport"
                                        Margin="2"/>
                                <Button Content="تقرير المهام" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenTasksReport"
                                        Margin="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- إدارة -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="5,0,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="⚙️ الإدارة" 
                                     FontSize="16" FontWeight="Bold"
                                     Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="إدارة الفريق" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenTeamManagement"
                                        Margin="2"/>
                                <Button Content="تقييمات الموظفين" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenEvaluations"
                                        Margin="2"/>
                                <Button Content="طلبات الإجازة" 
                                        Style="{StaticResource DashboardButton}"
                                        Click="OpenLeaveRequests"
                                        Margin="2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>