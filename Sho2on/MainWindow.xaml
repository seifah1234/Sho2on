<Window x:Class="HR_Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        xmlns:themes="clr-namespace:HR_Application.UserControls"
        Height="800" Width="800" MinHeight="400" MinWidth="800"
        Title="{DynamicResource AppTitle}" WindowStyle="ThreeDBorderWindow"
        xmlns:local="clr-namespace:HR_Application"
        Loaded="Window_Loaded"
        FlowDirection="RightToLeft"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>
        <DropShadowEffect x:Key="GlowEffect"   BlurRadius="12" ShadowDepth="0" Color="#00BCD4" Opacity="0.7"/>
        <DropShadowEffect x:Key="CardShadow"   BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.4"/>

        <!-- Storyboards — logic unchanged -->
        <Storyboard x:Key="ExpandAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height" From="0" To="100" Duration="0:0:0.4" FillBehavior="Stop"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" FillBehavior="Stop"/>
        </Storyboard>
        <Storyboard x:Key="CollapseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height" From="100" To="0" Duration="0:0:0.4" FillBehavior="Stop"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4" FillBehavior="Stop"/>
        </Storyboard>

        <!-- ═══ HoverButtonStyle — main nav items ═══ -->
        <Style x:Key="HoverButtonStyle" TargetType="Button">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="{DynamicResource TextMenuColor}"/>
            <Setter Property="Padding"        Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="14"
                                Padding="4">
                            <Grid>
                                <Rectangle x:Name="AccentStripe"
                                           Width="4" HorizontalAlignment="Left"
                                           RadiusX="2" RadiusY="2"
                                           Fill="Transparent"
                                           Margin="0,8,0,8"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background"
                                        Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="AccentStripe" Property="Fill"
                                        Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ TextSubButtonStyle ═══ -->
        <Style x:Key="TextSubButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryColor}"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width"           Value="145"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceLightColor}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Drawer panel shared style ═══ -->
        <Style x:Key="DrawerPanelBorder" TargetType="Border">
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- ════ Window background (theme-aware) ════ -->
        <Border CornerRadius="0 0 20 20" Background="{DynamicResource MainBackgroundBrush}"/>

        <!-- ════ Main layout ════ -->
        <Border CornerRadius="0 0 20 20" Background="{DynamicResource MainBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dashboard content area -->
                <Grid Grid.Column="1" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- Theme toggle button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <Button HorizontalAlignment="Right"
            Margin="2"
            Style="{DynamicResource HoverButtonStyle}"
                                    Name="DashboardDisplay"
            Click="DashboardDisplay_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceLightColor}" CornerRadius="12" 
            Height="50"
                                    Width="50">

                                        <Icon:PackIconMaterial
                                       Kind="ViewDashboardOutline"
                                       Width="20" Height="20"
                                       Foreground="{DynamicResource AccentColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Right"
            Margin="2"
            Style="{DynamicResource HoverButtonStyle}"
                                    Name="TasksBtn"
            Click="TasksBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceLightColor}" CornerRadius="12" 
            Height="50"
                                    Width="50">

                                        <Icon:PackIconMaterial
                                       Kind="CheckboxMarkedCircle"
                                       Width="20" Height="20"
                                       Foreground="{DynamicResource AccentColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Right"
            Margin="2"
            Style="{DynamicResource HoverButtonStyle}"
                                    Name="ChatsBtn"
            Click="ChatsBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceLightColor}" CornerRadius="12" 
            Height="50"
                                    Width="50">

                                        <Grid>
                                            
                                        <Icon:PackIconMaterial
                                       Kind="Chat"
                                       Width="30" Height="30"
                                       Foreground="{DynamicResource AccentColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <Border x:Name="ChatBadge" Background="Red" CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                            <TextBlock x:Name="ChatBadgeText" Text="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Right"
        Margin="2"
        Style="{DynamicResource HoverButtonStyle}"
        Click="ThemeToggle_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceLightColor}" x:Name="ThemeIconBorder" CornerRadius="12" 
            Height="50"
                                    Width="50">

                                    <Icon:PackIconMaterial x:Name="ThemeModeIcon"
                                   Kind="WeatherSunny"
                                   Width="20" Height="20"
                                   Foreground="{DynamicResource AccentColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="20" Padding="14,5"
            Background="{DynamicResource SurfaceLightColor}" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00BCD4" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="Calendar" Width="14" Height="14"
                                   Foreground="{DynamicResource AccentColor}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding CurrentDateTime}"
                       FontSize="13" Foreground="{DynamicResource ThirdColor}"
                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>


                        <TextBlock x:Name="WelcomeText"
                                   HorizontalAlignment="Left"
                                       FontSize="24" Foreground="{DynamicResource MutedColor}"
                                       Margin="48,4,0,0"/>

                    </Grid>
                    
                    <Image Margin="20" Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Stretch="Uniform"
                            x:Name="GIFBack" Source="/assets/images/Back.gif"/>
                    <Grid Background="Transparent" Grid.Row="1" Name="dashboardControl" Visibility="Collapsed">
                    </Grid>
                </Grid>

                <!-- ════════════════ Sidebar ════════════════ -->
                <Border Panel.ZIndex="1000"
                        Grid.Column="0"
                        x:Name="SideBar"
                        HorizontalAlignment="Left"
                        Width="240"
                        CornerRadius="0 24 24 0"
                        Background="{DynamicResource SidebarBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                    </Border.Effect>
                    <!-- Accent edge line -->
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#00BCD4"     Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>0,0,1,0</Border.BorderThickness>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
                        <DockPanel Margin="0">

                            <!-- Hidden menu button — unchanged -->
                            <Button Visibility="Collapsed"
                                    Name="menu_btn"
                                    MouseLeave="menu_btn_MouseLeave"
                                    Click="menu_btn_Click"
                                    MouseEnter="menu_btn_MouseEnter"
                                    Width="35" Height="35"
                                    Style="{x:Null}"
                                    Background="Transparent"
                                    DockPanel.Dock="Top"
                                    HorizontalAlignment="Left"
                                    BorderThickness="0"
                                    VerticalAlignment="Top"
                                    Margin="10">
                                <Icon:PackIconMaterial Kind="Menu" Foreground="#FFFFFF" Width="25" Height="25"/>
                            </Button>

                            <!-- Logo / Avatar -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,32,0,24" HorizontalAlignment="Center">
                                <Border HorizontalAlignment="Center"
                                        CornerRadius="50" Width="86" Height="86"
                                        BorderThickness="2">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00BCD4" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#00BCD4" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Border CornerRadius="50" Background="{DynamicResource AccentColor}" Margin="3">
                                        <Image Name="GIFIcon" Stretch="Fill" Height="72" Width="68"
                                               Source="assets/images/icon.gif"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Border>

                                <!-- Badge -->
                                <Border HorizontalAlignment="Center" Margin="0,10,0,0"
                                        CornerRadius="20" Padding="14,4"
                                        Background="{DynamicResource SurfaceLightColor}"
                                        BorderThickness="1">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00BCD4" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <TextBlock Text="{DynamicResource HumanResourcesSystem}"
                                               Foreground="{DynamicResource ThirdColor}"
                                               FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Separator -->
                            <Rectangle DockPanel.Dock="Top" Height="1" Margin="20,0,20,16" Opacity="0.2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- ════ Nav items ════ -->
                            <StackPanel Margin="8,0,8,0" DockPanel.Dock="Top" Orientation="Vertical">

                                <TextBlock Text="{DynamicResource MainMenu}"
                                           Foreground="{DynamicResource MutedColor}"
                                           FontSize="10" FontWeight="Bold"
                                           Margin="16,0,16,8"
                                           HorizontalAlignment="Right"/>

                                <!-- Reports -->
                                <Button Visibility="{Binding ReportP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=ReportP}"
                                        Name="reports_btn" Click="Panel_btn_Click"
                                        Style="{DynamicResource HoverButtonStyle}"
                                        Tag="ReportPanel" Height="58" Margin="4,2,4,2">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource SurfaceLightColor}">
                                            <Icon:PackIconMaterial Kind="ChartBar" Width="20" Height="20"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Reports}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMenuColor}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel HorizontalAlignment="Center" Name="ReportPanel" Visibility="Collapsed"
                                            Margin="12,4,12,8" Orientation="Vertical">
                                    <Button Margin="3" Click="EmployeeDataOpen"
                                            Visibility="{Binding EmploDataP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=EmploDataP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource EmployeeData}" Foreground="{DynamicResource SecondaryColor}"/>
                                    <Button Margin="3" Click="EmployeeMonthOpen"
                                            Visibility="{Binding EmploMonthP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=EmploMonthP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource MonthlyEmployees}"/>
                                </StackPanel>

                                <!-- Employee Affairs -->
                                <Button Visibility="{Binding EmploP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=EmploP}"
                                        Click="Panel_btn_Click" Tag="EmployeePanel"
                                        Style="{DynamicResource HoverButtonStyle}" Height="58" Margin="4,2,4,2">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource SurfaceLightColor}">
                                            <Icon:PackIconMaterial Kind="AccountGroup" Width="20" Height="20"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource PersonnelAffairs}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMenuColor}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel HorizontalAlignment="Center" Name="EmployeePanel" Visibility="Collapsed"
                                            Margin="12,4,12,8" Orientation="Vertical">
                                    <Button Margin="3" Tag="ErrandsPanel" Click="Errands_MouseLeftButtonDown"
                                            Visibility="{Binding ErrandP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=ErrandP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Requests}"/>
                                    <Button Margin="3" Tag="HolidayManagementPanel" Click="HolidayManagement_MouseLeftButtonDown"
                                            Visibility="{Binding HolidaysManagementP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=HolidaysManagementP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource LeaveManagement}"/>
                                    <Button Margin="3" Click="AddEmploOpen"
                                            Visibility="{Binding AddEmploP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AddEmploP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource EmployeeManagement}"/>
                                    <Button Margin="3" Width="140" FontSize = "12" Content="{DynamicResource EmployeeEvaluation}"
                                            Click="OpenEvaluation_Click" FlowDirection="RightToLeft"
                                            Visibility="{Binding EmpEvalP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=EmpEvalP}"/>
                                    <Button Margin="3" x:Name="uploadEmployeesBtn" Click="uploadEmployeesBtn_Click"
                                            Visibility="{Binding uploadEmployeesP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=uploadEmployeesP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource ImportEmployees}"/>
                                </StackPanel>

                                <!-- Attendance -->
                                <Button Visibility="{Binding AttendanceP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AttendanceP}"
                                        Click="Panel_btn_Click" Tag="AttendancePanel"
                                        Style="{DynamicResource HoverButtonStyle}" Height="58" Margin="4,2,4,2">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource SurfaceLightColor}">
                                            <Icon:PackIconMaterial Kind="LocationEnter" Width="20" Height="20"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Attendance}" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMenuColor}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel HorizontalAlignment="Center" Name="AttendancePanel" Visibility="Collapsed"
                                            Margin="12,4,12,8" Orientation="Vertical">
                                    <Button Margin="3" Click="DataEditOpen"
                                            Visibility="{Binding DataEditP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=DataEditP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource ReviewRecords}"/>
                                    <Button Margin="3" Click="AddAttendOpen"
                                            Visibility="{Binding ManualP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=ManualP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Manual}"/>
                                    <Button Margin="3" Click="MonthlyDataOpen"
                                            Visibility="{Binding MonthlyP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=MonthlyP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource MonthlyRecords}"/>
                                </StackPanel>

                                <!-- Salary -->
                                <Button Visibility="{Binding SalaryP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=SalaryP}"
                                        Click="Panel_btn_Click" Tag="SalaryPanel"
                                        Style="{DynamicResource HoverButtonStyle}" Height="58" Margin="4,2,4,2">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource SurfaceLightColor}">
                                            <Icon:PackIconMaterial Kind="CashMultiple" Width="20" Height="20"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Payroll}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMenuColor}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel HorizontalAlignment="Center" Name="SalaryPanel" Visibility="Collapsed"
                                            Margin="12,4,12,8" Orientation="Vertical">
                                    <Button Margin="3" Click="AddMainSalary"
                                            Visibility="{Binding AddMainSalaryP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AddMainSalaryP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource EmployeeFinancials}"/>
                                    <Button Margin="3" Click="SalaryReport"
                                            Visibility="{Binding SalaryReportP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=SalaryReportP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft">
                                        <TextBlock Text="{DynamicResource SalaryReport}" FontSize="14"/>
                                    </Button>
                                    <Button Margin="3" Click="EmployeeSalaryDataOpen"
                                            Visibility="{Binding EmploSalaryDataP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=EmploSalaryDataP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" >
                                        <TextBlock Text="{DynamicResource EmployeeSalaries}" FontSize="13" FontWeight="Normal"/>
                                    </Button>
                                    <Button Margin="3" Click="AddDeductions"
                                            Visibility="{Binding AddDeductionsP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AddDeductionsP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft">
                                        <TextBlock Text="{DynamicResource BenefitsDeductions}" FontSize="13" FontWeight="Normal"/>
                                    </Button>
                                    <Button Margin="3" x:Name="btnImportCommissions"
                                            Visibility="{Binding UploadCommessionsP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=UploadCommessionsP}"
                                            Click="btnImportCommissions_Click"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft">
                                        <TextBlock Text="{DynamicResource ImportCommissions}" FontSize="13" FontWeight="Normal"/>
                                    </Button>
                                    <Button Margin="3" Click="MonthlySalaryDataOpen"
                                            Visibility="{Binding MonthlyP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=MonthlyP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource MonthlyData}"/>
                                    <Button Margin="3" Click="BulkSalaryPaymentOpen"
                                            Visibility="{Binding BulkSalaryPaymentP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=BulkSalaryPaymentP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource BulkSalaryPayment}"/>
                                    <Button Margin="3" Click="LoanManagementOpen" Tag="LoanManagementPanel"
                                            Visibility="{Binding LoanManagementP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=LoanManagementP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource LoanManagement}"/>
                                </StackPanel>

                                <!-- FingerPrints -->
                                <Button Visibility="{Binding MachineP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=MachineP}"
                                        Click="Panel_btn_Click" Tag="FingerPrintsPanel"
                                        Style="{DynamicResource HoverButtonStyle}" Height="58" Margin="4,2,4,2">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource SurfaceLightColor}">
                                            <Icon:PackIconMaterial Kind="Fingerprint" Width="20" Height="20"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource FingerPrints}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMenuColor}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel HorizontalAlignment="Center" Name="FingerPrintsPanel" Visibility="Collapsed"
                                            Margin="12,4,12,8" Orientation="Vertical">
                                    <Button Margin="3" Click="AddMachineOpen"
                                            Visibility="{Binding AddMachineP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AddMachineP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Add}"/>
                                    <Button Margin="3" Click="GetDataClicked"
                                            Visibility="{Binding GetDataP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=GetDataP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft">
                                        <TextBlock Text="{DynamicResource UploadFingerprint}" FontSize="13"/>
                                    </Button>
                                    <Button Margin="3" Click="download_data_btn_ButtonClicked"
                                            Visibility="{Binding DownloadDataP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=DownloadDataP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource DownloadData}"/>
                                    <Button Margin="3" Click="upload_data_btn_ButtonClicked"
                                            Visibility="{Binding UploadDataP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=UploadDataP}"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource UploadData}"/>
                                    <Button Margin="3" Click="BtnGenerateTemplate_Click"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource DownloadTemplate}"/>
                                </StackPanel>

                                <!-- Settings -->
                                <Button Visibility="{Binding SettingsP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=SettingsP}"
                                        Click="Panel_btn_Click" Tag="SettingsPanel"
                                        Style="{DynamicResource HoverButtonStyle}" Height="58" Margin="4,2,4,2">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource SurfaceLightColor}">
                                            <Icon:PackIconMaterial Kind="Cog" Width="20" Height="20"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Settings}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMenuColor}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel HorizontalAlignment="Center" Name="SettingsPanel" Visibility="Collapsed"
                                            Margin="12,4,12,8" Orientation="Vertical">
                                    <Button Margin="3"
                                            Visibility="{Binding AllDatasP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AllDatasP}"
                                            Click="Datas_MouseLeftButtonDown" Tag="DatasPanel"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource AddData}"/>
                                    <Button Margin="3"
                                            Visibility="{Binding AllPermissionP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AllPermissionP}"
                                            Click="Permission_MouseLeftButtonDown" Tag="PermissionsPanel"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Permissions}"/>
                                    <Button Margin="3"
                                            Visibility="{Binding Backup, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Backup}"
                                            Click="Backup_Button_Click"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Backup}"/>
                                    <Button Margin="3"
                                            Visibility="{Binding AllSettingsP, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=AllSettingsP}"
                                            Tag="MainSettingsPanel" Click="MainSettings_MouseLeftButtonDown"
                                            Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource GeneralSettings}"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- Separator before bottom actions -->
                            <Rectangle DockPanel.Dock="Bottom" Height="1" Margin="20,12,20,0" Opacity="0.15">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#00BCD4"     Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- ════ Bottom: Theme toggle + Logout ════ -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,16">

                                
                                <!-- Logout button -->
                                <Button Name="logout_btn"
                                        Click="logout_btn_Click"
                                        Style="{DynamicResource HoverButtonStyle}"
                                        Height="52" Margin="4,4,4,0">
                                    <StackPanel Width="192" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="12" Width="40" Height="40" Margin="4,0,0,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1A0A0A" Offset="0"/>
                                                    <GradientStop Color="#2D0A0A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Icon:PackIconMaterial Kind="Logout" Width="20" Height="20"
                                                                   Foreground="#EF5350"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Logout}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="#EF9A9A"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </DockPanel>
                    </ScrollViewer>
                </Border>

                <!-- ════════════════ Drawer Panels ════════════════ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DatasPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1"
                          x:Name="DatasPanel" HorizontalAlignment="Right" Width="185">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform" X="-250"/>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource DrawerPanelBorder}">
                            <StackPanel Margin="10,16,10,10" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource Data}" Foreground="{DynamicResource AccentColor}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Button Margin="3" Click="AddDepartOpen"  IsEnabled="{Binding DepartP}"  Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Departments}"/>
                                <Button Margin="3" Click="AddQualificationOpen"  IsEnabled="{Binding QualificationP}"  Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Qualifications}"/>
                                <Button Margin="3" Click="AddJobOpen"     IsEnabled="{Binding JobP}"     Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Jobs}"/>
                                <Button Margin="3" Click="AddJobDegreeOpen" IsEnabled="{Binding DegreeP}" Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Sectors}"/>
                                <Button Margin="3" Click="AddAreaOpen" IsEnabled="{Binding AreaP}" Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Areas}"/>
                                <Button Margin="3" Click="AddShiftOpen"   IsEnabled="{Binding ShiftP}"   Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Shifts}"/>
                                <Button Margin="3" Visibility="Collapsed" Click="AddBreakOpen" IsEnabled="{Binding BreakP}" Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Breaks}"/>
                                <Button Margin="3" FontSize="12" Click="AddLateOpen" IsEnabled="{Binding LateP}" Width="140" FlowDirection="RightToLeft" Content="{DynamicResource LateOvertime}"/>
                                <Button Margin="3" Click="AddHoliOpen"    IsEnabled="{Binding WHP}"      Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource WeeklyHolidays}"/>
                                <Button Margin="3" Click="AddHoliTypeOpen" IsEnabled="{Binding HTypeP}"  Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource LeaveTypes}"/>
                                <Button Margin="3" Click="AddOfficalsOpen" IsEnabled="{Binding OfficalsP}"  Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Officials}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PermissionsPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1"
                          x:Name="PermissionsPanel" HorizontalAlignment="Right" Width="185">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform1" X="-250"/>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource DrawerPanelBorder}">
                            <StackPanel Margin="10,16,10,10" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource Permissions}" Foreground="{DynamicResource AccentColor}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Button Margin="3" Click="PermissionsOpen"     IsEnabled="{Binding PermissionP}"   Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource ProgramPermissions}"/>
                                <Button Margin="3" Click="UserPermissionsOpen"  IsEnabled="{Binding UserPermissionP}" Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource UserPermissions}"/>
                                <Button Margin="3" Click="BranchPermissionsOpen" IsEnabled="{Binding BranchPermissionP}" Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource BranchPermissions}"/>
                                <Button Margin="3" Click="AddRoleOpen"         IsEnabled="{Binding RoleP}"         Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Groups}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- MainSettingsPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1"
                          x:Name="MainSettingsPanel" HorizontalAlignment="Right" Width="185">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform2" X="-250"/>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource DrawerPanelBorder}">
                            <StackPanel Margin="10,16,10,10" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource Settings}" Foreground="{DynamicResource AccentColor}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Button Margin="3" Click="SettingsOpen"   IsEnabled="{Binding MonthSettingP}" Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource GeneralSettings}"/>
                                <Button Margin="3" Click="ArchiveOpen"    IsEnabled="{Binding ArchiveP}"      Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource Archive}"/>
                                <Button Margin="3" Click="StorageOpen"    IsEnabled="{Binding StorageP}"      Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource FileStorage}"/>
                                <Button Margin="3" Click="AddBranchOpen"  IsEnabled="{Binding BranchP}"       Width="140" FontSize = "12" FlowDirection="RightToLeft" Content="{DynamicResource AddBranches}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- HolidayManagementPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1"
                          x:Name="HolidayManagementPanel" HorizontalAlignment="Right" Width="185">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform3" X="-250"/>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource DrawerPanelBorder}">
                            <StackPanel Margin="10,16,10,10" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource LeaveManagement}" Foreground="{DynamicResource AccentColor}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Button Margin="3" x:Name="btnManageBalance" IsEnabled="{Binding ManageBalanceP}"
                                        Width="140" FontSize = "12" Click="btnManageBalance_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="AccountCash" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource ManageBalance}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnHoliRequests" IsEnabled="{Binding HoliRequestsP}"
                                        Width="140" FontSize = "12" Click="HolidaysManagementOpen">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="AccountCash" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource LeaveRequests}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnNewRequest" IsEnabled="{Binding NewRequestP}"
                                        Width="140" FontSize = "12" FontWeight="Bold" Click="btnNewRequest_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource LeaveRequest}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnManageLeaveTypes" IsEnabled="{Binding ManageLeaveTypesP}"
                                        Width="140" FontSize = "12" FontWeight="Bold" Click="btnManageLeaveTypes_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="FormatListBulleted" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource LeaveTypes}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnBalanceReport" IsEnabled="{Binding BalanceReportP}"
                                        Width="140" FontSize = "12" FontWeight="Bold" Click="btnBalanceReport_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="ChartBar" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource BalanceReport}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ErrandsPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1"
                          x:Name="ErrandsPanel" HorizontalAlignment="Right" Width="185">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform5" X="-250"/>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource DrawerPanelBorder}">
                            <StackPanel Margin="10,16,10,10" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource Requests}" Foreground="{DynamicResource AccentColor}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Button Margin="3" Width="140" FontSize = "12" IsEnabled="{Binding NewMissionP}" Click="ErrandsOpen">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource MissionRequest}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" Width="140" FontSize = "12" IsEnabled="{Binding ManageMissionP}" Click="ErrandsRequestsOpen">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="AccountCash" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource MissionRequests}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnPermissionRequests" IsEnabled="{Binding PermissionRequestsP}"
                                        Width="140" FontSize = "12" Click="btnPermissionRequests_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="AccountCash" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource PermissionRequests}"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnPermissionNewRequest" IsEnabled="{Binding NewPermissionRequestP}"
                                        Width="140" FontSize = "12" FontWeight="Bold" Click="btnPermissionNewRequest_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource PermissionRequest}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LoanManagementPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1"
                          x:Name="LoanManagementPanel" HorizontalAlignment="Right" Width="185">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform4" X="-250"/>
                        </Grid.RenderTransform>
                        <Border Style="{DynamicResource DrawerPanelBorder}">
                            <StackPanel Margin="10,16,10,10" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource LoanManagement}" Foreground="{DynamicResource AccentColor}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Button Margin="3" x:Name="btnLoanRequest" IsEnabled="{Binding LoanRequestP}"
                                        Width="140" FontSize = "12" Click="btnLoanRequest_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="CashMinus" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource LoanRequest}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnLoanApprove" IsEnabled="{Binding LoanApproveP}"
                                        Width="140" FontSize = "12" Click="btnLoanApprove_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="CashCheck" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource LoanApproval}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="3" x:Name="btnFriendBoxReport" IsEnabled="{Binding FriendBoxReportP}"
                                        Width="140" FontSize = "12" Click="btnFriendBoxReport_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="CashCheck" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{DynamicResource FriendshipFundStatement}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Border>

        <!-- ════════════ Drawer Storyboards — all names & targets preserved ════════════ -->
        <Grid.Resources>
            <Storyboard x:Key="ShowDrawer">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform"  Storyboard.TargetProperty="X" To="180" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="HideDrawer">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform"  Storyboard.TargetProperty="X" To="-250" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="ShowDrawer1">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform1" Storyboard.TargetProperty="X" To="180" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="HideDrawer1">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform1" Storyboard.TargetProperty="X" To="-250" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="ShowDrawer2">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform2" Storyboard.TargetProperty="X" To="180" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="HideDrawer2">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform2" Storyboard.TargetProperty="X" To="-250" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="ShowDrawer3">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform3" Storyboard.TargetProperty="X" To="180" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="HideDrawer3">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform3" Storyboard.TargetProperty="X" To="-250" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="ShowDrawer4">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform4" Storyboard.TargetProperty="X" To="180" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="HideDrawer4">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform4" Storyboard.TargetProperty="X" To="-250" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="ShowDrawer5">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform5" Storyboard.TargetProperty="X" To="180" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="HideDrawer5">
                <DoubleAnimation Storyboard.TargetName="DrawerTransform5" Storyboard.TargetProperty="X" To="-250" Duration="0:0:0.3"/>
            </Storyboard>
        </Grid.Resources>
    </Grid>
</Window>
