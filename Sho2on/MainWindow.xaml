<Window x:Class="HR_Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:uc="clr-namespace:HR_Application.UserControls"
        Height="800" Width="800" MinHeight="400" MinWidth="800"
        Title="OR HR" WindowStyle="ThreeDBorderWindow"
        Loaded="Window_Loaded"
        FlowDirection="RightToLeft"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" 
        Background="Transparent">
    <Window.Resources>
        <!-- تأثير ظل -->
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="5" ShadowDepth="2" Color="Gray"/>

        <!-- تحديث الـ Storyboards للانيميشن -->
        <Storyboard x:Key="ExpandAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                    From="0" To="100"
                    Duration="0:0:0.4"
                    FillBehavior="Stop"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                    From="0" To="1"
                    Duration="0:0:0.4"
                    FillBehavior="Stop"/>
        </Storyboard>

        <Storyboard x:Key="CollapseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                    From="100" To="0"
                    Duration="0:0:0.4"
                    FillBehavior="Stop"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                    From="1" To="0"
                    Duration="0:0:0.4"
                    FillBehavior="Stop"/>
        </Storyboard>

        <!-- تحسين أنماط الأزرار -->
        <Style x:Key="HoverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentColor}" 
                                    BorderThickness="1" BorderBrush="#FFFFFF"
                                    CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource SecondaryColor}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="DimGray" 
                BorderThickness="1" BorderBrush="White"
                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Margin" Value="5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- تحسين أنماط الأزرار النصية -->
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentColor}" 
                BorderThickness="0" BorderBrush="White"
                CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" 
          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource SecondaryColor}"/>
                    <Setter Property="FontSize" Value="15"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" 
      BorderThickness="1" BorderBrush="White"
      CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" 
VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource SecondaryColor}"/>
                    <Setter Property="FontSize" Value="14"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="DimGray" 
      BorderThickness="1" BorderBrush="White"
      CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" 
VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Margin" Value="5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- تحسين أنماط الأزرار الفرعية -->
        <Style x:Key="TextSubButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="10"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#BBDEFB" CornerRadius="10"
      BorderThickness="0" BorderBrush="White">
                                    <ContentPresenter HorizontalAlignment="Center" 
VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontSize" Value="15"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF" CornerRadius="10"
      BorderThickness="0" BorderBrush="White">
                                    <ContentPresenter HorizontalAlignment="Center" 
VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#263238"/>
                    <Setter Property="FontSize" Value="14"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="DimGray" CornerRadius="10"
      BorderThickness="1" BorderBrush="White">
                                    <ContentPresenter HorizontalAlignment="Center" 
VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Margin" Value="5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
       <Border Background="{StaticResource MainBackgroundBrush}" CornerRadius="0 0 20 20"  >
        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent" Name="dashboardControl" Grid.Column="1" Margin="5">
                    <Image Visibility="Collapsed" Margin="0 40 0 0" x:Name="GIFBack" Source="assets/images/Back.gif"/>
                    
                </Grid>
                <Border Panel.ZIndex="1000" Grid.Column="0" x:Name="SideBar" HorizontalAlignment="Left" Width="230" CornerRadius="0 20 20 20" Background="{StaticResource HeaderBackground}"  >
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0 0 0 0" FlowDirection="RightToLeft">
                        <DockPanel Margin="0 0 0 0">
                            <Button Visibility="Collapsed" Name="menu_btn" MouseLeave="menu_btn_MouseLeave" Click="menu_btn_Click" MouseEnter="menu_btn_MouseEnter" Width="35" Height="35" Style="{x:Null}" Background="Transparent" DockPanel.Dock="Top" HorizontalAlignment="Left" BorderThickness="0" VerticalAlignment="Top" Margin="10">
                                <Icon:PackIconMaterial Kind="Menu" Foreground="#FFFFFF" Width="25" Height="25"/>
                            </Button>

                            <Border HorizontalAlignment="Center" DockPanel.Dock="Top" CornerRadius="100" Background="#FFFFFF" Width="80" Height="75" Margin="0 25 0 0">
                                <Image Name="GIFIcon" Stretch="Fill" Height="75" Width="70" Source="assets/images/icon.gif"/>
                            </Border>

                            <StackPanel Margin="0 10 0 0" DockPanel.Dock="Top" Orientation="Vertical">
                                <!-- زر التقارير مع أيقونة -->
                                <Button IsEnabled="{Binding ReportP}" Name="reports_btn" Click="Panel_btn_Click" Style="{StaticResource HoverButtonStyle}" Cursor="Hand" Tag="ReportPanel" Height="60" Margin="0 0 0 10" BorderThickness="0" Background="Transparent">
                                    <StackPanel Width="180" Orientation="Horizontal">
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="2" BorderThickness="1">
                                            <Icon:PackIconMaterial Kind="ChartBar"  Width="45" Height="45"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" Text="التقارير" Margin="25 0 0 0"  FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel HorizontalAlignment="Center" Name="ReportPanel" Visibility="Collapsed" Margin="20 10 20 10" Orientation="Vertical">
                                    <Button Click="EmployeeDataOpen" IsEnabled="{Binding EmploDataP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="بيانات الموظفين"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="EmployeeMonthOpen" IsEnabled="{Binding EmploMonthP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="شهري الموظفين"/>
                                </StackPanel>

                                <!-- زر شئون العاملين مع أيقونة -->
                                <Button IsEnabled="{Binding EmploP}" Click="Panel_btn_Click" Cursor="Hand" Tag="EmployeePanel" Style="{StaticResource HoverButtonStyle}" Height="60" Margin="0 10 0 10" BorderThickness="0" Background="Transparent">
                                    <StackPanel Width="180" Orientation="Horizontal">
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="2" BorderThickness="1">
                                            <Icon:PackIconMaterial Kind="AccountGroup"  Width="45" Height="45"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" Text="شئون العاملين" Margin="25 0 0 0" FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel HorizontalAlignment="Center" Name="EmployeePanel" Visibility="Collapsed" Margin="20 10 20 10" Orientation="Vertical">
                                    <Button Tag="ErrandsPanel" Click="Errands_MouseLeftButtonDown" IsEnabled="{Binding ErrandP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="الاجراءات"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Tag="HolidayManagementPanel" Click="HolidayManagement_MouseLeftButtonDown"  IsEnabled="{Binding HolidaysManagementP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="ادارة الاجازات"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="AddEmploOpen" IsEnabled="{Binding AddEmploP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="ادارة موظف"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button x:Name="uploadEmployeesBtn" Click="uploadEmployeesBtn_Click" IsEnabled="{Binding uploadEmployeesP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="رفع ملف الموظفين"/>
                                </StackPanel>

                                <!-- زر شئون العاملين مع أيقونة -->
                                <Button IsEnabled="{Binding AttendanceP}" Click="Panel_btn_Click" Cursor="Hand" Tag="AttendancePanel" Style="{StaticResource HoverButtonStyle}" Height="60" Margin="0 10 0 10" BorderThickness="0" Background="Transparent">
                                    <StackPanel Width="180" Orientation="Horizontal">
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="2" BorderThickness="1">
                                            <Icon:PackIconMaterial Kind="LocationEnter"  Width="45" Height="45"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" Text="الحضور و الانصراف" Margin="25 0 0 0" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel HorizontalAlignment="Center" Name="AttendancePanel" Visibility="Collapsed" Margin="20 10 20 10" Orientation="Vertical">
                                    <Button Click="DataEditOpen" IsEnabled="{Binding DataEditP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="مراجعة الحركات"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="AddAttendOpen" IsEnabled="{Binding ManualP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="Manual"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="MonthlyDataOpen" IsEnabled="{Binding MonthlyP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="الحركات الشهرية"/>
                                </StackPanel>

                                <!-- زر المرتبات مع أيقونة -->
                                <Button IsEnabled="{Binding SalaryP}" Click="Panel_btn_Click" Cursor="Hand" Tag="SalaryPanel" Style="{StaticResource HoverButtonStyle}" Height="60" Margin="0 10 0 10" BorderThickness="0" Background="Transparent">
                                    <StackPanel Width="180" Orientation="Horizontal">
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="2" BorderThickness="1">
                                            <Icon:PackIconMaterial Kind="CashMultiple"  Width="45" Height="45"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" Text="الاجور والمرتبات" Margin="25 0 0 0" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel HorizontalAlignment="Center" Name="SalaryPanel" Visibility="Collapsed" Margin="20 10 20 10" Orientation="Vertical">
                                    <Button Click="AddMainSalary" IsEnabled="{Binding AddMainSalaryP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="ادارة ماليات موظف"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="SalaryReport" IsEnabled="{Binding SalaryReportP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft">
                                        <TextBlock Text="تقرير المرتبات" FontSize="14"/>
                                    </Button>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="AddDeductions" IsEnabled="{Binding AddDeductionsP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" FontSize="12">
                                        <TextBlock Text="استحقاقات و استقطاعت" Foreground="#FFFFFF" FontSize="14" FontWeight="Normal"/>
                                    </Button>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button x:Name="btnImportCommissions" 
        IsEnabled="{Binding UploadCommessionsP}"
        Click="btnImportCommissions_Click"
Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" FontSize="12">
                                        <TextBlock Text="رفع العمولات" Foreground="#FFFFFF" FontSize="14" FontWeight="Normal"/>

                                    </Button>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="MonthlySalaryDataOpen" IsEnabled="{Binding MonthlyP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="البيانات الشهرية"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="BulkSalaryPaymentOpen" IsEnabled="{Binding BulkSalaryPaymentP}"  Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="صرف المرتبات الجماعي"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="LoanManagementOpen" Tag="LoanManagementPanel" IsEnabled="{Binding LoanManagementP}"  Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="ادارة السلف"/>
                                </StackPanel>

                                <!-- زر FingerPrints مع أيقونة -->
                                <Button IsEnabled="{Binding MachineP}" Click="Panel_btn_Click" Cursor="Hand" Tag="FingerPrintsPanel" Style="{StaticResource HoverButtonStyle}" Height="60" Margin="0 10 0 10" BorderThickness="0" Background="Transparent">
                                    <StackPanel Width="180" Orientation="Horizontal">
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="2" BorderThickness="1">
                                            <Icon:PackIconMaterial Kind="Fingerprint" Width="45" Height="45"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" Text="FingerPrints" Margin="25 0 0 0" FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel HorizontalAlignment="Center" Name="FingerPrintsPanel" Visibility="Collapsed" Margin="20 10 20 10" Orientation="Vertical">
                                    <Button Click="AddMachineOpen" IsEnabled="{Binding AddMachineP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="Add"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="GetDataClicked" IsEnabled="{Binding GetDataP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft">
                                        <TextBlock Text="Upload Fingerprint" FontSize="14"/>
                                    </Button>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="download_data_btn_ButtonClicked" IsEnabled="{Binding DownloadDataP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="Download Data"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="upload_data_btn_ButtonClicked" IsEnabled="{Binding UploadDataP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="Upload Data"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button Click="BtnGenerateTemplate_Click"  Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="Download Template"/>
                                </StackPanel>

                                <!-- زر Settings مع أيقونة -->
                                <Button IsEnabled="{Binding SettingsP}" Click="Panel_btn_Click" Cursor="Hand" Tag="SettingsPanel" Style="{StaticResource HoverButtonStyle}" Height="60" Margin="0 10 0 10" BorderThickness="0" Background="Transparent">
                                    <StackPanel Width="180" Orientation="Horizontal">
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="5" BorderThickness="1">
                                            <Icon:PackIconMaterial Kind="Cog"  Width="45" Height="45"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" Text="Settings" Margin="25 0 0 0" FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel HorizontalAlignment="Center" Name="SettingsPanel" Visibility="Collapsed" Margin="20 10 20 0" Orientation="Vertical">
                                    <Button IsEnabled="{Binding AllDatasP}" Click="Datas_MouseLeftButtonDown" Tag="DatasPanel" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="اضافة البيانات"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button IsEnabled="{Binding AllPermissionP}" Click="Permission_MouseLeftButtonDown" Tag="PermissionsPanel" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="الصلاحيات"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button IsEnabled="{Binding Backup}" Click="Backup_Button_Click" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="Backup"/>
                                    <Separator Margin="15" Background="#FFFFFF"/>
                                    <Button IsEnabled="{Binding AllSettingsP}" Tag="MainSettingsPanel" Click="MainSettings_MouseLeftButtonDown" Style="{StaticResource TextButtonStyle}" Cursor="Hand" Foreground="#FFFFFF" FlowDirection="RightToLeft" Content="الاعدادات العامة"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- زر Logout مع أيقونة -->
                            <Button Name="logout_btn" Click="logout_btn_Click" Style="{StaticResource HoverButtonStyle}" Cursor="Hand" Height="60" DockPanel.Dock="Bottom" Margin="0 10 0 0" BorderThickness="0" Background="Transparent">
                                <StackPanel Width="180" Orientation="Horizontal">
                                    <Border CornerRadius="8" BorderBrush="#FFFFFF" Width="55" Height="55" Padding="2" BorderThickness="1">
                                        <Icon:PackIconMaterial Kind="Logout" Width="45" Height="45"/>
                                    </Border>
                                    <TextBlock HorizontalAlignment="Right" Text="Logout" Margin="25 0 0 0" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </DockPanel>
                    </ScrollViewer>
                </Border>

                <!-- السيده بار المحسن -->

                <!-- المناطق المنسدلة المحسنة -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DatasPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1" x:Name="DatasPanel" HorizontalAlignment="Right" Width="180">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform" X="-250"/>
                        </Grid.RenderTransform>
                            <Border CornerRadius="20 20 20 20" Background="{StaticResource HeaderBackground}"  >
                            <StackPanel Margin="10 20 10 10" Orientation="Vertical">
                                <Button Click="AddDepartOpen" IsEnabled="{Binding DepartP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="الادارات"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                <Button Click="AddJobOpen" IsEnabled="{Binding JobP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="الوظائف"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                <Button Click="AddJobDegreeOpen" IsEnabled="{Binding DegreeP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="القطاعات"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                <Button Click="AddShiftOpen" IsEnabled="{Binding ShiftP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="الورديات"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                <Button Visibility="Collapsed" Click="AddBreakOpen" IsEnabled="{Binding BreakP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="الراحات"/>
                                <Button FontSize="12" Click="AddLateOpen" IsEnabled="{Binding LateP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="التأخير و الاضافي"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                <Button Click="AddHoliOpen" IsEnabled="{Binding WHP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="الاجازات الاسبوعية"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                <Button Click="AddHoliTypeOpen" IsEnabled="{Binding HTypeP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="أنواع الاجازات"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PermissionsPanel -->
                    <Grid FlowDirection="LeftToRight" Grid.Column="1" Grid.Row="1" x:Name="PermissionsPanel" HorizontalAlignment="Right" Width="180">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTransform1" X="-250"/>
                        </Grid.RenderTransform>
                            <Border CornerRadius="20 20 20 20" Background="{StaticResource HeaderBackground}"  >
                            <StackPanel Margin="10 20 10 0" Orientation="Vertical">
                                    <Button Click="PermissionsOpen" IsEnabled="{Binding PermissionP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="صلاحيات البرنامج"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
                                    <Button Click="UserPermissionsOpen" IsEnabled="{Binding UserPermissionP}" Style="{StaticResource TextButtonStyle}" Cursor="Hand" FlowDirection="RightToLeft" Content="صلاحيات المستخدم"/>
                                <Separator Margin="20" Background="#FFFFFF"/>
