<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sho2onMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sho2onMobile"
    xmlns:pages="clr-namespace:Sho2onMobile.Pages"
    Title="Sho2onMobile">

    <ShellContent
        Title="Login Page"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Main Page"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Register Page"
        ContentTemplate="{DataTemplate pages:RegisterPage}"
        Route="RegisterPage" />

</Shell>
