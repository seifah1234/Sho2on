diff -ruN repo_orig_v2/Sho2on-mobile/Sho2on.Web/Components/Pages/Attendance/LiveTracking.razor repo_extract/Sho2on-mobile/Sho2on.Web/Components/Pages/Attendance/LiveTracking.razor
