@using Microsoft.AspNetCore.Components.Authorization
@using Sho2on.Web.Constants
@using Sho2on.Web.Models
@using Sho2on.Web.Models.Navigation
@using Sho2on.Web.Services
@inject NavigationService Navigation
@inject LocalizationService Lang
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

<div class="sidebar" style="@(Lang.IsRtl ? "position: fixed; top: 0; right: 0; bottom: 0; height: 100vh;" : "position: fixed; top: 0; left: 0; bottom: 0; height: 100vh;")" dir="@(Lang.IsRtl ? "rtl" : "ltr")">
    <!-- الزخارف -->
    <div class="sidebar-decoration"></div>
    <div class="sidebar-dots">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
    </div>

    <div class="sidebar-header">
        <div class="logo">
            <div class="logo-icon">R</div>
            <div class="logo-text">
                <h3>RAKZ</h3>
                <span>@Lang.T("نظام الموارد البشرية")</span>
            </div>
        </div>
    </div>

    <div class="sidebar-divider"></div>

    <div class="sidebar-menu">
        @if (visibleMenu != null)
        {
            @foreach (var item in visibleMenu)
            {
                <SidebarGroup Item="item" />
            }
        }
    </div>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="avatar">@initials</div>
            <div>
                <strong>@userName</strong><small>@userRole</small>
            </div>
        </div>
    </div>
</div>

@code {
    string userName = "";
    string userRole = "";
    string initials = "?";
    List<NavigationItem>? visibleMenu;

    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.FindFirst("FullName")?.Value ?? user.Identity?.Name ?? "";
        userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        if (!string.IsNullOrEmpty(userName)) initials = userName.Trim()[0].ToString().ToUpper();
        bool isAdmin = user.IsInRole(RoleNames.Admin);
        var userPermissions = user.Claims.Where(c => c.Type == "perm").Select(c => c.Value).ToHashSet();

        var fullMenu = Navigation.GetMenu();
        visibleMenu = isAdmin ? fullMenu : FilterByPermissions(fullMenu, userPermissions);

    }

    List<NavigationItem> FilterByPermissions(List<NavigationItem> items, HashSet<string> userPermissions)
    {
        var result = new List<NavigationItem>();

        foreach (var item in items)
        {
            if (item.Children.Count > 0)
            {
                var visibleChildren = FilterByPermissions(item.Children, userPermissions);
                if (visibleChildren.Count > 0)
                {
                    result.Add(new NavigationItem
                    {
                        Title = item.Title,
                        Icon = item.Icon,
                        Url = item.Url,
                        RequiredPermission = item.RequiredPermission,
                        Children = visibleChildren
                    });
                }
            }
            else if (item.RequiredPermission == null || userPermissions.Contains(item.RequiredPermission))
            {
                result.Add(item);
            }
        }

        return result;
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
    }
}