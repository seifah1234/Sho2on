@using Microsoft.AspNetCore.Components.Authorization
@using Sho2on.Web.Models
@using Sho2on.Web.Services
@inject NavigationService Navigation
@inject LocalizationService Lang
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

<div class="sidebar" style="position: fixed; top: 0; right: 0; bottom: 0; height: 100vh;">
    <!-- الزخارف -->
    <div class="sidebar-decoration"></div>
    <div class="sidebar-dots">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
    </div>

    <div class="sidebar-header">
        <div class="logo">
            <div class="logo-icon">R</div>
            <div class="logo-text">
                <h3>RAKZ</h3>
                <span>@Lang.T("نظام الموارد البشرية")</span>
            </div>
        </div>
    </div>

    <div class="sidebar-divider"></div>

    <div class="sidebar-menu">
        @foreach (var item in Navigation.GetMenu())
        {
            <SidebarGroup Item="item" />
        }
    </div>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="avatar">@initials</div>
            <div>
                <strong>@userName</strong>
                <small>@userRole</small>
            </div>
        </div>
    </div>
</div>

@code {
    string userName = "";
    string userRole = "";
    string initials = "?";

    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.FindFirst("FullName")?.Value ?? user.Identity?.Name ?? "";
        userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        if (!string.IsNullOrEmpty(userName)) initials = userName.Trim()[0].ToString().ToUpper();
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
    }
}