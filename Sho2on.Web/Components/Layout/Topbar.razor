@using Microsoft.AspNetCore.Components.Authorization
@using Sho2on.Web.Services
@inject LocalizationService Lang
@inject UiStateService UiState
@inject AuthenticationStateProvider AuthProvider

<header class="topbar">
    <div class="topbar-left">
        <button class="icon-btn" @onclick="UiState.ToggleSidebar">
            <i class="bi bi-list"></i>
        </button>
        <div class="page-info">
            <h2>@Lang.T("لوحة التحكم")</h2>
            <span>@Lang.T("مرحباً بك فى نظام Sho2on")</span>
        </div>
    </div>

    <div class="topbar-right">
        <button class="icon-btn" @onclick="Lang.Toggle">
            <i class="bi bi-translate"></i>
        </button>
        <button class="icon-btn">
            <i class="bi bi-moon"></i>
        </button>
        <button class="icon-btn notification">
            <i class="bi bi-bell"></i>
            <span class="badge">5</span>
        </button>
        <div class="user-menu">
            <div class="avatar">@initials</div>
            <div class="user-info">
                <strong>@userName</strong>
                <small>@userRole</small>
            </div>
            <i class="bi bi-chevron-down"></i>
        </div>
    </div>
</header>

@code {
    string userName = "";
    string userRole = "";
    string initials = "?";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.FindFirst("FullName")?.Value ?? user.Identity?.Name ?? "";
        userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        if (!string.IsNullOrEmpty(userName)) initials = userName.Trim()[0].ToString().ToUpper();
    }
}