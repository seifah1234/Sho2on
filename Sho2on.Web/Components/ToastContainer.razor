@inject NotificationService Notify
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in Notify.Messages.ToList())
    {
        <div class="toast toast-@toast.Type">
            <i class="bi @(toast.Type == "error" ? "bi-exclamation-circle" : "bi-check-circle")"></i>
            <span>@toast.Message</span>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Notify.OnChange += StateHasChanged;
    public void Dispose() => Notify.OnChange -= StateHasChanged;
}