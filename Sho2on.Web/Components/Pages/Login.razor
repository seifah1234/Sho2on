@using static Microsoft.AspNetCore.Components.Web.RenderMode
@page "/login"
@rendermode InteractiveServer
@using Sho2on.Web.Services
@using Sho2on.Web.Components.Layout

@layout EmptyLayout
@inject LocalizationService Lang
@inject IJSRuntime JSRuntime

<div class="login-page" dir="@(Lang.IsRtl ? "rtl" : "ltr")">

    <!-- ══ البانل الأيسر - GIF الخلفية (مخفي في الموبايل) ══ -->
    <div class="brand-panel">
        <div class="brand-background">
            <img src="/images/Back.gif" alt="Background" class="bg-gif" />
            <div class="bg-overlay"></div>
        </div>

        <div class="brand-decor">
            <div class="decor-circle decor-1"></div>
            <div class="decor-circle decor-2"></div>
            <div class="decor-circle decor-3"></div>
        </div>

        <div class="brand-content">
            <h1>@Lang.T("نظام RAKZ")</h1>
            <p>@Lang.T("إدارة الموظفين والحضور والرواتب في مكان واحد")</p>
        </div>

        <p class="brand-footer">© Original IBS</p>
    </div>

    <!-- ══ البانل الأيمن - كارت تسجيل الدخول ══ -->
    <div class="form-panel">
        <button class="lang-toggle" @onclick="async () => await Lang.Toggle()">
            <i class="bi bi-globe"></i>
            @(Lang.IsRtl ? "English" : "عربي")
        </button>

        <div class="login-card">
            <div class="card-header">
                <div class="card-logo">
                    <img src="/images/logo.png" alt="RAKZ" class="card-logo-img"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="card-logo-fallback" style="display:none;">
                        <span>R</span>
                    </div>
                </div>
                <h3>@Lang.T("تسجيل الدخول")</h3>
                <p>@Lang.T("أهلاً بك، سجّل دخولك للمتابعة")</p>
            </div>

            <form class="login-form" @onsubmit="HandleSubmit">
                <div class="input-group">
                    <label for="username">
                        <i class="bi bi-person"></i>
                        @Lang.T("اسم المستخدم")
                    </label>
                    <div class="input-wrapper">
                        <i class="bi bi-person input-icon"></i>
                        <input id="username" type="text" name="username"
                               placeholder="@Lang.T("أدخل اسم المستخدم")"
                               autocomplete="username"
                               @bind="username" />
                    </div>
                </div>

                <div class="input-group">
                    <label for="password">
                        <i class="bi bi-key"></i>
                        @Lang.T("كلمة المرور")
                    </label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock input-icon"></i>
                        <input id="password" type="password" name="password"
                               placeholder="@Lang.T("أدخل كلمة المرور")"
                               autocomplete="current-password"
                               @bind="password" />
                    </div>
                </div>

                <button type="submit" class="login-submit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        @Lang.T("جاري الدخول...")
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right"></i>
                        @Lang.T("تسجيل الدخول")
                    }
                </button>
            </form>

            @if (ErrorType == "invalid")
            {
                <div class="error-message shake">
                    <div class="error-icon">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                    <div class="error-text">
                        <strong>@Lang.T("فشل تسجيل الدخول")</strong>
                        <span>@Lang.T("اسم المستخدم أو كلمة المرور غير صحيحة")</span>
                    </div>
                </div>
            }
            else if (ErrorType == "connection")
            {
                <div class="error-message shake">
                    <div class="error-icon">
                        <i class="bi bi-wifi-off"></i>
                    </div>
                    <div class="error-text">
                        <strong>@Lang.T("خطأ في الاتصال")</strong>
                        <span>@Lang.T("تعذر الاتصال بالخادم، برجاء المحاولة لاحقاً")</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorType { get; set; }

    private string username = "";
    private string password = "";
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            return;
        }

        isLoading = true;

        try
        {
            await JSRuntime.InvokeVoidAsync("submitLoginForm", username, password);
        }
        catch
        {
            isLoading = false;
        }
    }
}