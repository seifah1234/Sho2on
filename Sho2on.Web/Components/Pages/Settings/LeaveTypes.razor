@page "/settings/leave-types"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]

@using Microsoft.AspNetCore.Components.Forms
@using Sho2on.Web.Models
@using Sho2on.Web.Services
@using static Sho2on.Web.Services.LeaveTypeService

@inject LeaveTypeService LeaveTypeSvc
@inject NotificationService Notify
@inject LocalizationService Lang
@inject ILogger<LeaveTypes> Logger

@using Sho2on.Web.Models.Navigation

<ModuleTabs Tabs="LeaveTabs.Items" />
<div class="leave-types-page">

    <div class="page-toolbar">
        <div class="search-filter">
            <input class="search-input"
                   placeholder="@Lang.T("ابحث بالاسم أو الكود")"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="HandleSearchKeyUp" />

            <button class="btn-secondary" @onclick="LoadItems">
                <i class="bi bi-search"></i>
                @Lang.T("بحث")
            </button>
        </div>

        <button class="btn-primary" @onclick="StartCreate">
            <i class="bi bi-plus-lg"></i>
            @Lang.T("إضافة نوع إجازة")
        </button>
    </div>

    <div class="leave-types-layout @(!showForm ? "full-width" : "")">
        <section class="table-wrapper">
            @if (loading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>@Lang.T("جاري التحميل...")</p>
                </div>
            }
            else if (items.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>@Lang.T("لا توجد أنواع إجازات")</p>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Lang.T("الاسم")</th>
                            <th>@Lang.T("الكود")</th>
                            <th class="hide-sm">@Lang.T("الرصيد الافتراضي")</th>
                            <th>@Lang.T("الحالة")</th>
                            <th class="hide-md">@Lang.T("الخصم")</th>
                            <th class="hide-md">@Lang.T("الموافقة")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(!item.IsActive ? "inactive-row" : "")">
                                <td>@item.Name</td>
                                <td><span class="code-badge">@item.Code</span></td>
                                <td class="hide-sm">@item.DefaultBalance @Lang.T("يوم")</td>
                                <td>
                                    <span class="status @(item.IsActive ? "active" : "inactive")">
                                        @(item.IsActive ? Lang.T("نشط") : Lang.T("غير نشط"))
                                    </span>
                                </td>
                                <td class="hide-md">@(item.DeductFromBalance ? Lang.T("يخصم") : Lang.T("لا يخصم"))</td>
                                <td class="hide-md">@(item.RequiresApproval ? Lang.T("يتطلب موافقة") : Lang.T("مباشر"))</td>
                                <td class="row-actions">
                                    <button class="icon-action"
                                            title="@Lang.T("تعديل")"
                                            @onclick="() => StartEdit(item.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="icon-action danger"
                                            title="@Lang.T("حذف")"
                                            @onclick="() => Delete(item)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (showForm)
        {
            <aside class="form-card">
                <div class="form-title">
                    <h3>@(form.Id.HasValue ? Lang.T("تعديل نوع إجازة") : Lang.T("نوع إجازة جديد"))</h3>

                    <button class="icon-action" title="@Lang.T("إغلاق")" @onclick="CloseForm">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <EditForm Model="form" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="field">
                        <label>@Lang.T("اسم نوع الإجازة")</label>
                        <InputText @bind-Value="form.Name" />
                        <ValidationMessage For="() => form.Name" />
                    </div>

                    <div class="field">
                        <label>@Lang.T("الكود")</label>
                        <InputText @bind-Value="form.Code" />
                        <ValidationMessage For="() => form.Code" />
                    </div>

                    <div class="field">
                        <label>@Lang.T("الرصيد الافتراضي (بالأيام)")</label>
                        <InputNumber @bind-Value="form.DefaultBalance" />
                        <ValidationMessage For="() => form.DefaultBalance" />
                    </div>

                    <div class="field">
                        <label>@Lang.T("الحد الأقصى للأيام المتتالية")</label>
                        <InputNumber @bind-Value="form.MaxConsecutiveDays" />
                        <small>@Lang.T("اتركه فارغًا إذا لم يوجد حد.")</small>
                        <ValidationMessage For="() => form.MaxConsecutiveDays" />
                    </div>

                    <div class="field checkbox">
                        <label>
                            <InputCheckbox @bind-Value="form.IsActive" />
                            @Lang.T("نوع الإجازة نشط")
                        </label>
                    </div>

                    <div class="field checkbox">
                        <label>
                            <InputCheckbox @bind-Value="form.DeductFromBalance" />
                            @Lang.T("يخصم من رصيد الموظف")
                        </label>
                    </div>

                    <div class="field checkbox">
                        <label>
                            <InputCheckbox @bind-Value="form.RequiresApproval" />
                            @Lang.T("يتطلب موافقة المدير")
                        </label>
                    </div>

                    <div class="field">
                        <label>@Lang.T("ملاحظات")</label>
                        <InputTextArea @bind-Value="form.Notes" rows="4" />
                        <ValidationMessage For="() => form.Notes" />
                    </div>

                    <div class="form-actions">
                        <button class="btn-primary" type="submit" disabled="@saving">
                            <i class="bi bi-floppy"></i>
                            @(saving ? Lang.T("جاري الحفظ...") : Lang.T("حفظ"))
                        </button>

                        <button class="btn-secondary" type="button" @onclick="CloseForm">
                            @Lang.T("إلغاء")
                        </button>
                    </div>
                </EditForm>
            </aside>
        }
    </div>
</div>

@code {
    private List<LeaveTypeListItem> items = [];
    private LeaveTypeFormModel form = new();
    private string searchTerm = "";
    private bool loading = true;
    private bool saving;
    private bool showForm;

    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        try
        {
            loading = true;
            StateHasChanged();
            items = await LeaveTypeSvc.GetListAsync(searchTerm);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load leave types");
            Notify.ShowError(Lang.T("تعذر تحميل أنواع الإجازات"));
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await LoadItems();
    }

    private void StartCreate()
    {
        form = new LeaveTypeFormModel();
        showForm = true;
    }

    private async Task StartEdit(int id)
    {
        var result = await LeaveTypeSvc.GetByIdAsync(id);

        if (result is null)
        {
            Notify.ShowError(Lang.T("نوع الإجازة غير موجود"));
            return;
        }

        form = result;
        showForm = true;
    }

    private async Task Save()
    {
        try
        {
            saving = true;
            StateHasChanged();

            var isEdit = form.Id.HasValue;
            await LeaveTypeSvc.SaveAsync(form);

            Notify.ShowSuccess(isEdit
                ? Lang.T("تم تعديل نوع الإجازة بنجاح")
                : Lang.T("تم إضافة نوع الإجازة بنجاح"));

            CloseForm();
            await LoadItems();
        }
        catch (InvalidOperationException ex)
        {
            Notify.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save leave type");
            Notify.ShowError(Lang.T("حدث خطأ أثناء حفظ نوع الإجازة"));
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private async Task Delete(LeaveTypeListItem item)
    {
        try
        {
            await LeaveTypeSvc.DeleteAsync(item.Id);
            Notify.ShowSuccess(Lang.T("تم حذف نوع الإجازة بنجاح"));
            await LoadItems();
        }
        catch (InvalidOperationException ex)
        {
            Notify.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete leave type {Id}", item.Id);
            Notify.ShowError(Lang.T("حدث خطأ أثناء حذف نوع الإجازة"));
        }
    }

    private void CloseForm()
    {
        form = new LeaveTypeFormModel();
        showForm = false;
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;
}