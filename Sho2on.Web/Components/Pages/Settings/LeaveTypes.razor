@page "/settings/leave-types"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]

@using Microsoft.AspNetCore.Components.Forms
@using Sho2on.Web.Models
@using Sho2on.Web.Services
@using static Sho2on.Web.Services.LeaveTypeService

@inject LeaveTypeService LeaveTypeSvc
@inject NotificationService Notify
@inject ILogger<LeaveTypes> Logger

@using Sho2on.Web.Models.Navigation

<ModuleTabs Tabs="LeaveTabs.Items" />
<div class="leave-types-page">

    <div class="page-toolbar">
        <div class="search-filter">
            <input class="search-input"
                   placeholder="ابحث بالاسم أو الكود"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="HandleSearchKeyUp" />

            <button class="btn-secondary" @onclick="LoadItems">
                <i class="bi bi-search"></i>
                بحث
            </button>
        </div>

        <button class="btn-primary" @onclick="StartCreate">
            <i class="bi bi-plus-lg"></i>
            إضافة نوع إجازة
        </button>
    </div>

    <div class="leave-types-layout">
        <section class="table-wrapper">
            @if (loading)
            {
                <p class="empty-state">جاري التحميل...</p>
            }
            else if (items.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>لا توجد أنواع إجازات</p>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th>الكود</th>
                            <th>الرصيد الافتراضي</th>
                            <th>الحالة</th>
                            <th>الخصم من الرصيد</th>
                            <th>الموافقة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(!item.IsActive ? "inactive-row" : "")">
                                <td>@item.Name</td>
                                <td><span class="code-badge">@item.Code</span></td>
                                <td>@item.DefaultBalance يوم</td>
                                <td>
                                    <span class="status @(item.IsActive ? "active" : "inactive")">
                                        @(item.IsActive ? "نشط" : "غير نشط")
                                    </span>
                                </td>
                                <td>@(item.DeductFromBalance ? "يخصم" : "لا يخصم")</td>
                                <td>@(item.RequiresApproval ? "يتطلب موافقة" : "مباشر")</td>
                                <td class="row-actions">
                                    <button class="icon-action"
                                            title="تعديل"
                                            @onclick="() => StartEdit(item.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="icon-action danger"
                                            title="حذف"
                                            @onclick="() => Delete(item)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (showForm)
        {
            <aside class="form-card">
                <div class="form-title">
                    <h3>@(form.Id.HasValue ? "تعديل نوع إجازة" : "نوع إجازة جديد")</h3>

                    <button class="icon-action" title="إغلاق" @onclick="CloseForm">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <EditForm Model="form" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="field">
                        <label>اسم نوع الإجازة</label>
                        <InputText @bind-Value="form.Name" />
                        <ValidationMessage For="() => form.Name" />
                    </div>

                    <div class="field">
                        <label>الكود</label>
                        <InputText @bind-Value="form.Code" />
                        <ValidationMessage For="() => form.Code" />
                    </div>

                    <div class="field">
                        <label>الرصيد الافتراضي (بالأيام)</label>
                        <InputNumber @bind-Value="form.DefaultBalance" />
                        <ValidationMessage For="() => form.DefaultBalance" />
                    </div>

                    <div class="field">
                        <label>الحد الأقصى للأيام المتتالية</label>
                        <InputNumber @bind-Value="form.MaxConsecutiveDays" />
                        <small>اتركه فارغًا إذا لم يوجد حد.</small>
                        <ValidationMessage For="() => form.MaxConsecutiveDays" />
                    </div>

                    <div class="field checkbox">
                        <label>
                            <InputCheckbox @bind-Value="form.IsActive" />
                            نوع الإجازة نشط
                        </label>
                    </div>

                    <div class="field checkbox">
                        <label>
                            <InputCheckbox @bind-Value="form.DeductFromBalance" />
                            يخصم من رصيد الموظف
                        </label>
                    </div>

                    <div class="field checkbox">
                        <label>
                            <InputCheckbox @bind-Value="form.RequiresApproval" />
                            يتطلب موافقة المدير
                        </label>
                    </div>

                    <div class="field">
                        <label>ملاحظات</label>
                        <InputTextArea @bind-Value="form.Notes" rows="4" />
                        <ValidationMessage For="() => form.Notes" />
                    </div>

                    <div class="form-actions">
                        <button class="btn-primary" type="submit" disabled="@saving">
                            <i class="bi bi-floppy"></i>
                            @(saving ? "جاري الحفظ..." : "حفظ")
                        </button>

                        <button class="btn-secondary" type="button" @onclick="CloseForm">
                            إلغاء
                        </button>
                    </div>
                </EditForm>
            </aside>
        }
    </div>
</div>

@code {
    private List<LeaveTypeListItem> items = [];
    private LeaveTypeFormModel form = new();
    private string searchTerm = "";
    private bool loading = true;
    private bool saving;
    private bool showForm;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        try
        {
            loading = true;
            items = await LeaveTypeSvc.GetListAsync(searchTerm);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load leave types");
            Notify.ShowError("تعذر تحميل أنواع الإجازات");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await LoadItems();
    }

    private void StartCreate()
    {
        form = new LeaveTypeFormModel();
        showForm = true;
    }

    private async Task StartEdit(int id)
    {
        var result = await LeaveTypeSvc.GetByIdAsync(id);

        if (result is null)
        {
            Notify.ShowError("نوع الإجازة غير موجود");
            return;
        }

        form = result;
        showForm = true;
    }

    private async Task Save()
    {
        try
        {
            saving = true;

            var isEdit = form.Id.HasValue;
            await LeaveTypeSvc.SaveAsync(form);

            Notify.ShowSuccess(isEdit
                ? "تم تعديل نوع الإجازة بنجاح"
                : "تم إضافة نوع الإجازة بنجاح");

            CloseForm();
            await LoadItems();
        }
        catch (InvalidOperationException ex)
        {
            Notify.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save leave type");
            Notify.ShowError("حدث خطأ أثناء حفظ نوع الإجازة");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete(LeaveTypeListItem item)
    {
        try
        {
            await LeaveTypeSvc.DeleteAsync(item.Id);
            Notify.ShowSuccess("تم حذف نوع الإجازة بنجاح");
            await LoadItems();
        }
        catch (InvalidOperationException ex)
        {
            Notify.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete leave type {Id}", item.Id);
            Notify.ShowError("حدث خطأ أثناء حذف نوع الإجازة");
        }
    }

    private void CloseForm()
    {
        form = new LeaveTypeFormModel();
        showForm = false;
    }
}