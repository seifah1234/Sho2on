@page "/settings/branches"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@using Sho2on.Database.Models
@using Sho2on.Web.Models
@using Sho2on.Web.Services
@inject BranchService BranchSvc
@inject AreaService AreaSvc
@inject LocalizationService Lang
@inject NotificationService Notify
@inject IJSRuntime JS
@implements IDisposable

<div class="settings-page">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-building"></i> @Lang.T("الفروع")</h2>
            <p class="page-subtitle">@Lang.T("إدارة فروع الشركة")</p>
        </div>
        <button class="btn-primary" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> @Lang.T("إضافة فرع")
        </button>
    </div>

    @if (loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>@Lang.T("جاري التحميل...")</p></div>
    }
    else if (items == null || items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-building"></i><p>@Lang.T("لا توجد فروع")</p></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Lang.T("الاسم")</th>
                        <th>@Lang.T("المنطقة")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.AreaName</td>
                            <td class="row-actions">
                                <button class="icon-action" title="@Lang.T("تعديل")" @onclick="() => OpenEditModal(item)"><i class="bi bi-pencil"></i></button>
                                <button class="icon-action danger" title="@Lang.T("حذف")" @onclick="() => RequestDelete(item)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isEdit ? Lang.T("تعديل فرع") : Lang.T("فرع جديد"))</h3>
                <button class="icon-action" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label>@Lang.T("الاسم")</label>
                    <input class="search-input" @bind="formName" placeholder="@Lang.T("اسم الفرع")" />
                </div>
                <div class="field">
                    <label>@Lang.T("المنطقة")</label>
                    <select class="select-input" @bind="formAreaId">
                        <option value="">@Lang.T("اختر المنطقة")</option>
                        @if (areas != null)
                        {
                            @foreach (var a in areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- حقل الموقع -->
                <div class="field">
                    <label>@Lang.T("موقع الفرع")</label>
                    <div class="map-container">
                        <div id="branch-map" class="branch-map"></div>
                    </div>
                    <small class="map-hint">
                        @Lang.T("اضغط على الخريطة لتحديد موقع الفرع")
                    </small>
                </div>

                <!-- حقل نطاق الحضور -->
                <div class="field">
                    <label>@Lang.T("نطاق الحضور")</label>
                    <div class="radius-input">
                        <input type="number"
                               class="search-input"
                               min="10"
                               max="5000"
                               @bind="formRadius"
                               @bind:event="oninput"
                               @onchange="OnRadiusChanged" />
                        <span>@Lang.T("متر")</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseModal">@Lang.T("إلغاء")</button>
                <button class="btn-primary" @onclick="SubmitSave">@Lang.T("حفظ")</button>
            </div>
        </div>
    </div>
}

@if (itemToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-box small" @onclick:stopPropagation="true">
            <div class="modal-header"><h3>@Lang.T("تأكيد الحذف")</h3></div>
            <div class="modal-body"><p>@Lang.T("هل أنت متأكد من حذف") <strong>@itemToDelete.Name</strong>؟</p></div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CancelDelete">@Lang.T("إلغاء")</button>
                <button class="btn-danger" @onclick="ConfirmDelete">@Lang.T("حذف")</button>
            </div>
        </div>
    </div>
}

@code {
    List<BranchDto>? items;
    List<AreaDto>? areas;
    bool loading = true;
    bool showModal = false;
    bool isEdit = false;
    int? editingId;
    string formName = "";
    int? formAreaId;
    BranchDto? itemToDelete;
    double? formLatitude;
    double? formLongitude;
    int formRadius = 100;
    bool mapInitialized = false;
    DotNetObjectReference<Branches>? dotNetRef;

    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;
    protected override async Task OnInitializedAsync() => await LoadData();

    async Task LoadData()
    {
        loading = true; StateHasChanged();
        try { items = await BranchSvc.GetAllAsync(); areas = await AreaSvc.GetAllAsync(); }
        catch { Notify.ShowError(Lang.T("حدث خطأ")); }
        finally { loading = false; StateHasChanged(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showModal && !mapInitialized)
        {
            mapInitialized = true;
            dotNetRef ??= DotNetObjectReference.Create(this);

            // انتظر حتى يظهر الـ modal بالكامل
            await Task.Delay(300);

            // استخدم الإحداثيات الصحيحة
            double initLat = formLatitude ?? 30.0444;
            double initLng = formLongitude ?? 31.2357;

            await JS.InvokeVoidAsync(
                            "branchMap.init",
                            "branch-map",
                            initLat,
                            initLng,
                            formRadius,
                            dotNetRef
                        );
        }
    }

    [JSInvokable]
    public Task LocationChanged(double latitude, double longitude)
    {
        formLatitude = latitude;
        formLongitude = longitude;
        StateHasChanged();
        return Task.CompletedTask;
    }

    void OpenAddModal()
    {
        isEdit = false;
        editingId = null;
        formName = "";
        formAreaId = null;

        // القاهرة كموقع افتراضي
        formLatitude = 30.0444;
        formLongitude = 31.2357;
        formRadius = 100;

        mapInitialized = false;
        showModal = true;
        StateHasChanged();
    }

    void OpenEditModal(BranchDto item)
    {
        isEdit = true;
        editingId = item.Id;
        formName = item.Name;
        formAreaId = item.AreaId;

        formLatitude = item.Latitude;
        formLongitude = item.Longitude;
        formRadius = item.RadiusMeters > 0 ? item.RadiusMeters : 100;

        mapInitialized = false;
        showModal = true;

        StateHasChanged();

        _ = InitializeMapAfterModalShown();
    }

    private async Task InitializeMapAfterModalShown()
    {
        // انتظر حتى يظهر الـ modal
        await Task.Delay(400);

        if (showModal && !mapInitialized)
        {
            mapInitialized = true;
            dotNetRef ??= DotNetObjectReference.Create(this);

            double initLat = formLatitude ?? 30.0444;
            double initLng = formLongitude ?? 31.2357;

            await JS.InvokeVoidAsync(
                            "branchMap.init",
                            "branch-map",
                            initLat,
                            initLng,
                            formRadius,
                            dotNetRef
                        );
        }
    }

    async Task CloseModal()
    {
        await JS.InvokeVoidAsync("branchMap.destroy");
        mapInitialized = false;
        showModal = false;
    }

    async Task OnRadiusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int radius))
        {
            formRadius = radius;
            await JS.InvokeVoidAsync("branchMap.setRadius", formRadius);
        }
    }

    async Task SubmitSave()
    {
        if (string.IsNullOrWhiteSpace(formName)) { Notify.ShowError(Lang.T("أدخل الاسم")); return; }
        if (!formLatitude.HasValue || !formLongitude.HasValue)
        {
            Notify.ShowError(Lang.T("حدد موقع الفرع على الخريطة"));
            return;
        }
        try
        {
            await BranchSvc.SaveAsync(
                editingId,
                formName,
                formAreaId,
                formLatitude,
                formLongitude,
                formRadius);
            Notify.ShowSuccess(Lang.T("تم الحفظ"));
            await CloseModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            Notify.ShowError($"{Lang.T("حدث خطأ")}: {ex.Message}");
        }
    }

    void RequestDelete(BranchDto item) => itemToDelete = item;
    void CancelDelete() => itemToDelete = null;

    async Task ConfirmDelete()
    {
        if (itemToDelete == null) return;
        try
        {
            await BranchSvc.DeleteAsync(itemToDelete.Id);
            Notify.ShowSuccess(Lang.T("تم الحذف"));
            itemToDelete = null;
            await LoadData();
        }
        catch
        {
            Notify.ShowError(Lang.T("حدث خطأ"));
        }
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;
}