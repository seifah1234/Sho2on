@page "/announcements/types"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@using Sho2on.Database.Models
@using Sho2on.Web.Services
@inject AnnouncementService AnnouncementSvc
@inject LocalizationService Lang
@inject NotificationService Notify
@inject ILogger<AnnouncementTypes> Logger
@implements IDisposable

<div class="announcement-types-page">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-tags"></i> @Lang.T("أنواع الإعلانات")</h2>
            <p class="page-subtitle">@Lang.T("إدارة أنواع الإعلانات")</p>
        </div>
        <button class="btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i> @Lang.T("نوع جديد")
        </button>
    </div>

    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>@Lang.T("جاري التحميل...")</p>
        </div>
    }
    else if (types == null || types.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <p>@Lang.T("لا توجد أنواع")</p>
        </div>
    }
    else
    {
        <div class="types-grid">
            @foreach (var type in types)
            {
                <div class="type-card">
                    <div class="type-icon" style="background-color: @type.Color">
                        <i class="bi bi-megaphone-fill"></i>
                    </div>
                    <div class="type-info">
                        <strong>@type.Name</strong>
                    </div>
                    <div class="type-actions">
                        <button class="icon-action" title="@Lang.T("تعديل")" @onclick="() => OpenEditModal(type)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="icon-action danger" title="@Lang.T("حذف")" @onclick="() => RequestDelete(type)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isEdit ? Lang.T("تعديل نوع") : Lang.T("نوع جديد"))</h3>
                <button class="icon-action" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label>@Lang.T("الاسم")</label>
                    <input class="search-input" @bind="formName" placeholder="@Lang.T("اسم النوع")" />
                </div>
                <div class="field">
                    <label>@Lang.T("اللون")</label>
                    <div class="color-picker">
                        <input type="color" @bind="formColor" />
                        <span>@formColor</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseModal">@Lang.T("إلغاء")</button>
                <button class="btn-primary" @onclick="SubmitSave">@Lang.T("حفظ")</button>
            </div>
        </div>
    </div>
}

@if (typeToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-box small" @onclick:stopPropagation="true">
            <div class="modal-header"><h3>@Lang.T("تأكيد الحذف")</h3></div>
            <div class="modal-body">
                <p>@Lang.T("هل أنت متأكد من حذف") <strong>@typeToDelete.Name</strong>؟</p>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CancelDelete">@Lang.T("إلغاء")</button>
                <button class="btn-danger" @onclick="ConfirmDelete">@Lang.T("حذف")</button>
            </div>
        </div>
    </div>
}

@code {
    List<AnnouncementType>? types;
    bool loading = true;
    bool showModal = false;
    bool isEdit = false;
    int? editingId;
    string formName = "";
    string formColor = "#64748B";

    AnnouncementType? typeToDelete;

    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        loading = true;
        StateHasChanged();
        try
        {
            types = await AnnouncementSvc.GetAnnouncementTypesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ أثناء تحميل أنواع الإعلانات");
            Notify.ShowError(Lang.T("حدث خطأ أثناء تحميل البيانات"));
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }




    void OpenCreateModal()
    {
        isEdit = false;
        editingId = null;
        formName = "";
        formColor = "#64748B";
        showModal = true;
    }

    void OpenEditModal(AnnouncementType type)
    {
        isEdit = true;
        editingId = type.Id;
        formName = type.Name;
        formColor = type.Color;
        showModal = true;
    }

    void CloseModal() => showModal = false;

    async Task SubmitSave()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            Notify.ShowError(Lang.T("أدخل الاسم"));
            return;
        }

        try
        {
            if (isEdit && editingId.HasValue)
            {
                var existing = await AnnouncementSvc.GetAnnouncementTypeByIdAsync(editingId.Value);
                if (existing != null)
                {
                    existing.Name = formName;
                    existing.Color = formColor;
                    await AnnouncementSvc.UpdateAnnouncmentType(existing);
                }
            }
            else
            {
                var newType = new AnnouncementType
                {
                    Name = formName,
                    Color = formColor,
                };
                await AnnouncementSvc.CreateAnnouncmentType(newType);
            }

            Notify.ShowSuccess(Lang.T("تم الحفظ بنجاح"));
            CloseModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ أثناء حفظ نوع الإعلان");
            Notify.ShowError(Lang.T("حدث خطأ، حاول مرة أخرى"));
        }
    }

    void RequestDelete(AnnouncementType type) => typeToDelete = type;
    void CancelDelete() => typeToDelete = null;

    async Task ConfirmDelete()
    {
        if (typeToDelete == null) return;
        try
        {
            await AnnouncementSvc.DeleteAnnouncmentType(typeToDelete);
            Notify.ShowSuccess(Lang.T("تم الحذف"));
            typeToDelete = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطأ أثناء حذف نوع الإعلان");
            Notify.ShowError(Lang.T("حدث خطأ"));
            typeToDelete = null;
        }
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;
}