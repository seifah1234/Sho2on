@page "/leaves/permissions"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]

@using System.Security.Claims
@using Sho2on.Database.Models
@using Sho2on.Web.Models.Navigation
@using Sho2on.Web.Services
@using static Sho2on.Web.Services.PermissionManagementService

@inject PermissionManagementService PermissionMgmtSvc
@inject AuthenticationStateProvider AuthProvider
@inject LocalizationService Lang
@inject NotificationService Notify
@inject CurrentUserService CurrentUserSvc

<div class="permission-management-page">

    <ModuleTabs Tabs="LeaveTabs.Items" />

    <div class="page-toolbar">
        <div class="search-filter">
            <input class="search-input"
                   placeholder="@Lang.T("ابحث باسم الموظف أو الكود")"
                   @bind="searchTerm"
                   @bind:event="oninput" />

            <select class="select-input" @bind="selectedStatus">
                <option value="">@Lang.T("كل الحالات")</option>
                <option value="Pending" selected>@Lang.T("قيد الانتظار")</option>
                <option value="Approved">@Lang.T("معتمد")</option>
                <option value="Rejected">@Lang.T("مرفوض")</option>
            </select>

            <button class="btn-secondary" @onclick="LoadRequests">
                <i class="bi bi-search"></i>
                @Lang.T("بحث")
            </button>
        </div>

        <a href="/leaves/permission-request" class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            @Lang.T("طلب إذن جديد")
        </a>
    </div>

    @if (loading)
    {
        <p class="muted">@Lang.T("جاري التحميل...")</p>
    }
    else if (requests.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-clock-history"></i>
            <p>@Lang.T("لا توجد طلبات أذونات")</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@Lang.T("الموظف")</th>
                        <th>@Lang.T("نوع الإذن")</th>
                        <th>@Lang.T("التاريخ والوقت")</th>
                        <th>@Lang.T("المدة")</th>
                        <th>@Lang.T("الحالة")</th>
                        <th>@Lang.T("المسؤول")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in requests)
                    {
                        <tr>
                            <td>
                                <strong>@item.EmployeeName</strong>
                                <small>@item.EmployeeCode</small>
                            </td>
                            <td>@GetPermissionTypeText(item.PermissionType)</td>
                            <td>
                                @item.StartDateTime.ToString("yyyy/MM/dd")
                                <br />
                                <small>
                                    @item.StartDateTime.ToString("HH:mm")
                                    -
                                    @item.EndDateTime.ToString("HH:mm")
                                </small>
                            </td>
                            <td>@item.Duration.ToString("0.##") @Lang.T("ساعة")</td>
                            <td>
                                <span class="status @GetStatusClass(item.Status)">
                                    @GetStatusText(item.Status)
                                </span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.ApproverName) ? "-" : item.ApproverName)</td>
                            <td class="row-actions">
                                @if ((isManager || isHR) && item.Status == "Pending")
                                {
                                    <button class="icon-action success"
                                            title="@Lang.T("اعتماد")"
                                            @onclick="() => Approve(item)">
                                        <i class="bi bi-check-lg"></i>
                                    </button>

                                    <button class="icon-action danger"
                                            title="@Lang.T("رفض")"
                                            @onclick="() => OpenReject(item)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
    
                                @* الموظف العادي يشوف التفاصيل فقط *@
                                <button class="icon-action info"
                                        title="@Lang.T("تفاصيل")"
                                        @onclick="() => ViewDetails(item)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (rejectingRequest is not null)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h3>@Lang.T("رفض طلب الإذن")</h3>

                <textarea class="reject-reason"
                          placeholder="@Lang.T("اكتب سبب الرفض")"
                          @bind="rejectionReason"></textarea>

                <div class="form-actions">
                    <button class="btn-primary danger-button" @onclick="ConfirmReject">
                        @Lang.T("تأكيد الرفض")
                    </button>

                    <button class="btn-secondary" @onclick="CloseReject">
                        @Lang.T("إلغاء")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@* مودال التفاصيل *@
@if (showDetails && selectedPermission != null)
{
    <div class="modal-backdrop" @onclick="CloseDetails">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@Lang.T("تفاصيل طلب الإذن")</h3>
                <button class="close-btn" @onclick="CloseDetails">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("الموظف")</span>
                    <span class="detail-value">@selectedPermission.EmployeeName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("الكود")</span>
                    <span class="detail-value">@selectedPermission.EmployeeCode</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("نوع الإذن")</span>
                    <span class="detail-value">@GetPermissionTypeText(selectedPermission.PermissionType)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("التاريخ")</span>
                    <span class="detail-value">@selectedPermission.StartDateTime.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("من وقت")</span>
                    <span class="detail-value">@selectedPermission.StartDateTime.ToString("HH:mm")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("إلى وقت")</span>
                    <span class="detail-value">@selectedPermission.EndDateTime.ToString("HH:mm")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("المدة")</span>
                    <span class="detail-value">@selectedPermission.Duration.ToString("0.##") @Lang.T("ساعة")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("الحالة")</span>
                    <span class="detail-value">
                        <span class="status @GetStatusClass(selectedPermission.Status)">
                            @GetStatusText(selectedPermission.Status)
                        </span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("السبب")</span>
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(selectedPermission.Reason) ? "-" : selectedPermission.Reason)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">@Lang.T("المسؤول")</span>
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(selectedPermission.ApproverName) ? "-" : selectedPermission.ApproverName)</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseDetails">@Lang.T("إغلاق")</button>
            </div>
        </div>
    </div>
}


@code {
    
    private List<PermissionListItem> requests = [];
    private PermissionListItem? rejectingRequest;
    private string searchTerm = "";
    private string selectedStatus = "Pending";
    private string rejectionReason = "";
    private int currentUserId;
    private bool isManager;
    private bool isHR;
    private bool loading = true;
    private bool showDetails = false;
    private PermissionListItem? selectedPermission;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        int.TryParse(
            authState.User.FindFirstValue("UserId"),
            out currentUserId);

            
        var user = await GetCurrentUserAsync();
        isManager = user?.JobTitle?.IsManager == true;
        isHR = user?.Department?.IsHR == true;

        await LoadRequests();
    }
    private void ViewDetails(PermissionListItem item)
    {
        selectedPermission = item;
        showDetails = true;
    }

    private void CloseDetails()
    {
        showDetails = false;
        selectedPermission = null;
    }

    private async Task<User?> GetCurrentUserAsync()
    {
        return await CurrentUserSvc.GetCurrentUserAsync();
    }
    private async Task LoadRequests()
    {
        loading = true;
        try
        {
            if (!isManager && !isHR)
            {
                // الموظف العادي يشوف طلباته فقط
                requests = await PermissionMgmtSvc.GetRequestsByEmployeeAsync(currentUserId);
            }
            else
            {
                requests = await PermissionMgmtSvc.GetRequestsAsync(selectedStatus, searchTerm);
            }
        }
        catch
        {
            Notify.ShowError(Lang.T("تعذر تحميل طلبات الأذونات"));
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Approve(PermissionListItem item)
    {
        try
        {
            await PermissionMgmtSvc.ApproveAsync(item.Id, currentUserId);
            Notify.ShowSuccess(Lang.T("تم اعتماد طلب الإذن"));
            await LoadRequests();
        }
        catch (InvalidOperationException ex)
        {
            Notify.ShowError(ex.Message);
        }
    }

    private void OpenReject(PermissionListItem item)
    {
        rejectingRequest = item;
        rejectionReason = "";
    }

    private void CloseReject()
    {
        rejectingRequest = null;
        rejectionReason = "";
    }

    private async Task ConfirmReject()
    {
        if (rejectingRequest is null)
            return;

        try
        {
            await PermissionMgmtSvc.RejectAsync(
                rejectingRequest.Id,
                currentUserId,
                rejectionReason);

            Notify.ShowSuccess(Lang.T("تم رفض طلب الإذن"));

            CloseReject();
            await LoadRequests();
        }
        catch (InvalidOperationException ex)
        {
            Notify.ShowError(ex.Message);
        }
    }

    private string GetPermissionTypeText(string type) => type switch
    {
        "EarlyLeave" => Lang.T("خروج مبكر"),
        "LateEntry" => Lang.T("دخول متأخر"),
        "PersonalLeave" => Lang.T("إذن شخصي"),
        "Emergency" => Lang.T("إذن طارئ"),
        "Official" => Lang.T("إذن رسمي"),
        _ => Lang.T("أخرى")
    };

    private string GetStatusText(string status) => status switch
    {
        "Pending" => Lang.T("قيد الانتظار"),
        "Approved" => Lang.T("معتمد"),
        "Rejected" => Lang.T("مرفوض"),
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        "Pending" => "pending",
        "Approved" => "approved",
        "Rejected" => "rejected",
        _ => ""
    };
}